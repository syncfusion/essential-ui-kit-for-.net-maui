    </ContentView.Resources>
    <ContentView.Content>
        <Grid ColumnSpacing="0" RowSpacing="0">
            <!-- WINDOWS AND MAC VIEW -->
            <ScrollView IsVisible="{OnIdiom Phone=False,  Default=true}" HorizontalOptions="Fill"
                VerticalOptions="Fill" VerticalScrollBarVisibility="Never">
                <StackLayout HorizontalOptions="Fill" Spacing="0" VerticalOptions="Start">
                    <!--  NAVBAR AT TOP  -->
                    <StackLayout IsVisible="{OnIdiom Phone=False, Default=true}" HorizontalOptions="Fill"
                        Spacing="0" Grid.ColumnSpan="3" Grid.Row="0" VerticalOptions="Start">
                        <Grid
                            Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight} ,Dark={DynamicResource BackgroundColorDark}}"
                            ColumnDefinitions="*,Auto" HeightRequest="60">
                            <!--  Navigation Items (Right Side)  -->
                            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                                <HorizontalStackLayout Padding="0,10,8,10">

                                    <buttons:SfButton Text="Home" Style="{StaticResource NavButtonStyle}"
                                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                        FontFamily="Roboto-Medium" FontSize="14" HeightRequest="40" WidthRequest="58"
                                        CornerRadius="0">

                                    </buttons:SfButton>


                                    <!--  About Button  -->
                                    <buttons:SfButton Text="About Us" Style="{StaticResource NavButtonStyle}"
                                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                        FontFamily="Roboto-Medium" FontSize="14" Margin="4,0" HeightRequest="40"
                                        WidthRequest="79" CornerRadius="0" />
                                    <!--  Contact Button  -->
                                    <buttons:SfButton Text="Contact Us" Style="{StaticResource NavButtonStyle}"
                                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                        FontFamily="Roboto-Medium" FontSize="14" HeightRequest="40" WidthRequest="98"
                                        CornerRadius="0" />

                                </HorizontalStackLayout>

                                <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0"
    StrokeShape="RoundRectangle 50">
                                    <buttons:SfButton Style="{StaticResource NavButtonStyle}">
                                        <buttons:SfButton.Content>
                                            <DataTemplate>
                                                <Label Text="&#xE700;" FontFamily="UIKitIcons" VerticalOptions="Center"
                    FontSize="20" HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" HeightRequest="22" WidthRequest="22" />
                                            </DataTemplate>
                                        </buttons:SfButton.Content>

                                    </buttons:SfButton>
                                </Border>
                                <!--  Profile Image  -->
                                <Border StrokeThickness="0" Padding="0,6,24,6" BackgroundColor="Transparent"
                                x:Name="ProfileAvatarBorder">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ProfileButton_Tapped" />
                                    </Border.GestureRecognizers>
                                    <sfavatar:SfAvatarView ContentType="Custom" ImageSource="profileavatar.png"
                                    AvatarShape="Circle" AvatarSize="Small" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                        <!--  SEPARATOR LINE  -->
                        <BoxView BackgroundColor="{AppThemeBinding Light=#E5E1E3, Dark=#474648}" HeightRequest="1"
                            HorizontalOptions="Fill" />
                    </StackLayout>

                    <!--  MAIN CONTENT  -->
                    <StackLayout HorizontalOptions="Center" Spacing="0" VerticalOptions="Center">
                        <!--  SVG PATH WITH AVATARS ON TOP  -->
                        <Grid HorizontalOptions="Center" VerticalOptions="Center"
                            Margin="{OnIdiom Desktop='0,54,0,62', Phone='0,77,0,64'}">
                            <!--  SVG WAVY DESIGN (Background)  -->
                            <Path Data="{StaticResource WavyDesignPath}"
                                Fill="{AppThemeBinding Light=#F7EDFF, Dark=#35303C}" Opacity="0.7"
                                HorizontalOptions="Fill" VerticalOptions="Fill" />
                            <!--  3 GROUPED AVATAR IMAGES (On Top)  -->
                            <Grid HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="367"
                                WidthRequest="493">
                                <!--  First Avatar  -->
                                <sfavatar:SfAvatarView ContentType="Custom" ImageSource="middle3.jpg"
                                    HeightRequest="218" Margin="65,177,310,0" WidthRequest="118" ZIndex="3"
                                    CornerRadius="100" />
                                <!--  Second Avatar  -->
                                <sfavatar:SfAvatarView ContentType="Custom" ImageSource="middle1.jpg"
                                    Margin="152,49,161,29" HeightRequest="289" ZIndex="1" WidthRequest="180"
                                    CornerRadius="100" />
                                <!--  Third Avatar  -->
                                <sfavatar:SfAvatarView ContentType="Custom" ImageSource="middle2.jpg"
                                    Margin="285,14,90,135" HeightRequest="218" ZIndex="3" WidthRequest="118"
                                    CornerRadius="100" />
                            </Grid>
                        </Grid>
                        <!--  Product title  -->
                        <Label LineHeight="{OnPlatform Android=1.25, Default=1.22}" FontSize="36"
                            FontFamily="Roboto-Regular" Style="{DynamicResource TitleLabelStyle}" Padding="0"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                            HorizontalOptions="Center" HorizontalTextAlignment="Center" Text="About Us"
                            Margin="0,16,0,8" />
                        <!--  Product description  -->
                        <Label Margin="{OnPlatform Android='32,0,32,56' , Default='110,0,110,36'}"
                            Style="{DynamicResource DescriptionLabelStyle}" Padding="0"
                            TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                            HorizontalTextAlignment="Center" FontSize="16" LineHeight="1.5" CharacterSpacing="0.5"
                            FontFamily="Roboto-Regular" HeightRequest="{OnPlatform Android=202, Default=138}"
                            Text="We are passionate about [industry/sector focus], driven by a commitment to quality, innovation, and customer satisfaction. Since our founding in [1996], we have dedicated ourselves to delivering exceptional products/services that meet the evolving needs of our clients. Our team of experienced professionals works tirelessly to push the boundaries of what's possible, ensuring that we stay ahead of industry trends while maintaining the highest standards of excellence. We believe in the power of collaboration, creativity, and integrity, which are the core values that guide everything." />
                    </StackLayout>
                </StackLayout>
            </ScrollView>
            <!-- ANDROID AND iOS VIEW -->
            <ScrollView IsVisible="{OnIdiom Default=false, Phone=true}" HorizontalOptions="Center"
                VerticalOptions="Center">
                <StackLayout HorizontalOptions="Center" Spacing="0" VerticalOptions="Center">
                    <!--  Product image  -->
                    <Grid HorizontalOptions="Center" VerticalOptions="Center"
                    Margin="{OnIdiom Desktop='0,54,0,62', Phone='10,77,0,64'}">
                        <!--  SVG WAVY DESIGN (Background)  -->
                        <Path Data="{StaticResource WavyDesignPath}"
                    Fill="{AppThemeBinding Light={OnIdiom Default='#F7EDFF', Phone=Transparent}, Dark={OnIdiom Default='#35303C', Phone=Transparent}}" Opacity="0.7"
                    HorizontalOptions="Fill" VerticalOptions="Fill" />
                        <!--  3 GROUPED AVATAR IMAGES (On Top)  -->
                        <Grid HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="367"
                    WidthRequest="493">
                            <!--  First Avatar  -->
                            <sfavatar:SfAvatarView ContentType="Custom" ImageSource="middle3.jpg"
                    HeightRequest="218" Margin="65,177,310,0" WidthRequest="118" ZIndex="3"
                    CornerRadius="100" />
                            <!--  Second Avatar  -->
                            <sfavatar:SfAvatarView ContentType="Custom" ImageSource="middle1.jpg"
                    Margin="152,49,161,29" HeightRequest="289" ZIndex="1" WidthRequest="180"
                    CornerRadius="100" />
                            <!--  Third Avatar  -->
                            <sfavatar:SfAvatarView ContentType="Custom" ImageSource="middle2.jpg"
                    Margin="285,14,90,135" HeightRequest="218" ZIndex="3" WidthRequest="118"
                    CornerRadius="100" />
                        </Grid>
                    </Grid>
                    <!--  Product title  -->
                    <Label LineHeight="{OnPlatform Android=1.22,
                          Default=-1}" FontFamily="Roboto-Regular" Style="{DynamicResource TitleLabelStyle}"
                        FontSize="36" Margin="0,0,0,16"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                        HorizontalOptions="Center" HorizontalTextAlignment="Center" Text="About Us">

                    </Label>
                    <!--  Product description  -->
                    <Label Margin="16,0,16,0" Style="{DynamicResource DescriptionLabelStyle}" FontSize="16"
                        FontFamily="Roboto-Regular" LineHeight="1.5" CharacterSpacing="0.5"
                        TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                        Text="We are passionate about [industry/sector focus], driven by a commitment to quality, innovation, and customer satisfaction. Since our founding in [1996], we have dedicated ourselves to delivering exceptional products/services that meet the evolving needs of our clients. Our team of experienced professionals works tirelessly to push the boundaries of what's possible, ensuring that we stay ahead of industry trends while maintaining the highest standards of excellence. We believe in the power of collaboration, creativity, and integrity, which are the core values that guide everything." />
                </StackLayout>
            </ScrollView>
        </Grid>
    </ContentView.Content>
</ContentView>
