<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Navigation.AppUsagePage"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:model="clr-namespace:EssentialMAUIUIKit.Models.Navigation"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters"
             x:DataType="local:AppUsageViewModel">

    <!-- Binding -->
    <ContentView.BindingContext>
        <local:AppUsageViewModel />
    </ContentView.BindingContext>

    <!-- Resources -->
    <ContentView.Resources>
        <ResourceDictionary>
            <converter:StringToGlyphConverter x:Key="GlyphConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <ContentView.Content>
        <Grid VerticalOptions="Start"
              RowDefinitions="*">

            <!-- ✅ DESKTOP -->
            <Border StrokeShape="RoundRectangle 8"
                    Margin="0,24,0,24"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light= #E5E1E3, Dark=#474648}"
                    MaximumWidthRequest="{OnPlatform WinUI=421, MacCatalyst=421}"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                    IsVisible="{OnPlatform Android=False, iOS=False}">

                <Grid>
                    <listView:SfListView
                        ScrollBarVisibility="Never"
                        ItemSize="80"
                        ItemSpacing="0"
                        SelectionMode="None"
                        SelectionBackground="Transparent"
                        VerticalOptions="Fill"
                        ItemsSource="{Binding AppUsageList}">

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="model:AppUsage">
                                <!-- ROOT -->
                                <Grid RowDefinitions="*,1"
                                          ColumnSpacing="0"
                                          RowSpacing="0">

                                    <!-- CONTENT -->
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="8"
                                              RowSpacing="8">

                                        <!-- App Icon -->
                                        <Border WidthRequest="48"
                                                    HeightRequest="48"
                                                    Margin="28,0,0,0"
                                                    BackgroundColor="{Binding BackgroundColor}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 24"
                                                    HorizontalOptions="Start"
                                                    VerticalOptions="Center">

                                            <Label x:Name="AppIcon"
                                                       FontFamily="FontIcons"
                                                       FontSize="20"
                                                       WidthRequest="40"
                                                       HeightRequest="40"
                                                       Text="{Binding AppName, Converter={StaticResource GlyphConverter}, ConverterParameter={x:Reference AppIcon}}"
                                                       TextColor="{DynamicResource Gray-White}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center">

                                                <Label.Resources>
                                                    <ResourceDictionary>
                                                        <ResourceDictionary.MergedDictionaries>
                                                            <ResourceDictionary Source="../../Styles/FontIcons.xaml" />
                                                        </ResourceDictionary.MergedDictionaries>
                                                    </ResourceDictionary>
                                                </Label.Resources>
                                            </Label>
                                        </Border>

                                        <!-- Name + Progress -->
                                        <StackLayout Grid.Column="1"
                                                         Margin="4,0,8,0"
                                                         Spacing="12"
                                                         VerticalOptions="Center">

                                            <Label Margin="0,-8,0,0"
                                                       FontFamily="Roboto-Regular"
                                                       FontSize="16"
                                                       Text="{Binding AppName}"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                            <progressBar:SfLinearProgressBar
                                                    HeightRequest="4"
                                                    Progress="{Binding ProgressBarValue}"
                                                    ProgressFill="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                                    TrackFill="{AppThemeBinding Light= #F7EDFF, Dark=#35303C}"
                                                    HorizontalOptions="Fill" />
                                        </StackLayout>

                                        <!-- Value -->
                                        <Label Grid.Column="2"
                                                   Margin="0,20,24,0"
                                                   FontFamily="Roboto-Regular"
                                                   FontSize="14"
                                                   VerticalOptions="Center"
                                                   Text="{Binding ProgressValue}"
                                                   TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}" />

                                    </Grid>

                                    <!-- Divider -->
                                    <BoxView Grid.Row="1"
                                                 HeightRequest="1"
                                                 Style="{DynamicResource HorizontalSeparatorStyle}" />

                                </Grid>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                    </listView:SfListView>
                </Grid>
            </Border>

            <!-- ✅ MOBILE -->
            <Grid IsVisible="{OnPlatform WinUI=False, MacCatalyst=False}">

                <listView:SfListView
                    ScrollBarVisibility="Never"
                    ItemSize="72"
                    ItemSpacing="0"
                    ItemsSource="{Binding AppUsageList}"
                    SelectionMode="None"
                    SelectionBackground="Transparent">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="model:AppUsage">
                            <Grid RowDefinitions="*,1"
                                      ColumnSpacing="0"
                                      RowSpacing="0">

                                <!-- CONTENT -->
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="8"
                                          RowSpacing="8">

                                    <!-- App Icon -->
                                    <Border WidthRequest="48"
                                                HeightRequest="48"
                                                Margin="28,0,0,0"
                                                BackgroundColor="{Binding BackgroundColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 24"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center">

                                        <Label x:Name="AppIcon"
                                                   FontFamily="FontIcons"
                                                   FontSize="20"
                                                   WidthRequest="40"
                                                   HeightRequest="40"
                                                   Text="{Binding AppName, Converter={StaticResource GlyphConverter}, ConverterParameter={x:Reference AppIcon}}"
                                                   TextColor="{DynamicResource Gray-White}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center">

                                            <Label.Resources>
                                                <ResourceDictionary>
                                                    <ResourceDictionary.MergedDictionaries>
                                                        <ResourceDictionary Source="../../Styles/FontIcons.xaml" />
                                                    </ResourceDictionary.MergedDictionaries>
                                                </ResourceDictionary>
                                            </Label.Resources>
                                        </Label>
                                    </Border>

                                    <!-- Name + Progress -->
                                    <StackLayout Grid.Column="1"
                                                     Margin="6,0,8,0"
                                                     Spacing="12"
                                                     VerticalOptions="Center">

                                        <Label Margin="0,-6,0,0"
                                                   FontFamily="Roboto-Regular"
                                                   FontSize="16"
                                                   Text="{Binding AppName}"
                                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                        <progressBar:SfLinearProgressBar
                                                HeightRequest="4"
                                                Progress="{Binding ProgressBarValue}"
                                                ProgressFill="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                                TrackFill="{AppThemeBinding Light= #F7EDFF, Dark=#35303C}"
                                                HorizontalOptions="Fill" />
                                    </StackLayout>

                                    <!-- Value -->
                                    <Label Grid.Column="2"
                                               Margin="0,24,24,0"
                                               FontFamily="Roboto-Regular"
                                               FontSize="14"
                                               VerticalOptions="Center"
                                               Text="{Binding ProgressValue}"
                                               TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}" />

                                </Grid>

                                <!-- Divider -->
                                <BoxView Grid.Row="1"
                                             HeightRequest="1"
                                             Style="{DynamicResource HorizontalSeparatorStyle}" />

                            </Grid>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>

                </listView:SfListView>
            </Grid>

        </Grid>
    </ContentView.Content>
</ContentView>