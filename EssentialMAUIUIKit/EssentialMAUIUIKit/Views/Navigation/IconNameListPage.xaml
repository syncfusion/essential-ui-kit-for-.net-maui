<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EssentialMAUIUIKit.Views.Navigation.IconNameListPage"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:local="clr-namespace:EssentialMAUIUIKit">
    <ContentView.BindingContext>
        <local:NameListViewModel />
    </ContentView.BindingContext>
    <ContentView.Resources>
        <Style TargetType="listView:ListViewItem">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                        Value="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
            <Style.Triggers>
                <DataTrigger TargetType="listView:ListViewItem"
                    Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid RowSpacing="0" RowDefinitions="{OnPlatform Default=*, MacCatalyst=*}"
            Padding="{OnIdiom Desktop='0,24,0,24'}">
            <Border StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                MaximumWidthRequest="{OnPlatform MacCatalyst=566, WinUI=566}" VerticalOptions="Fill" HorizontalOptions="Center"
                IsVisible="{OnPlatform Android=False, iOS=False}">
                <Grid>
                    <listView:SfListView AllowGroupExpandCollapse="False"  AutoFitMode="Height"
                        ScrollBarVisibility="Never" ItemSpacing="0" ItemsSource="{Binding NamesListData}"
                        Padding="12,12,12,0"
                        SelectionBackground="Transparent"
                        SelectionGesture="Tap" SelectionMode="None" VerticalOptions="Fill">

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="local:NameInfo">
                                <StackLayout Spacing="0">
                                    <Grid>
                                        <StackLayout IsVisible="{Binding IsHeader}" Padding="10,4,0,4">
                                            <Label FontFamily="Roboto-Medium" FontSize="16"
                                                        Text="{Binding Name}" LineHeight="1.5"
                                                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                        VerticalOptions="Center" />

                                        </StackLayout>
                                        <Grid IsVisible="{Binding IsNonHeader}"
                                                    HorizontalOptions="Start">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Column="0">
                                                <Label HeightRequest="18" WidthRequest="18" Margin="10,10,5,10"
                                                            VerticalOptions="Start" Style="{DynamicResource IconLabelStyle}"
                                                            TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                                            Text="{DynamicResource Account}" />
                                            </StackLayout>

                                            <StackLayout Grid.Column="1">
                                                <Label FontFamily="Roboto-Regular" FontSize="14"
                                                            HorizontalOptions="Start" LineHeight="1"
                                                            Text="{Binding Name}" Margin="5,14,10,8"
                                                            CharacterSpacing="0.25"
                                                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                            VerticalOptions="Center" VerticalTextAlignment="Center" />
                                            </StackLayout>

                                        </Grid>

                                    </Grid>
                                </StackLayout>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                    </listView:SfListView>
                </Grid>
            </Border>

            <Grid IsVisible="{OnPlatform WinUI=False, MacCatalyst=False}"
                Padding="{OnIdiom Phone='0,8,0,0'}">
                <listView:SfListView x:Name="IconNameList" AllowGroupExpandCollapse="False" 
                    AutoFitMode="Height" ScrollBarVisibility="Never" ItemSpacing="0"
                    ItemsSource="{Binding NamesListData}"
                    SelectionBackground="Transparent"
                    SelectionGesture="Tap" SelectionMode="None" VerticalOptions="Fill">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="local:NameInfo">
                            <StackLayout Spacing="0">
                                <Grid>
                                    <StackLayout IsVisible="{Binding IsHeader}" Padding="16,8,0,8">
                                        <Label FontFamily="Roboto-Medium" FontSize="16" Text="{Binding Name}"
                                                    LineHeight="1.5"
                                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                    VerticalOptions="Center" />

                                    </StackLayout>
                                    <Grid IsVisible="{Binding IsNonHeader}" HorizontalOptions="Start">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackLayout Padding="16,11,0,11" Grid.Column="0">
                                            <Label HeightRequest="18" WidthRequest="18"
                                                        Style="{DynamicResource IconLabelStyle}"
                                                        TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                                        Text="{DynamicResource Account}" />
                                        </StackLayout>

                                        <StackLayout Padding="{OnIdiom Phone='12,10,0,10', Tablet='13,10,0,10'}"
                                                    Grid.Column="1">
                                            <Label FontFamily="Roboto-Regular" FontSize="14"
                                                        HorizontalOptions="Start" LineHeight="1.428"
                                                        Text="{Binding Name}" Padding="0,1,0,1" CharacterSpacing="0.25"
                                                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                        VerticalOptions="Center" VerticalTextAlignment="Center" />
                                        </StackLayout>
                                    </Grid>
                                </Grid>
                            </StackLayout>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>
            </Grid>
        </Grid>
    </ContentView.Content>
</ContentView>
