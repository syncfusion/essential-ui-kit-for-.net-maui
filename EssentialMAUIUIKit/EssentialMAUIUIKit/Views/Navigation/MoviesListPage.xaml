<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Navigation.MoviesListPage"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:avatar="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             x:DataType="local:MoviesViewModel">
    <ContentView.BindingContext>
        <local:MoviesViewModel/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <ResourceDictionary>
            <Style TargetType="listView:ListViewItem">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Background" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Background" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Background"
                                            Value="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="Background" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>

        <Grid 
              ColumnSpacing="0"
              RowSpacing="0"
                RowDefinitions="*">

            <Border Margin="0,24,0,24"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light= #E5E1E3, Dark=#474648}"
                    StrokeShape="RoundRectangle 8"
                    MaximumWidthRequest="{OnPlatform WinUI=766, MacCatalyst=766}"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                    IsVisible="{OnPlatform Android=False, iOS=False}">
                <Grid>
                    <listView:SfListView
                        AllowSwiping="True"
                        AutoFitMode="Height"
                        ScrollBarVisibility="Never"
                        ItemSpacing="0"
                        ItemSize="72"
                        ItemsSource="{Binding MoviesList}"
                        SelectionGesture="Tap"
                        SelectionMode="None"
                        SelectionBackground="Transparent"
                        VerticalOptions="Fill">

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Movie">
                                <Grid
                                        ColumnDefinitions="Auto, *"
                                        ColumnSpacing="0"
                                        RowDefinitions="72, 1"
                                        RowSpacing="0">

                                    <!-- Movie Image Avatar -->
                                    <avatar:SfAvatarView
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="40,12,0,12"
                                            ContentType="Default"
                                            ImageSource="{Binding MovieImage}"
                                            WidthRequest="48"
                                            HeightRequest="48"
                                            CornerRadius="10"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"/>

                                    <!-- Movie Name and Year -->
                                    <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="12,14"
                                            Spacing="4">

                                        <Label
                                                FontFamily="Roboto-Regular"
                                                FontSize="16"
                                                LineBreakMode="TailTruncation"
                                                LineHeight="{OnPlatform Android=1.5,
                                                                Default=-1}"
                                                Text="{Binding MovieName}"
                                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center"/>

                                        <Label
                                                FontFamily="Roboto-Regular"
                                                FontSize="14"
                                                LineHeight="{OnPlatform Android=1.5,
                                                                Default=-1}"
                                                Text="{Binding MovieYear}"
                                                TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                VerticalOptions="Fill"
                                                VerticalTextAlignment="Center"/>


                                    </StackLayout>

                                    <!-- Rating Badge -->
                                    <Border
                                            Grid.RowSpan="2"
                                            Grid.Column="2"
                                            Margin="16,0,24,20"
                                            BackgroundColor="{AppThemeBinding Light=#1C7E39,Dark=#3CB053}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 12"
                                            
                                            Padding="6,3"
                                            VerticalOptions="Center"
                                            HorizontalOptions="End">

                                        <StackLayout
                                                HorizontalOptions="Center"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                
                                                VerticalOptions="Center">
                                            <Label FontSize="10"
                                                       Text="&#xE71E;" 
                                                       FontFamily="UIKitIcons"
                                                       LineHeight="{OnPlatform Android=1.5,
                                                                    Default=-1}"
                                                       TextColor="#FFFFFF"
                                                       VerticalOptions="Center"
                                                       VerticalTextAlignment="Center"/>

                                            <Label
                                                    FontFamily="Roboto-Regular"
                                                    FontSize="11"
                                                    HorizontalOptions="Start"
                                                    LineHeight="{OnPlatform Android=1.5,
                                                                    Default=-1}"
                                                    Text="{Binding MovieRating}"
                                                    TextColor="#FFFFFF"
                                                    VerticalTextAlignment="Center"/>

                                        </StackLayout>
                                    </Border>
                                    <BoxView
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Style="{DynamicResource HorizontalSeparatorStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                    </listView:SfListView>
                </Grid>

            </Border>

            <Grid Grid.Row="2"
                  IsVisible="{OnPlatform WinUI=False, MacCatalyst=False}">
                <listView:SfListView
                    AllowSwiping="True"
                    AutoFitMode="Height"
                    ScrollBarVisibility="Never"
                    ItemSpacing="0"
                    ItemsSource="{Binding MoviesList}"
                    SelectionMode="None"
                    SelectionBackground="Transparent"
                    SelectionGesture="Tap"
                    VerticalOptions="Fill">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Movie">
                            <Grid
                                    ColumnDefinitions="Auto, *"
                                    ColumnSpacing="0"
                                    RowDefinitions="72, 1"
                                    RowSpacing="0">

                                <!-- Movie Image Avatar -->
                                <avatar:SfAvatarView
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="16,12,2,12"
                                        ImageSource="{Binding MovieImage}"
                                        ContentType="Default"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        CornerRadius="8"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center"/>

                                <!-- Movie Name and Year -->
                                <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="12,12,0,0"
                                        Spacing="4">

                                    <Label
                                            FontFamily="Roboto-Medium"
                                            FontSize="16"
                                            LineBreakMode="TailTruncation"
                                            LineHeight="{OnPlatform Android=1.5,
                                                Default=-1}"
                                            Text="{Binding MovieName}"
                                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center"/>

                                    <Label
                                            FontFamily="Roboto-Medium"
                                            FontSize="14"
                                            LineHeight="{OnPlatform Android=1.5,
                                                Default=-1}"
                                            Text="{Binding MovieYear}"
                                            TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                            VerticalOptions="Fill"
                                            VerticalTextAlignment="Center"/>


                                </StackLayout>

                                <!-- Rating Badge -->
                                <Border
                                        Grid.RowSpan="2"
                                        Grid.Column="2"
                                        Margin="16,0,12,24"
                                        Padding="6,3"
                                        BackgroundColor="{AppThemeBinding Light=#1C7E39,Dark=#3CB053}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 16"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center">

                                    <StackLayout
                                            HorizontalOptions="Center"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            VerticalOptions="Center">
                                        <Label FontSize="10"
                                                   LineHeight="{OnPlatform Android=1.5,
                                                        Default=-1}"
                                                   Text="&#xE71E;" 
                                                   FontFamily="UIKitIcons"
                                                   Margin="{OnPlatform Android='0,0,0,2',iOS='0,0,0,2'}"
                                                   TextColor="#FFFFFF"
                                                   VerticalOptions="Center"
                                                   VerticalTextAlignment="Center"/>

                                        <Label
                                                FontFamily="Roboto-Regular"
                                                FontSize="11"
                                                HorizontalOptions="Start"
                                                LineHeight="{OnPlatform Android=1.5,
                                                    Default=-1}"
                                                Text="{Binding MovieRating}"
                                                TextColor="#FFFFFF"
                                                VerticalTextAlignment="Center"/>

                                    </StackLayout>
                                </Border>
                                <BoxView
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Style="{DynamicResource HorizontalSeparatorStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>
            </Grid>

        </Grid>

    </ContentView.Content>
</ContentView>