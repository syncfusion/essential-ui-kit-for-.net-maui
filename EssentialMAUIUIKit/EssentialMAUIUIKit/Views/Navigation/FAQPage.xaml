<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="EssentialMAUIUIKit.Views.Navigation.FAQPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:EssentialMAUIUIKit"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    x:DataType="local:FAQViewModel">

    <ContentView.BindingContext>
        <local:FAQViewModel />
    </ContentView.BindingContext>

    <Grid Margin="{OnIdiom Phone='12',
                    Tablet='12',
                    Desktop='0,12,0,12'}"
          MaximumWidthRequest="{OnPlatform WinUI=766, MacCatalyst=766}">

        <Border
            Margin="0,24,0,24"
            StrokeShape="RoundRectangle 8"
            Stroke="{AppThemeBinding Light= #E5E1E3, Dark=#474648}"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

            <Border.StrokeThickness>
                <OnPlatform x:TypeArguments="x:Double">
                    <On Platform="Android,iOS" Value="0" />
                    <On Platform="WinUI,MacCatalyst" Value="1" />
                </OnPlatform>
            </Border.StrokeThickness>

            <Grid RowDefinitions="Auto,*">

                <!-- Header -->

                <Label
                    Grid.Row="0"
                    FontFamily="Roboto-Medium"
                    FontSize="16"
                    HorizontalOptions="Start"
                    HorizontalTextAlignment="Start"
                    Style="{DynamicResource TitleLabelStyle}"
                    Text="Top Questions">

                    <Label.Padding>
                        <OnPlatform x:TypeArguments="Thickness">
                            <On Platform="Android,iOS" Value="8,0,0,10" />
                            <On Platform="WinUI,MacCatalyst" Value="40,24,0,12" />
                        </OnPlatform>
                    </Label.Padding>

                </Label>

                <!-- FAQ List -->

                <listView:SfListView
                    x:Name="FAQList"
                    Grid.Row="1"
                    AutoFitMode="DynamicHeight"
                    ItemSpacing="4"
                    ItemsSource="{Binding QuestionsList}"
                    ScrollBarVisibility="Never"
                    SelectionMode="None"
                    VerticalOptions="Fill">

                    <listView:SfListView.Padding>
                        <OnPlatform x:TypeArguments="Thickness">
                            <On Platform="Android,iOS" Value="8,0,2,0" />
                            <On Platform="WinUI,MacCatalyst" Value="26,0,26,0" />
                        </OnPlatform>
                    </listView:SfListView.Padding>

                    <listView:SfListView.ItemTemplate>

                        <DataTemplate x:DataType="local:QuestionItem">

                            <Grid Margin="0,0,0,0"
                                    BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight},
                                                                      Dark={DynamicResource BackgroundColorDark}}">

                                <syncfusion:SfExpander
                                        HeaderIconPosition="End"
                                        Margin="0">

                                    <syncfusion:SfExpander.Header>

                                        <Grid Padding="0,8">

                                            <Label
                                                    FontFamily="Roboto-Regular"
                                                    FontSize="14"
                                                    Margin="14,0,0,0"
                                                    FontAttributes="Bold"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    LineBreakMode="WordWrap"
                                                    MaxLines="2"
                                                    
                                                    Style="{DynamicResource TitleLabelStyle}"
                                                    Text="{Binding Question}" />

                                        </Grid>

                                    </syncfusion:SfExpander.Header>

                                    <syncfusion:SfExpander.Content>

                                        <VerticalStackLayout
                                                BindableLayout.ItemsSource="{Binding Answer}"
                                                Spacing="1">

                                            <BindableLayout.ItemTemplate>

                                                <DataTemplate>

                                                    <Label Margin="20,0,20,0"
                                                            x:DataType="x:String"
                                                            HorizontalOptions="Start"
                                                            HorizontalTextAlignment="Start"
                                                            LineHeight="{OnPlatform Default=-1, Android=1.25}"
                                                            Style="{DynamicResource DescriptionLabelStyle}"
                                                            Text="{Binding}"
                                                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight},
                                                                                        Dark={DynamicResource PrimaryTextColorDark}}" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </syncfusion:SfExpander.Content>
                                </syncfusion:SfExpander>
                            </Grid>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>
            </Grid>
        </Border>
    </Grid>
</ContentView>