<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:avatar="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:local="clr-namespace:EssentialMAUIUIKit"
    x:Class="EssentialMAUIUIKit.Views.Navigation.SongsPage"
    x:DataType="local:SongPageViewModel">

    <!-- Binding Context -->
    <ContentView.BindingContext>
        <local:SongPageViewModel />
    </ContentView.BindingContext>

    <!-- Resources -->
    <ContentView.Resources>
        <ResourceDictionary>
            <local:PlayPauseConverter x:Key="PlayPauseConverter" />

            <Style TargetType="listView:ListViewItem">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Background" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Background" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Background"
                                            Value="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="Background" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <ContentView.Content>
        <Grid
            RowDefinitions="*"
            ColumnSpacing="0"
            RowSpacing="0">

            <!-- Desktop View -->
            <Border
                Margin="0,24,0,12"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light= #E5E1E3, Dark=#474648}"
                IsVisible="{OnPlatform Android=False, iOS=False}"
                BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                MaximumWidthRequest="{OnPlatform WinUI=767, MacCatalyst=767}">
                <listView:SfListView
                        VerticalOptions="Fill"
                        ScrollBarVisibility="Never"
                        ItemSize="83"
                        ItemSpacing="0"
                        SelectionMode="None"
                        ItemsSource="{Binding SongsPageList}"
                        SelectionBackground="Transparent">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Song">
                            <Grid
                                        RowDefinitions="Auto,Auto"
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="0"
                                        RowSpacing="0">

                                <!-- Avatar -->
                                <avatar:SfAvatarView
                                            WidthRequest="48"
                                            HeightRequest="48"
                                            CornerRadius="28"
                                            Margin="40,20,0,14"
                                            ImageSource="{Binding SongImage}"
                                            ContentType="Default"
                                            StrokeThickness="0" />

                                <!-- Overlay Play -->
                                <Grid
                                            Margin="40,14,0,0"
                                            BackgroundColor="#95000000">

                                    <Grid.Clip>
                                        <EllipseGeometry
                                                    Center="24,30"
                                                    RadiusX="24"
                                                    RadiusY="24" />
                                    </Grid.Clip>

                                    <Label
                                                Text="{Binding IsPlaying, Converter={StaticResource PlayPauseConverter}}"
                                                FontFamily="UIKitIcons"
                                                FontSize="14"
                                                Margin="0,6,0,12"
                                                TextColor="White"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                FontAttributes="Bold" />
                                </Grid>

                                <!-- Song Info -->
                                <StackLayout
                                            Grid.Column="1"
                                            Margin="12,0"
                                            Spacing="4"
                                            VerticalOptions="Center">

                                    <Label
                                                Text="{Binding SongName}"
                                                FontFamily="Roboto-Regular"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}" />

                                    <Label
                                                Text="{Binding Composer}"
                                                FontFamily="Roboto-Regular"
                                                FontSize="14"
                                                TextColor="{AppThemeBinding Light=#5F5E60, Dark=#929092}" />
                                </StackLayout>

                                <!-- Right Section -->
                                <StackLayout
                                            Grid.Column="2"
                                            Margin="0,8,36,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">

                                    <Label
                                                Text="{Binding Duration}"
                                                FontFamily="Roboto-Medium"
                                                FontSize="11"
                                                Padding="0,0,0,3"
                                                TextColor="{AppThemeBinding Light=#5F5E60, Dark=#9CA3AF}"
                                                HorizontalOptions="Center" />

                                    <Border
                                                WidthRequest="26"
                                                HeightRequest="26"
                                                StrokeShape="RoundRectangle 14"
                                                BackgroundColor="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}"
                                                Stroke="Transparent"
                                                HorizontalOptions="End">

                                        <Label Margin="1,0,0,0"
                                                    Text="{Binding IsPlaying, Converter={StaticResource PlayPauseConverter}}"
                                                    FontFamily="UIKitIcons"
                                                    FontSize="12"
                                                    TextColor="White"
                                                    FontAttributes="Bold"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding IsPlaying}"
                                                                    Value="True">
                                                    <Setter Property="Margin" Value="0,0,0,0" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </StackLayout>

                                <!-- Separator -->
                                <BoxView
                                            Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            Style="{DynamicResource HorizontalSeparatorStyle}" />
                            </Grid>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>

                </listView:SfListView>
            </Border>

            <!-- Mobile View -->
            <StackLayout
                Grid.Row="1"
                IsVisible="{OnPlatform WinUI=False, MacCatalyst=False}">

                <listView:SfListView
                    AllowSwiping="True"
                    ScrollBarVisibility="Never"
                    AutoFitMode="Height"
                    ItemsSource="{Binding SongsPageList}"
                    VerticalOptions="Fill"
                    ItemSpacing="0"
                    SelectionMode="None"
                    SelectionBackground="Transparent">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Song">

                            <Grid
                                HeightRequest="76"
                                RowDefinitions="*,Auto"
                                ColumnDefinitions="Auto,Auto,*"
                                ColumnSpacing="12">

                                <!-- Avatar -->
                                <avatar:SfAvatarView
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Margin="22,0,6,0"
                                    CornerRadius="24"
                                    VerticalOptions="Center"
                                    ImageSource="{Binding SongImage}"
                                    ContentType="Custom"
                                    StrokeThickness="0" />

                                <!-- Overlay -->
                                <Grid
                                    Margin="16,0,0,0"
                                    BackgroundColor="#95000000">

                                    <Grid.Clip>
                                        <EllipseGeometry
                                            Center="30,37"
                                            RadiusX="24"
                                            RadiusY="24" />
                                    </Grid.Clip>

                                    <Label
                                        Text="{Binding IsPlaying, Converter={StaticResource PlayPauseConverter}}"
                                        FontSize="14"
                                        FontFamily="UIKitIcons"
                                        TextColor="White"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        FontAttributes="Bold" />
                                </Grid>

                                <!-- Song Info -->
                                <StackLayout
                                    Grid.Column="1"
                                    Margin="4,0"
                                    Spacing="4"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding SongName}"
                                        FontFamily="Roboto-Medium"
                                        FontSize="16"
                                        TextColor="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />

                                    <Label
                                        Text="{Binding Composer}"
                                        FontFamily="Roboto-Regular"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light=#6B7280, Dark=#D1D5DB}" />
                                </StackLayout>

                                <!-- Right Section -->
                                <StackLayout
                                    Grid.Column="2"
                                    Margin="0,0,24,0"
                                    Spacing="2"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End">

                                    <Label
                                        Text="{Binding Duration}"
                                        FontFamily="Roboto-Medium"
                                        FontSize="11"
                                        Margin="0,0,3,2"
                                        HorizontalOptions="End"
                                        TextColor="{AppThemeBinding Light=#5F5E60, Dark=#9CA3AF}" />

                                    <Border
                                        WidthRequest="26"
                                        HeightRequest="26"
                                        StrokeShape="RoundRectangle 13"
                                        BackgroundColor="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}"
                                        Stroke="Transparent"
                                        HorizontalOptions="End">

                                        <Label
                                            Text="{Binding IsPlaying, Converter={StaticResource PlayPauseConverter}}"
                                            FontFamily="UIKitIcons"
                                            FontSize="10"
                                            Padding="0,0,0,1"
                                            TextColor="White"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            FontAttributes="Bold" />
                                    </Border>
                                </StackLayout>

                                <!-- Separator -->
                                <BoxView
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Style="{DynamicResource HorizontalSeparatorStyle}"
                                    HeightRequest="1" />

                            </Grid>

                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>

                </listView:SfListView>

            </StackLayout>

        </Grid>
    </ContentView.Content>

</ContentView>