<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Navigation.SuggestionPage"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:avatar="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:navigation="clr-namespace:EssentialMAUIUIKit.Views.Navigation"
             x:DataType="local:SuggestionViewModel">

    <!-- ViewModel is set in code-behind -->

    <ContentView.Resources>
        <ResourceDictionary>

            <Shadow x:Key="LightShadow"
                Brush="#A0A0A0"
                Offset="0,2"
                Radius="2"
                Opacity="0.55" />

            <Shadow x:Key="DarkShadow"
                    Brush="#000000"
                    Offset="0,4"
                    Radius="8"
                    Opacity="0.4" />

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <ContentView.Content>
        <Grid RowSpacing="0"
              RowDefinitions="*">

            <!-- DESKTOP VIEW -->
            <Border StrokeShape="RoundRectangle 8"
                    Margin="0,24,0,24"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light= #E5E1E3, Dark=#474648}"
                    MaximumWidthRequest="{OnPlatform WinUI=766, MacCatalyst=766}"
                   
                    BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                    IsVisible="{OnPlatform Android=False, iOS=False}">

                <Grid>

                    <BoxView Style="{DynamicResource HorizontalSeparatorStyle}" />

                    <listView:SfListView
                        AutoFitMode="Height"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                        ScrollBarVisibility="Never"
                        ItemsSource="{Binding SuggestionsList}"
                        SelectionBackground="Transparent"
                        VerticalOptions="Fill">

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SuggestionItem">
                                <StackLayout Spacing="0"
                                                BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">

                                    <Grid Margin="24,0"
                                             ColumnDefinitions="Auto,*,Auto"
                                             ColumnSpacing="0">

                                        <!-- Profile Image -->
                                        <avatar:SfAvatarView WidthRequest="48"
                                                   HeightRequest="48"
                                                   Margin="0,16"
                                                   BackgroundColor="{DynamicResource Gray-200}"
                                                   Stroke="{DynamicResource Gray-Bg}"
                                                   StrokeThickness="1"
                                                   CornerRadius="24"
                                                   ContentType="Default"
                                                   ImageSource="{Binding ImagePath}"
                                                   Style="{DynamicResource ProfileBorderStyle}">
                                        </avatar:SfAvatarView>

                                        <!-- Name & ID -->
                                        <StackLayout Grid.Column="1"
                                                        Margin="16,16,0,13"
                                                        Spacing="3"
                                                        VerticalOptions="Center"
                                                        BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">

                                            <Label Text="{Binding SuggestionName}"
                                                      FontFamily="Roboto-Medium"
                                                      Style="{DynamicResource TitleLabelStyle}"
                                                      HorizontalOptions="Start" />

                                            <Label Text="{Binding Id}"
                                                      TextColor="{AppThemeBinding Light=#5F5E60 ,Dark=#929092}"
                                                      Style="{DynamicResource DescriptionLabelStyle}"
                                                      HorizontalOptions="Start" />

                                        </StackLayout>

                                        <!-- FOLLOW Button -->
                                        <buttons:SfButton Grid.Column="2"
                                                             Margin="0,20"
                                                             WidthRequest="90"
                                                             HeightRequest="40"
                                                             CornerRadius="24"
                                                             FontSize="14"
                                                             Style="{DynamicResource FormsButtonStyle}"
                                                             Text="follow"
                                                             IsVisible="{Binding IsNotRequested}"
                                                             Clicked="OnFollowButtonClicked"
                                                             x:Name="FollowButtonDesktop"/>

                                        <!-- REQUESTED Button -->
                                        <Border Grid.Column="2"
                                                   Margin="0,20"
                                                   WidthRequest="116"
                                                   HeightRequest="40"
                                                   StrokeShape="RoundRectangle 20"
                                                   StrokeThickness="0.5"
                                                   Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#505050}"
                                                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#3C3B3D}"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End"
                                                   IsVisible="{Binding IsRequested}"
                                                   Shadow="{AppThemeBinding Light={StaticResource LightShadow}, Dark={StaticResource DarkShadow}}"
                                                   x:Name="RequestedBorderDesktop">

                                            <Label FontSize="14"
                                                       FontFamily="Roboto-Medium"
                                                      VerticalOptions="Center"
                                                      HorizontalOptions="Center"
                                                       TextColor="{AppThemeBinding Light=#3C3B3D, Dark=#FFFFFF}"
                                                       Text="Requested" />

                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnRequestedBorderTapped"/>
                                            </Border.GestureRecognizers>
                                        </Border>

                                    </Grid>

                                    <BoxView Style="{DynamicResource HorizontalSeparatorStyle}" />

                                </StackLayout>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>

                    </listView:SfListView>

                </Grid>
            </Border>

            <!-- MOBILE VIEW -->
            <Grid Grid.Row="1"
                  IsVisible="{OnPlatform WinUI=False, MacCatalyst=False}">

                <listView:SfListView
                    AutoFitMode="Height"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                    ScrollBarVisibility="Never"
                    ItemsSource="{Binding SuggestionsList}"
                    SelectionBackground="Transparent"
                    VerticalOptions="Fill">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SuggestionItem">
                            <StackLayout Spacing="0"
                                             BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">

                                <Grid 
                                          ColumnDefinitions="Auto,*,Auto"
                                          RowSpacing="0"
                                          ColumnSpacing="0">

                                    <!-- Profile Image -->
                                    <avatar:SfAvatarView WidthRequest="48"
                                                    HeightRequest="48"
                                                    Margin="16,0,0,0"
                                                    BackgroundColor="{DynamicResource Gray-200}"
                                                    Stroke="{DynamicResource Gray-Bg}"
                                                    StrokeThickness="1"
                                                    CornerRadius="24"
                                                    ContentType="Default"
                                                    ImageSource="{Binding ImagePath}"
                                                    Style="{DynamicResource ProfileBorderStyle}">
                                    </avatar:SfAvatarView>

                                    <!-- Name & ID -->
                                    <StackLayout Grid.Column="1"
                                                     Margin="16,16,0,13"
                                                     Spacing="3"
                                                     VerticalOptions="Start"
                                                     HorizontalOptions="Start"
                                                     BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">

                                        <Label Text="{Binding SuggestionName}"
                                                   FontFamily="Roboto-Medium"
                                                   Style="{DynamicResource TitleLabelStyle}" />

                                        <Label Text="{Binding Id}"
                                                   VerticalOptions="Start"
                                                   HorizontalOptions="Start"
                                                   Style="{DynamicResource DescriptionLabelStyle}" />

                                    </StackLayout>

                                    <buttons:SfButton Grid.Column="2"
                                                          Margin="0,12,12,12"
                                                          WidthRequest="90"
                                                          HeightRequest="40"
                                                          CornerRadius="24"
                                                          FontSize="12"
                                                          Style="{DynamicResource FormsButtonStyle}"
                                                          Text="FOLLOW"
                                                          IsVisible="{Binding IsNotRequested}"
                                                          Clicked="OnFollowButtonClicked"
                                                          x:Name="FollowButtonMobile"/>


                                    <Border Grid.Column="2"
                                                Margin="0,12,12,12"
                                                WidthRequest="116"
                                                HeightRequest="40"
                                                StrokeShape="RoundRectangle 20"
                                                StrokeThickness="0.5"
                                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#505050}"
                                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#3C3B3D}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="End"
                                                IsVisible="{Binding IsRequested}"
                                                Shadow="{AppThemeBinding Light={StaticResource LightShadow}, Dark={StaticResource DarkShadow}}"
                                                x:Name="RequestedBorderMobile">

                                        <Label FontSize="14"
                                                   FontFamily="Roboto-Medium"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#3C3B3D, Dark=#FFFFFF}"
                                                   Text="Requested" />

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRequestedBorderTapped"/>
                                        </Border.GestureRecognizers>
                                    </Border>

                                </Grid>

                                <BoxView Style="{DynamicResource HorizontalSeparatorStyle}" />

                            </StackLayout>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>

                </listView:SfListView>

            </Grid>

        </Grid>
    </ContentView.Content>
</ContentView>