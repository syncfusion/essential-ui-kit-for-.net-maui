<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:rotator="clr-namespace:Syncfusion.Maui.Rotator;assembly=Syncfusion.Maui.Rotator"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:chip="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:local="clr-namespace:EssentialMAUIUIKit"
    x:Class="EssentialMAUIUIKit.Views.Navigation.MoviesPage"
    x:DataType="local:MoviesPageViewModel">

    <ContentView.BindingContext>
        <local:MoviesPageViewModel />
    </ContentView.BindingContext>

    <ContentView.Content>

        <ScrollView HorizontalScrollBarVisibility="Never">
            <Grid
                ColumnSpacing="0"
                RowSpacing="0"
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">

                <rotator:SfRotator
                    Grid.Row="0"
                    HeightRequest="{OnPlatform Android=200,
                                                   iOS=200,
                                                   WinUI=327,
                                                   MacCatalyst=327}"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    BackgroundColor="Transparent"
                    EnableAutoPlay="True"
                    NavigationDelay="2000"
                    NavigationDirection="Horizontal"
                    NavigationStripMode="Dots"
                    DotsStroke="Transparent"
                    SelectedDotColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                    UnselectedDotColor="#EBECEF"
                    ItemsSource="{Binding RotatorMoviesList}">

                    <rotator:SfRotator.ItemTemplate>
                        <DataTemplate x:DataType="local:RotatorMovie">

                            <Grid
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">

                                <Image
                                    Source="{Binding Image}"
                                    Aspect="Fill"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />

                            </Grid>

                        </DataTemplate>
                    </rotator:SfRotator.ItemTemplate>

                </rotator:SfRotator>

                <!-- Row 1: Language Filter Chips -->
                <ScrollView
                    Grid.Row="1"
                    Orientation="Horizontal"
                    IsVisible="True"
                    HorizontalScrollBarVisibility="Never"
                    Margin="{OnIdiom Phone='12,24,12,12',
                        Tablet='24,24,8,16',
                        Desktop='24,24,8,16'}">

                    <chip:SfChipGroup
                        ChipType="Choice"
                        ChipCornerRadius="31"
                        ChipTextSize="14"
                        ChipFontFamily="Roboto-Medium"
                        ItemHeight="32"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}"
                        ChipBackground="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                        ChipTextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                        ChipStroke="{AppThemeBinding Light=#E5E1E3, Dark=#474648}"
                        ChipStrokeThickness="1"
                        SelectedChipTextColor="#FFFFFF"
                        SelectedChipBackground="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}">
                    </chip:SfChipGroup>

                </ScrollView>

                <!-- Mobile Only - Coming Soon Banner -->
                <Border
                    Grid.Row="2"
                    Margin="12,12,12,32"
                    HeightRequest="48"
                    IsVisible="{OnIdiom Phone=True, Tablet=False, Desktop=False}"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                    StrokeShape="RoundRectangle 6">

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        Padding="16,0">

                        <Label
                            Grid.Column="0"
                            Text="Coming Soon"
                            FontSize="16"
                            FontFamily="Roboto-Medium"
                            TextColor="#FFFFFF"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Text="Explore Upcoming Movies"
                            FontSize="13"
                            FontFamily="Roboto-Regular"
                            TextColor="#FFFFFF"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="24"
                            FontFamily="Roboto-Medium"
                            TextColor="#FFFFFF"
                            Margin="0,0,0,6"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

                <!-- Movies Header -->
                <Grid
                    Grid.Row="2"
                    Margin="24,16,16,4"
                    IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}"
                    ColumnDefinitions="*,Auto">

                    <Label
                        Grid.Column="0"
                        FontFamily="Roboto-Medium"
                        FontSize="22"
                        Text="Movies"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                        VerticalTextAlignment="Center" />

                    <buttons:SfButton
                        Grid.Column="1"
                        FontSize="14"
                        HeightRequest="36"
                        HorizontalOptions="End"
                        TextColor="{AppThemeBinding Light=#7633DA,Dark=#8D4CF5}"
                        Style="{DynamicResource TransparentButtonStyle}"
                        FontFamily="Roboto-Medium"
                        Text="VIEW ALL"
                        VerticalOptions="Center" />

                </Grid>

                <!-- Showing Movies -->
                <ScrollView
                    Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="{OnIdiom
                        Phone='6,0,6,16',
                        Tablet='24,0,8,16',
                        Desktop='24,0,8,16'}">

                    <StackLayout
                        Orientation="Horizontal"
                        Padding="8,6,8,0"
                        BindableLayout.ItemsSource="{Binding ShowingMoviesList}">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate x:DataType="local:ShowingMovie">

                                <Grid
                                    Padding="6,4"
                                    HorizontalOptions="Center">

                                    <Grid
                                        WidthRequest="140"
                                        HeightRequest="270"
                                        RowDefinitions="Auto, Auto, Auto"
                                        RowSpacing="0">

                                        <Grid.GestureRecognizers>
                                            <PointerGestureRecognizer 
                                                PointerEntered="OnMoviePointerEntered"
                                                PointerExited="OnMoviePointerExited"
                                                PointerPressed="OnMoviePointerPressed"
                                                PointerReleased="OnMoviePointerReleased" />
                                        </Grid.GestureRecognizers>

                                        <!-- Poster -->
                                        <Border
                                            Grid.Row="0"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8">

                                            <Image
                                                Aspect="AspectFill"
                                                HeightRequest="210"
                                                WidthRequest="140"
                                                Source="{Binding Image}" />

                                        </Border>

                                        <!-- Rating -->
                                        <Border
                                            Grid.Row="1"
                                            Margin="0,8,0,0"
                                            Padding="6,4"
                                            HeightRequest="20"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light=#F3F0F2, Dark=#2A2A2A}"
                                            StrokeShape="RoundRectangle 12">

                                            <HorizontalStackLayout
                                                Spacing="4"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="★"
                                                    FontSize="10"
                                                    TextColor="{AppThemeBinding Light=#7633DA,Dark=#8D4CF5}"
                                                    Margin="0,-2.5,0,0"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Text="{Binding Movierating, StringFormat='{0:F1}'}"
                                                    FontFamily="Roboto-Medium"
                                                    FontSize="11"
                                                    Margin="0,-2,0,0"
                                                    TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Text="{Binding MoviesVotes}"
                                                    FontSize="11"
                                                    Padding="40,0,0,0"
                                                    Margin="6,-2.5,0,0"
                                                    HorizontalOptions="End"
                                                    TextColor="{AppThemeBinding Light=#5F5E60, Dark=#929092}"
                                                    VerticalOptions="Center" />

                                            </HorizontalStackLayout>

                                        </Border>

                                        <!-- Movie Title -->
                                        <Label
                                            Grid.Row="2"
                                            Margin="2,8,0,0"
                                            Text="{Binding Moviename}"
                                            FontFamily="Roboto-Regular"
                                            FontSize="14"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation"
                                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                    </Grid>

                                </Grid>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </StackLayout>

                </ScrollView>

                <!-- Upcoming Movies Header -->
                <Grid
                    Grid.Row="4"
                    Margin="24,4,16,4"
                    IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}"
                    ColumnDefinitions="*,Auto">

                    <Label
                        Grid.Column="0"
                        FontFamily="Roboto-Medium"
                        FontSize="22"
                        Text="Upcoming Movies"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                        VerticalTextAlignment="Center" />

                    <buttons:SfButton
                        Grid.Column="1"
                        FontSize="14"
                        HeightRequest="36"
                        HorizontalOptions="End"
                        TextColor="{AppThemeBinding Light=#7633DA,Dark=#8D4CF5}"
                        Style="{DynamicResource TransparentButtonStyle}"
                        Text="VIEW ALL"
                        FontFamily="Roboto-Medium"
                        VerticalOptions="Center" />

                </Grid>

                <!-- Upcoming Movies List -->
                <ScrollView
                    Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="{OnIdiom
                        Phone='6,12,6,16',
                        Tablet='24,0,8,16',
                        Desktop='24,0,8,16'}">

                    <StackLayout
                        Orientation="Horizontal"
                        Padding="8,6,8,0"
                        BindableLayout.ItemsSource="{Binding UpcomingMoviesList}">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate x:DataType="local:UpcomingMovie">

                                <Grid
                                    Padding="6,4"
                                    HorizontalOptions="Center">

                                    <Grid
                                        WidthRequest="140"
                                        HeightRequest="270"
                                        RowDefinitions="Auto, Auto, Auto"
                                        RowSpacing="0">

                                        <Grid.GestureRecognizers>
                                            <PointerGestureRecognizer 
                                                PointerEntered="OnMoviePointerEntered"
                                                PointerExited="OnMoviePointerExited"
                                                PointerPressed="OnMoviePointerPressed"
                                                PointerReleased="OnMoviePointerReleased" />
                                        </Grid.GestureRecognizers>

                                        <!-- Poster -->
                                        <Border
                                            Grid.Row="0"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8">

                                            <Image
                                                Aspect="AspectFill"
                                                HeightRequest="210"
                                                WidthRequest="140"
                                                Source="{Binding Image}" />

                                        </Border>

                                        <!-- Rating -->
                                        <Border
                                            Grid.Row="1"
                                            Margin="0,8,0,0"
                                            Padding="6,4"
                                            HeightRequest="20"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light=#F3F0F2, Dark=#3C3B3D}"
                                            StrokeShape="RoundRectangle 12">

                                            <HorizontalStackLayout
                                                Spacing="4"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="★"
                                                    FontSize="10"
                                                    TextColor="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}"
                                                    Margin="0,-2.5,0,0"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Text="{Binding Movierating, StringFormat='{0:F1}'}"
                                                    FontFamily="Roboto-Medium"
                                                    FontSize="11"
                                                    Margin="0,-2,0,0"
                                                    TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Text="{Binding MoviesVotes}"
                                                    FontSize="11"
                                                    Padding="40,0,0,0"
                                                    Margin="6,-2.5,0,0"
                                                    HorizontalOptions="End"
                                                    TextColor="{AppThemeBinding Light=#5F5E60, Dark=#929092}"
                                                    VerticalOptions="Center" />

                                            </HorizontalStackLayout>

                                        </Border>

                                        <!-- Movie Title -->
                                        <Label
                                            Grid.Row="2"
                                            Margin="2,8,0,0"
                                            Text="{Binding Moviename}"
                                            FontFamily="Roboto-Regular"
                                            FontSize="14"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation"
                                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                    </Grid>

                                </Grid>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </StackLayout>

                </ScrollView>

            </Grid>

        </ScrollView>

    </ContentView.Content>

</ContentView>