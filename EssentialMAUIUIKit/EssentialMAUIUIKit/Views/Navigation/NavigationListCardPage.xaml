<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Navigation.NavigationListCardPage"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             x:DataType="local:NavigationListViewModel">

    <ContentView.BindingContext>
        <local:NavigationListViewModel/>
    </ContentView.BindingContext>

    <ContentView.Content>

        <Grid RowDefinitions="*"
              WidthRequest="{OnPlatform WinUI=650, MacCatalyst=650}">

            <Grid Grid.Row="1">
                <listView:SfListView
                    x:Name="navigationList"
                    Padding="0,0,0,0"
                    AutoFitMode="Height"
                    ScrollBarVisibility="Never"
                    ItemsSource="{Binding NavigationList}"
                    SelectionBackground="Transparent"
                    VerticalOptions="Fill">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="local:NavigationItem">
                            <ViewCell>

                                <Border
                                    Margin="8"
                                    Padding="0"
                                    BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2A2A2A}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill">

                                    <Border.Shadow>
                                        <Shadow Offset="0,1"
                                                Radius="2"
                                                Opacity="0.08"
                                                Brush="{AppThemeBinding Light=#000000, Dark={DynamicResource BackgroundColorDark}}" />
                                    </Border.Shadow>


                                    <Border Stroke="Transparent"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8">

                                        <Grid ColumnDefinitions="120,*">

                                            <Image
                                                Aspect="AspectFill"
                                                BackgroundColor="{DynamicResource Gray-200}"
                                                HeightRequest="130"
                                                WidthRequest="120">
                                                <Image.Source>
                                                    <UriImageSource
                                                        CacheValidity="14"
                                                        CachingEnabled="true"
                                                        Uri="{Binding ItemImage}"/>
                                                </Image.Source>
                                            </Image>

                                            <StackLayout
                                                Grid.Column="1"
                                                Padding="16,14,12,14"
                                                Spacing="4"
                                                VerticalOptions="Fill">

                                                <!-- Title -->
                                                <Label FontFamily="Roboto-Medium"
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                       Text="{Binding ItemName}"/>

                                                <Label FontFamily="Roboto-Regular"
                                                       FontSize="12"
                                                       Margin="0,6,0,6"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                       LineBreakMode="TailTruncation"
                                                       LineHeight="{OnPlatform Android=1.25, Default=-1}"
                                                       MaxLines="2"
                                                       Text="{Binding ItemDescription}"/>

                                                <Grid ColumnDefinitions="Auto,*"
                                                      VerticalOptions="FillAndExpand">

                                                    <Border Grid.Column="0"
                                                            Padding="6,3"
                                                            BackgroundColor="#7633DA"
                                                            StrokeShape="RoundRectangle 16"
                                                            StrokeThickness="0"
                                                            HorizontalOptions="Fill"
                                                            VerticalOptions="End">

                                                        <HorizontalStackLayout Spacing="4"
                                                                            VerticalOptions="Center"
                                                                            HorizontalOptions="Center">
                                                            
                                                            <Label Text="★"
                                                                FontSize="12"
                                                                TextColor="White"
                                                                VerticalOptions="Start"
                                                                VerticalTextAlignment="Start"
                                                                Padding="0"
                                                                Margin="0,-3,0,0"/>

                                                            <Label Text="{Binding ItemRating, StringFormat='{0:F1}'}"
                                                                FontFamily="Roboto-Medium"
                                                                FontSize="12"
                                                                TextColor="White"
                                                                VerticalOptions="Center"
                                                                VerticalTextAlignment="Center"
                                                                Padding="0,0,2,0"
                                                                Margin="0,-1.8,0,0"/>
                                                        </HorizontalStackLayout>
                                                    </Border>

                                                    <buttons:SfButton
                                                        Grid.Column="1"
                                                        Background="Transparent"
                                                        Padding="0"
                                                        CornerRadius="0"
                                                        FontFamily="FontIcons"
                                                        FontSize="16"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="End"
                                                        Margin="0,0,-16,-8"
                                                        Text="{DynamicResource ArrowRight}"
                                                        TextColor ="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                                </Grid>
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </Border>
                            </ViewCell>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>

            </Grid>
        </Grid>

    </ContentView.Content>
</ContentView>