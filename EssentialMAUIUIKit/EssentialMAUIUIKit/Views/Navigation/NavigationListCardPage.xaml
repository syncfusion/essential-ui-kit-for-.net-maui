<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:local="clr-namespace:EssentialMAUIUIKit"
    x:Class="EssentialMAUIUIKit.Views.Navigation.NavigationListCardPage"
    x:DataType="local:NavigationListViewModel">

    <!-- Binding Context -->
    <ContentView.BindingContext>
        <local:NavigationListViewModel />
    </ContentView.BindingContext>

    <ContentView.Resources>
        <Style TargetType="listView:ListViewItem">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                    Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                    Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                    Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                    Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>

    <ContentView.Content>
        <Grid Margin="{OnIdiom Phone='12,12,12,0',
                    Tablet='12,12,12,0',
                    Desktop='0,12,0,12'}"
            RowDefinitions="*"
            MaximumWidthRequest="{OnPlatform WinUI=706, MacCatalyst=706}">

            <Grid Grid.Row="1">

                <listView:SfListView
                    x:Name="navigationList"
                    Padding="0"
                    AutoFitMode="Height"
                    ScrollBarVisibility="Never"
                    ItemsSource="{Binding NavigationList}"
                    SelectionMode="None"
                    VerticalOptions="Fill">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="local:NavigationItem">
                            <Border
                                    x:Name="itemBorder"
                                    Margin="8"
                                    Padding="0"
                                    BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2A2A2A}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnItemTapped" />
                                </Border.GestureRecognizers>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="Opacity" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>

                                <Border.Shadow>
                                    <Shadow
                                            Offset="0,1"
                                            Radius="3"
                                            Opacity="0.15"
                                            Brush="{AppThemeBinding Light=#000000, Dark=#1C1B1D}" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="Auto,*">

                                    <!-- Image -->
                                    <Image
                                                Aspect="AspectFill"
                                                BackgroundColor="{DynamicResource Gray-200}"
                                                HeightRequest="116"
                                                WidthRequest="129">

                                        <Image.Source>
                                            <UriImageSource
                                                        Uri="{Binding ItemImage}"
                                                        CacheValidity="14"
                                                        CachingEnabled="true" />
                                        </Image.Source>
                                    </Image>

                                    <!-- Content -->
                                    <StackLayout
                                                Grid.Column="1"
                                                Padding="12,12,0,0"
                                                VerticalOptions="Fill">

                                        <!-- Title -->
                                        <Label
                                                    Text="{Binding ItemName}"
                                                    FontFamily="Roboto-Medium"
                                                    FontSize="14"
                                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                        <!-- Description -->
                                        <Label
                                                    Text="{Binding ItemDescription}"
                                                    FontFamily="Roboto-Regular"
                                                    FontSize="12"
                                                    Margin="{OnIdiom Phone='0,6,0,0',
                                                                        Tablet='0,12,0,0',
                                                                        Desktop='0,12,0,0'}"
                                                    VerticalOptions="Center"
                                                    LineBreakMode="TailTruncation"
                                                    LineHeight="{OnPlatform Android=1.25, Default=-1}"
                                                    MaxLines="2"
                                                    TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}" />

                                        <!-- Footer -->
                                        <Grid Margin="0,0,0,0"
                                                    ColumnDefinitions="Auto,*"
                                                    VerticalOptions="Fill">

                                            <!-- Rating -->
                                            <Border
                                                        Margin="0,0,0,12"
                                                        Grid.Column="0"
                                                        Padding="6,4"
                                                        BackgroundColor="#7633DA"
                                                        StrokeShape="RoundRectangle 16"
                                                        StrokeThickness="0"
                                                        VerticalOptions="End">

                                                <HorizontalStackLayout
                                                            Spacing="4"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Center">

                                                    <Label
                                                                Text="&#xE71E;" 
                                                                FontFamily="UIKitIcons"
                                                                FontSize="10"
                                                                TextColor="White"
                                                                Margin="0,1,0,0" />

                                                    <Label
                                                                Text="{Binding ItemRating, StringFormat='{0:F1}'}"
                                                                FontFamily="Roboto-Medium"
                                                                FontSize="11"
                                                                TextColor="White"
                                                                Padding="0,0,2,0"
                                                                Margin="0,0,0,0" />
                                                </HorizontalStackLayout>
                                            </Border>

                                            <!-- Arrow Button -->
                                            <buttons:SfButton
                                                        Grid.Column="1"
                                                        Margin="0,0,4,2"
                                                        Text="&#xE709;" 
                                                        FontFamily="UIKitIcons"
                                                        Background="Transparent"
                                                        Padding="0"
                                                        CornerRadius="30"
                                                        HeightRequest="40"
                                                        WidthRequest="40"
                                                        FontSize="16"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="End"
                                                        TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}" />

                                        </Grid>
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>

                </listView:SfListView>
            </Grid>
        </Grid>
    </ContentView.Content>

</ContentView>