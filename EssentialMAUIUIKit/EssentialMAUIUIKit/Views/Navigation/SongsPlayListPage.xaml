<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Navigation.SongsPlayListPage"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:avatar="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             x:DataType="local:SongPageViewModel">
    <ContentView.BindingContext>
        <local:SongPageViewModel/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <ResourceDictionary>
            <Style TargetType="listView:ListViewItem">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Background" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Background" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Background"
                                            Value="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="Background" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid ColumnSpacing="0"
              RowDefinitions="*"
              RowSpacing="0">

            <Border StrokeShape="RoundRectangle 8"
                    Grid.Row="0"
                    Margin="0,24,0,24"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light= #E5E1E3, Dark=#474648}"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                    IsVisible="{OnPlatform Android=False, iOS=False}"
                    MaximumWidthRequest="{OnPlatform WinUI=776, MacCatalyst=776}">
                <Grid>

                    <listView:SfListView
                        AllowSwiping="True"
                        AutoFitMode="Height"
                        ScrollBarVisibility="Never"
                        ItemSpacing="0"
                        ItemsSource="{Binding SongsPageList}"
                        SelectionBackground="Transparent"
                        SelectionMode="None"
                        VerticalOptions="Fill">

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Song">
                                <StackLayout>
                                    <Grid
                                           ColumnDefinitions="Auto, Auto, *"
                                           ColumnSpacing="0"
                                           RowSpacing="0">

                                        <avatar:SfAvatarView
                                               WidthRequest="48"
                                               HeightRequest="48"
                                               CornerRadius="28"
                                               Margin="40,24,0,14"
                                               ImageSource="{Binding SongImage}"
                                               ContentType="Default"
                                               StrokeThickness="0" />

                                        <StackLayout
                                               Grid.Column="1"
                                               HorizontalOptions="Fill"
                                               Spacing="0"
                                               VerticalOptions="Fill">
                                            <!--  Name of the Song  -->
                                            <Label
                                                   Margin="12,24,0,0"
                                                   FontFamily="Roboto-Regular"
                                                   FontSize="16"
                                                   HeightRequest="24"
                                                   LineHeight="{OnPlatform Android=1.5,
                                                       Default=-1}"
                                                   Text="{Binding SongName}"
                                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"/>

                                            <!--  Composer of the song  -->
                                            <Label
                                                   Margin="12,0,0,0"
                                                   FontFamily="Roboto-Regular"
                                                   FontSize="14"
                                                   HeightRequest="21"
                                                   LineHeight="{OnPlatform Android=1.25,
                                                       Default=-1}"
                                                   Text="{Binding Composer}"
                                                   TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"/>
                                        </StackLayout>

                                        <!--  Menu button  -->
                                        <buttons:SfButton
                                               x:Name="MenuButton"
                                               Grid.Column="2"
                                               Margin="16,0"
                                               CornerRadius="50"
                                               HorizontalOptions="End"
                                               TextColor="{AppThemeBinding Light= #474648, Dark=#C9C6C8}"
                                               Style="{DynamicResource IconButtonStyle}"
                                               Text="{DynamicResource More}"/>

                                    </Grid>
                                    <!--  Seperator  -->
                                    <BoxView Style="{DynamicResource HorizontalSeparatorStyle}"/>
                                </StackLayout>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                    </listView:SfListView>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  IsVisible="{OnPlatform WinUI=False, MacCatalyst=False}">

                <listView:SfListView
                    AllowSwiping="True"
                    AutoFitMode="Height"
                    ScrollBarVisibility="Never"
                    ItemSpacing="0"
                    ItemsSource="{Binding SongsPageList}"
                    SelectionBackground="Transparent"
                    SelectionMode="None"
                    VerticalOptions="Fill">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Song">
                            <StackLayout>
                                <Grid
                                        ColumnDefinitions="Auto, Auto, *"
                                        ColumnSpacing="0"
                                        RowSpacing="0">

                                    <avatar:SfAvatarView
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    CornerRadius="28"
                                                    Margin="16,12,0,10"
                                                    ImageSource="{Binding SongImage}"
                                                    ContentType="Default"
                                                    StrokeThickness="0" />

                                    <StackLayout
                                            Grid.Column="1"
                                            HorizontalOptions="Fill"
                                            Spacing="0"
                                            VerticalOptions="Fill">
                                        <!--  Name of the Song  -->
                                        <Label
                                                Margin="16,13,0,0"
                                                FontFamily="Roboto-Regular"
                                                FontSize="16"
                                                HeightRequest="24"
                                                LineHeight="{OnPlatform Android=1.5,
                                                    Default=-1}"
                                                Text="{Binding SongName}"
                                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"/>

                                        <!--  Composer of the song  -->
                                        <Label
                                                Margin="16,0,0,12"
                                                FontFamily="Roboto-Regular"
                                                FontSize="14"
                                                HeightRequest="21"
                                                LineHeight="{OnPlatform Android=1.25,
                                                    Default=-1}"
                                                Text="{Binding Composer}"
                                                TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"/>
                                    </StackLayout>

                                    <!--  Menu button  -->
                                    <buttons:SfButton
                                            x:Name="MenuButton"
                                            Grid.Column="2"
                                            Margin="16,0"
                                            CornerRadius="50"
                                            HorizontalOptions="End"
                                            TextColor="{AppThemeBinding Light= #474648, Dark=#C9C6C8}"
                                            Style="{DynamicResource IconButtonStyle}"
                                            Text="{DynamicResource More}"/>

                                </Grid>
                                <!--  Seperator  -->
                                <BoxView Style="{DynamicResource HorizontalSeparatorStyle}"/>
                            </StackLayout>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>
            </Grid>


        </Grid>
    </ContentView.Content>
</ContentView>