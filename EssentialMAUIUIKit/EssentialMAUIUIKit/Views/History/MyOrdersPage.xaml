<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.History.MyOrdersPage"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
			 xmlns:chip="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
             x:DataType="local:OrdersViewModel">

    <ContentView.BindingContext>
        <local:OrdersViewModel x:Name="viewModel"/>
    </ContentView.BindingContext>

    <ContentView.Resources>
		<ResourceDictionary>
			<converter:StringToColorConverter x:Key="StringToColorConverter"/>
        </ResourceDictionary>
    </ContentView.Resources>


	<ContentView.Content>
		<VerticalStackLayout WidthRequest="{OnIdiom Default=650, Phone=-1}">

			<chip:SfChipGroup x:Name="chipView"
							  ChipClicked="chipView_ChipClicked"
							  ItemsSource="{Binding Tabs}"
							  ChipType="Choice"
							  ChipCornerRadius="16"
							  Margin="{OnIdiom Phone='8,12,4,12', Default='12,12,4,12'}"
							  HorizontalOptions="Start"
							  VerticalOptions="Center"
							  ChipFontFamily="Roboto-Medium"
							  ChipPadding="{OnIdiom Phone='0', Default='2'}"
							  ChipStroke="{AppThemeBinding Dark=#474648, Light=#E5E1E3}"
							  ChipStrokeThickness="2"
							  ChipTextSize="14"
							  HeightRequest="32"							  
							  SelectedChipBackground="{AppThemeBinding Dark=#8D4CF5, Light=#7633DA}"
							  ChipTextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}"
							  SelectedChipTextColor="{AppThemeBinding Light=#FFFFFF, Dark=#FFFFFF}">
			</chip:SfChipGroup>

			<BoxView HeightRequest="1"
					 Margin="12,0,12,0"
					 BackgroundColor="{AppThemeBinding Light=#E5E1E3, Dark=#474648}" />

			<ScrollView>
				<listView:SfListView x:Name="myOrderList"
									 AutoFitMode="DynamicHeight"
									 ItemsSource="{Binding FilteredOrders}"
									 SelectionMode="None"
									 HeightRequest="{OnIdiom Phone='600', Tablet='650', Default='545'}"
									 VerticalOptions="Start"
									 ScrollBarVisibility="Never">


					<listView:SfListView.ItemTemplate>
						<DataTemplate x:DataType="local:Order">
							<syncEffectsView:SfEffectsView Margin="0,0,0,0"
														   TouchDownEffects="Ripple">
								<StackLayout Spacing="0">
									<Grid ColumnDefinitions="Auto, *, *"
										  ColumnSpacing="0"
										  RowSpacing="0">

										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="{OnIdiom Default=1, Phone=0}" />
										</Grid.RowDefinitions>

										<Border Grid.Row="0"
												Grid.RowSpan="4"
												Grid.Column="0"
												Margin="12,20,6,16"
												StrokeThickness="0"
												WidthRequest="70"
												HeightRequest="70"
												StrokeShape="RoundRectangle 8">
											<!--  Product image  -->
											<Image Aspect="Fill"
												   WidthRequest="70"
												   HeightRequest="70">
												<Image.Source>
													<UriImageSource CacheValidity="14"
																	CachingEnabled="true"
																	Uri="{Binding ProductImage}" />
												</Image.Source>
											</Image>
										</Border>

										<!--  Product name  -->
										<Label Grid.Row="0"
											   Grid.Column="1"
											   Margin="6,24,0,0"
											   FontFamily="Roboto-Medium"
											   FontSize="14"
											   HorizontalOptions="Start"
											   LineBreakMode="TailTruncation"
											   MaxLines="1"
											   Text="{Binding Name}"
											   TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}" />

										<!--  Description label  -->
										<Label Grid.Row="1"
											   Grid.Column="1"
											   Grid.ColumnSpan="2"
											   Margin="6,4,0,7"
											   FontFamily="Roboto-Regular"
											   FontSize="12"
											   HorizontalOptions="Start"
											   Text="{Binding Description}"
											   TextColor="{AppThemeBinding Light=#5F5E60, Dark=#929092}" />


										<StackLayout Grid.Row="2"
													 Grid.Column="1"
													 Margin="6,7,0,16"
													 Padding="0"
													 HorizontalOptions="Start"
													 Orientation="Horizontal"
													 Spacing="0"
													 VerticalOptions="Start">
											<!--  Order ID  -->
											<Label Margin="0,-2,0,0"
												   FontFamily="Roboto-Regular"
												   FontSize="12"
												   Text="{Binding OrderId, StringFormat='Order ID: {0}'}"
												   TextColor="{AppThemeBinding Light=#5F5E60, Dark=#929092}"
												   VerticalOptions="Center" />
										</StackLayout>
										<StackLayout Grid.Row="2"
													 Grid.Column="3"
													 Margin="0,0,12,14"
													 IsVisible="{Binding ShowStatus}"
													 Padding="0"
													 HorizontalOptions="End"
													 Orientation="Horizontal"
													 Spacing="0"
													 VerticalOptions="Start">
											<Border Stroke="Transparent"
													StrokeShape="RoundRectangle 12,12,12,12"
													HeightRequest="24"
													HorizontalOptions="Start"
													VerticalOptions="Start"
													WidthRequest="96">

												<Border.Content>
													<Grid>
														<BoxView BackgroundColor="{Binding Status, Converter={x:StaticResource StringToColorConverter}, ConverterParameter=0}"
																 Opacity="0.1" />

														<Label FontFamily="Roboto-Medium"
															   FontSize="12"
															   HorizontalOptions="Center"
															   Text="{Binding Status}"
															   TextColor="{Binding Status, Converter={x:StaticResource StringToColorConverter}, ConverterParameter=0}"
															   VerticalOptions="Center" />
													</Grid>
												</Border.Content>
											</Border>
										</StackLayout>


									</Grid>

									<BoxView HeightRequest="1"
											 Margin="12,0,12,0"
											 BackgroundColor="{AppThemeBinding Light=#E5E1E3, Dark=#474648}" />

								</StackLayout>
							</syncEffectsView:SfEffectsView>
						</DataTemplate>
					</listView:SfListView.ItemTemplate>
				</listView:SfListView>
			</ScrollView>
		</VerticalStackLayout>

	</ContentView.Content>

</ContentView>