<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.History.TransactionHistoryPage"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters;assembly=EssentialMAUIUIKit"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
			 xmlns:sfavatar="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:DataType="local:TransactionHistoryViewModel">
    <ContentView.BindingContext>
        <local:TransactionHistoryViewModel x:Name="viewModel"/>
    </ContentView.BindingContext>

    <ContentView.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        </ResourceDictionary>
    </ContentView.Resources>

    <ContentView.Content>
		<ScrollView>
			<Grid RowDefinitions="Auto" Margin="{OnPlatform 
												Android='4', 
												iOS='4', 
												Default='32'}">


				<Border WidthRequest="{OnPlatform WinUI=650, MacCatalyst=650}"
						BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
						StrokeShape="RoundRectangle 10">
					<StackLayout>

						<Label Text="Payment History"
							   Margin="24,18,0,18"
							   FontSize="22"
							   FontFamily="Roboto-Medium" />

						<BoxView HeightRequest="1"
								 Style="{DynamicResource HorizontalSeparatorStyle}" />

						<StackLayout x:Name="transactionList"
									 BindableLayout.ItemsSource="{Binding TransactionDetails}"
									 Margin="{OnPlatform 
												Android='0,0,8,0', 
												iOS='0,0,8,0', 
												Default='24'}">

							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="local:TransactionDetail">

									<!-- Wrapper for Header + Item -->
									<StackLayout>

										<!-- GROUP HEADER (Yesterday only) -->
										<Label Text="{Binding GroupHeader}"
											   FontSize="16"
											   FontAttributes="Bold"
											   TextColor="{AppThemeBinding Light=#5F5E60, Dark=#929092}"
											   IsVisible="{Binding ShowHeader}"
											   Margin="{OnPlatform 
														Android='14', 
														iOS='14', 
														Default='1,16,0,16'}"/>

										<Border BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
												Stroke="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
												StrokeShape="RoundRectangle 4"
												HeightRequest="72">

											<syncEffectsView:SfEffectsView RippleBackground="{DynamicResource Gray-300}"
																		   TouchDownEffects="Ripple">

												<Grid ColumnDefinitions="Auto, *"
													  ColumnSpacing="0"
													  RowDefinitions="Auto, Auto"
													  RowSpacing="0">

													<!-- Profile Image -->

													<!-- Profile Image / Avatar -->
													<Border Grid.RowSpan="2"
															Margin="16,12,12,12"
															StrokeShape="RoundRectangle 26"
															StrokeThickness="0"
															HorizontalOptions="Center"
															VerticalOptions="Center">

														<Grid>
															<Image Aspect="Fill"
																   HeightRequest="48"
																   WidthRequest="48">
																<Image.Source>
																	<UriImageSource Uri="{Binding CustomerImage}" />
																</Image.Source>
															</Image>

															<sfavatar:SfAvatarView ContentType="Initials"
																				   InitialsType="SingleCharacter"
																				   WidthRequest="48"
																				   HeightRequest="48"
																				   CornerRadius="24"
																				   AvatarName="{Binding CustomerName}"
																				   FontSize="16"
																				   Background="{AppThemeBinding Dark=#1C2F1E, Light=#CEFFC9}"
																				   InitialsColor="{AppThemeBinding Dark=#3CB053, Light=#1C7E39}"
																				   IsVisible="{Binding UseAvatar}" />
														</Grid>

													</Border>


													<!-- Name + Amount -->
													<Grid ColumnDefinitions="*,*"
														  Grid.Row="0"
														  Grid.Column="1"
														  VerticalOptions="Center">

														<!-- Customer Name (UNCHANGED) -->
														<Label FontFamily="Roboto-Medium"
															   FontSize="14"
															   Margin="0,14,0,0"
															   HorizontalOptions="Start"
															   Text="{Binding CustomerName}"
															   HorizontalTextAlignment="Start"
															   TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}" />

														<!-- Amount -->
														<Label Grid.Column="1"
															   Margin="0,16,12,0"
															   FontFamily="Roboto-Medium"
															   FontSize="14"
															   HorizontalOptions="End"
															   VerticalOptions="Start"
															   HorizontalTextAlignment="End"
															   Text="{Binding DisplayAmount}"
															   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}">

															<Label.Triggers>
																<DataTrigger TargetType="Label"
																			 Binding="{Binding IsCredited}"
																			 Value="True">
																	<Setter Property="TextColor"
																			Value="{AppThemeBinding Light=#1C7E39, Dark=#3CB053}"/>
																</DataTrigger>
															</Label.Triggers>

														</Label>

													</Grid>

													<!-- TIME + FAILED -->
													<Grid ColumnDefinitions="*,*"
														  Grid.Row="1"
														  Grid.Column="1">

														<!-- TIME -->
														<Label HorizontalOptions="Start"
															   Margin="0,0,0,14">
															<Label.FormattedText>
																<FormattedString>
																	<!-- DATE (bigger) -->
																	<Span Text="{Binding DisplayDate}"
																		  FontSize="12"
																		  FontFamily="Roboto-Regular"
																		  TextColor="{AppThemeBinding Light=#5F5E60, Dark=#929092}" />
																	<!-- TIME (smaller) -->
																	<Span Text="{Binding DisplayTime}"
																		  FontSize="10"																		  
																		  FontFamily="Roboto-Regular"
																		  TextColor="{AppThemeBinding Light=#5F5E60, Dark=#929092}" />
																</FormattedString>
															</Label.FormattedText>
														</Label>

														<!-- FAILED -->
														<Label Grid.Column="1"
															   Margin="0,0,12,14"
															   FontFamily="Roboto-Regular"
															   FontSize="12"
															   HorizontalOptions="End"
															   HorizontalTextAlignment="End"
															   VerticalOptions="End"
															   Text="Failed"
															   TextColor="{AppThemeBinding Dark=#FF5C61, Light=#C20D32}"
															   IsVisible="{Binding IsFailed}" />

													</Grid>

												</Grid>
											</syncEffectsView:SfEffectsView>
										</Border>

									</StackLayout>

								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</StackLayout>
					</StackLayout>
				</Border>
			</Grid>
		</ScrollView>
	</ContentView.Content>
</ContentView>