<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.History.TransactionHistoryPage"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters;assembly=EssentialMAUIUIKit"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
			 xmlns:sfavatar="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:DataType="local:TransactionHistoryViewModel">
    <ContentView.BindingContext>
        <local:TransactionHistoryViewModel x:Name="viewModel"/>
    </ContentView.BindingContext>

    <ContentView.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        </ResourceDictionary>
    </ContentView.Resources>

    <ContentView.Content>
		<ScrollView>
			<Grid RowDefinitions="Auto">

				<Border WidthRequest="{OnPlatform WinUI=650, MacCatalyst=650}"
						BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
						StrokeShape="RoundRectangle 10"
						Margin="8">
					<StackLayout>

						<Label Margin="10"
							   Text="Payment History"
							   FontSize="20"
							   FontFamily="Roboto-Medium" />

						<BoxView HeightRequest="1"
								 Style="{DynamicResource HorizontalSeparatorStyle}" />

						<StackLayout x:Name="transactionList"
									 BindableLayout.ItemsSource="{Binding TransactionDetails}"
									 Spacing="10">

							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="local:TransactionDetail">

									<!-- Wrapper for Header + Item -->
									<StackLayout Spacing="4">

										<!-- GROUP HEADER (Yesterday only) -->
										<Label Text="{Binding GroupHeader}"
											   FontSize="13"
											   FontAttributes="Bold"
											   TextColor="Gray"
											   IsVisible="{Binding ShowHeader}"
											   Margin="10,8,0,8" />

										<Border Margin="0"
												Padding="0"
												BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
												Stroke="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
												StrokeShape="RoundRectangle 4"
												HeightRequest="72">

											<syncEffectsView:SfEffectsView RippleBackground="{DynamicResource Gray-300}"
																		   TouchDownEffects="Ripple">

												<Grid ColumnDefinitions="Auto, *"
													  ColumnSpacing="0"
													  RowDefinitions="Auto, Auto"
													  RowSpacing="0">

													<!-- Profile Image -->

													<!-- Profile Image / Avatar -->
													<Border Grid.RowSpan="2"
															Margin="18,8,14,14"
															Stroke="{DynamicResource Gray-Bg}"
															StrokeThickness="1"
															StrokeShape="RoundRectangle 26"
															HorizontalOptions="Center"
															VerticalOptions="Center">

														<Grid>
															<Image Aspect="Fill"
																   HeightRequest="52"
																   WidthRequest="52">

																<Image.Source>
																	<UriImageSource Uri="{Binding CustomerImage}" />
																</Image.Source>
															</Image>

															<sfavatar:SfAvatarView ContentType="Initials"
																				   InitialsType="SingleCharacter"
																				   WidthRequest="52"
																				   HeightRequest="52"
																				   CornerRadius="24"
																				   AvatarName="{Binding CustomerName}"
																				   Background="{AppThemeBinding Dark=Green, Light=LightGreen}"
																				   InitialsColor="{AppThemeBinding Dark=LightGreen, Light=Green}"
																				   Stroke="Black"
																				   IsVisible="{Binding UseAvatar}" />
														</Grid>

													</Border>


													<!-- Name + Amount -->
													<Grid ColumnDefinitions="*,*"
														  Grid.Row="0"
														  Grid.Column="1"
														  VerticalOptions="Center">

														<!-- Customer Name (UNCHANGED) -->
														<Label FontFamily="Roboto-Medium"
															   FontSize="16"
															   Margin="0,10,0,0"
															   HorizontalOptions="Start"
															   Text="{Binding CustomerName}"
															   HorizontalTextAlignment="Start"
															   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

														<!-- Amount -->
														<Label Grid.Column="1"
															   Margin="0,12,24,0"
															   FontFamily="Roboto-Medium"
															   FontSize="14"
															   HorizontalOptions="End"
															   HorizontalTextAlignment="End"
															   Text="{Binding DisplayAmount}"
															   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}">

															<Label.Triggers>
																<DataTrigger TargetType="Label"
																			 Binding="{Binding IsCredited}"
																			 Value="True">
																	<Setter Property="TextColor"
																			Value="Green" />
																</DataTrigger>
															</Label.Triggers>

														</Label>

													</Grid>

													<!-- TIME + FAILED -->
													<Grid ColumnDefinitions="*,*"
														  Grid.Row="1"
														  Grid.Column="1"
														  Padding="0"
														  Margin="0,0,0,5">

														<!-- TIME -->
														<Label FontFamily="Roboto-Regular"
															   FontSize="12"
															   Margin="0,0,0,10"
															   HorizontalOptions="Start"
															   Text="{Binding DisplayDateTime}"
															   TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}" />

														<!-- FAILED -->
														<Label Grid.Column="1"
															   Margin="0,0,24,0"
															   FontFamily="Roboto-Regular"
															   FontSize="12"
															   HorizontalOptions="End"
															   HorizontalTextAlignment="End"
															   Text="Failed"
															   TextColor="{AppThemeBinding Dark=#FF5C61, Light=#C20D32}"
															   IsVisible="{Binding IsFailed}" />

													</Grid>

												</Grid>
											</syncEffectsView:SfEffectsView>
										</Border>

									</StackLayout>

								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</StackLayout>
					</StackLayout>
				</Border>
			</Grid>
		</ScrollView>
	</ContentView.Content>
</ContentView>