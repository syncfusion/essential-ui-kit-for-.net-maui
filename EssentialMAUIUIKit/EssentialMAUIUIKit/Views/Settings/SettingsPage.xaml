<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Settings.SettingsPage"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
              xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:controls="clr-namespace:EssentialMAUIUIKit.Controls">
    <ContentView.Content>
        <Grid RowDefinitions="Auto,*" IsVisible="{OnIdiom Phone=True, Default=True}">
            <Grid RowDefinitions="Auto,1,*">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="327,1,*,Auto" Padding="16,19">
                    <!-- Left Header -->
                    <Grid Grid.Column="0" IsVisible="{OnIdiom Phone=True, Desktop=True, Tablet=True}" ColumnDefinitions="Auto,*">
                        <buttons:SfButton Text="&#xe708;" FontFamily="UIKitIcons" FontSize="18" Background="Transparent" CornerRadius="20" HeightRequest="30" WidthRequest="30"  TextColor="{AppThemeBinding Light=#474648 ,Dark=#C9C6C8}" VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Settings"
                               FontFamily="Roboto-Medium"
                               FontSize="16"
                               Margin="12,0,0,0"
                               VerticalOptions="Center"/>   
                    </Grid>

                    <!-- Right Header -->
                    <Grid Grid.Column="{OnIdiom Desktop=2, Tablet=2, Phone=0}" IsVisible="{OnIdiom Phone=False, Desktop=True, Tablet=True}" ColumnDefinitions="Auto,*">
                        <buttons:SfButton  Text="&#xe708;" FontFamily="UIKitIcons" Background="Transparent" CornerRadius="20" HeightRequest="30" WidthRequest="30" TextColor="{AppThemeBinding Light=#474648 ,Dark=#C9C6C8}"
                                           FontSize="18"
                                           Margin="16,0,0,0"
                                           VerticalOptions="Center"/>

                        <Label Grid.Column="1"
                               Text="Help center"
                               FontFamily="Roboto-Medium"
                               FontSize="16"
                               Margin="12,0,0,0"
                               VerticalOptions="Center"/>       
                    </Grid>

                    <!-- Search -->
                    <buttons:SfButton Grid.Column="3" IsVisible="{OnIdiom Phone=False, Desktop=True}" Text="&#xe715;" Background="Transparent" CornerRadius="20" HeightRequest="30" WidthRequest="30" TextColor="{AppThemeBinding Light=#474648 ,Dark=#C9C6C8}"
                                       FontFamily="MaterialAssets"
                                       FontSize="18"
                                       Margin="0,0,16,0"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"/>       
                </Grid>
                <!-- Horizontal Divider -->
                <BoxView Grid.Row="1" HeightRequest="1" Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" />
            </Grid>
            <BoxView HeightRequest="1"
                    VerticalOptions="End" IsVisible="{OnIdiom Phone='False', Default='True'}" Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"/>
            <Grid Grid.Row="1" VerticalOptions="Fill">    
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{OnIdiom Default=327}"/>
                    <ColumnDefinition Width="{OnIdiom Default=*, Phone=0}"/>
                </Grid.ColumnDefinitions>
                <BoxView WidthRequest="1" IsVisible="{OnIdiom Phone=False, Default=True}"
                        HorizontalOptions="End" Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"/>
                <ScrollView VerticalOptions="Fill">
                    <StackLayout Spacing="0" IsVisible="{OnIdiom Phone=True, Desktop=True, Tablet=True}"
                            VerticalOptions="Fill">
                        <Grid RowDefinitions="Auto, Auto"
                              ColumnDefinitions="Auto, *"
                              ColumnSpacing="12"
                              Margin="0,8,0,24"
                              Padding="32,16"
                              HeightRequest="72">
                            <core:SfAvatarView
                                x:Name="profileImage"
                                ContentType="Custom"
                                CornerRadius="48"
                                Grid.Column="0"
                                Grid.RowSpan="2"
                                WidthRequest="48"
                                HeightRequest="48"/>
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="John Chris"
                                FontFamily="Roboto-Medium"
                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                FontSize="16"/>
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="Platinum Member"
                                FontFamily="Roboto-Regular"
                                TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                FontSize="14"/>
                        </Grid>
                        <syncEffectsView:SfEffectsView RippleBackground="{AppThemeBinding Light=#D3D3D3, Dark=#555555}" TouchDownEffects="Ripple">
                            <HorizontalStackLayout Spacing="12" Margin="32,0" Padding="16,20">
                                <Label
                                        FontFamily="MaterialAssets"
                                        FontSize="18"
                                        VerticalOptions="Center"
                                        Text="&#xe71b;" />
                                <Label
                                        FontFamily="Roboto-Regular"
                                        HorizontalOptions="Start"
                                        FontSize="16"
                                        Text="Profile"
                                        VerticalOptions="Center" />

                            </HorizontalStackLayout>

                        </syncEffectsView:SfEffectsView>

                        <syncEffectsView:SfEffectsView RippleBackground="{AppThemeBinding Light=#D3D3D3, Dark=#555555}" TouchDownEffects="Ripple">
                            <HorizontalStackLayout
                                                Spacing="12"
                                                Margin="32,0"
                                                Padding="16,20">
                                <Label
                                    FontFamily="UIKitIcons"
                                    FontSize="18"
                                    VerticalOptions="Center"
                                    Text="&#xe714;"/>
                                <Label
                                    FontFamily="Roboto-Regular"
                                    HorizontalOptions="Start"
                                    FontSize="16"
                                    Text="Security"
                                    VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </syncEffectsView:SfEffectsView>

                        <syncEffectsView:SfEffectsView RippleBackground="{AppThemeBinding Light=#D3D3D3, Dark=#555555}" TouchDownEffects="Ripple">
                            <HorizontalStackLayout
                                    Spacing="12"
                                    Margin="32,0"
                                    Padding="16,20">
                                <Label
                                    FontFamily="UIKitIcons"
                                    FontSize="18"
                                    VerticalOptions="Center"
                                    Text="&#xe71c;"/>
                                <Label
                                    FontFamily="Roboto-Regular"
                                    HorizontalOptions="Start"
                                    FontSize="16"
                                    Text="Privacy"
                                    VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </syncEffectsView:SfEffectsView>

                        <syncEffectsView:SfEffectsView RippleBackground="{AppThemeBinding Light=#D3D3D3, Dark=#555555}" TouchDownEffects="Ripple">
                            <HorizontalStackLayout
                                    Spacing="12"
                                    Margin="32,0"
                                    Padding="16,20">
                                <Label
                                    FontFamily="UIKitIcons"
                                    FontSize="18"
                                    VerticalOptions="Center"
                                    Text="&#xe700;"/>
                                <Label
                                    FontFamily="Roboto-Regular"
                                    HorizontalOptions="Start"
                                    Text="Notifications"
                                    FontSize="16"
                                    VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </syncEffectsView:SfEffectsView>
                        
                        <Border Margin="32,0"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                BackgroundColor="#EBDCFF">

                            <Grid Padding="16,20"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12">

                                <!-- Left Icon -->
                                <Label
                                    Grid.Column="0"
                                    FontFamily="MaterialAssets"
                                    FontSize="18"
                                    VerticalOptions="Center"
                                    TextColor="#7633DA"
                                    Text="&#xe778;"/>

                                <!-- Center Text -->
                                <Label
                                    Grid.Column="1"
                                    FontFamily="Roboto-Regular"
                                    FontSize="16"
                                    Text="Help Center"
                                    TextColor="#7633DA"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Fill"/>

                                <!-- Right Icon -->
                                <Label
                                    Grid.Column="2"
                                    FontFamily="MaterialAssets"
                                    FontSize="18"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    TextColor="#7633DA"
                                    Text="&#xe706;"/>
                            </Grid>
                        </Border>

                        <BoxView
                            Margin="32,20,32,38"
                            HeightRequest="1"
                            BackgroundColor="{AppThemeBinding Light=#E5E1E3, Dark=#474648}"/>
                        <syncEffectsView:SfEffectsView RippleBackground="{AppThemeBinding Light=#D3D3D3, Dark=#555555}" TouchDownEffects="Ripple">
                            <HorizontalStackLayout
                            Spacing="12"
                            Margin="32,0"
                            Padding="16,20">
                                <Label
                                VerticalOptions="Center"
                                FontSize="30"
                                Text="="/>
                                <Label
                                FontFamily="Roboto-Regular"
                                FontSize="16"
                                HorizontalOptions="Start"
                                Text="Terms of Service"
                                VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </syncEffectsView:SfEffectsView>

                        <syncEffectsView:SfEffectsView RippleBackground="{AppThemeBinding Light=#D3D3D3, Dark=#555555}" TouchDownEffects="Ripple">
                            <HorizontalStackLayout
                            Spacing="12"
                            Margin="32,-20"
                            Padding="16,20">
                                <Label
                                FontSize="18"
                                FontAttributes="Bold"
                                FontFamily="Roboto-Medium"
                                VerticalOptions="Center"
                                Text="＠"/>
                                <Label
                                FontFamily="Roboto-Regular"
                                HorizontalOptions="Start"
                                FontSize="16"
                                Text="Privacy and Policy"
                                VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </syncEffectsView:SfEffectsView>
                    </StackLayout>
                </ScrollView>
                <ContentView Grid.Column="1" IsVisible="{OnIdiom Phone=False, Desktop=True, Tablet=True}" x:Name="HelpPage"/>
            </Grid>
        </Grid>
    </ContentView.Content>
</ContentView>