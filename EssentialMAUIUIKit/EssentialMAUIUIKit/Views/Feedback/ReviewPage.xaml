<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Feedback.ReviewPage"
             xmlns:rating="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             x:DataType="local:ReviewViewModel">
    <ContentView.BindingContext>
        <local:ReviewViewModel/>
    </ContentView.BindingContext>
    <ContentView.Content>

        <ScrollView VerticalScrollBarVisibility="Never">

            <StackLayout
                    BackgroundColor="{AppThemeBinding
                            Light={DynamicResource BackgroundColorLight},
                            Dark={DynamicResource BackgroundColorDark}}">

                <Grid BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                      HeightRequest="55"
                      ColumnDefinitions="{OnIdiom Default='Auto,*,Auto', Desktop='*,Auto'}">

                    <buttons:SfButton  Grid.Column="0"
                                    FontFamily="MaterialAssets"
                                    IsVisible="{OnIdiom Desktop='false', Default='true'}"
                                    Background="Transparent"
                                    WidthRequest="40"
                                    HeightRequest="30"
                                    Rotation="180"
                                    Text="&#xe72d;"
                                    TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />

                    <Label Grid.Column="{OnIdiom Desktop='0', Default='1'}"
                           Text="Ratings and Reviews"
                           FontSize="16"
                           FontFamily="Roboto-Medium"
                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                           VerticalOptions="Center"
                           HorizontalOptions="Start" />

                    <HorizontalStackLayout  Grid.Column="2"
                                            Spacing="16"
                                            VerticalOptions="Center">

                        <buttons:SfButton Background="Transparent"
                                          CornerRadius="4"
                                          HeightRequest="30"
                                          WidthRequest="30"
                                          Padding="8,0"
                                          TextColor="{DynamicResource Gray-700}">
                            <buttons:SfButton.Content>
                                <DataTemplate>
                                <Label  Grid.Column="0"
                                        FontFamily="FontIcons"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        Text="&#xe705;"
                                        TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center" />
                                </DataTemplate>
                            </buttons:SfButton.Content>
                        </buttons:SfButton>

                        <buttons:SfButton Background="Transparent"
                                          HeightRequest="30"
                                        WidthRequest="30"
                                        CornerRadius="4"
                                        Padding="8,0"
                                        TextColor="{DynamicResource Gray-700}">
                            <buttons:SfButton.Content>
                                <DataTemplate>
                                    <Label
                                        FontFamily="FontIcons"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        Text="&#xe708;"
                                        TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center" />
                                </DataTemplate>
                            </buttons:SfButton.Content>
                        </buttons:SfButton>

                    </HorizontalStackLayout>

                </Grid>

                <BoxView  HeightRequest="1"
                          Style="{DynamicResource HorizontalSeparatorStyle}"/>


                <Border StrokeShape="{OnIdiom Desktop='RoundRectangle 8', Tablet='RoundRectangle 8'}"
                        WidthRequest="{OnIdiom Default=900,Tablet=800, Phone=-1}"
                        Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                        Margin="{OnIdiom Default='24,32,24,0',Phone='0,24,0,8'}">
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                        <Label Text="Write a Review"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                               FontSize="16"
                               CharacterSpacing="0.15"
                               Margin="{OnIdiom Default='24,16', Phone='16,0,16,16'}"
                               FontFamily="Roboto-Medium"/>

                        <StackLayout Grid.Row="1"
                                     Orientation="Horizontal">

                            <!--  Product image  -->

                            <Border Margin="{OnIdiom Default='24,0,0,0', Phone='16,0,0,0'}" StrokeShape="RoundRectangle 8" Stroke="Transparent" HeightRequest="{OnIdiom Default='100', Phone='60'}" WidthRequest="{OnIdiom Default='100', Phone='60'}">
                                <Image
                                   x:Name="ProductImage"
                                   Aspect="AspectFill"
                                   Source="{Binding ProductImageUrl}"
                                   BackgroundColor="{DynamicResource Gray-200}"/>
                            </Border>

                            <!--  Product name label  -->

                            <VerticalStackLayout 
                                Margin="16,0"
                                Spacing="16">
                            <Label
                                HorizontalOptions="Start"
                                FontFamily="{OnIdiom Default='Roboto-Regular', Phone='Roboto-Medium'}"
                                FontSize="16"
                                CharacterSpacing="0.5"
                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                Text="{Binding ProductName}"/>

                            <StackLayout Orientation="Horizontal"
                                         Spacing="{OnIdiom Phone=4, Tablet=5, Desktop=6}"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">

                                <Label Text="$76.50"
                                        FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=16}"
                                        FontFamily="Roboto-Medium"
                                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                <Label Text="$90.00"
                                       FontSize="12"
                                       FontFamily="Roboto-Regular"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                       TextDecorations="Strikethrough" />

                                <Border BackgroundColor="{AppThemeBinding Light=#CEFFC9,Dark=Transparent}"
                                        StrokeThickness="0"
                                        Margin="{OnIdiom Phone='25,0,0,0', Tablet='5,0,0,0', Desktop='4,0,0,0'}"
                                        StrokeShape="RoundRectangle 12"
                                        HorizontalOptions="End"
                                        Padding="6,2"
                                        VerticalOptions="Center">

                                    <Label Text="30% OFF"
                                            FontSize="11"
                                            FontFamily="Roboto-Medium"
                                            TextColor="{AppThemeBinding Light=#1C7E39, Dark=#3CB053}" />
                                </Border>
                            </StackLayout>
                            </VerticalStackLayout>
                        </StackLayout>

                        <BoxView Grid.Row="2"
                                 Margin="24,24,24,0"
                                 HeightRequest="1"
                                 Style="{DynamicResource HorizontalSeparatorStyle}"/>


                        <Label Text="How would you like to rate?"
                               Margin="{OnIdiom Default='24, 16, 0, 0', Phone='16'}"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                               Grid.Row="3"
                               FontSize="16"
                               CharacterSpacing="0.15"
                               FontFamily="Roboto-Medium"/>

                        <rating:SfRating Margin="{OnIdiom Default='32', Phone='24'}"
                                         BackgroundColor="Transparent"
                                         Grid.Row="4"
                                         HorizontalOptions="Center"
                                         ItemSize="30"
                                         ItemSpacing="10"
                                         IsReadOnly="False"
                                         Style="{DynamicResource RatingStyle}"
                                         VerticalOptions="Start">
                            <rating:SfRating.RatingSettings>
                                <rating:RatingSettings  RatedFill="#FFBE52"
                                                        RatedStroke="#FFBE52"
                                                        UnratedStroke="#787678"
                                                        UnratedStrokeThickness="1"/>
                            </rating:SfRating.RatingSettings>
                        </rating:SfRating>
                    </Grid>
                </Border>

                <BoxView  HeightRequest="8"
                          IsVisible="{OnIdiom Phone='true', Default='false'}"
                          BackgroundColor="{AppThemeBinding Light={DynamicResource SentMessageColorLight}, Dark={DynamicResource SentMessageColorDark}}"/>

                <Border StrokeShape="{OnIdiom Desktop='RoundRectangle 8', Tablet='RoundRectangle 8'}"
                        WidthRequest="{OnIdiom Default=900, Tablet=800, Phone=-1}"
                        Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                        Margin="{OnIdiom Default='24',Phone='0,24,0,8'}">
                    <StackLayout>
                        <Label Text="Upload photos and videos"
                               Margin="{OnIdiom Default='24,24,0,0', Phone='16,0,0,0'}"
                               FontSize="16"
                               CharacterSpacing="0.15"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                               FontFamily="Roboto-Medium"/>
                        <Border StrokeDashOffset="1"
                                            StrokeDashArray="5,5"
                                            Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                            Margin="{OnIdiom Phone='16', Default='24'}">
                            <syncEffectsView:SfEffectsView TouchDownEffects="Ripple"
                               RippleBackground="{DynamicResource Gray-300}">
                                <StackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Margin="46">
                                    <Image
                                                Source="export.png"
                                                HeightRequest="24"
                                                WidthRequest="24"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center"/>
                                    <Label Text="Click to upload or drag and drop"
                                                   Margin="12"
                                                   FontSize="12"
                                                   FontFamily="Roboto-Regular"
                                                   TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                   HorizontalOptions="Center"/>
                                </StackLayout>
                            </syncEffectsView:SfEffectsView>
                        </Border>
                    </StackLayout>
                </Border>

                <BoxView  HeightRequest="8"
                          IsVisible="{OnIdiom Phone='true', Default='false'}"
                          BackgroundColor="{AppThemeBinding Light={DynamicResource SentMessageColorLight}, Dark={DynamicResource SentMessageColorDark}}"/>

                <Border StrokeShape="{OnIdiom Desktop='RoundRectangle 8', Tablet='RoundRectangle 8'}"
                        WidthRequest="{OnIdiom Default=900, Tablet=800, Phone=-1}"
                        Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                        Margin="{OnIdiom Default='24,0,24,24',Phone='0'}">
                    <StackLayout>
                        <StackLayout Orientation="Vertical" Spacing="16" Margin="{OnIdiom Default='24,24,16,16', Phone='16'}">
                            <Label Text="Title"
                               FontSize="16"
                               CharacterSpacing="0.15"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                               FontFamily="Roboto-Medium"/>

                        <inputLayout:SfTextInputLayout Stroke="{AppThemeBinding Light={DynamicResource ContentTextColorDark}, Dark={DynamicResource SecondaryTextColorLight}}"
                                                       HeightRequest="76"
                                                       IsHintAlwaysFloated="True"
                                                       ShowHint="False"
                                                       InputViewPadding="{OnIdiom Default='15,5,5,15', Phone='15,5,5,5'}"
                                                       ContainerType="Outlined"
                                                       BackgroundColor="Transparent" >
                            <inputLayout:SfTextInputLayout.HintLabelStyle>
                                <inputLayout:LabelStyle TextColor="{AppThemeBinding Light={DynamicResource PlaceholderTextColorLight}, Dark={DynamicResource PlaceholderTextColorDark}}"/>
                            </inputLayout:SfTextInputLayout.HintLabelStyle>
                            <Entry Text="{Binding ReviewInfo.Title}" Placeholder="Title (optional)" />
                        </inputLayout:SfTextInputLayout>

                        <Label Text="Describe your Review"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                               CharacterSpacing="0.15"
                               FontFamily="Roboto-Medium"/>

                        <Border Stroke="{AppThemeBinding Light={DynamicResource ContentTextColorDark}, Dark={DynamicResource SecondaryTextColorLight}}"
                                StrokeThickness="1"
                                HeightRequest="116">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4"/>
                            </Border.StrokeShape>
                            <inputLayout:SfTextInputLayout  VerticalOptions="Fill"
                                                            IsHintAlwaysFloated="True"
                                                            ShowHint="False"
                                                            ContainerBackground="Transparent"
                                                            UnfocusedStrokeThickness="0"
                                                            FocusedStrokeThickness="0"
                                                            ContainerType="Outlined" >
                                <Editor Text="{Binding ReviewInfo.Review}"
                                        Placeholder="Leave us a message..."
                                        FontSize="16"
                                        PlaceholderColor="{AppThemeBinding Light={DynamicResource PlaceholderTextColorLight}, Dark={DynamicResource PlaceholderTextColorDark}}"
                                        AutoSize="TextChanges"/>
                            </inputLayout:SfTextInputLayout>
                        </Border>
                        </StackLayout>

                        <BoxView  HeightRequest="1"
                              Margin="{OnIdiom Phone='0,16,0,0'}"
                              IsVisible="{OnIdiom Phone='true', Default='false'}"
                              Style="{DynamicResource HorizontalSeparatorStyle}"/>

                        <buttons:SfButton Text="Submit"
                                      x:Name="submitButton"
                                      HorizontalOptions="Center"
                                      Style="{DynamicResource FormsButtonStyle}"
                                      Margin="{OnIdiom Phone='0,16', Default='24'}"
                                      CornerRadius="20"
                                      Clicked="OnSubmitClicked"/>
                    </StackLayout>
                </Border>
            </StackLayout>

        </ScrollView>

    </ContentView.Content>
</ContentView>
