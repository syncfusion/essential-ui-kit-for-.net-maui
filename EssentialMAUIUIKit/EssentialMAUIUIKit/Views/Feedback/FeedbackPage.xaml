<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Feedback.FeedbackPage"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:chip="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
             xmlns:progressbar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters"
             xmlns:model="clr-namespace:EssentialMAUIUIKit.Models"
             x:DataType="local:FeedbackViewModel"
             x:Name="feedbackPage">

    <ContentView.BindingContext>
        <local:FeedbackViewModel/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <ResourceDictionary>
            <converter:BooleanToStringConverter x:Key="boolToStringConverter" />
            <converter:BooleanToColorConverter x:Key="boolToColorConverter" />
        </ResourceDictionary>
        <Style TargetType="listView:ListViewItem">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Background"
                    Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Background"
                    Value= "Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>

    <ContentView.Content>
        <ScrollView VerticalScrollBarVisibility="Never">
            <StackLayout
                    BackgroundColor="{AppThemeBinding
                            Light={DynamicResource BackgroundColorLight},
                            Dark={DynamicResource BackgroundColorDark}}">
                <Grid BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                      HeightRequest="55"
                      ColumnDefinitions="{OnIdiom Default='Auto,*,Auto', Desktop='*,Auto'}">

                    <buttons:SfButton  Grid.Column="0"
                                    IsVisible="{OnIdiom Desktop='false', Default='true'}"
                                    Background="Transparent"
                                    WidthRequest="40"
                                    HeightRequest="30"
                                    Rotation="180"
                                    Text="&#xe72d;"
                                    FontFamily="MaterialAssets"
                                    TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />

                    <Label Grid.Column="{OnIdiom Desktop='0', Default='1'}"
                           Text="Ratings and Reviews"
                           FontSize="16"
                           FontFamily="Roboto-Medium"
                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                           VerticalOptions="Center"
                           HorizontalOptions="Start" />

                    
                    <HorizontalStackLayout  Grid.Column="2"
                                            Spacing="16"
                                            VerticalOptions="Center">

                        <buttons:SfButton Background="Transparent"
                                          HeightRequest="30"
                                        WidthRequest="30"
                                        CornerRadius="4"
                                        Padding="8,0"
                                        TextColor="{DynamicResource Gray-700}">
                            <buttons:SfButton.Content>
                                <DataTemplate>
                                <Label  Grid.Column="0"
                                        FontFamily="FontIcons"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        Text="&#xe705;"
                                        TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center" />
                                </DataTemplate>
                            </buttons:SfButton.Content>
                        </buttons:SfButton>

                        <buttons:SfButton Background="Transparent"
                                          HeightRequest="30"
                                        WidthRequest="30"
                                        CornerRadius="4"
                                        Padding="8,0"
                                        TextColor="{DynamicResource Gray-700}">
                            <buttons:SfButton.Content>
                                <DataTemplate>
                                    <Label
                                        FontFamily="FontIcons"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        Text="&#xe708;"
                                        TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center" />
                                </DataTemplate>
                            </buttons:SfButton.Content>
                        </buttons:SfButton>
                    </HorizontalStackLayout>

                </Grid>

                <BoxView  HeightRequest="1"
                          Style="{DynamicResource HorizontalSeparatorStyle}"/>

                <Grid RowDefinitions="Auto,8,Auto"
                      RowSpacing="8">
                    <Border StrokeShape="{OnIdiom Desktop='RoundRectangle 8', Tablet='RoundRectangle 8'}"
                            Padding="{OnIdiom Default=24, Phone=0}"
                            WidthRequest="{OnIdiom Default=900, Tablet=800, Phone=-1}"
                            Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                            Grid.Row="0"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                            Margin="{OnIdiom Desktop='24,24,24,12', Phone='16,0', Tablet='24,8'}">
                        
                        <StackLayout>
                            <Label Text="Ratings and Reviews"
                                   Margin="{OnIdiom Default=0, Phone='0,24,16,0'}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                   FontFamily="Roboto-Medium"/>
                            
                            <BoxView Style="{DynamicResource HorizontalSeparatorStyle}"      
                                 Margin="{OnIdiom Default='0,24,0,12', Phone='0,10'}"/>

                            <Grid RowDefinitions="Auto,*"
                                  ColumnDefinitions="{OnIdiom Phone='*,90', Tablet='*,120', Desktop='*,140'}">

                                <!-- Header -->

                                <Grid Grid.Row="0"
                                      Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto">

                                    <Label Grid.Column="0"
                                           Text="Review Summary"
                                           FontSize="{OnIdiom Phone=20, Tablet=22, Desktop=24}"
                                           FontFamily="Roboto-Regular"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight},
                                                                      Dark={DynamicResource PrimaryTextColorDark}}" />

                                    <buttons:SfButton Grid.Column="1"
                                                    Text="Write a review"
                                                    Margin="{OnIdiom Desktop='0,0,12,0', Phone=0}"
                                                    FontSize="12"
                                                    FontFamily="Roboto-Medium"
                                                    WidthRequest="90"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Center"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    Background="Transparent"
                                                    Command="{Binding WriteReviewCommand}"
                                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight},
                                                                               Dark={DynamicResource PrimaryColorDark}}" />

                                </Grid>

                                <!-- Rating Distribution -->

                                <listView:SfListView Grid.Row="1"
                                                     Grid.Column="0"
                                                     ItemsSource="{Binding RatingInfo}"
                                                     ItemSize="34">

                                    <listView:SfListView.ItemTemplate>

                                        <DataTemplate x:DataType="local:RatingInfo">

                                            <Grid ColumnDefinitions="Auto,*">

                                                <Label Grid.Column="0"
                                                       Text="{Binding StarText}"
                                                       FontSize="12"
                                                       FontFamily="Roboto-Regular"
                                                       VerticalTextAlignment="Center"
                                                       TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight},
                                                                                  Dark={DynamicResource SecondaryTextColorDark}}" />

                                                <progressbar:SfLinearProgressBar Grid.Column="1"
                                                                                 Margin="16,0,0,0"
                                                     Progress="{Binding RatingValue}"
                                                     ProgressFill="{AppThemeBinding Light={DynamicResource PrimaryColorLight},
                                                                                  Dark={DynamicResource PrimaryColorDark}}"
                                                     TrackFill="{AppThemeBinding Light={DynamicResource ReceivedMessageColorLight},
                                                                             Dark={DynamicResource ReceivedMessageColorDark}}"
                                                     HeightRequest="4"
                                                     VerticalOptions="Center"/>

                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>

                                <!-- Overall Rating -->

                                <VerticalStackLayout Grid.Row="1"
                                                     Grid.Column="1"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Margin="{OnIdiom Default='32,0,0,0', Phone='16,0,0,0'}"
                                                     Spacing="12">

                                    <Label Text="3.9"
                                           HorizontalTextAlignment="Center"
                                           FontFamily="Roboto-Regular"
                                           FontSize="{OnIdiom Phone=32, Tablet=42, Desktop=56}"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight},
                                                                      Dark={DynamicResource PrimaryTextColorDark}}" />

                                    <HorizontalStackLayout HorizontalOptions="Center"
                                                           Spacing="1">

                                        <Label Text="&#xE71E;"
                                               FontFamily="UIKitIcons"
                                               TextColor="#FFBE52"/>

                                        <Label Text="&#xE71E;"
                                               FontFamily="UIKitIcons"
                                               TextColor="#FFBE52"/>

                                        <Label Text="&#xE71E;"
                                               FontFamily="UIKitIcons"
                                               TextColor="#FFBE52"/>

                                        <Label Text="&#xE71E;"
                                               FontFamily="UIKitIcons"
                                               TextColor="#FFBE52"/>

                                        <Label Text="&#xE71D;"
                                               FontFamily="UIKitIcons"
                                               TextColor="#787678"/>

                                    </HorizontalStackLayout>

                                    <Label Text="311 reviews"
                                           FontSize="{OnIdiom Default=14, Phone=12}"
                                           FontFamily="Roboto-Regular"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight},
                                                                      Dark={DynamicResource SecondaryTextColorDark}}" />

                                </VerticalStackLayout>

                            </Grid>
                        </StackLayout>
                    </Border>

                    <BoxView  HeightRequest="8"
                              Grid.Row="1"
                              IsVisible="{OnIdiom Phone='true', Default='false'}"
                              BackgroundColor="{AppThemeBinding Light={DynamicResource SentMessageColorLight}, Dark={DynamicResource SentMessageColorDark}}"/>

                    <Border WidthRequest="{OnIdiom Default=900, Tablet=800, Phone=-1}"
                            StrokeShape="{OnIdiom Desktop='RoundRectangle 8', Tablet='RoundRectangle 8'}"
                            Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                            Grid.Row="2"
                            Margin="{OnIdiom Desktop='24,0', Phone='0,0,0,8', Tablet='24,8'}"
                            BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">

                        <StackLayout x:Name="stacklayout"
                                     Spacing="0">
                            <Label Text="Reviews"
                                   FontFamily="Roboto-Medium"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                   Margin="{OnIdiom Desktop='24,24,0,12', Default='16,16,12,12'}"/>

                            <Grid RowDefinitions="Auto,*">
                                <VerticalStackLayout Spacing="16"
                                                     Grid.Row="0">

                                    <chip:SfChipGroup DisplayMemberPath="Text"
                                                      Margin="{OnIdiom Default='22,0,0,0', Phone='16,0,0,0'}">

                                        <chip:SfChip Text="All"
                                                     CornerRadius="31"
                                                     TextColor="White"
                                                     FontSize="14"
                                                     FontFamily="Roboto-Medium"
                                                     Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                     VerticalTextAlignment="Center"
                                                     HorizontalTextAlignment="Center"
                                                     Background="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"/>
                                        <chip:SfChip Text="Newest"
                                                     FontSize="14"
                                                     FontFamily="Roboto-Medium"
                                                     Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                     CornerRadius="30"/>
                                        <chip:SfChip Text="Highest"
                                                     FontSize="14"
                                                     FontFamily="Roboto-Medium"
                                                     Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                     CornerRadius="30"/>
                                        <chip:SfChip Text="Lowest"
                                                     FontSize="14"
                                                     FontFamily="Roboto-Medium"
                                                     Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                     CornerRadius="30"/>
                                    </chip:SfChipGroup>

                                </VerticalStackLayout>

                                <!--  List view to show the feedback given by the customers  -->
                                <listView:SfListView BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                                     Grid.Row="1"
                                                     AutoFitMode="DynamicHeight"
                                                     ScrollBarVisibility="Never"
                                                     IsScrollingEnabled="False"
                                                     ItemsSource="{Binding FeedbackInfo}"
                                                     SelectionBackground="Transparent"
                                                     VerticalOptions="Fill">

                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate x:DataType="model:Review">
                                            <Grid Margin="0,16,0,0"
                                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                                  ColumnDefinitions="Auto,*,Auto">

                                                <!-- Profile Image -->

                                                <Border Grid.Row="0"
                                                        Grid.Column="0"
                                                        Margin="{OnIdiom Desktop='24,0,12,0', Default='16,0,12,0'}"
                                                        BackgroundColor="{DynamicResource Gray-Bg}"
                                                        StrokeShape="RoundRectangle 24"
                                                        HeightRequest="40"
                                                        WidthRequest="40"
                                                        Style="{DynamicResource ProfileBorderStyle}"
                                                        VerticalOptions="Start">

                                                    <Image BackgroundColor="{DynamicResource Gray-200}">
                                                        <Image.Source>
                                                            <UriImageSource CacheValidity="14"
                                                                            CachingEnabled="true"
                                                                            Uri="{Binding CustomerImage}" />
                                                        </Image.Source>
                                                    </Image>
                                                </Border>

                                                <!-- Header -->

                                                <Grid Grid.Row="0"
                                                      Grid.Column="1"
                                                      ColumnDefinitions="*,Auto,Auto">

                                                    <VerticalStackLayout Spacing="2">

                                                        <Label Text="{Binding CustomerName}"
                                                               FontFamily="Roboto-Regular"
                                                               FontSize="16"
                                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                                        <Label Text="2 reviews"
                                                               FontFamily="Roboto-Regular"
                                                               FontSize="12"
                                                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}" />

                                                    </VerticalStackLayout>

                                                    <!-- Date -->
                                                    <HorizontalStackLayout Grid.Column="2"
                                                                           Margin="0,0,24,0">
                                                        <Border Padding="8,4"
                                                                VerticalOptions="Center"
                                                                StrokeThickness="1"
                                                                Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                                StrokeShape="RoundRectangle 8">

                                                            <Label Text="{Binding ReviewedDate}"
                                                                   FontFamily="Roboto-Medium"
                                                                   FontSize="11"
                                                                   HorizontalTextAlignment="Center"
                                                                   VerticalTextAlignment="Center"
                                                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                                        </Border>

                                                        <!-- More -->
                                                        <buttons:SfButton Background="Transparent"
                                                                         CornerRadius="4"
                                                                          HeightRequest="40"
                                                                          WidthRequest="20"
                                                                         TextColor="{DynamicResource Gray-700}">
                                                            <buttons:SfButton.Content>
                                                                <DataTemplate>
                                                                    <Label Text="&#xE719;"
                                                                           FontFamily="FontIcons"
                                                                           FontSize="12"
                                                                           HorizontalTextAlignment="Center"
                                                                           FontAttributes="Bold"
                                                                           VerticalOptions="Center"
                                                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" >
                                                                    </Label>
                                                                </DataTemplate>
                                                            </buttons:SfButton.Content>
                                                        </buttons:SfButton>
                                                    </HorizontalStackLayout>
                                                </Grid>

                                                <!-- Rating -->

                                                <HorizontalStackLayout Grid.Row="1"
                                                                       Grid.Column="0"
                                                                       Grid.ColumnSpan="3"
                                                                       Margin="{OnIdiom Default='24,10,0,0', Phone='16,10,0,0'}"
                                                                       Spacing="2">

                                                    <Label Text="&#xE71E;"
                                                            FontFamily="UIKitIcons"
                                                            TextColor="#FFBE52" />

                                                    <Label Text="&#xE71E;"
                                                           FontFamily="UIKitIcons"
                                                           TextColor="#FFBE52" />

                                                    <Label Text="&#xE71E;"
                                                           FontFamily="UIKitIcons"
                                                           TextColor="#FFBE52" />

                                                    <Label Text="&#xE71E;"
                                                           FontFamily="UIKitIcons"
                                                           TextColor="#FFBE52" />

                                                    <Label Text="&#xE71D;"
                                                           FontFamily="UIKitIcons"
                                                           TextColor="#787678" />

                                                    <Label Text="4/5"
                                                           Margin="4,0,0,0"
                                                           FontFamily="Roboto-Regular"
                                                           FontSize="12"
                                                           VerticalOptions="Center"
                                                           TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}" />

                                                </HorizontalStackLayout>

                                                <!-- Review Title -->

                                                <Label Grid.Row="2"
                                                       Grid.Column="0"
                                                       Grid.ColumnSpan="3"
                                                       Margin="{OnIdiom Default='24,12,24,0', Phone='16,12,16,0'}"
                                                       FontFamily="Roboto-Medium"
                                                       FontSize="16"
                                                       LineBreakMode="WordWrap"
                                                       Text="{Binding ReviewTitle}"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                                <!-- Review -->

                                                <Label Grid.Row="3"
                                                       Grid.Column="0"
                                                       Grid.ColumnSpan="3"
                                                       Margin="{OnIdiom Default='24,10,24,0', Phone='16,10,16,0'}"
                                                       CharacterSpacing="0.25"
                                                       FontFamily="Roboto-Regular"
                                                       FontSize="14"
                                                       LineHeight="1.3"
                                                       LineBreakMode="WordWrap"
                                                       Text="{Binding Comment}"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                                <!-- Images -->

                                                <listView:SfListView Grid.Row="4"
                                                                     Grid.Column="0"
                                                                     Grid.ColumnSpan="3"
                                                                     Margin="{OnIdiom Default='24,12,0,0', Phone='16,12,0,0'}"
                                                                     HeightRequest="70"
                                                                     ItemSpacing="0,0,4,0"
                                                                     IsScrollingEnabled="False"
                                                                     ItemSize="60"
                                                                     Orientation="Horizontal"
                                                                     ItemsSource="{Binding CustomerReviewImages}">

                                                    <listView:SfListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Stroke="Transparent"
                                                                    StrokeShape="RoundRectangle 8"
                                                                    HeightRequest="60"
                                                                    WidthRequest="60">

                                                                <Image Source="review3.png"
                                                                       Aspect="AspectFit" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </listView:SfListView.ItemTemplate>
                                                </listView:SfListView>

                                                <!-- Actions -->

                                                
                                            <HorizontalStackLayout Grid.Row="5"
                                                                   Grid.Column="0"
                                                                   Grid.ColumnSpan="3"
                                                                   Margin="{OnIdiom Default='24,12,0,0', Phone='16,12,0,0'}"
                                                                   Spacing="4">
                                                    <buttons:SfButton Background="Transparent"
                                                                      CornerRadius="4"
                                                                      Padding="8,0"
                                                                      Clicked="FavouriteButton_Clicked"
                                                                      TextColor="{DynamicResource Gray-700}">
                                                        <buttons:SfButton.Content>
                                                            <DataTemplate x:DataType="model:Review">
                                                                <HorizontalStackLayout Spacing="2">
                                                                    <Label Text="{Binding IsFavourite, Converter={StaticResource boolToStringConverter}, ConverterParameter=1}"
                                                                           TextColor="{Binding IsFavourite, Converter={StaticResource boolToColorConverter}, ConverterParameter=4}"
                                                                           FontFamily="FontIcons"
                                                                           FontSize="14"
                                                                           VerticalOptions="Center" />

                                                                    <Label Text="{Binding LikeCount}"
                                                                           FontFamily="Roboto-Regular"
                                                                           FontSize="12"
                                                                           VerticalOptions="Center"
                                                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />
                                                                </HorizontalStackLayout>
                                                            </DataTemplate>
                                                        </buttons:SfButton.Content>
                                                    </buttons:SfButton>


                                                    <buttons:SfButton Background="Transparent"
                                                                        CornerRadius="4"
                                                                        Padding="8,0"
                                                                        TextColor="{DynamicResource Gray-700}">
                                                        <buttons:SfButton.Content>
                                                            <DataTemplate>
                                                                <Label Text="&#xE704;"
                                                                       FontFamily="FontIcons"
                                                                       Margin="4,0,0,0"
                                                                       FontSize="14"
                                                                       VerticalOptions="Center"
                                                                       TextColor="#788396" />
                                                            </DataTemplate>
                                                        </buttons:SfButton.Content>
                                                    </buttons:SfButton>

                                                </HorizontalStackLayout>

                                                <!-- Divider -->

                                                <BoxView Grid.Row="6"
                                                         Grid.ColumnSpan="3"
                                                         Margin="{OnIdiom Default='24,16,24,0', Phone='16,16,16,0'}"
                                                         HeightRequest="1"
                                                         Style="{DynamicResource HorizontalSeparatorStyle}" />

                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </Grid>
                        </StackLayout>
                    </Border>
                </Grid>
            </StackLayout>
        </ScrollView>
    </ContentView.Content>
</ContentView>