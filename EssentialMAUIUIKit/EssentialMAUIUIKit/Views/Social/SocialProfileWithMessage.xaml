<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Social.SocialProfileWithMessage"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:model="clr-namespace:EssentialMAUIUIKit.Models"
             x:DataType="local:ProfileViewModel">
    <ContentView.BindingContext>
        <local:ProfileViewModel/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <Style TargetType="listView:ListViewItem">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Background"
                        Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Background"
                        Value= "Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>
    <ContentView.Content>
        <ScrollView VerticalScrollBarVisibility="Never">

            <Grid WidthRequest="{OnPlatform WinUI=650, MacCatalyst=650}"
                  ColumnSpacing="0"
                  RowDefinitions="240, *"
                  RowSpacing="0">

                <!-- Top profile header -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="Auto, *"
                    ColumnSpacing="0"
                    RowDefinitions="Auto, Auto, Auto, *"
                    RowSpacing="0">

                    <!-- Spacer column to push profile image to right on desktop/tablet; stacked centered on phone -->
                    <BoxView Grid.Row="0" Grid.Column="0" Color="Transparent"/>

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="16,30,16,10"
                        BackgroundColor="{DynamicResource Gray-White}"
                        Stroke="{DynamicResource Gray-White}"
                        StrokeThickness="2"
                        StrokeShape="{OnIdiom Desktop='RoundRectangle 10,10,10,10', Tablet='RoundRectangle 10,10,10,10', Phone='RoundRectangle 60,60,60,60'}"
                        HeightRequest="{OnIdiom Phone=74, Tablet=96, Desktop=96}"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        WidthRequest="{OnIdiom Phone=74, Tablet=96, Desktop=96}">

                        <!--  Profile image  -->
                        <Image Margin="-10"
                               Aspect="AspectFill"
                               HeightRequest="{OnIdiom Phone=74, Tablet=96, Desktop=96}"
                               WidthRequest="{OnIdiom Phone=74, Tablet=96, Desktop=96}"
                               HorizontalOptions="Center">
                            <Image.Source>
                                <UriImageSource
                                    CacheValidity="14"
                                    CachingEnabled="true"
                                    Uri="{Binding Profile.ProfileImage}"/>
                            </Image.Source>
                        </Image>

                    </Border>

                    <StackLayout
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalOptions="Center"
                        Margin="0,8,0,32"
                        Padding="0"
                        Spacing="0">

                        <!--  Profile name  -->
                        <Label
                            HeightRequest="24"
                            HorizontalOptions="Center" FontFamily="Roboto-Medium"
                            FontSize="{OnIdiom Phone=14, Tablet=14, Desktop=14}"
                            Style="{DynamicResource TitleLabelStyle}"
                            Text="{Binding Profile.ProfileName}"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"/>

                        <StackLayout
                            Margin="0,0,0,16"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            Orientation="Horizontal"
                            Spacing="5">

                            <!--  Designation  -->
                            <Label
                                FontSize="12"
                                VerticalOptions="Center"
                                Style="{DynamicResource DescriptionLabelStyle}"
                                Text="{Binding Profile.Designation}"/>

                            <BoxView HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Color="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                     Style="{DynamicResource VerticalSeparatorStyle}"/>

                            <!--  State and country  -->
                            <Label
                                FontSize="12"
                                VerticalOptions="Center"
                                Style="{DynamicResource DescriptionLabelStyle}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Profile.State}"/>
                                        <Span Text=" "/>
                                        <Span Text="{Binding Profile.Country}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </StackLayout>

                        <Grid
                            ColumnDefinitions="Auto, Auto, Auto, Auto, Auto"
                            ColumnSpacing="24"
                            RowDefinitions="Auto, Auto"
                            RowSpacing="0">

                            <!--  post count label  -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="16" FontFamily="Roboto-Medium"
                                Style="{DynamicResource TitleLabelStyle}"
                                Text="{Binding Profile.PostsCount}"/>

                            <!--  Post title label  -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                Style="{DynamicResource DescriptionLabelStyle}"
                                Text="Posts"/>

                            <BoxView
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                BackgroundColor="{DynamicResource Gray-400}"
                                HeightRequest="24"
                                HorizontalOptions="Center"
                                Style="{DynamicResource VerticalSeparatorStyle}"/>

                            <!--  Followers count label  -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="2"
                                FontSize="16" FontFamily="Roboto-Medium"
                                Style="{DynamicResource TitleLabelStyle}"
                                Text="{Binding Profile.FollowersCount}"/>

                            <!--  Followers title label  -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="2"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                Style="{DynamicResource DescriptionLabelStyle}"
                                Text="Followers"/>

                            <BoxView
                                Grid.RowSpan="2"
                                Grid.Column="3"
                                BackgroundColor="{DynamicResource Gray-400}"
                                HeightRequest="24"
                                HorizontalOptions="Center"
                                Style="{DynamicResource VerticalSeparatorStyle}"/>

                            <!--  Following count label  -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="4"
                                FontSize="16" FontFamily="Roboto-Medium"
                                HorizontalOptions="Center"
                                Style="{DynamicResource TitleLabelStyle}"
                                Text="{Binding Profile.FollowingCount}"/>

                            <!--  Following title label  -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="4"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                Style="{DynamicResource DescriptionLabelStyle}"
                                Text="Following"/>

                        </Grid>

                    </StackLayout>

                </Grid>

                <!-- Bottom content panel: 7 rows for About, About text, action buttons, Connections title, Connections list, TabView, Pictures grid -->
                <Grid
                    Grid.Row="1"
                    ColumnSpacing="0"
                    RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                    RowSpacing="0">

                    <!--  About title  -->
                    <Label
                        Grid.Row="0"
                        Margin="{OnIdiom Phone='16,4,16,8', Desktop='16,24,16,8', Tablet='16,24,16,8'}"
                        FontSize="14" FontFamily="Roboto-Medium"
                        HorizontalOptions="Start"
                        Style="{DynamicResource TitleLabelStyle}"
                        Text="About"/>

                    <!--  About  -->
                    <Label
                        Grid.Row="1"
                        Margin="16,0,16,24"
                        FontFamily="Roboto-Regular"
                        FontSize="12"
                        HorizontalOptions="Start"
                        HorizontalTextAlignment="Start"
                        LineHeight="{OnPlatform Default=-1, Android=1.5}"
                        Text="{Binding Profile.About}"
                        TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"/>

                    <Grid Grid.Row="2"
                          Margin="16,0,16,24" HorizontalOptions="Center"
                          ColumnDefinitions="Auto, Auto"
                          ColumnSpacing="12">

                        <!--  Follow button  -->
                        <buttons:SfButton Grid.Column="0"
                            CornerRadius="20"
                            FontSize="14"
                            Stroke="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                            StrokeThickness="2"
                            FontFamily="Roboto-Medium"
                            Background="Transparent"
                            Text="Follow" WidthRequest="{OnIdiom Phone=170, Tablet=271, Desktop=191}"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}">
                        </buttons:SfButton>

                        <!--  Message button  -->
                        <buttons:SfButton Grid.Column="1"
                            CornerRadius="20"
                            FontSize="14"
                            Stroke="#E5E1E3"
                            StrokeThickness="2"
                            Background="Transparent"
                            FontFamily="Roboto-Medium"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                            Text="Message" WidthRequest="{OnIdiom Phone=170, Tablet=271, Desktop=191}"/>

                    </Grid>

                    <!--  Connections title  -->
                    <Label
                        Grid.Row="3"
                        Margin="16,0"
                        FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=16}"
                        HorizontalOptions="Start"
                        Style="{DynamicResource TitleLabelStyle}"
                        Text="{OnIdiom Phone='Connections', Desktop='Highlights'}" FontFamily="Roboto-Medium"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"/>

                    <listView:SfListView Grid.Row="4"
                                         Margin="16,8,16,0"
                                         Padding="0"
                                         AutoFitMode="DynamicHeight"
                                         HeightRequest="140"
                                         HorizontalOptions="Fill"
                                         ScrollBarVisibility="Never"
                                         IsStickyHeader="False"
                                         ItemSpacing="0"
                                         ItemsSource="{Binding Profile.Connections}"
                                         Orientation="Horizontal"
                                         SelectionBackground="Transparent"
                                         VerticalOptions="Start">


                        <listView:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="model:Connection">
                                <StackLayout Margin="4,16,4,0" Spacing="0">
                                    <syncEffectsView:SfEffectsView TouchDownEffects="Ripple" RippleBackground="{DynamicResource Gray-300}">
                                        <Border
                                        Margin="0,0,0,4"
                                        StrokeThickness="4"
                                        StrokeShape="RoundRectangle 35"
                                        HeightRequest="64"
                                        HorizontalOptions="Center"
                                        WidthRequest="64">

                                            <Image
                                            Aspect="AspectFill"
                                            BackgroundColor="{DynamicResource Gray-200}"
                                            HeightRequest="56"
                                            HorizontalOptions="Center"
                                            WidthRequest="56">
                                                <Image.Source>
                                                    <UriImageSource
                                                    CacheValidity="14"
                                                    CachingEnabled="true"
                                                    Uri="{Binding ImagePath}"/>
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                    </syncEffectsView:SfEffectsView>

                                    <!--  Profile name  -->
                                    <Label
                                        FontFamily="Roboto-Regular"
                                        FontSize="12"
                                        Margin="0,4,0,0"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        LineHeight="{OnPlatform Default=-1}"
                                        Text="{Binding Name}"
                                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                        VerticalOptions="Center"/>

                                </StackLayout>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>

                    </listView:SfListView>

                    <!--  Photos tab icons (image-only headers)  -->
                    <tabView:SfTabView Grid.Row="5"
                                       HeightRequest="48" 
                                       Margin="{OnIdiom Phone='0,0,16,0', Desktop='20,0,16,0', Tablet='20,0,16,0'}"
                                       TabWidthMode="Default"
                                       HorizontalOptions="Start"
                                       HeaderDisplayMode="Image"
                                       IndicatorWidthMode="Stretch"
                                       SelectedIndex="0" WidthRequest="{OnIdiom Phone=400, Desktop=610, Tablet=596}"
                                       BackgroundColor="Transparent">
                        <tabView:SfTabItem ImageSource="photo.png" />
                        <tabView:SfTabItem ImageSource="video.png" />
                        <tabView:SfTabItem ImageSource="heart.png" />
                    </tabView:SfTabView>

                    <listView:SfListView
                        x:Name="listView"
                        Grid.Row="6"
                        Margin="{OnIdiom Phone='0,0,0,0', Desktop='14,0,16,16', Tablet='14,0,16,16'}"
                        AutoFitMode="Height"
                        ScrollBarVisibility="Never"
                        IsScrollingEnabled="False"
                        ItemSpacing="{OnIdiom Phone='1', Tablet='0,0,0,0', Desktop='2,0,0,2'}"
                        ItemsSource="{Binding Profile.Pictures}"
                        SelectionBackground="Transparent">

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="model:Picture">
                                <syncEffectsView:SfEffectsView TouchDownEffects="Ripple" RippleBackground="{DynamicResource Gray-300}">
                                    <Grid>
                                        <Border HeightRequest="{OnIdiom Phone=185, Tablet=177, Desktop=177}"
                                            WidthRequest="{OnIdiom Phone=204, Tablet=208, Desktop=208}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 0">
                                            <!--  Photos  -->
                                            <Image
                                            Aspect="AspectFill"
                                            BackgroundColor="{DynamicResource Gray-200}">
                                                <Image.Source>
                                                    <UriImageSource
                                                    CacheValidity="14"
                                                    CachingEnabled="true"
                                                    Uri="{Binding ImagePath}"/>
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                    </Grid>
                                </syncEffectsView:SfEffectsView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>

                        <listView:SfListView.ItemsLayout>
                            <listView:GridLayout SpanCount="{OnPlatform Default=3, Android=2, iOS=2}"/>
                        </listView:SfListView.ItemsLayout>

                    </listView:SfListView>
                </Grid>
            </Grid>
        </ScrollView>
    </ContentView.Content>
</ContentView>
