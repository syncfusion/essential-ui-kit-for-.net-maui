<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Social.SocialProfileWithInterest"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:model="clr-namespace:EssentialMAUIUIKit.Models"
             x:DataType="local:ProfileViewModel">
    <ContentView.BindingContext>
        <local:ProfileViewModel/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <Style TargetType="listView:ListViewItem">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Background"
                        Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Background"
                        Value= "Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>
    <ContentView.Content>
        <ScrollView VerticalScrollBarVisibility="Never">
            <Grid RowDefinitions="Auto, Auto" WidthRequest="{OnPlatform WinUI=650, MacCatalyst=650}" HorizontalOptions="Fill">

                <!-- Header image -->
                <Image
                    Grid.Row="0"
                    x:Name="ProfileImage"
                    Aspect="AspectFill"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                    HeightRequest="196"
                    HorizontalOptions="Fill"
                    Source="{Binding Profile.HeaderImagePath}"/>

                <!-- Content panel: profile, name, designation, about, buttons, interests, photos -->
                <Grid Grid.Row="1"
                      Padding="16,16,16,0"
                      BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                      RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
                      RowSpacing="12">

                    <!-- Profile image + name + designation row -->
                    <Grid Grid.Row="0"
                          RowDefinitions="Auto, Auto, Auto"
                          RowSpacing="4">

                        <Border Grid.Row="0"
                            Margin="0,-57,0,0"
                            BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                            Stroke="{DynamicResource Gray-White}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 60,60,60,60"
                            HeightRequest="{OnIdiom Phone=78, Tablet=108, Desktop=108}"
                            HorizontalOptions="Start"
                            WidthRequest="{OnIdiom Phone=78, Tablet=108, Desktop=108}">
                            <!--  Profile image  -->
                            <Image
                               x:Name="picture"
                               Aspect="AspectFit"
                               BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                               HeightRequest="{OnIdiom Phone=74, Tablet=104, Desktop=104}"
                               Source="{Binding Profile.ProfileImage}"
                               WidthRequest="{OnIdiom Phone=74, Tablet=104, Desktop=104}"/>
                        </Border>

                        <Label
                            Grid.Row="1"
                            FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=16}"
                            HorizontalOptions="Start" FontFamily="Roboto-Medium"
                            HorizontalTextAlignment="Start"
                            Style="{DynamicResource TitleLabelStyle}"
                            Text="{Binding Profile.ProfileName}"/>

                        <StackLayout
                            Grid.Row="2"
                            Margin="0"
                            HorizontalOptions="Start"
                            Orientation="Horizontal"
                            Spacing="5">

                            <!--  Designation label  -->
                            <Label
                                FontSize="12"
                                Style="{DynamicResource DescriptionLabelStyle}"
                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                Text="{Binding Profile.Designation}"/>

                            <BoxView HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Color="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                     Style="{DynamicResource VerticalSeparatorStyle}"/>

                            <!--  State and country label  -->
                            <Label FontSize="12"
                                   VerticalOptions="Center"
                                   Style="{DynamicResource DescriptionLabelStyle}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Profile.State}"
                                              TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                              FontFamily="Roboto-Regular"/>
                                        <Span Text=" "/>
                                        <Span Text="{Binding Profile.Country}"
                                              TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                              FontFamily="Roboto-Regular"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </StackLayout>
                    </Grid>

                    <!--  About description label  -->
                    <Label
                       Grid.Row="1"
                       FontSize="12"
                       FontFamily="Roboto-Regular"
                       HorizontalOptions="Start"
                       HorizontalTextAlignment="Start"
                       Style="{DynamicResource TitleLabelStyle}"
                       Text="{Binding Profile.About}"
                       TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"/>

                    <!-- Follow + Message buttons row -->
                    <StackLayout
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalOptions="{OnIdiom Desktop=Start, Tablet=Start, Phone=Center}"
                        Spacing="12">

                        <!--  Follow button  -->
                        <buttons:SfButton
                            CornerRadius="20"
                            FontSize="14"
                            Stroke="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                            StrokeThickness="2" ImageSize="14"
                            FontFamily="Roboto-Medium" ShowIcon="True" HorizontalTextAlignment="Start"
                            Text="Follow" ImageAlignment="Default" TextColor="White"
                            WidthRequest="{OnIdiom Phone=168, Tablet=240, Desktop=180}">
                            <buttons:SfButton.ImageSource>
                                <FontImageSource
                                    FontFamily="MaterialAssets"
                                    Glyph="&#xe70d;"
                                    Color="White"
                                    Size="20"/>
                            </buttons:SfButton.ImageSource>
                        </buttons:SfButton>

                        <!--  Message button  -->
                        <buttons:SfButton
                            CornerRadius="20"
                            FontSize="14"
                            Stroke="#E5E1E3"
                            StrokeThickness="2" ImageSize="14"
                            Background="Transparent"
                            FontFamily="Roboto-Medium" ShowIcon="True" HorizontalTextAlignment="Start"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                            Text="Message" ImageAlignment="Default"
                            WidthRequest="{OnIdiom Phone=168, Tablet=240, Desktop=180}">
                            <buttons:SfButton.ImageSource>
                                <FontImageSource
                                    FontFamily="MaterialAssets"
                                    Glyph="&#xe784;"
                                    Color="Black"
                                    Size="20"/>
                            </buttons:SfButton.ImageSource>
                        </buttons:SfButton>

                    </StackLayout>

                    <!-- Interest section: title + horizontal list -->
                    <Grid Grid.Row="3"
                          RowDefinitions="Auto, Auto"
                          RowSpacing="10" Padding="0,10,0,0">

                        <!--  Interest title label  -->
                        <Label Grid.Row="0"
                           FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=16}"
                           HorizontalOptions="Start"
                           HorizontalTextAlignment="Start"
                           Style="{DynamicResource TitleLabelStyle}"
                           Text="Interests" FontFamily="Roboto-Medium"
                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"/>

                        <listView:SfListView Grid.Row="1"
                            Padding="0"
                            AutoFitMode="DynamicHeight"
                            HeightRequest="100"
                            HorizontalOptions="Fill"
                            ScrollBarVisibility="Never"
                            ItemSpacing="0"
                            ItemsSource="{Binding Profile.Interests}"
                            Orientation="Horizontal"
                            SelectionBackground="Transparent">

                            <listView:SfListView.ItemTemplate>
                                <DataTemplate x:DataType="model:Interest">
                                    <StackLayout Margin="8,0,8,0" Spacing="4">
                                        <syncEffectsView:SfEffectsView TouchDownEffects="Ripple" RippleBackground="{DynamicResource Gray-300}">
                                            <Border
                                            Margin="0,0,0,4"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 35,35,35,35"
                                            HeightRequest="56"
                                            HorizontalOptions="Center"
                                            WidthRequest="56">

                                                <Image
                                                Aspect="AspectFill"
                                                BackgroundColor="{DynamicResource Gray-200}"
                                                HeightRequest="56"
                                                HorizontalOptions="Center"
                                                WidthRequest="56">
                                                    <Image.Source>
                                                        <UriImageSource
                                                        CacheValidity="14"
                                                        CachingEnabled="true"
                                                        Uri="{Binding ImagePath}"/>
                                                    </Image.Source>
                                                </Image>
                                            </Border>
                                        </syncEffectsView:SfEffectsView>

                                        <!--  Profile name  -->
                                        <Label
                                            FontFamily="Roboto-Regular"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            LineHeight="{OnPlatform Default=-1}"
                                            Text="{Binding Name}"
                                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                            VerticalOptions="Center"/>

                                    </StackLayout>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>
                    </Grid>

                    <!-- Photos section: title + grid -->
                    <Grid Grid.Row="4"
                          RowDefinitions="Auto, Auto"
                          RowSpacing="8">

                        <!--  Photo title label  -->
                        <Label Grid.Row="0"
                           Margin="{OnIdiom Phone='0,0,0,10',  Tablet='0,0,0,12', Desktop='0,0,0,12'}"
                           FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=16}"
                           HorizontalOptions="Start"
                           HorizontalTextAlignment="Start"
                           Style="{DynamicResource TitleLabelStyle}"
                           Text="Photos &amp; Videos" FontFamily="Roboto-Medium"
                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"/>

                        <listView:SfListView Grid.Row="1"
                            x:Name="listView"
                            AutoFitMode="Height"
                            ScrollBarVisibility="Never"
                            IsScrollingEnabled="False"
                            Margin="{OnIdiom Phone='0,0,0,0', Tablet='0,0,0,0', Desktop='0,0,0,0'}"
                            ItemSpacing="{OnIdiom Phone='0,0,0,12', Tablet='0,0,0,8', Desktop='0,0,0,8'}"
                            ItemsSource="{Binding Profile.Pictures}"
                            SelectionBackground="Transparent">
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate x:DataType="model:Picture">
                                    <syncEffectsView:SfEffectsView TouchDownEffects="Ripple" RippleBackground="{DynamicResource Gray-300}">
                                        <Grid>
                                            <Border HeightRequest="{OnIdiom Desktop=177, Phone=165, Tablet=165}"
                                            WidthRequest="{OnIdiom Phone=170, Tablet=198, Desktop=198}"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0">
                                                <!--  Photos  -->
                                                <Image
                                                Aspect="AspectFill"
                                                BackgroundColor="{DynamicResource Gray-200}">
                                                    <Image.Source>
                                                        <UriImageSource
                                                    CacheValidity="14"
                                                    CachingEnabled="true"
                                                    Uri="{Binding ImagePath}"/>
                                                    </Image.Source>
                                                </Image>
                                            </Border>
                                        </Grid>
                                    </syncEffectsView:SfEffectsView>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>

                            <listView:SfListView.ItemsLayout>
                                <listView:GridLayout SpanCount="{OnPlatform Default=3, Android=2, iOS=2}"/>
                            </listView:SfListView.ItemsLayout>

                        </listView:SfListView>
                    </Grid>

                </Grid>
            </Grid>
        </ScrollView>
    </ContentView.Content>
</ContentView>
