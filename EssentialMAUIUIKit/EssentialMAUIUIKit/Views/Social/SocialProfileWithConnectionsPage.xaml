<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Social.SocialProfileWithConnectionsPage"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:model="clr-namespace:EssentialMAUIUIKit.Models"
             x:DataType="local:ProfileViewModel">
    <ContentView.BindingContext>
        <local:ProfileViewModel/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <Style TargetType="listView:ListViewItem">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Background" Value= "Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>
    <ContentView.Content>
        <ScrollView VerticalScrollBarVisibility="Never">

            <Grid Margin="0,16,0,0" WidthRequest="{OnPlatform WinUI=650, MacCatalyst=650}"
                  RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                  RowSpacing="0"
                  HorizontalOptions="Fill">

                <!-- Header row: profile image + stats (uses natural flow instead of negative margins) -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto, *"
                      ColumnSpacing="28"
                      Margin="16,0,16,12">

                    <Border Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 60,60,60,60"
                            HeightRequest="{OnIdiom Phone=72, Tablet=72, Desktop=72}"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="{OnIdiom Phone=72, Tablet=72, Desktop=72}">

                        <!--  Profile image  -->
                        <Image Aspect="AspectFill"
                               BackgroundColor="{DynamicResource Gray-200}"
                               HeightRequest="{OnIdiom Phone=72, Tablet=72, Desktop=72}"
                               WidthRequest="{OnIdiom Phone=72, Tablet=72, Desktop=72}">
                            <Image.Source>
                                <UriImageSource
                                    CacheValidity="14"
                                    CachingEnabled="true"
                                    Uri="{Binding Profile.ProfileImage}"/>
                            </Image.Source>
                        </Image>
                    </Border>

                    <Grid Grid.Column="1"
                          VerticalOptions="Center"
                          ColumnDefinitions="Auto, Auto, Auto"
                          ColumnSpacing="40"
                          RowDefinitions="Auto, Auto"
                          RowSpacing="4">

                        <!--  post count label  -->
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               HorizontalOptions="Center"
                               Style="{DynamicResource TitleLabelStyle}"
                               Text="{Binding Profile.PostsCount}"/>

                        <!--  Post title label  -->
                        <Label Grid.Row="1"
                               Grid.Column="0"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                               Style="{DynamicResource DescriptionLabelStyle}"
                               Text="Posts"/>

                        <!--  Followers count label  -->
                        <Label Grid.Row="0"
                               Grid.Column="1"
                               HorizontalOptions="Center"
                               Style="{DynamicResource TitleLabelStyle}"
                               Text="{Binding Profile.FollowersCount}"/>

                        <!--  Followers title label  -->
                        <Label Grid.Row="1"
                               Grid.Column="1"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                               Style="{DynamicResource DescriptionLabelStyle}"
                               Text="Followers"/>

                        <!--  Following count label  -->
                        <Label Grid.Row="0"
                               Grid.Column="2"
                               HorizontalOptions="Center"
                               Style="{DynamicResource TitleLabelStyle}"
                               Text="{Binding Profile.FollowingCount}"/>

                        <!--  Following title label  -->
                        <Label Grid.Row="1"
                               Grid.Column="2"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                               Style="{DynamicResource DescriptionLabelStyle}"
                               Text="Following"/>

                    </Grid>
                </Grid>

                <!-- Profile name + designation row -->
                <StackLayout Grid.Row="1" Margin="{OnIdiom Phone='16,0,16,14', Desktop='16,0,16,4', Tablet='16,0,16,4'}">
                    <!--  Profile name  -->
                    <Label FontFamily="Roboto-Medium"
                           FontSize="14"
                           HorizontalOptions="Start"
                           LineHeight="{OnPlatform Default=-1, Android=1.5}"
                           Text="{Binding Profile.ProfileName}"
                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"/>

                    <StackLayout Margin="0,4,0,0"
                                 HorizontalOptions="Start"
                                 Orientation="Horizontal"
                                 Spacing="5">

                        <!--  Designation label  -->
                        <Label FontSize="12"
                               Style="{DynamicResource DescriptionLabelStyle}"
                               Text="{Binding Profile.Designation}"
                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"/>

                        <BoxView HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Color="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                 Style="{DynamicResource VerticalSeparatorStyle}"/>

                        <!--  State and country label  -->
                        <Label FontSize="12"
                               VerticalOptions="Center"
                               Style="{DynamicResource DescriptionLabelStyle}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Profile.State}"
                                          TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                          FontFamily="Roboto-Regular"/>
                                    <Span Text=" "/>
                                    <Span Text="{Binding Profile.Country}"
                                          TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                          FontFamily="Roboto-Regular"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </StackLayout>
                </StackLayout>

                <!--  About description label  -->
                <Label Grid.Row="2"
                       Margin="16,0,16,16"
                       FontFamily="Roboto-Regular"
                       FontSize="12"
                       HorizontalOptions="Start"
                       HorizontalTextAlignment="Start"
                       LineHeight="{OnPlatform Default=-1, Android=1.3}"
                       Text="{Binding Profile.About}"
                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"/>

                <!-- Action buttons row: uses flexible sizing instead of oversized fixed widths -->
                <Grid Grid.Row="3"
                      Margin="16,0,16,0"
                      ColumnDefinitions="*, *"
                      ColumnSpacing="{OnIdiom Phone=13, Desktop=24, Tablet=24}">

                    <buttons:SfButton Grid.Column="0"
                                      Text="Edit Profile"
                                      Stroke="#E5E1E3"
                                      StrokeThickness="2"
                                      Background="Transparent"
                                      FontFamily="Roboto-Medium"
                                      TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                      HorizontalOptions="Fill"/>
                    <buttons:SfButton Grid.Column="1"
                                      Text="Share Profile"
                                      Stroke="#E5E1E3"
                                      StrokeThickness="2"
                                      Background="Transparent"
                                      FontFamily="Roboto-Medium"
                                      TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                      HorizontalOptions="Fill"/>
                </Grid>

                <!--  Connection title label  -->
                <Label Grid.Row="4"
                       Margin="16,18,0,0"
                       FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=16}"
                       HorizontalOptions="Start" FontFamily="Roboto-Medium"
                       Style="{DynamicResource TitleLabelStyle}"
                       Text="Connections"/>

                <Grid Grid.Row="5" ColumnDefinitions="Auto,*">

                    <buttons:SfButton Margin="16,16,10,0"
                                      Padding="16"
                                      Background="{AppThemeBinding Light=#FCF8FA, Dark=#313032}"
                                      CornerRadius="32"
                                      FontFamily="FontIcons"
                                      FontAttributes="Bold"
                                      FontSize="20"
                                      HeightRequest="56"
                                      HorizontalOptions="Start"
                                      Text="{DynamicResource Add}"
                                      HorizontalTextAlignment="Center"
                                      VerticalTextAlignment="Center"
                                      TextColor="{AppThemeBinding Light=#C9C6C8, Dark=#5F5E60}"
                                      VerticalOptions="Start"
                                      WidthRequest="56"/>

                    <listView:SfListView Grid.Column="1"
                                         Margin="0,0,0,18"
                                         Padding="0"
                                         AutoFitMode="DynamicHeight"
                                         HeightRequest="110"
                                         HorizontalOptions="Fill"
                                         ScrollBarVisibility="Never"
                                         IsStickyHeader="False"
                                         ItemSpacing="0"
                                         ItemsSource="{Binding Profile.Connections}"
                                         Orientation="Horizontal"
                                         SelectionBackground="Transparent"
                                         VerticalOptions="Start">

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="model:Connection">
                                <StackLayout Margin="4,16,4,0" Spacing="0">

                                    <syncEffectsView:SfEffectsView TouchDownEffects="Ripple" RippleBackground="{DynamicResource Gray-300}">
                                        <Border Margin="0,0,0,4"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 35,35,35,35"
                                                HeightRequest="56"
                                                HorizontalOptions="Center"
                                                WidthRequest="56">

                                            <Image Aspect="AspectFill"
                                                   BackgroundColor="{DynamicResource Gray-200}"
                                                   HeightRequest="56"
                                                   HorizontalOptions="Center"
                                                   WidthRequest="56">
                                                <Image.Source>
                                                    <UriImageSource
                                                        CacheValidity="14"
                                                        CachingEnabled="true"
                                                        Uri="{Binding ImagePath}"/>
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                    </syncEffectsView:SfEffectsView>

                                    <!--Profile name-->
                                    <Label FontFamily="Roboto-Regular"
                                           FontSize="12"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineHeight="{OnPlatform Default=-1}"
                                           Text="{Binding Name}"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                           VerticalOptions="Center"/>
                                </StackLayout>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                    </listView:SfListView>
                </Grid>

                <!--  Photo title label  -->
                <Label Grid.Row="6"
                       Margin="16,0,0,10"
                       FontSize="{OnIdiom Phone=14, Tablet=16, Desktop=16}"
                       HorizontalOptions="Start" FontFamily="Roboto-Medium"
                       Style="{DynamicResource TitleLabelStyle}"
                       Text="Photos &amp; Videos"/>

                <listView:SfListView x:Name="listView"
                                     Grid.Row="7"
                                     Grid.ColumnSpan="2"
                                     Margin="{OnIdiom Phone='10,0,10,16', Tablet='0,0,0,0', Desktop='0,0,0,0'}"
                                     AutoFitMode="Height"
                                     ScrollBarVisibility="Never"
                                     IsScrollingEnabled="False"
                                     ItemSpacing="{OnIdiom Phone='0,8,0,8', Tablet='0,0,0,0', Desktop='0,0,0,8'}"
                                     ItemsSource="{Binding Profile.Pictures}"
                                     SelectionBackground="Transparent">
                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="model:Picture">
                            <syncEffectsView:SfEffectsView TouchDownEffects="Ripple" RippleBackground="{DynamicResource Gray-300}">
                                <Grid>
                                    <!--Photos-->
                                    <Border HeightRequest="{OnIdiom Desktop=177, Phone=165, Tablet=208}"
                                        WidthRequest="{OnIdiom Desktop=208, Phone=170, Tablet=208}"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0">
                                        <Image Aspect="AspectFill"
                                           BackgroundColor="{DynamicResource Gray-200}">
                                            <Image.Source>
                                                <UriImageSource
                                                CacheValidity="14"
                                                CachingEnabled="true"
                                                Uri="{Binding ImagePath}"/>
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                </Grid>
                            </syncEffectsView:SfEffectsView>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                    <listView:SfListView.ItemsLayout>
                        <listView:GridLayout SpanCount="{OnPlatform Default=3, Android=2, iOS=2}"/>
                    </listView:SfListView.ItemsLayout>
                </listView:SfListView>
            </Grid>
        </ScrollView>
    </ContentView.Content>
</ContentView>
