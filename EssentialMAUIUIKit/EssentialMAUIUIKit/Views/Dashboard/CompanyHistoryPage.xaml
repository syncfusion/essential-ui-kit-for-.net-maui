<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Dashboard.CompanyHistoryPage"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters;assembly=EssentialMAUIUIKit"
             x:DataType="local:CompanyHistoryViewModel"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:models="clr-namespace:EssentialMAUIUIKit.Models.Dashboard;assembly=EssentialMAUIUIKit">

    <ContentView.BindingContext>
        <local:CompanyHistoryViewModel/>
    </ContentView.BindingContext>

    <ContentView.Resources>
        <converter:IndexToBooleanConverter x:Key="IndexToBooleanConverter"/>
    </ContentView.Resources>

    <ScrollView Orientation="Vertical"
                VerticalScrollBarVisibility="Never"
                HorizontalScrollBarVisibility="Never">

        <Grid RowDefinitions="Auto,*" Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">

            <Grid Grid.Row="0" HeightRequest="{OnPlatform WinUI=60,MacCatalyst=60,iOS=60,Android=60}"
              Padding="0,10,24,10"
              IsVisible="{OnIdiom Phone=False,Tablet=True,Desktop=True}">

                <Image Source="{Binding CompanyLogo}"
                   HeightRequest="30"
                   WidthRequest="30"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   Margin="{OnIdiom Tablet='28,0,0,0', Desktop='24,0,0,0'}"/>

                <!-- Notification Bell Icon with Badge -->

                <syncfusion:SfBadgeView HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    Margin="0,0,67,0"
                                    IsVisible="{OnIdiom Phone=False,Tablet=True,Desktop=True}">
                    <syncfusion:SfBadgeView.Content>
                        <Label Text="&#xe708;" FontSize="18"
                           FontFamily="DashboardFontIcons"
                           HeightRequest="16"
                           WidthRequest="16"/>
                    </syncfusion:SfBadgeView.Content>

                </syncfusion:SfBadgeView>

                <!-- Profile Image Avatar -->

                <syncfusion:SfAvatarView ContentType="Custom"
                                     AvatarSize="Medium"
                                     AvatarShape="Circle"
                                     ImageSource="{Binding ProfileImage}"
                                     HorizontalOptions="End"
                                     Background="Transparent"
                                     Margin="0"
                                     IsVisible="{OnIdiom Phone=False,Tablet=True,Desktop=True}"/>
            </Grid>

            <BoxView HeightRequest="1" Margin="0,60,0,0" IsVisible="{OnIdiom Phone=False, Default=True, Tablet=True}"
                 Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                 HorizontalOptions="Fill"/>
            <Grid Grid.Row="1" RowDefinitions="*"
              VerticalOptions="Fill"
              ColumnDefinitions="*" Margin="{OnIdiom Desktop='10,0,24,0', Phone='16,0,0,0',Tablet='32,0,32,0'}"
              HorizontalOptions="Fill" >

                <Grid ColumnDefinitions="{OnIdiom Desktop='257,1,*', Tablet='50,1,*',Phone='Auto,360,*'}" RowDefinitions="*"
                      VerticalOptions="Fill"
                      Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">
                    <Grid Grid.Column="0">
                        <!-- Desktop (WinUI/Mac) -->
                        <Grid WidthRequest="{OnPlatform WinUI=257,MacCatalyst=257,iOS=250}"
                              HorizontalOptions="Start"
                              VerticalOptions="Fill"
                              IsVisible="{OnIdiom Desktop=True,Phone=False,Tablet=False}">

                            <CollectionView ItemsSource="{Binding MenuItemList}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10" Stroke="Transparent">
                                            <Label x:DataType="models:CompanyHistoryMenuItem"
                                                   Text="{Binding Name}"
                                                   FontFamily="Roboto-Regular"
                                                   FontSize="16"
                                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center"
                                                   Margin="{OnPlatform WinUI='5,0,5,5', iOS='20,0,0,0', MacCatalyst='8,0,5,0'}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource PrimaryFormsColor}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>

                        <!-- Tablet -->
                        <Grid HorizontalOptions="Start"
                              VerticalOptions="Start"
                              IsVisible="{OnIdiom Tablet=True,Desktop=False,Phone=False}">

                            <CollectionView Margin="0"
                                            ItemsSource="{Binding MenuItemList}"
                                            SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="24" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CompanyHistoryMenuItem">

                                        <Grid HeightRequest="64" WidthRequest="72" HorizontalOptions="Center">
                                            <Label Text="{Binding IconGlyph}"
                                                   FontFamily="MaterialAssets"
                                                   FontSize="24"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="TextColor" Value="#7633DA" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Grid>

                    <BoxView Grid.Column="1" WidthRequest="1" Margin="0" HorizontalOptions="Fill" VerticalOptions="Fill" Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" IsVisible="{OnIdiom Phone=False, Default=True}"/>
                    <Grid Grid.Column="{OnIdiom Desktop=2, Phone=1,Tablet=2}"
                          Grid.Row="0"
                          VerticalOptions="{OnPlatform WinUI=FillAndExpand, Android=Start, iOS=Start, MacCatalyst=Start}">
                        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,*" VerticalOptions="Fill"
                              Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">
                            <Grid Grid.Row="0"
                                  Margin="{OnIdiom Phone='16,0', Default='24,0,24,0'}"
                                  HeightRequest="72"
                                  Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">
                                <HorizontalStackLayout Grid.Column="0" Margin="{x:OnIdiom Phone='0', Desktop=0,Tablet=0}"
                                                       HorizontalOptions="Start"
                                                       HeightRequest="{OnPlatform WinUI=28, MacCatalyst=28}"
                                                       VerticalOptions="Center">
                                    <Label Text="{Binding PageTitle}"
                                           FontSize="{OnPlatform WinUI='22', MacCatalyst='22',Android='16', iOS='16'}"
                                           FontFamily="{OnPlatform WinUI='Roboto-Regular', Android='Roboto-Medium', iOS='Roboto-Medium'}"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                           VerticalOptions="Start"/>
                                </HorizontalStackLayout>
                            </Grid>
                            <BoxView Grid.Row="1" HeightRequest="1" HorizontalOptions="Fill" Margin="30,-10,10,0"  Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" VerticalOptions="Start" IsVisible="{OnIdiom Phone=False,Tablet=True,Desktop=True}"/>
                            <Grid Grid.Row="2"
                                  VerticalOptions="Start"
                                  HorizontalOptions="Fill"
                                  Margin="{OnIdiom Desktop='24,20,24,0',Tablet='32,32,16,50', Phone='16,0,0,0'}">
                                <Label Text="{Binding PageDescription}"
                                       TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                       FontFamily="Roboto-Regular"
                                       FontSize="16"
                                       LineBreakMode="WordWrap"
                                       HorizontalTextAlignment="Start"/>
                            </Grid>

                            <Grid Grid.Row="3"
                                  VerticalOptions="Fill"
                                  HorizontalOptions="Fill" Padding="-18,0,-18,0"
                                  Margin="{OnIdiom Phone='20,20,0,0', Desktop=20, Tablet=20}">
                                <BoxView WidthRequest="2" Color="#7633DA" Margin="10" HeightRequest="560" IsVisible="{OnIdiom Desktop=True,Phone=False,Tablet=True}" HorizontalOptions="Center" VerticalOptions="Fill"/>
                                <CollectionView ItemsSource="{Binding CompanyHistoryDetails}" IsVisible="{OnIdiom Phone=False, Desktop=True, Tablet=True}" VerticalOptions="Fill" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:CompanyHistoryData">
                                            <Grid WidthRequest="600" ColumnDefinitions="224,152,224" Padding="0,10">
                                                <!-- LEFT CARD -->
                                                <Border Grid.Column="0"
                                                        WidthRequest="224" 
                                                        MinimumHeightRequest="120"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="Fill"
                                                        Background="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}"
                                                        StrokeThickness="0">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding Index, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=Even}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible" Value="False"/>
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="3"/>
                                                    </Border.StrokeShape>
                                                    <VerticalStackLayout Padding="12" Spacing="8">
                                                        <Label Text="{Binding Year}"
                                                               FontSize="14"
                                                               FontAttributes="Bold" FontFamily="Roboto-Regular"
                                                               TextColor="White"/>
                                                        <Label Text="{Binding Achievements}"
                                                               FontSize="14"
                                                               TextColor="White" FontFamily="Roboto-Regular"
                                                               LineBreakMode="WordWrap"/>
                                                    </VerticalStackLayout>
                                                </Border>
                                                <!-- CENTER -->
                                                <Grid Grid.Column="1">
                                                    <!-- VERTICAL TIMELINE SEGMENT (hidden on the last item so the line ends at the final dot) -->
                                                    <BoxView WidthRequest="2"
                                                             Color="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}"
                                                             HorizontalOptions="Center"
                                                             VerticalOptions="Fill"
                                                             IsVisible="{Binding IsLastItem, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=NotLast}">
                                                    </BoxView>
                                                    <!-- LEFT CONNECTOR -->
                                                    <BoxView WidthRequest="76"
                                                             HeightRequest="2"
                                                             Color="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}"
                                                             HorizontalOptions="Start"
                                                             VerticalOptions="Center">
                                                        <BoxView.Triggers>
                                                            <DataTrigger TargetType="BoxView"
                                                                         Binding="{Binding Index, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=Even}"
                                                                         Value="True">
                                                                <Setter Property="IsVisible" Value="False"/>
                                                            </DataTrigger>
                                                        </BoxView.Triggers>
                                                    </BoxView>
                                                    <!-- RIGHT CONNECTOR -->
                                                    <BoxView WidthRequest="76"
                                                             HeightRequest="2"
                                                             Color="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}"
                                                             HorizontalOptions="End"
                                                             VerticalOptions="Center">
                                                        <BoxView.Triggers>
                                                            <DataTrigger TargetType="BoxView"
                                                                         Binding="{Binding Index, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=Even}"
                                                                         Value="False">
                                                                <Setter Property="IsVisible" Value="False"/>
                                                            </DataTrigger>
                                                        </BoxView.Triggers>
                                                    </BoxView>
                                                    <!-- DOT -->
                                                    <Border WidthRequest="12"
                                                            HeightRequest="12"
                                                            BackgroundColor="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center"
                                                            StrokeThickness="0"
                                                            ZIndex="10">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="20"/>
                                                        </Border.StrokeShape>
                                                    </Border>
                                                </Grid>
                                                <!-- RIGHT CARD -->
                                                <Border Grid.Column="2"
                                                        WidthRequest="224"
                                                        MinimumHeightRequest="120"
                                                        HorizontalOptions="Start"
                                                        VerticalOptions="Fill"
                                                        Background="{AppThemeBinding Light=#F4EBFA, Dark=#35303C}"
                                                        StrokeThickness="0">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding Index, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=Even}"  Value="False">
                                                            <Setter Property="IsVisible" Value="False"/>
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="3"/>
                                                    </Border.StrokeShape>
                                                    <VerticalStackLayout Padding="12" Spacing="8">
                                                        <Label Text="{Binding Year}"
                                                               FontSize="14"
                                                               FontAttributes="Bold" FontFamily="Roboto-Regular"
                                                               TextColor="{AppThemeBinding Light=#313032 , Dark=#FFFFFF}"/>
                                                        <Label Text="{Binding Achievements}"
                                                               FontSize="14" FontFamily="Roboto-Regular"
                                                               TextColor="{AppThemeBinding Light=#313032 , Dark=#FFFFFF}"
                                                               LineBreakMode="WordWrap"/>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <!--Mobile view -->
                                <CollectionView ItemsSource="{Binding CompanyHistoryDetails}" VerticalOptions="Fill" SelectionMode="None" IsVisible="{OnIdiom Phone=True,Desktop=False, Tablet=False}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:CompanyHistoryData">
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="30">
                                                <!-- LEFT ITEM -->
                                                <AbsoluteLayout HeightRequest="136" Padding="10" IsVisible="{Binding Index, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=Odd}">
                                                    <!-- Card -->
                                                    <Border MinimumWidthRequest="224"
                                                            HorizontalOptions="Start" IsVisible="{Binding Index, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=Odd}"
                                                            Margin="5,10,10,10" AbsoluteLayout.LayoutBounds="0,-20,224,-1"
                                                            AbsoluteLayout.LayoutFlags="None"
                                                            Background="#7633DA" Stroke="Transparent"
                                                            Padding="12">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="2"/>
                                                        </Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="5">
                                                            <Label Text="{Binding Year}"
                                                                   TextColor="White"
                                                                   FontAttributes="Bold"
                                                                   FontSize="14"/>
                                                            <Label Text="{Binding Achievements}"
                                                                   TextColor="White"
                                                                   FontSize="12"
                                                                   LineBreakMode="WordWrap"/>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <!-- Connector -->
                                                    <Path Stroke="#7633DA"
                                                          StrokeThickness="2" Margin="30,0"
                                                          AbsoluteLayout.LayoutBounds="0,0,400,400"
                                                          AbsoluteLayout.LayoutFlags="None"
                                                          HorizontalOptions="Fill">
                                                        <Path.Data>
                                                            <PathGeometry>
                                                                <PathFigure StartPoint="180,40">
                                                                    <!-- Short horizontal -->
                                                                    <LineSegment Point="255,40"/>
                                                                    <!-- Rounded corner -->
                                                                    <ArcSegment Point="260,45" Size="5,5" SweepDirection="Clockwise"/>
                                                                    <!-- Tall vertical -->
                                                                    <LineSegment Point="260,200"/>
                                                                </PathFigure>
                                                            </PathGeometry>
                                                        </Path.Data>
                                                    </Path>
                                                </AbsoluteLayout>
                                                <!-- RIGHT ITEM -->
                                                <AbsoluteLayout
                                                                Grid.ColumnSpan="3" Padding="0"
                                                                HeightRequest="136" 
                                                                IsVisible="{Binding Index, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=Even}">
                                                    <!-- Connector -->
                                                    <Path
                                                        AbsoluteLayout.LayoutBounds="0,-20,220,224"
                                                        AbsoluteLayout.LayoutFlags="None" Margin="60,0"
                                                        IsVisible="{Binding Index, Converter={StaticResource IndexToBooleanConverter},ConverterParameter=NotLast:4}"
                                                        Stroke="#7633DA"
                                                        StrokeThickness="2">    
                                                        <Path.Data>
                                                            <PathGeometry>
                                                                <!--Start from left-middle of card-->
                                                                <PathFigure StartPoint="20,210">
                                                                    <LineSegment Point="20,73"/>
                                                                    <ArcSegment Point="25,68" Size="5,5" SweepDirection="Clockwise"/>
                                                                    <LineSegment Point="120,68"/>
                                                                </PathFigure>
                                                            </PathGeometry>
                                                        </Path.Data>
                                                    </Path>
                                                    <!-- Card -->
                                                    <Border
                                                            WidthRequest="224"
                                                            MinimumHeightRequest="136"
                                                            Background="#F4EBFA"
                                                            Stroke="Transparent"
                                                            Padding="14,22" 
                                                            AbsoluteLayout.LayoutBounds="{OnPlatform Android='110,0,240,-1',iOS='140,0,240,-1'}"
                                                            AbsoluteLayout.LayoutFlags="None">                              
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="2"/>
                                                        </Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="5">
                                                            <Label Text="{Binding Year}"
                                                                   TextColor="#444"
                                                                   FontAttributes="Bold"
                                                                   FontSize="14"/>
                                                            <Label Text="{Binding Achievements}"
                                                                   TextColor="#444"
                                                                   FontSize="12"
                                                                   LineBreakMode="WordWrap"/>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </AbsoluteLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollView>
</ContentView>
