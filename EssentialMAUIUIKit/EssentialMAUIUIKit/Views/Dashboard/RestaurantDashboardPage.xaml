<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Dashboard.RestaurantDashboardPage"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:DataType="local:RestaurantDashboardViewModel"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core">
    <ContentView.BindingContext>
        <local:RestaurantDashboardViewModel/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <ResourceDictionary>
            <converter:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>

            <Style x:Key="NavButtonStyle" TargetType="buttons:SfButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Background" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>

            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <ScrollView>
            <StackLayout>
                <Grid HeightRequest="{OnPlatform WinUI=60, MacCatalyst=60}"
                      IsVisible="{OnPlatform Android=False, iOS=False}"
                      ColumnDefinitions="Auto,*,Auto,Auto"
                      Margin="0,0,30,0"
                      ColumnSpacing="0">

                    <Label Grid.Column="0"
                           Text="{Binding DashboardTitle}"
                           FontSize="22"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           TextColor="{StaticResource PrimaryFormsColor}"
                           FontFamily="Righteous"
                           Margin="{OnPlatform WinUI='24,0,0,0', MacCatalyst='24,0,0,0'}"/>

                    <!-- Notification Icon -->
                    <Border Grid.Column="2"
                            WidthRequest="40"
                            HeightRequest="40"
                            StrokeShape="RoundRectangle 50"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">
                        <buttons:SfButton Style="{StaticResource NavButtonStyle}">
                            <buttons:SfButton.Content>
                                <DataTemplate>
                                    <Label Text="&#xE700;"
                                           FontFamily="UIKitIcons"
                                           VerticalOptions="Center"
                                           FontSize="20"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           HeightRequest="22"
                                           WidthRequest="22" />
                                </DataTemplate>
                            </buttons:SfButton.Content>
                            
                        </buttons:SfButton>
                    </Border>

                    <!-- Profile Image Avatar -->
                    <Border Grid.Column="3"
                            Padding="0,6,0,6"
                            BackgroundColor="Transparent"
                            StrokeThickness="0" x:Name="ProfileAvatarBorder">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ProfileButton_Tapped" />
                        </Border.GestureRecognizers>
                        <syncfusion:SfAvatarView ContentType="Custom"
                                                   ImageSource="{Binding ProfileImage}"
                                                   AvatarShape="Circle"
                                                   AvatarSize="Small"/>
                         
                    </Border>
                </Grid>
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                         HorizontalOptions="Fill"/>
                <Grid RowDefinitions="{OnPlatform WinUI='*', MacCatalyst='*'}"
                      VerticalOptions="Start"
                      ColumnDefinitions="*"
                      HorizontalOptions="Fill"
                      MaximumHeightRequest="{OnPlatform WinUI=769, MacCatalyst=769}">
                    <Grid ColumnDefinitions="{OnPlatform WinUI='Auto,Auto,*', MacCatalyst='Auto,Auto,*', Default={OnIdiom Desktop='Auto,Auto,*', Tablet='*', Phone='*'}}"
                          RowDefinitions="*"
                          VerticalOptions="Start">
                        <!-- First Layout with Width 257 and Height 769 - Desktop Only (WinUI + MacCatalyst + Desktop Idiom) -->
                        <Grid Grid.Column="0"
                              VerticalOptions="Start"
                              WidthRequest="{OnPlatform WinUI=257, MacCatalyst=257, Default={OnIdiom Desktop=257}}"
                              HorizontalOptions="Start"
                              IsVisible="{OnPlatform Android=False, iOS=False, Default={OnIdiom Desktop=True, Tablet=False, Phone=False}}">
                            <VerticalStackLayout x:Name="MenuListContainer">
                                <CollectionView ItemsSource="{Binding MenuItemList}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Menu Item Container with Hover Effect -->
                                            <Border x:DataType="local:RestaurantDashboardMenuItem"
                                                    Padding="0"
                                                    HeightRequest="48"
                                                    Stroke="Transparent"
                                                    StrokeThickness="0"
                                                    x:Name="MenuItemBorder">
                                                <Border.GestureRecognizers>
                                                    <PointerGestureRecognizer 
                                                        PointerEntered="OnMenuItemPointerEntered"
                                                        PointerExited="OnMenuItemPointerExited"/>
                                                </Border.GestureRecognizers>
                                                
                                                <Grid ColumnDefinitions="*"
                                                      RowDefinitions="*"
                                                      Padding="0"
                                                      HorizontalOptions="Fill"
                                                      VerticalOptions="Fill">
                                                    
                                                    <!-- Hover Overlay Background -->
                                                    <BoxView 
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Color="{AppThemeBinding Light=#D0D0D0, Dark=#505050}"
                                                        Opacity="{Binding IsHovered, Converter={StaticResource BoolToOpacityConverter}}"
                                                        x:Name="HoverOverlay"
                                                        HorizontalOptions="Fill"
                                                        VerticalOptions="Fill"/>
                                                    
                                                    <!-- Selected Indicator (Left Border) -->
                                                    <BoxView 
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        WidthRequest="4"
                                                        Color="{StaticResource PrimaryFormsColor}"
                                                        HorizontalOptions="Start"
                                                        VerticalOptions="Fill"
                                                        IsVisible="{Binding IsSelected}"/>
                                                    
                                                    <!-- Menu Item Text -->
                                                    <Label 
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Text="{Binding Name}"
                                                        FontSize="14"
                                                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight},
                                                                                    Dark={DynamicResource PrimaryTextColorDark}}"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="Start"
                                                        Margin="16,0,0,0"
                                                        FontFamily="Roboto-Regular"
                                                        x:Name="MenuLabel">
                                                        
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding IsSelected}"
                                                                         Value="True">
                                                                <Setter Property="TextColor"
                                                                        Value="{StaticResource PrimaryFormsColor}" />
                                                                <Setter Property="FontFamily"
                                                                        Value="Roboto-Medium" />
                                                                <Setter Property="FontAttributes"
                                                                        Value="Bold" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Grid.Column="1"
                                 WidthRequest="1"
                                 Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Fill"
                                 IsVisible="{OnPlatform Android=False, iOS=False, Default={OnIdiom Desktop=True, Tablet=False, Phone=False}}"/>
                        <!-- Second Layout with Width 631 and Height 769 -->
                        <Grid Grid.Column="{OnPlatform WinUI='2', MacCatalyst='2', Default={OnIdiom Desktop='2', Tablet='0', Phone='0'}}"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                              VerticalOptions="Start"
                              HorizontalOptions="Fill"
                              Margin="{OnPlatform WinUI='0,24,0,0', MacCatalyst='0,24,0,16', Android='4,16,16,16', iOS='4,16,16,16'}">
                            
                                <CollectionView Grid.Row="0"
                                            ItemsSource="{Binding CurrentWeekSummary}"
                                            HorizontalScrollBarVisibility="{OnPlatform WinUI=Never, MacCatalyst=Never}"
                                            VerticalScrollBarVisibility="Default"
                                            Margin="{OnPlatform WinUI='16,0,0,0', MacCatalyst='16,0,0,0', Android='12,0,0,0', iOS='12,0,0,0'}">
                                    <CollectionView.ItemsLayout>
                                        <OnPlatform x:TypeArguments="ItemsLayout">
                                            <On Platform="Android">
                                                <LinearItemsLayout Orientation="Vertical"
                                                               ItemSpacing="16"/>
                                            </On>
                                            <On Platform="iOS">
                                                <LinearItemsLayout Orientation="Vertical"
                                                               ItemSpacing="16"/>
                                            </On>
                                            <On Platform="WinUI">
                                                <LinearItemsLayout Orientation="Horizontal"
                                                               ItemSpacing="10"/>
                                            </On>
                                            <On Platform="MacCatalyst">
                                                <LinearItemsLayout Orientation="Horizontal"
                                                               ItemSpacing="10"/>
                                            </On>
                                        </OnPlatform>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                        <Grid>
                                            <cards:SfCardView
                                                    CornerRadius="4"
                                                    BorderWidth="0"
                                                    Margin="4"
                                                    WidthRequest="{OnPlatform WinUI=282, MacCatalyst=282}"
                                                    HeightRequest="{OnPlatform WinUI=145, MacCatalyst=145, Android=135, iOS=135}"
                                                    Background="{AppThemeBinding Light=#FFFFFF,Dark=#1C1B1D}">

                                                <cards:SfCardView.Shadow>
                                                    <Shadow Brush="#000000"
                                                        Offset="0,1"
                                                        Radius="3"
                                                        Opacity="0.15"/>
                                                </cards:SfCardView.Shadow>


                                                <Grid x:DataType="local:RevenueSummary" Margin="16">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- Title -->
                                                    <Grid Grid.Row="0"
                                                          HorizontalOptions="Fill"
                                                          ColumnDefinitions="*,*">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding SummaryTitle}"
                                                               FontSize="16"
                                                               TextColor="{AppThemeBinding Light=#5F5E60,Dark=#929092}"
                                                               FontFamily="Roboto-Regular"
                                                               HorizontalOptions="Start"
                                                               VerticalOptions="Start"/>
                                                        <Border Grid.Column="1"
                                                                Stroke="Transparent"
                                                                HeightRequest="32"
                                                                WidthRequest="32"
                                                            VerticalOptions="Start"
                                                                Background="{Binding IconBackground}"
                                                                HorizontalOptions="End">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="4"/>
                                                            </Border.StrokeShape>
                                                            <Label FontFamily="DashboardFontIcons"
                                                                   Margin="{OnPlatform WinUI='3,4,0,0', MacCatalyst='3,4,0,0',Android='2,4,0,0', iOS='2,4,0,0'}"
                                                                   Text="{Binding SummaryIcon}"
                                                                   TextColor="{Binding IconColor}"
                                                                   WidthRequest="18"
                                                                   HeightRequest="18"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Current Week value Value -->
                                                    <Label Grid.Row="1"
                                                        Text="{Binding CurrentWeekValue}"
                                                        FontSize="22"
                                                        FontAttributes="Bold"
                                                        TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}"
                                                        FontFamily="Roboto-Medium"
                                                        VerticalOptions="Start"/>

                                                    <!-- Differnce comparing past week -->
                                                    <HorizontalStackLayout Grid.Row="2"
                                                                           Padding="0,8,0,0">
                                                        <Label Text="{Binding DifferenceValue}"
                                                               FontSize="16"
                                                               TextColor="{AppThemeBinding Light=#3CB053, Dark=#3CB053}"
                                                               FontFamily="Roboto-Regular"
                                                               VerticalOptions="Center"/>
                                                        <Label Text="{Binding DifferenceDescription}"
                                                               FontSize="16"
                                                               TextColor="{AppThemeBinding Light=#5F5E60,Dark=#929092}"
                                                               FontFamily="Roboto-Regular"
                                                               VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </cards:SfCardView>
                                        </Grid>
                                    </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            <Label Grid.Row="1"
                                   Text="Orders list"
                                   FontFamily="Roboto-Medium"
                                   FontSize="{OnPlatform WinUI=22, MacCatalyst=22, Android=16, iOS=16}"
                                   Margin="{OnPlatform WinUI='32,30,0,16', MacCatalyst='32,30,0,16', Android='16,40,0,12', iOS='16,40,0,12'}"/>
                            <BoxView Grid.Row="2"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Start"
                                     HeightRequest="1"
                                     Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"/>
                            <Grid Grid.Row="3"
                                  ColumnDefinitions="{OnPlatform WinUI='1.5*,2*,2*,2*,1*', MacCatalyst='1.5*,2*,2*,2*,1*', Default={OnIdiom Desktop='1.5*,2*,2*,2*,1*', Tablet='1.5*,2*,2*,2*,1*', Phone='2*,1.5*,1*'}}"
                                  HorizontalOptions="Fill"
                                  Margin="0,24,0,8">
                                <Label Grid.Column="0"
                                       Text="{Binding OrderDetailsHeader[0]}"
                                       FontFamily="Roboto-Medium"
                                       FontSize="14"
                                       HorizontalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="{Binding OrderDetailsHeader[1]}"
                                       FontFamily="Roboto-Medium"
                                       FontSize="14"
                                       HorizontalOptions="Start"/>
                                <Label Grid.Column="2"
                                       Text="{Binding OrderDetailsHeader[2]}"
                                       FontFamily="Roboto-Medium"
                                       FontSize="14"
                                       HorizontalOptions="Start"
                                       IsVisible="{OnPlatform Android=False, iOS=False, Default={OnIdiom Desktop=True, Tablet=True, Phone=False}}"/>
                                <Label Grid.Column="3"
                                       Text="{Binding OrderDetailsHeader[3]}"
                                       FontFamily="Roboto-Medium"
                                       FontSize="14"
                                       HorizontalOptions="Start"
                                       IsVisible="{OnPlatform Android=False, iOS=False, Default={OnIdiom Desktop=True, Tablet=True, Phone=False}}"/>
                                <Label Grid.Column="4"
                                       Text="{Binding OrderDetailsHeader[4]}"
                                       FontFamily="Roboto-Medium"
                                       FontSize="14"
                                       HorizontalOptions="Start"/>
                            </Grid>
                            <BoxView Grid.Row="4"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Start"
                                     HeightRequest="1"
                                     Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"/>
                            <Grid Grid.Row="5"
                                  ColumnDefinitions="*"
                                  VerticalOptions="Fill"
                                  Margin="0,8,0,0">
                                <CollectionView ItemsSource="{Binding OrderDetails}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:DataType="local:RestaurantOrder"
                                                  ColumnDefinitions="{OnPlatform WinUI='1.5*,2*,2*,2*,1*', MacCatalyst='1.5*,2*,2*,2*,1*', Default={OnIdiom Desktop='1.5*,2*,2*,2*,1*', Tablet='1.5*,2*,2*,2*,1*', Phone='2*,1.5*,1*'}}"
                                                  HeightRequest="46">
                                                <Label Grid.Column="0"
                                                       Text="{Binding OrderID}"
                                                       FontFamily="Roboto-Regular"
                                                       FontSize="14"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                                <Label Grid.Column="1"
                                                       Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}"
                                                       FontFamily="Roboto-Regular"
                                                       FontSize="14"
                                                       HorizontalOptions="Start"
                                                       VerticalOptions="Center"/>
                                                <Label Grid.Column="2"
                                                       Text="{Binding PaymentMode}"
                                                       FontFamily="Roboto-Regular"
                                                       FontSize="14"
                                                       HorizontalOptions="Start"
                                                       VerticalOptions="Center"
                                                       IsVisible="{OnPlatform Android=False, iOS=False, Default={OnIdiom Desktop=True, Tablet=True, Phone=False}}"/>
                                                <Label Grid.Column="3"
                                                       Text="{Binding Status}"
                                                       FontFamily="Roboto-Regular"
                                                       FontSize="14"
                                                       HorizontalOptions="Start"
                                                       VerticalOptions="Center"
                                                       TextColor="{Binding StatusColor}"
                                                       IsVisible="{OnPlatform Android=False, iOS=False, Default={OnIdiom Desktop=True, Tablet=True, Phone=False}}"/>
                                                
                                                    <buttons:SfButton Grid.Column="4" HeightRequest="32" WidthRequest="64" 
                                                                      HorizontalOptions="Start"
                                                                      CornerRadius="50"
                                                                      Background="{AppThemeBinding Light=#F0E8F8, Dark=White}"
                                                                      VerticalOptions="Center">
                                                    <buttons:SfButton.Content>
                                                        <DataTemplate>
                                                            <Label Text="View"
                                                                   Margin="{OnPlatform WinUI='0,0,0,8', MacCatalyst='0,0,0,8'}"
                                                               FontFamily="Roboto-Medium"
                                                               FontSize="14"
                                                               TextColor="#7633DA"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalTextAlignment="Center">

                                                            </Label>
                                                        </DataTemplate>
                                                    </buttons:SfButton.Content>
                                                        
                                                    </buttons:SfButton>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </StackLayout>
        </ScrollView>
    </ContentView.Content>
</ContentView>
                    