<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Dashboard.HealthCarePage"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:controls="clr-namespace:EssentialMAUIUIKit.Controls"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:segmentedControl="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
             xmlns:picker="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
             xmlns:gauge="clr-namespace:Syncfusion.Maui.Gauges;assembly=Syncfusion.Maui.Gauges">
    <ContentView.BindingContext>
        <local:HealthCareViewModel/>
    </ContentView.BindingContext>
    <ContentView.Content>
        <StackLayout>
            <Grid HeightRequest="60" Padding="24,16" IsVisible="{OnIdiom Default=True, Phone=False}">
                <Label Text="Health Care" FontSize="22" VerticalOptions="Center" HorizontalOptions="Start" TextColor="{StaticResource PrimaryFormsColor}" FontFamily="Righteous"/>

                <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                    <!-- Notification Bell Icon with Badge -->
                    <Grid HeightRequest="42" WidthRequest="42">
                        <syncfusion:SfBadgeView HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{OnIdiom Default=True, Phone=False}">
                            <syncfusion:SfBadgeView.Content>
                                <Label Text="&#xe708;" FontFamily="DashboardFontIcons" FontSize="20"/>
                            </syncfusion:SfBadgeView.Content>
                        </syncfusion:SfBadgeView>
                    </Grid>
                    <!-- Profile Image Avatar -->
                    <syncfusion:SfAvatarView ContentType="Custom" AvatarSize="Small" AvatarShape="Circle" x:DataType="local:HealthCareViewModel" ImageSource="{Binding ProfileImage}" HorizontalOptions="End" IsVisible="{OnIdiom Default=True, Phone=False}"/>
                </HorizontalStackLayout>
            </Grid>
            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" HorizontalOptions="Fill" />
            <Grid RowDefinitions="{OnIdiom Desktop='Auto', Tablet='Auto'}" VerticalOptions="{OnPlatform Default= 'FillAndExpand'}" ColumnDefinitions="*" HorizontalOptions="Fill" Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">
                <ScrollView Grid.Row="{OnIdiom Desktop='0', Tablet='0'}">
                    <Grid x:Name="mainGrid" ColumnDefinitions="{OnIdiom Desktop='Auto, Auto, 5*, 3*', Tablet='Auto, Auto, 5*, 3*'}" RowDefinitions="*,*" VerticalOptions="Fill">
                        <!-- First Layout with Width 257 and Height 769 -->
                        <Grid Grid.Column="0" VerticalOptions="Start" HorizontalOptions="Start" WidthRequest="200" IsVisible="{OnIdiom Default=True, Phone=False, Tablet=False}">
                            <VerticalStackLayout>
                                <CollectionView x:DataType="local:HealthCareViewModel" ItemsSource="{Binding MenuItemList}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10" StrokeThickness="0">
                                                <!-- Menu Item Text -->
                                                <Label x:DataType="local:HealthCareMenuItem" Text="{Binding Name}" FontSize="16" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" VerticalOptions="Center" Margin="0,0,5,0">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource PrimaryFormsColor}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Grid>
                        <Grid Grid.Column="0" Padding="21,34" IsVisible="{OnIdiom Default=False, Tablet= True}">
                            <VerticalStackLayout Spacing="50">
                                <Label Text="&#xe714;" FontFamily="UIKitIcons" FontSize="26" TextColor="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}"/>
                                <Label Text="&#xe729;" FontFamily="UIKitIcons" FontSize="26"/>
                                <Label Text="&#xe71f;" FontFamily="UIKitIcons" FontSize="26"/>
                                <Label Text="&#xe71b;" FontFamily="MaterialAssets" FontSize="26"/>
                                <Label Text="&#xe716;" FontFamily="MaterialAssets" FontSize="26"/>
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Grid.Column="1" Grid.Row="0" WidthRequest="2" Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" HorizontalOptions="Start" VerticalOptions="Fill" IsVisible="{OnIdiom Default=True, Phone=False}"/>
                        <BoxView x:Name="borderLine" Grid.Column="1" Grid.Row="1" WidthRequest="2" Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" HorizontalOptions="Start" VerticalOptions="Fill" IsVisible="{OnIdiom Phone=False, Default=True}"/>
                        <!-- Second Layout with Width 631 and Height 769 -->
                        <Grid  ColumnDefinitions="Auto,*" Grid.Column="{OnIdiom Desktop='2', Tablet ='2'}" Grid.Row="{OnPlatform Android='0',iOS='0'}" VerticalOptions="{OnIdiom Desktop=FillAndExpand, Phone=Start}" IsVisible="{OnIdiom Default=True, Phone=False}">
                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="{OnIdiom Desktop='10,0', Tablet='10,0', Default='0,0'}" IsVisible="{OnIdiom Default=True, Phone=False}" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">
                                <Grid Grid.Row="0" RowDefinitions="Auto,*" VerticalOptions="Start">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="{OnIdiom Phone='16,24', Default='22,24'}" HeightRequest="{OnIdiom Desktop=60, Tablet=60}" IsVisible="{OnIdiom Default=True, Phone=False}">
                                        <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Start" HeightRequest="{OnIdiom Desktop=28}" VerticalOptions="Center">
                                            <Label Text="Daily Tracker" FontSize="22" FontFamily="Roboto-Medium" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" VerticalOptions="Start"/>
                                        </HorizontalStackLayout>
                                        <Grid  x:Name="pickerGrid" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                                            <Border Stroke="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource GrayBorderBackgroundColor}}" HeightRequest="40" WidthRequest="145"  Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource GrayBorderBackgroundColor}}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="20"/>
                                                </Border.StrokeShape>
                                                <Border.Shadow>
                                                    <Shadow Brush="#000000" Offset="0,2" Opacity="0.3" Radius="3" />
                                                </Border.Shadow>
                                                <Grid Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <!--DatePicker control-->
                                                    <picker:SfDatePicker RelativeView="{x:Reference pickerGrid}" x:Name="datePicker" Mode="RelativeDialog" TextDisplayMode="Fade" MinimumDate="2000/01/01" MaximumDate="2050/12/31" RelativePosition="AlignBottom" SelectionChanged="OnDatePickerSelectionChanged" Opacity="0"/>
                                                    <Label x:Name="dateLabel" Text="{Binding Source={x:Reference datePicker}, Path=SelectedDate, StringFormat='{0:dd MMM, yyyy}' }" FontFamily="Roboto-Medium" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="DatePicker_Tapped"/>
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                    <!--Datepicker Icon-->
                                                    <Label Grid.Column="1" FontFamily="DashboardFontIcons" Text="&#xe711;" HorizontalOptions="End" VerticalOptions="Center" IsVisible="{OnPlatform WinUI=True}"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    <Grid x:DataType="local:HealthCareViewModel" Grid.Row="1" VerticalOptions="Fill">
                                        <chart:SfCircularChart>
                                            <!-- Series Definition -->
                                            <chart:SfCircularChart.Series>
                                                <chart:DoughnutSeries  x:Name="doughnutSeries" ItemsSource="{Binding CaloriesChartDataValue.CaloriesConsumedInADay}" XBindingPath="Nutrient" YBindingPath="Value" InnerRadius ="0.75" PaletteBrushes="{Binding CaloriesChartDataValue.SegmentColors}" ShowDataLabels="False" StrokeWidth="5"  
                                                    Stroke="{AppThemeBinding Dark={DynamicResource BackgroundColorDark}, Light={DynamicResource BackgroundColorLight}}">
                                                </chart:DoughnutSeries>
                                            </chart:SfCircularChart.Series>
                                        </chart:SfCircularChart>
                                        <Grid RowDefinitions="*,*">
                                            <Label Grid.Row="0" Text="{Binding CaloriesChartDataValue.TotalCaloriesInADay}" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" FontFamily="Roboto-Medium" FontSize="22" VerticalOptions="End" HorizontalOptions="Center" />
                                            <Label Grid.Row="1" Text="Calories Consumed" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" FontFamily="Roboto-Regular" FontSize="14" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,8,0,0" />
                                        </Grid>

                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="1" Margin="-10,0,-10,0">
                                    <BoxView HeightRequest="8"  Color="{AppThemeBinding Light={DynamicResource SentMessageColorLight}, Dark={DynamicResource SentMessageColorDark}}" IsVisible="{OnIdiom Default=True, Phone=False}"/>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid Padding="0" RowDefinitions="Auto,Auto">
                                        <CollectionView x:DataType="local:HealthCareViewModel" ItemsSource="{Binding CaloriesConsumedList}">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackLayout x:DataType="local:CaloriesConsumedData" IsVisible ="{Binding IsSelected}" HorizontalOptions="Start">
                                                        <syncfusion:SfChipGroup ItemsSource="{Binding CaloriesConsumedPerMeal}" SelectedItem="{Binding CaloriesConsumedPerMeal[0],Mode=OneTime}" SelectionChanged="OnChipSelectionChanging"  ChipType="Choice" ChipCornerRadius="25" Margin="{OnPlatform Default='6,16,0,0', MacCatalyst='0,32,0,0'}" HorizontalOptions="Start" ChipStroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"  ChipFontFamily="Roboto-Medium" ChipTextColor="{AppThemeBinding Light={DynamicResource BackgroundColorDark}, Dark={DynamicResource BackgroundColorLight}}" SelectedChipBackground="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}" SelectedChipTextColor="{DynamicResource BackgroundColorLight}" >
                                                            <syncfusion:SfChipGroup.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid x:DataType="local:MealCalorieConsumed" HeightRequest="32" >
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Label Grid.Column="0" FontFamily="DashboardFontIcons" Text="{Binding MealIcon}" TextColor="{Binding MealIconColor}" HorizontalOptions="Start" FontSize="20" Margin="10,6,0,0" />
                                                                        <!-- Chip Text -->
                                                                        <Label Grid.Column="1" Text="{Binding MealTime}" FontFamily="Roboto-Medium" TextColor="{Binding MealFontColor}" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start" Margin="10,0" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </syncfusion:SfChipGroup.ItemTemplate>
                                                        </syncfusion:SfChipGroup>
                                                    </StackLayout>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                        <CollectionView x:DataType="local:HealthCareViewModel" ItemsSource="{Binding CaloriesChartDataValue.SelectedMealDetails, Mode=TwoWay}" SelectionMode="None" Grid.Row="1" WidthRequest="{OnIdiom Desktop=530}">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid HorizontalOptions="Fill" RowSpacing="32" ColumnSpacing="32" Padding="50,40">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!--Nutritional Data Boxes-->
                                                        <Border Grid.Row="0" Padding="0,18" Grid.Column="0" Stroke="{AppThemeBinding Light=#E5E1E3,Dark=#474648}" StrokeThickness="1"  BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}" HeightRequest="103" WidthRequest="121" StrokeShape="RoundRectangle 4">
                                                            <Border.Shadow>
                                                                <!--Combined Shadow Effect-->
                                                                <Shadow Brush="#26000000" Offset="0,1" Radius="3" />
                                                            </Border.Shadow>
                                                            <StackLayout x:DataType="local:MealCalorieConsumed" VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                                                <Label Text="{Binding CaloriesFromFiber}" FontSize="28" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalTextAlignment="Center"/>
                                                                <Label Text="Fiber" FontSize="14" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Dark={DynamicResource SecondaryTextColorDark}, Light={DynamicResource SecondaryTextColorLight}}" HorizontalTextAlignment="Center"/>
                                                                <BoxView Color="{Binding NutrientColorValue.FiberColor}" WidthRequest="52" HeightRequest="4" HorizontalOptions="Center"/>
                                                            </StackLayout>

                                                        </Border>

                                                        <Border Grid.Row="0" Padding="0,18" Grid.Column="1" Stroke="{AppThemeBinding Light=#E5E1E3,Dark=#474648}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}" HeightRequest="103" WidthRequest="121" StrokeShape="RoundRectangle 4">
                                                            <Border.Shadow>
                                                                <!--Combined Shadow Effect-->
                                                                <Shadow Brush="#26000000" Offset="0,1" Radius="3" />
                                                            </Border.Shadow>
                                                            <StackLayout x:DataType="local:MealCalorieConsumed" VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                                                <Label Text="{Binding CaloriesFromProtein}" FontSize="28" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalTextAlignment="Center"/>
                                                                <Label Text="Protein" FontSize="14" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Dark={DynamicResource SecondaryTextColorDark}, Light={DynamicResource SecondaryTextColorLight}}" HorizontalTextAlignment="Center"/>
                                                                <BoxView Color="{Binding NutrientColorValue.ProteinColor}" WidthRequest="52" HeightRequest="4" HorizontalOptions="Center"/>
                                                            </StackLayout>
                                                        </Border>

                                                        <Border Grid.Row="0" Padding="0,18" Grid.Column="2" Stroke="{AppThemeBinding Light=#E5E1E3,Dark=#474648}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}" HeightRequest="103" WidthRequest="121" StrokeShape="RoundRectangle 4">
                                                            <Border.Shadow>
                                                                <!--Combined Shadow Effect-->
                                                                <Shadow Brush="#26000000" Offset="0,1" Radius="3" />
                                                            </Border.Shadow>
                                                            <StackLayout x:DataType="local:MealCalorieConsumed" VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                                                <Label Text="{Binding CaloriesFromCarbs}" FontSize="28" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalTextAlignment="Center"/>
                                                                <Label Text="Carbs" FontSize="14" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Dark={DynamicResource SecondaryTextColorDark}, Light={DynamicResource SecondaryTextColorLight}}" HorizontalTextAlignment="Center"/>
                                                                <BoxView Color="{Binding NutrientColorValue.CarbsColor}" WidthRequest="52" HeightRequest="4" HorizontalOptions="Center"/>
                                                            </StackLayout>
                                                        </Border>

                                                        <Border Grid.Row="1" Padding="0,18" Grid.Column="0" Stroke="{AppThemeBinding Light=#E5E1E3,Dark=#474648}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}" HeightRequest="103" WidthRequest="121" StrokeShape="RoundRectangle 4">
                                                            <Border.Shadow>
                                                                <!--Combined Shadow Effect-->
                                                                <Shadow Brush="#26000000" Offset="0,1" Radius="3" />
                                                            </Border.Shadow>
                                                            <StackLayout x:DataType="local:MealCalorieConsumed" VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                                                <Label Text="{Binding CaloriesFromVitamin}" FontSize="28" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalTextAlignment="Center"/>
                                                                <Label Text="Vitamin" FontSize="14" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Dark={DynamicResource SecondaryTextColorDark}, Light={DynamicResource SecondaryTextColorLight}}" HorizontalTextAlignment="Center"/>
                                                                <BoxView Color="{Binding NutrientColorValue.VitaminColor}" WidthRequest="52" HeightRequest="4" HorizontalOptions="Center"/>
                                                            </StackLayout>
                                                        </Border>

                                                        <Border Grid.Row="1" Padding="0,18" Grid.Column="1" Stroke="{AppThemeBinding Light=#E5E1E3,Dark=#474648}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}" HeightRequest="103" WidthRequest="121" StrokeShape="RoundRectangle 4">
                                                            <Border.Shadow>
                                                                <!--Combined Shadow Effect-->
                                                                <Shadow Brush="#26000000" Offset="0,1" Radius="3" />
                                                            </Border.Shadow>
                                                            <StackLayout x:DataType="local:MealCalorieConsumed" VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                                                <Label Text="{Binding CaloriesFromCalcium}" FontSize="28" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalTextAlignment="Center"/>
                                                                <Label Text="Calcium" FontSize="14" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Dark={DynamicResource SecondaryTextColorDark}, Light={DynamicResource SecondaryTextColorLight}}" HorizontalTextAlignment="Center"/>
                                                                <BoxView Color="{Binding NutrientColorValue.CalciumColor}" WidthRequest="52" HeightRequest="4" HorizontalOptions="Center"/>
                                                            </StackLayout>
                                                        </Border>

                                                        <Border Grid.Row="1" Padding="0,18" Grid.Column="2" Stroke="{AppThemeBinding Light=#E5E1E3,Dark=#474648}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}" HeightRequest="103" WidthRequest="121" StrokeShape="RoundRectangle 4">
                                                            <Border.Shadow>
                                                                <!--Combined Shadow Effect-->
                                                                <Shadow Brush="#26000000" Offset="0,1" Radius="3" />
                                                            </Border.Shadow>
                                                            <StackLayout x:DataType="local:MealCalorieConsumed" VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                                                <Label Text="{Binding CaloriesFromFat}" FontSize="28" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalTextAlignment="Center"/>
                                                                <Label Text="Fat" FontSize="14" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Dark={DynamicResource SecondaryTextColorDark}, Light={DynamicResource SecondaryTextColorLight}}" HorizontalTextAlignment="Center"/>
                                                                <BoxView Color="{Binding NutrientColorValue.FatColor}" WidthRequest="52" HeightRequest="4" HorizontalOptions="Center"/>
                                                            </StackLayout>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="3">
                            <BoxView x:Name="boxView1" Color="{AppThemeBinding Light={DynamicResource SentMessageColorLight}, Dark={DynamicResource SentMessageColorDark}}" IsVisible="{OnIdiom Default=True, Phone=False}" WidthRequest="8" HorizontalOptions="Start"/>
                        </Grid>
                        <BoxView x:Name="invHBorder" Grid.Column="2" Grid.Row="{OnIdiom Desktop='1',Tablet='1'}" VerticalOptions="Start" HeightRequest="8" HorizontalOptions="Fill" Color="{AppThemeBinding Light=#FCF8FA, Dark=#313032}" IsVisible="False" />
                        <Grid x:Name="TrackingGrid" x:DataType="local:HealthCareViewModel" Grid.Column="{OnIdiom Desktop='3', Tablet='3'}" Grid.Row="{OnPlatform Android='0', iOS='0'}" VerticalOptions="Fill" HorizontalOptions="{OnIdiom Desktop=End, Tablet=End, Phone=Start}">
                            <BoxView HorizontalOptions="Start" VerticalOptions="Fill" Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" IsVisible="{OnIdiom Default=True, Phone=False}"/>
                            <Grid RowDefinitions="{OnIdiom Desktop='Auto,*',Tablet='Auto,*', Phone='Auto,*'}" RowSpacing="0">
                                <Grid Grid.Row="0" RowDefinitions="{OnIdiom Desktop='*,*', Tablet='*,*'}">
                                    <HorizontalStackLayout Grid.Row="0" VerticalOptions="Start" IsVisible="{OnIdiom Default=True, Phone=False}">
                                        <Label Text="Tracking" FontSize="22" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HeightRequest="28" Margin="{OnIdiom Phone='16,16,0,16', Default='40,32,0,24'}"></Label>
                                    </HorizontalStackLayout>
                                    <Grid Grid.Row="1" RowDefinitions="*,*" ColumnDefinitions="*,*" HorizontalOptions="Fill" Padding="{OnIdiom Phone='20,16,20,32', Desktop='40,0,32,32', Tablet='40,0,32,32'}" RowSpacing="{OnIdiom Phone=16, Default=24}" ColumnSpacing="{OnIdiom Phone=16, Default=24}">
                                        <Border  BindingContext="{Binding TrackingNutrientData[0]}" Grid.Row="0" Grid.Column="0" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 4" HorizontalOptions="Fill" VerticalOptions="Fill">
                                            <Border.Shadow>
                                                <Shadow Brush="Black"
                                                        Radius="5"
                                                        Offset="0,2"
                                                        Opacity="0.5"/>
                                            </Border.Shadow>
                                            <Grid x:DataType="local:HealthCareModel" RowDefinitions="*" VerticalOptions="Fill">
                                                <Grid RowDefinitions="Auto,Auto,Auto">
                                                    <Grid.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#9F60FD" Offset="0"/>
                                                            <GradientStop Color="#D957BC" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Grid.Background>
                                                    <Label Text="&#xe700;" Padding="0,17,0,12" FontFamily="DashboardFontIcons"  Grid.Row="0" HorizontalOptions="Center" FontSize="42" TextColor="{DynamicResource Gray-White}"/>    
                                                    <Label Grid.Row="1" FontFamily="Roboto-Medium" FontSize="22" LineHeight="{OnPlatform Android=1.25,iOS=1.25, Default=-1}" Text="{Binding CategoryValue}" TextColor="{DynamicResource Gray-White}" HorizontalOptions="Center"/>
                                                    <Label Grid.Row="2" FontFamily="Roboto-Regular" FontSize="14" LineHeight="{OnPlatform Android=1.25, iOS=1.25, Default=-1}" Text="{Binding Category}" TextColor="{DynamicResource Gray-White}" HorizontalOptions="Center" Padding="0,0,0,17"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Border BindingContext="{Binding TrackingNutrientData[1]}" Grid.Row="0" Grid.Column="1" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 4" HorizontalOptions="Fill" VerticalOptions="Fill" >
                                            <Border.Shadow>
                                                <Shadow Brush="Black"
                                                    Radius="5"
                                                    Offset="0,2"
                                                    Opacity="0.5"/>
                                            </Border.Shadow>
                                            <Grid x:DataType="local:HealthCareModel" RowDefinitions="{OnIdiom Desktop='Auto',Tablet='Auto', Phone='*'}" VerticalOptions="Fill">
                                                <Grid Padding="0"  RowDefinitions="Auto,Auto,Auto">
                                                    <Grid.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#6DB0FF" Offset="0"/>
                                                            <GradientStop Color="#6957D9" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Grid.Background>
                                                    <Label Text="&#xe704;" Padding="0,17,0,12" FontFamily="DashboardFontIcons"  Grid.Row="0" HorizontalOptions="Center" FontSize="42" TextColor="{DynamicResource Gray-White}"/>
                                                    <Label Grid.Row="1" FontFamily="Roboto-Medium" FontSize="22" LineHeight="{OnPlatform Android=1.25, iOS=1.25, Default=-1}" Text="{Binding CategoryValue}" TextColor="{DynamicResource Gray-White}" HorizontalOptions="Center"/>
                                                    <Label Grid.Row="2" FontFamily="Roboto-Regular" FontSize="14" LineHeight="{OnPlatform Android=1.25, iOS=1.25, Default=-1}" Text="{Binding Category}" TextColor="{DynamicResource Gray-White}" HorizontalOptions="Center" Padding="0,0,0,17"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Border BindingContext="{Binding TrackingNutrientData[2]}" Grid.Row="1" Grid.Column="0" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 4" HorizontalOptions="Fill" VerticalOptions="Fill" >
                                            <Border.Shadow>
                                                <Shadow Brush="Black"
                                                    Radius="5"
                                                    Offset="0,2"
                                                    Opacity="0.5"/>
                                            </Border.Shadow>
                                            <Grid x:DataType="local:HealthCareModel" RowDefinitions="{OnIdiom Desktop='Auto',Tablet='Auto',Phone='*'}" VerticalOptions="Fill">
                                                <Grid RowDefinitions="Auto,Auto,Auto">
                                                    <Grid.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FFAD4E" Offset="0"/>
                                                            <GradientStop Color="#D942B8" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Grid.Background>
                                                    <Label Text="&#xe70a;" Padding="0,17,0,12" FontFamily="DashboardFontIcons" Grid.Row="0" HorizontalOptions="Center" FontSize="42" TextColor="{DynamicResource Gray-White}"/>
                                                    <Label Grid.Row="1" FontFamily="Roboto-Medium" FontSize="22" LineHeight="{OnPlatform Android=1.25, iOS=1.25, Default=-1}" Text="{Binding CategoryValue}" TextColor="{DynamicResource Gray-White}" HorizontalOptions="Center"/>
                                                    <Label Grid.Row="2" FontFamily="Roboto-Regular" FontSize="14" LineHeight="{OnPlatform Android=1.25, iOS=1.25, Default=-1}" Text="{Binding Category}" TextColor="{DynamicResource Gray-White}" HorizontalOptions="Center" Padding="0,0,0,17"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Border BindingContext="{Binding TrackingNutrientData[3]}" Grid.Row="1" Grid.Column="1" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 4" HorizontalOptions="Fill" VerticalOptions="Fill" >
                                            <Border.Shadow>
                                                <Shadow Brush="Black"
                                                    Radius="5"
                                                    Offset="0,2"/>
                                            </Border.Shadow>
                                            <Grid x:DataType="local:HealthCareModel" RowDefinitions="{OnIdiom Desktop='Auto',Tablet='Auto',Phone='*'}" VerticalOptions="Fill">
                                                <Grid RowDefinitions="Auto,Auto,Auto">
                                                    <Grid.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#14E983" Offset="0"/>
                                                            <GradientStop Color="#0F9292" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Grid.Background>
                                                    <Label Text="&#xe70b;" Padding="0,17,0,12" FontFamily="DashboardFontIcons" Grid.Row="0" HorizontalOptions="Center" FontSize="42" TextColor="{DynamicResource Gray-White}"/>
                                                    <Label Grid.Row="1" FontFamily="Roboto-Medium" FontSize="22" LineHeight="{OnPlatform Android=1.25, iOS=1.25, Default=-1}" Text="{Binding CategoryValue}" TextColor="{DynamicResource Gray-White}" HorizontalOptions="Center"/>
                                                    <Label Grid.Row="2" FontFamily="Roboto-Regular" FontSize="14" LineHeight="{OnPlatform Android=1.25, iOS=1.25, Default=-1}" Text="{Binding Category}" TextColor="{DynamicResource Gray-White}" HorizontalOptions="Center" Padding="0,0,0,17"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <listView:SfListView Grid.Row="1" IsScrollingEnabled="False" ItemsSource="{Binding TrackingData}" SelectionMode="None" ItemSpacing="{OnIdiom Phone='16,16', Default='40,8'}" ItemSize="72">
                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:DataType="local:HealthCareModel" StrokeThickness="0" StrokeShape="RoundRectangle 4" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">
                                                    <Border.Shadow>
                                                        <Shadow Brush="Black" Radius="5" Offset="0,3" Opacity="0.3"/>
                                                    </Border.Shadow>
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <BoxView BackgroundColor="{Binding BackgroundGradientStart}" CornerRadius="4,0,4,0" HorizontalOptions="Center" WidthRequest="4"  HeightRequest="72" />
                                                        <Grid Grid.Column="1" RowDefinitions="*, *" ColumnDefinitions="*,Auto" RowSpacing="2" Padding="12,0">
                                                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Category}" HorizontalTextAlignment="Start" VerticalOptions="Center" FontFamily="Roboto-Medium"/>
                                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding CategoryValue}" VerticalOptions="Center" HorizontalTextAlignment="End" FontFamily="Roboto-Medium"/>
                                                            <Label Grid.Row="1" Grid.Column="0" FontAttributes="None" TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}" Text="{Binding CategoryPercentage}" FontFamily="Roboto-Regular"/>
                                                            <Label Grid.Row="1" Grid.Column="1" FontAttributes="None" Text="{Binding CategoryStage}" HorizontalOptions="End" FontFamily="Roboto-Regular" TextColor="{Binding CategoryStageColor}"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                        <listView:SfListView.Shadow>
                                                <Shadow Brush="{OnPlatform Default=#000000, WinUI=Transparent}" Offset="0,3" Opacity="0.3" Radius="3" />
                                        </listView:SfListView.Shadow>
                                    </listView:SfListView>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollView>
            </Grid>
        </StackLayout>
    </ContentView.Content>
</ContentView>