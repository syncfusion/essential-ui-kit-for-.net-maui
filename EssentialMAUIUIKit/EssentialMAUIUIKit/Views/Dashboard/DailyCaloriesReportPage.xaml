<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Dashboard.DailyCaloriesReportPage"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:picker="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"             
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core">

    <ContentView.BindingContext>
        <local:DailyCaloriesReportViewModel/>
    </ContentView.BindingContext>
    <ContentView.Content>
        <Grid RowDefinitions="Auto" VerticalOptions="Fill" HorizontalOptions="Fill" Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">
            <ScrollView Grid.Row="0" VerticalOptions="Fill">
                <Grid ColumnDefinitions="*">
                        <BoxView WidthRequest="2" Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" HorizontalOptions="Start" VerticalOptions="Fill" />
                         <Grid RowDefinitions="Auto,*" Margin="{OnPlatform WinUI='10,0,10,0'}" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">
                            <Grid Grid.Row="0" RowDefinitions="Auto,*" VerticalOptions="{OnPlatform WinUI='Start', Android='Start',iOS='Start'}">
                                <Grid x:Name="datePickerHost" Grid.Row="0" ColumnDefinitions="*,Auto" HorizontalOptions="{OnIdiom Phone=End}" Padding="16,16,16,0">
                                    <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 40" WidthRequest="{OnIdiom Phone=145}" Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource GrayBorderBackgroundColor}}">
                                        <Border.Shadow>
                                            <Shadow Brush="#000000" Offset="0,1" Opacity="0.3" Radius="3" />
                                        </Border.Shadow>
                                        <Grid Padding="0,10" ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalOptions="Fill">
                                            <!--DatePicker control-->
                                            <picker:SfDatePicker Grid.Column="0" RelativeView="{x:Reference datePickerHost}" x:Name="datePicker" SelectedDate="{Binding SelectedDate}" Mode="RelativeDialog" TextDisplayMode="Fade" MinimumDate="2000/01/01" MaximumDate="2050/12/31" RelativePosition="AlignBottom" SelectionChanged="OnDatePickerSelectionChanged" Opacity="0"/>
                                            <Label x:Name="pickerLabel" Grid.Column="0" Text="{Binding Source={x:Reference datePicker}, Path=SelectedDate, StringFormat='{0:dd MMM, yyyy}' }" FontFamily="Roboto-Medium" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="DatePicker_Tapped"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <!--Datepicker Icon-->
                                            <Label FontFamily="DashboardFontIcons" Text="&#xe711;" Grid.Column="1" VerticalOptions="Center" Margin="0,0,16,0" HorizontalOptions="Center" IsVisible="{OnPlatform WinUI=True}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="1" x:DataType="local:DailyCaloriesReportViewModel" VerticalOptions="Fill" WidthRequest="200" HeightRequest="200" Margin="0,24">
                                    <chart:SfCircularChart>
                                        <!-- Series Definition -->
                                        <chart:SfCircularChart.Series>
                                            <chart:DoughnutSeries x:Name="doughnutSeries" ItemsSource="{Binding CaloriesChartDataValue.CaloriesConsumedInADay}" XBindingPath="Nutrient" YBindingPath="Value" InnerRadius ="0.7" Radius="1" PaletteBrushes="{Binding CaloriesChartDataValue.SegmentColors}" ShowDataLabels="False" StrokeWidth="5" 
                                                Stroke="{AppThemeBinding Dark={DynamicResource BackgroundColorDark}, Light={DynamicResource BackgroundColorLight}}">
                                            </chart:DoughnutSeries>
                                        </chart:SfCircularChart.Series>
                                    </chart:SfCircularChart>
                                    <Grid RowDefinitions="*,*">
                                        <Label Grid.Row="0" Text="{Binding CaloriesChartDataValue.TotalCaloriesInADay}" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" FontFamily="Roboto-Medium" FontSize="22" VerticalOptions="End" HorizontalOptions="Center" />
                                        <Label Grid.Row="1" Text="Calories Consumed" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" FontFamily="Roboto-Regular" FontSize="14" VerticalOptions="Start" HorizontalOptions="Center"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="1" HorizontalOptions="Center">
                                <Grid RowDefinitions="Auto,Auto">
                                    <CollectionView x:DataType="local:DailyCaloriesReportViewModel" ItemsSource="{Binding CaloriesConsumedList}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:DataType="local:CaloriesConsumedData" IsVisible ="{Binding IsSelected}" Padding="16" VerticalOptions="Start" HeightRequest="-1">
                                                    <Grid.Triggers>
                                                        <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="False">
                                                            <Setter Property="HeightRequest" Value="0" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="HeightRequest" Value="-1" />
                                                        </DataTrigger>
                                                    </Grid.Triggers>
                                                    <syncfusion:SfChipGroup ItemsSource="{Binding CaloriesConsumedPerMeal}" SelectedItem="{Binding CaloriesConsumedPerMeal[0],Mode=OneTime}" SelectionChanged="OnChipSelectionChanging" ChipType="Choice" ChipCornerRadius="25" ChipStroke="{AppThemeBinding Light=#E5E1E3, Dark=#474648}" ChipStrokeThickness="1" ChipFontFamily="Roboto-Medium" ChipTextColor="{AppThemeBinding Light={DynamicResource BackgroundColorDark}, Dark={DynamicResource BackgroundColorLight}}" SelectedChipBackground="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}" SelectedChipTextColor="{AppThemeBinding Light=#FFFFFF,Dark=#FFFFFF}">
                                                        <syncfusion:SfChipGroup.ItemTemplate>
                                                            <DataTemplate>
                                                                <HorizontalStackLayout x:DataType="local:MealCalorieConsumed" Spacing="8" Margin="10,6">
                                                                    <Label FontFamily="DashboardFontIcons" Text="{Binding MealIcon}" TextColor="{Binding MealIconColor}" FontSize="16" VerticalOptions="Center" />
                                                                    <!-- Chip Text -->
                                                                    <Label Text="{Binding MealTime}" FontFamily="Roboto-Medium" TextColor="{Binding MealFontColor}" FontSize="14" VerticalOptions="Center" HorizontalOptions="Start"/>
                                                                </HorizontalStackLayout>
                                                            </DataTemplate>
                                                        </syncfusion:SfChipGroup.ItemTemplate>
                                                    </syncfusion:SfChipGroup>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                    <CollectionView x:DataType="local:DailyCaloriesReportViewModel" ItemsSource="{Binding CaloriesChartDataValue.SelectedMealDetails, Mode=TwoWay}" SelectionMode="None" Grid.Row="1">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:DataType="local:MealCalorieConsumed" ColumnSpacing="16" RowSpacing="16" Padding="34,24" HorizontalOptions="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!--Nutritional Data Boxes-->
                                                    <Border Grid.Row="0" Grid.Column="0" HeightRequest="72" WidthRequest="92" StrokeThickness="0" StrokeShape="RoundRectangle 4"  BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}" HorizontalOptions="Fill">
                                                        <Border.Shadow>
                                                            <!--Combined Shadow Effect-->
                                                            <Shadow Brush="Black" Offset="0,1" Radius="3" />
                                                        </Border.Shadow>
                                                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2"  Padding="0,8">
                                                            <Label Text="{Binding CaloriesFromFiber}" FontSize="22" FontFamily="Roboto-Medium" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalTextAlignment="Center"/>
                                                            <Label Text="Fiber" FontSize="12" FontFamily="Roboto-Medium" TextColor="{AppThemeBinding Dark={DynamicResource SecondaryTextColorDark}, Light={DynamicResource SecondaryTextColorLight}}" HorizontalTextAlignment="Center"/>
                                                            <BoxView Color="{Binding NutrientColorValue.FiberColor}" WidthRequest="32" HeightRequest="4" HorizontalOptions="Center"/>
                                                        </StackLayout>

                                                    </Border>

                                                    <Border Grid.Row="0" Grid.Column="1" HeightRequest="72" WidthRequest="92" StrokeThickness="0" StrokeShape="RoundRectangle 4" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}" HorizontalOptions="Fill">
                                                        <Border.Shadow>
                                                            <!--Combined Shadow Effect-->
                                                            <Shadow Brush="Black" Offset="0,1" Radius="3" />
                                                        </Border.Shadow>
                                                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2"  Padding="0,8">
                                                            <Label Text="{Binding CaloriesFromProtein}" FontSize="22" FontFamily="Roboto-Medium" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalTextAlignment="Center"/>
                                                            <Label Text="Protein" FontSize="12" FontFamily="Roboto-Medium" TextColor="{AppThemeBinding Dark={DynamicResource SecondaryTextColorDark}, Light={DynamicResource SecondaryTextColorLight}}" HorizontalTextAlignment="Center"/>
                                                            <BoxView Color="{Binding NutrientColorValue.ProteinColor}" WidthRequest="32" HeightRequest="4" HorizontalOptions="Center" />
                                                        </StackLayout>
                                                    </Border>

                                                    <Border Grid.Row="0" Grid.Column="2" HeightRequest="72" WidthRequest="92" StrokeThickness="0" StrokeShape="RoundRectangle 4" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}" HorizontalOptions="Fill" >
                                                        <Border.Shadow>
                                                            <!--Combined Shadow Effect-->
                                                            <Shadow Brush="Black" Offset="0,1" Radius="3" />
                                                        </Border.Shadow>
                                                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2"  Padding="0,8">
                                                            <Label Text="{Binding CaloriesFromCarbs}" FontSize="22" FontFamily="Roboto-Medium" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalTextAlignment="Center"/>
                                                            <Label Text="Carbs" FontSize="12" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Dark={DynamicResource SecondaryTextColorDark}, Light={DynamicResource SecondaryTextColorLight}}" HorizontalTextAlignment="Center"/>
                                                            <BoxView Color="{Binding NutrientColorValue.CarbsColor}" WidthRequest="32" HeightRequest="4" HorizontalOptions="Center"/>
                                                        </StackLayout>
                                                    </Border>

                                                    <Border Grid.Row="1" Grid.Column="0" HeightRequest="72" WidthRequest="92" StrokeThickness="0" StrokeShape="RoundRectangle 4" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"  HorizontalOptions="Fill">
                                                        <Border.Shadow>
                                                            <!--Combined Shadow Effect-->
                                                            <Shadow Brush="Black" Offset="0,1" Radius="3" />
                                                        </Border.Shadow>
                                                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2"  Padding="0,8">
                                                            <Label Text="{Binding CaloriesFromVitamin}" FontSize="22" FontFamily="Roboto-Medium" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalTextAlignment="Center"/>
                                                            <Label Text="Vitamin" FontSize="12" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Dark={DynamicResource SecondaryTextColorDark}, Light={DynamicResource SecondaryTextColorLight}}" HorizontalTextAlignment="Center"/>
                                                            <BoxView Color="{Binding NutrientColorValue.VitaminColor}" WidthRequest="32" HeightRequest="4" HorizontalOptions="Center"/>
                                                        </StackLayout>
                                                    </Border>

                                                    <Border Grid.Row="1" Grid.Column="1" HeightRequest="72" WidthRequest="92" StrokeThickness="0" StrokeShape="RoundRectangle 4" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"  HorizontalOptions="Fill">
                                                        <Border.Shadow>
                                                            <!--Combined Shadow Effect-->
                                                            <Shadow Brush="Black" Offset="0,1" Radius="3" />
                                                        </Border.Shadow>
                                                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2"  Padding="0,8">
                                                            <Label Text="{Binding CaloriesFromCalcium}" FontSize="22" FontFamily="Roboto-Medium" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalTextAlignment="Center"/>
                                                            <Label Text="Calcium" FontSize="12" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Dark={DynamicResource SecondaryTextColorDark}, Light={DynamicResource SecondaryTextColorLight}}" HorizontalTextAlignment="Center"/>
                                                            <BoxView Color="{Binding NutrientColorValue.CalciumColor}" WidthRequest="32" HeightRequest="4" HorizontalOptions="Center" />
                                                        </StackLayout>
                                                    </Border>

                                                    <Border Grid.Row="1" Grid.Column="2" HeightRequest="72" WidthRequest="92" StrokeThickness="0" StrokeShape="RoundRectangle 4" BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"  HorizontalOptions="Fill">
                                                        <Border.Shadow>
                                                            <!--Combined Shadow Effect-->
                                                            <Shadow Brush="Black" Offset="0,1" Radius="3" />
                                                        </Border.Shadow>
                                                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center"  Spacing="2"  Padding="0,8">
                                                            <Label Text="{Binding CaloriesFromFat}" FontSize="22" FontFamily="Roboto-Medium" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" HorizontalTextAlignment="Center"/>
                                                            <Label Text="Fat" FontSize="12" FontFamily="Roboto-Regular" TextColor="{AppThemeBinding Dark={DynamicResource SecondaryTextColorDark}, Light={DynamicResource SecondaryTextColorLight}}" HorizontalTextAlignment="Center"/>
                                                            <BoxView Color="{Binding NutrientColorValue.FatColor}" WidthRequest="32" HeightRequest="4" HorizontalOptions="Center" />
                                                        </StackLayout>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Grid>
                            </Grid>
                        </Grid>
                </Grid>
            </ScrollView>
        </Grid>
    </ContentView.Content>
</ContentView>