<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Transaction.DeliveryView"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:radioButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             x:DataType="local:CheckoutViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <radioButtons:SfRadioGroupKey x:Key="DeliveryAddressGroup"/>
        </ResourceDictionary>
    </ContentView.Resources>

    <StackLayout Spacing="0">

        <!--  Header  -->
        <Grid Padding="0,0,0,0" ColumnDefinitions="*, *" RowDefinitions="*, Auto, Auto, Auto">

            <Label Padding="10,0,0,30"
                   Grid.Column="0"
                   HorizontalOptions="Start" FontFamily="Roboto-Regular"
                   LineHeight="{OnPlatform Android=1.25, Default=-1}"
                   Style="{DynamicResource TitleLabelStyle}"
                   Text="Shipping Details" FontSize="28"
                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"/>

            <Border Grid.Row="1" Grid.Column="0" Margin="10,0,8,0" HeightRequest="172" WidthRequest="324" BackgroundColor="#F7EDFF" Stroke="#7633DA" StrokeShape="RoundRectangle 10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddressTapped" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
                    <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" Padding="32">
                        <HorizontalStackLayout Grid.Row="0" Spacing="8">
                            <Label Text="Jessica Reed"
                                   FontFamily="Roboto-Medium"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorLight}}"
                                   LineBreakMode="WordWrap"
                                   HorizontalOptions="Start"/>
                            <Border Grid.Column="0" Grid.Row="1" WidthRequest="56" BackgroundColor="#7633DA" StrokeThickness="1" HeightRequest="20" StrokeShape="RoundRectangle 10">
                                <Label Text="Default"
                                       FontFamily="Roboto-Medium"
                                       FontSize="10"
                                       TextColor="White"
                                       LineBreakMode="WordWrap" VerticalOptions="Center"
                                       HorizontalOptions="Center"/>
                            </Border>
                        </HorizontalStackLayout>
                        <Label Grid.Row="1"
                               Text="110 Echo Valley Road, Los Altos"
                               FontFamily="Roboto-Regular"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorLight}}"
                               HorizontalOptions="Start"/>
                        <Label Grid.Row="2"
                               Text="California, United States"
                               FontFamily="Roboto-Regular"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorLight}}"
                               HorizontalOptions="Start"/>
                        <Label Grid.Row="3"
                               Text="States"
                               FontFamily="Roboto-Regular"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorLight}}"
                               HorizontalOptions="Start"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" HeightRequest="172" Margin="8,0,10,0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddressTapped" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" Padding="32">
                        <Label Grid.Row="0"
                               Text="Workspace"
                               FontFamily="Roboto-Medium"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorLight}}"
                               LineBreakMode="WordWrap"
                               HorizontalOptions="Start"/>
                        <Label Grid.Row="1"
                               Text="500 Terry Francois Street"
                               FontFamily="Roboto-Regular"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorLight}}"
                               HorizontalOptions="Start"/>
                        <Label Grid.Row="2"
                               Text="San Francisco, CA 94158,"
                               FontFamily="Roboto-Regular"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorLight}}"
                               HorizontalOptions="Start"/>
                        <Label Grid.Row="3"
                               Text="United States"
                               FontFamily="Roboto-Regular"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorLight}}"
                               HorizontalOptions="Start"/>
                    </Grid>
                </Grid>
            </Border>

            <buttons:SfButton Grid.Row="2" Margin="8"
                              CornerRadius="24"
                              FontSize="14" HorizontalOptions="Start"
                              Stroke="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                              StrokeThickness="0"
                              FontFamily="Roboto-Medium"
                              Background="Transparent"
                              Text="+ Add New Address"
                              TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                              WidthRequest="181">
            </buttons:SfButton>
        </Grid>
    </StackLayout>
</ContentView>