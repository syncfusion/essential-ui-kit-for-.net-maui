<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Transaction.CheckoutPage"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:radiobutton="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
             xmlns:radioButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:templateSelector="clr-namespace:EssentialMAUIUIKit.Views.Transaction"
             x:DataType="local:CheckoutViewModel">
    <ContentView.BindingContext>
        <local:CheckoutViewModel x:Name="viewModel"/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <ResourceDictionary>
            <radioButtons:SfRadioGroupKey x:Key="PaymentModeGroup"/>
        </ResourceDictionary>
    </ContentView.Resources>


    <ContentView.Content>
        <ScrollView BackgroundColor="#FAF6F8" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout MaximumWidthRequest="{OnIdiom Phone=390, Tablet=1215, Desktop=1215}" HorizontalOptions="Fill">
                <Grid Padding="{OnIdiom Default='0', Desktop='16,16,16,0'}" IsVisible="{OnPlatform Android=False, iOS=False, MacCatalyst=True, WinUI=True}" ColumnSpacing="0" ColumnDefinitions="Auto,*">
                    <Grid Grid.Column="0" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="2">
                        <Label Text="Order Summary" Grid.Row="0" FontSize="28" Padding="10,0,0,0" FontFamily="Roboto-Regular"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                        <BoxView Grid.Row="1" 
                                 HeightRequest="1"
                                 Style="{DynamicResource HorizontalSeparatorStyle}"
                                 Margin="10"/>

                        <Border Grid.Row="2" Margin="10,20,10,10"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF">
                            <Grid ColumnDefinitions="Auto, Auto">
                                <Border Grid.Column="0" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Margin="16"
                                        HeightRequest="160"
                                        WidthRequest="{OnIdiom Phone=96, Default=128}">
                                    <Image Grid.Column="0"
                                           Grid.RowSpan="3"
                                           Source="silk_shirt.png"
                                           Aspect="AspectFill"/>
                                </Border>
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <Label Grid.Row="0" Padding="10,25,0,10"
                                           Text="Silk Maxi Column Skirt"
                                           LineBreakMode="TailTruncation"
                                           FontSize="24"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                           FontFamily="Roboto-Regular"/>
                                    <Label Grid.Row="1" Padding="10,0,0,8"
                                           Text="Midnight Grey • Size M"
                                           LineBreakMode="TailTruncation"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                           FontFamily="Roboto-Regular"/>
                                    <HorizontalStackLayout Grid.Row="2">
                                        <Label 
                                           Padding="10,20,0,10"
                                           LineBreakMode="TailTruncation" VerticalTextAlignment="Center"
                                           Text="&#xe728;" TextColor="#1C7E39" FontFamily="UIKitIcons" FontSize="16">
                                        </Label>
                                        <Label 
                                           Padding="0,20,0,12"
                                           LineBreakMode="TailTruncation" VerticalTextAlignment="Start"
                                           FontSize="16" FontFamily="Roboto-Regular" TextColor="#1C7E39"
                                           Text="  Delivery expected on Mar 23, 2024">
                                        </Label>
                                    </HorizontalStackLayout>
                                    <Label Grid.Row="3" Padding="10,0,0,8"
                                           Text="Order ID: #89027532"
                                           LineBreakMode="TailTruncation"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                           FontFamily="Roboto-Regular"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!--  ListView for Delivery  -->
                        <templateSelector:DeliveryView Grid.Row="3" Margin="{OnIdiom Phone='0,16,0,0', Tablet='0,24,0,0', Desktop='0,20,0,0'}"/>

                        <!-- Paymment method -->
                        <Grid Grid.Row="4" RowDefinitions="*,*" RowSpacing="0">
                            <Label Text="Payment Method" Grid.Row="0" FontSize="28" Padding="10,20,0,25"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                   FontFamily="Roboto-Regular"/>
                            <Border Grid.Column="0" Grid.Row="1"
                                    WidthRequest="662"
                                    HeightRequest="112" BackgroundColor="#EFF1FF"
                                    StrokeShape="RoundRectangle 10"
                                    Margin="10,10">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      RowDefinitions="Auto,*"
                                      Padding="28,25,12,8"
                                      ColumnSpacing="10"
                                      RowSpacing="4">
                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            WidthRequest="56"
                                            HeightRequest="40" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            Margin="6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCardsTapped" />
                                        </Border.GestureRecognizers>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#712AE2" Offset="0.0"/>
                                                <GradientStop Color="#8A4CFC" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Label Text="VISA"
                                               FontFamily="Roboto-Medium"
                                               FontSize="10"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <StackLayout Grid.Row="0" Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Visa ending in 4567"
                                               FontFamily="Roboto-Regular"
                                               FontSize="14"
                                               TextColor="{DynamicResource PrimaryTextColorLight}"/>
                                        <Label Text="Expires 12/28"
                                               FontFamily="Roboto-Regular"
                                               FontSize="14"
                                               TextColor="{DynamicResource SecondaryTextColorLight}"/>
                                    </StackLayout>
                                    <buttons:SfButton Grid.Row="0" Grid.Column="2"
                                                      Margin="8"
                                                      CornerRadius="24"
                                                      FontSize="14"
                                                      HorizontalOptions="End"
                                                      VerticalOptions="Center"
                                                      StrokeThickness="0"
                                                      FontFamily="Roboto-Medium"
                                                      Background="Transparent"
                                                      Text="Change"
                                                      TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                                      WidthRequest="90"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!--  Types of payments ways  -->
                        <Grid Grid.Row="5" ColumnDefinitions="*,*,*" RowSpacing="0" VerticalOptions="Center">
                            <Border Grid.Column="0" HeightRequest="86" StrokeShape="RoundRectangle 10" Margin="10,8,8,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCardsTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Padding="0,14,0,0">
                                    <Label Text="&#xe726;" FontSize="20"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                           FontFamily="UIKitIcons"/>
                                    <Label Text="Net Banking" Padding="0,8,0,0" 
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                           FontFamily="Roboto-Regular"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" HeightRequest="86" StrokeShape="RoundRectangle 10" Margin="8,8,8,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCardsTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Padding="0,14,0,0">
                                    <Label Text="&#xe712;" FontSize="20"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                           FontFamily="UIKitIcons"/>
                                    <Label Text="UPI Pay" Padding="0,8,0,0" 
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                           FontFamily="Roboto-Regular"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" HeightRequest="86" StrokeShape="RoundRectangle 10" Margin="8,8,8,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCardsTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Padding="0,14,0,0">
                                    <Label Text="&#xe720;"  FontSize="20"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                           FontFamily="UIKitIcons"/>
                                    <Label Padding="0,8,0,0" Text="Cash on Delivery" 
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                           FontFamily="Roboto-Regular"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                    </Grid>

                    <Grid Grid.Column="1" RowDefinitions="Auto, Auto" RowSpacing="18">
                        <!--  Price Details  -->
                        <templateSelector:PriceDetailView Grid.Column="1" Grid.Row="0"/>

                        <!-- Advantages -->
                        <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="*,*,*" RowSpacing="0">
                            <Border Grid.ColumnSpan="3" Grid.Column="0" Grid.Row="1"  HeightRequest="112" StrokeShape="RoundRectangle 10" BackgroundColor="#EFF1FF" Margin="6">
                                <HorizontalStackLayout Padding="10" Spacing="{OnIdiom Phone=10, Default=50}" HorizontalOptions="Center" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="{OnPlatform Default=0, MacCatalyst=10}">
                                        <Label Text="&#xe725;"
                                               FontSize="32" HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                               FontFamily="UIKitIcons"/>
                                        <Label Text="SECURE SSL" FontSize="10" 
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                               FontFamily="Roboto-Regular"/>
                                    </VerticalStackLayout>
                                    <BoxView Grid.RowSpan="2"
                                             BackgroundColor="{DynamicResource Gray-400}"
                                             HeightRequest="32"
                                             HorizontalOptions="Center"
                                             Style="{DynamicResource VerticalSeparatorStyle}"/>
                                    <VerticalStackLayout Spacing="{OnPlatform Default=0, MacCatalyst=10}">
                                        <Label Text="&#xe723;"
                                               FontSize="32" HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                               FontFamily="UIKitIcons"/>
                                        <Label Text="VERIFIED" 
                                               HorizontalOptions="Center" FontSize="10" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                               FontFamily="Roboto-Regular"/>
                                    </VerticalStackLayout>
                                    <BoxView Grid.RowSpan="2"
                                             BackgroundColor="{DynamicResource Gray-400}"
                                             HeightRequest="32"
                                             HorizontalOptions="Center"
                                             Style="{DynamicResource VerticalSeparatorStyle}"/>
                                    <VerticalStackLayout Spacing="{OnPlatform Default=0, MacCatalyst=10}">
                                        <Label Text="&#xe724;"
                                               FontSize="32" HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                               FontFamily="UIKitIcons"/>
                                        <Label Text="30-DAY RETURNS" 
                                               HorizontalOptions="Center" FontSize="10" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                               FontFamily="Roboto-Regular"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Mobile Layout -->
                <Grid Padding="{OnIdiom Default='0', Desktop='16,16,16,0'}" IsVisible="{OnPlatform Android=True, iOS=True, MacCatalyst=False, WinUI=False}" ColumnSpacing="0" ColumnDefinitions="*">
                    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="0" Padding="16,8,16,20">

                        <!-- 1. Header: Checkout Title -->
                        <Grid ColumnDefinitions="*,Auto" Grid.Row="0"
                              HorizontalOptions="Fill"
                              VerticalOptions="Center"
                              Padding="0,0,0,8">

                            <Label Text="Shipping Address"
                                   FontSize="16"  Grid.Column="0"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                   FontFamily="Roboto-Medium"
                                   VerticalOptions="Center"/>

                            <Button Text="Change"
                                    FontSize="14" Grid.Column="1"
                                    FontAttributes="Bold" Padding="0,0,4,0"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                    FontFamily="Roboto-Medium"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    Margin="0,2,0,0"/>
                        </Grid>


                        <!-- 2. Shipping Address Section -->
                        <Border Grid.Row="1" StrokeThickness="1" Margin="0,0,0,8"
                                StrokeShape="RoundRectangle 12" 
                                Stroke="{AppThemeBinding Light=#E5E5E5, Dark=#333333}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardsTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <Label Grid.Column="0" Text="&#xe71c;" FontFamily="MaterialAssets" FontSize="22" Padding="20,20,10,20" TextColor="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}"/>
                                <VerticalStackLayout Grid.Column="1" Padding="0,20,20,20" Spacing="8">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Jessica Miller" FontSize="16" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                               FontFamily="Roboto-Medium"/>

                                        <Label Text="10, Britta Street, California, 10, Britta Street, California, United States, 90210" 
                                               FontSize="14" LineBreakMode="WordWrap" LineHeight="1.5" Padding="0,0,50,0"
                                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                               FontFamily="Roboto-Regular"/>

                                        <Label Text="+1 (555) 012-3456" FontSize="14"
                                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                               FontFamily="Roboto-Medium"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <HorizontalStackLayout Grid.Row="2"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Center"
                                               Padding="0,18,0,16">

                            <Label Text="Review Items"
                                   FontSize="16" Padding="0,0,30,0"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                   FontFamily="Roboto-Medium"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- 3. Review Items Section -->
                        <Border Grid.Row="3" StrokeThickness="1" Margin="0,0,0,10"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#E5E5E5, Dark=#333333}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardsTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="100,*" ColumnSpacing="12" Padding="12,12,12,12">
                                <!-- Product Image -->
                                <Border Grid.Column="0" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="100" HeightRequest="130">
                                    <Image Source="womans_skirt_plain_long.png" 
                                           WidthRequest="80" HeightRequest="96"
                                           Aspect="AspectFill"/>
                                </Border>

                                <!-- Product Details -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" VerticalOptions="Center">
                                    <!-- Product Name -->
                                    <Label Grid.Row="0" Text="Women's skirt plain long" 
                                           FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                           FontFamily="Roboto-Medium"/>

                                    <!-- Product Details -->
                                    <Label Grid.Row="1" Text="Delivery expected by Mar 23, 2024" FontSize="12" Padding="0,0,0,8"
                                           TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                           FontFamily="Roboto-Regular"/>

                                    <!-- Quantity -->
                                    <Grid ColumnDefinitions="*,*" Grid.Row="2">
                                        <Label Grid.Column="0" Text="Item: 1" FontSize="14" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                               FontFamily="Roboto-Medium"/>

                                        <!-- Price -->
                                        <Label Grid.Column="1" Padding="18,0,0,0" Text="$140.00" FontSize="16" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                               FontFamily="Roboto-Medium"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Payment Method header row -->
                        <Grid ColumnDefinitions="*,Auto" Grid.Row="4"
                              HorizontalOptions="Fill"
                              VerticalOptions="Center"
                              Padding="0,0,0,8">

                            <Label Text="Payment Method"
                                   FontSize="16" Grid.Column="0"
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                   FontFamily="Roboto-Medium"
                                   VerticalOptions="Center"/>

                            <Button Text="+Add Card"
                                    FontSize="14" Grid.Column="1"
                                    FontAttributes="Bold" Padding="0,0,4,0"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                    FontFamily="Roboto-Medium"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    Margin="0,2,0,0"/>
                        </Grid>

                        <!-- 4. Payment Method Section -->
                        <VerticalStackLayout Grid.Row="5" Spacing="4" Margin="0,0,0,8">
                            <!-- Saved Card: Visa -->
                            <Border StrokeThickness="1" HeightRequest="70" StrokeShape="RoundRectangle 10" Margin="0,0,0,8"
                                    Stroke="{AppThemeBinding Light=#E5E1E3, Dark=#333333}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}">
                                <Grid ColumnDefinitions="25,60,*,80" ColumnSpacing="8" Padding="12,12,12,12" VerticalOptions="Center">

                                    <radiobutton:SfRadioButton 
                                        GroupKey="{StaticResource PaymentModeGroup}"
                                        Text=" " Padding="30,0,10,0"
                                        CheckedColor="#7633DA"
                                        UncheckedColor="#CCCCCC"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        IsChecked="True"/>
                                    
                                    <!-- Card Badge -->
                                    <Border Grid.Column="1" WidthRequest="48" HeightRequest="24"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            BackgroundColor="#F3F0F2">
                                        <Label Text="VISA" FontSize="12" FontFamily="Roboto-Medium"
                                               TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Card Details -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                        <Label Text="Visa Ending in 8908" FontSize="13" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                               FontFamily="Roboto-Medium"/>
                                        <Label Text="Expires 09/25" FontSize="12"
                                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                               FontFamily="Roboto-Regular"/>
                                    </VerticalStackLayout>

                                    <!-- Lock Icon -->
                                    <Label Grid.Column="3" Text="&#xe77b;" FontSize="20" 
                                           HorizontalOptions="End" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#5F5E60, Dark=#929092}"
                                           FontFamily="MaterialAssets"/>
                                </Grid>
                            </Border>

                            <!-- Saved Card: Mastercard -->
                            <Border StrokeThickness="1" StrokeShape="RoundRectangle 10" HeightRequest="70" Margin="0,0,0,8"
                                    Stroke="{AppThemeBinding Light=#E5E1E3, Dark=#333333}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}">
                                <Grid ColumnDefinitions="20,60,*" ColumnSpacing="8" Padding="12,12,12,12" VerticalOptions="Center">
                                    <radiobutton:SfRadioButton 
                                        GroupKey="{StaticResource PaymentModeGroup}"
                                        Text=" " Padding="30,0,10,0" 
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        CheckedColor="#7633DA"
                                        UncheckedColor="#CCCCCC"
                                        IsChecked="False"/>

                                    <!-- Card Badge -->
                                    <Border Grid.Column="1" WidthRequest="48" HeightRequest="24"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            BackgroundColor="#F3F0F2">
                                        <Label Text="MC" FontSize="12" FontFamily="Roboto-Medium"
                                               TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Card Details -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                        <Label Text="Mastercard Ending in 2345" FontSize="13" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                               FontFamily="Roboto-Medium"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <BoxView Grid.Row="6"
                                 HeightRequest="1"
                                 Style="{DynamicResource HorizontalSeparatorStyle}"
                                 Margin="0"/>

                        <expander:SfExpander Grid.Row="7" IsExpanded="True" Margin="0,0,0,16">
                            <expander:SfExpander.Header>
                                <HorizontalStackLayout Padding="0,12">
                                    <Label Text="Other payment methods" FontSize="14" FontFamily="Roboto-Medium" TextColor="{AppThemeBinding Light=#5F5E60, Dark=#929092}"/>
                                </HorizontalStackLayout>
                            </expander:SfExpander.Header>
                            <expander:SfExpander.Content>
                                <!-- 5. Order Summary Section -->
                                <VerticalStackLayout Spacing="12" >
                                    <Border StrokeThickness="1" StrokeShape="RoundRectangle 10" 
                                            Stroke="{AppThemeBinding Light=#E5E5E5, Dark=#333333}"
                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}">
                                        <VerticalStackLayout Padding="24,20" Spacing="16">
                                            <Label Text="Order Summary" FontSize="16" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                   FontFamily="Roboto-Medium"/>
                                            <!-- Price Details Rows -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <Label Grid.Column="0" Text="Price (3 items)" FontSize="14"
                                                       TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                       FontFamily="Roboto-Regular"/>
                                                <Label Grid.Column="1" Text="$450.00" FontSize="14" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}"
                                                       FontFamily="Roboto-Medium"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <Label Grid.Column="0" Text="Discount" FontSize="14"
                                                       TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                       FontFamily="Roboto-Regular"/>
                                                <Label Grid.Column="1" Text="-$43.00" FontSize="14" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}"
                                                       FontFamily="Roboto-Medium"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <Label Grid.Column="0" Text="Delivery Charges" FontSize="14"
                                                       TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                       FontFamily="Roboto-Regular"/>
                                                <StackLayout Grid.Column="1"
                                                             Orientation="Horizontal"
                                                             HorizontalOptions="End"
                                                             Margin="0">
                                                    <Label Text="$15" FontSize="14" FontFamily="Roboto-Medium"
                                                           Style="{DynamicResource SimpleLabelStyle}"
                                                           TextDecorations="Strikethrough" Padding="0,0,8,0" TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}"
                                                           HorizontalTextAlignment="End"/>
                                                    <Label Text=" Free" FontSize="12" FontFamily="Roboto-Regular" Padding="0" Margin="0"
                                                           Style="{DynamicResource SimpleLabelStyle}"
                                                           TextColor="#7633DA"
                                                           HorizontalTextAlignment="Center"/>
                                                </StackLayout>
                                            </Grid>
                                            <Border Grid.Row="6"
                                                    HeightRequest="1"
                                                    Style="{DynamicResource HorizontalSeparatorStyle}"                      
                                                    StrokeThickness="1"
                                                    StrokeDashArray="4,4"
                                                    HorizontalOptions="Fill"
                                                    Margin="0"/>

                                            <expander:SfExpander Grid.Row="4" IsExpanded="False" Margin="0,8,0,8">
                                                <expander:SfExpander.Header>
                                                    <HorizontalStackLayout Padding="0">
                                                        <Label Text="Apply Coupon" FontSize="14" TextColor="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}"/>
                                                    </HorizontalStackLayout>
                                                </expander:SfExpander.Header>
                                            </expander:SfExpander>

                                            <!-- Total Amount -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,0,0,10">
                                                <Label Grid.Column="0" Text="Total Amount" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                       FontFamily="Roboto-Bold"/>
                                                <Label Grid.Column="1" Text="$407.00" FontSize="22" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#313032, Dark=#FFFFFF}"
                                                       FontFamily="Roboto-Bold"/>
                                            </Grid>

                                            <!-- 7. Footer: Pay Now Button -->
                                            <Button Text="Pay Now" FontSize="16" FontAttributes="Bold" Padding="12"
                                                    BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                                    TextColor="White"
                                                    FontFamily="Roboto-Medium" HeightRequest="40"
                                                    CornerRadius="25"
                                                    Margin="0,0,0,12"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </expander:SfExpander.Content>
                        </expander:SfExpander>
                    </Grid>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </ContentView.Content>
</ContentView>