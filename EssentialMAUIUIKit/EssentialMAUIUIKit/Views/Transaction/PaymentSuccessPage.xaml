<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Transaction.PaymentSuccessPage"
             xmlns:button="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit">
    <Grid>
        <ScrollView Padding="20" HorizontalOptions="Fill"
                  VerticalOptions="Fill">
            <Border Stroke="Gray"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1B1D}"
                    MaximumWidthRequest="{OnIdiom Phone=328, Tablet=672, Desktop=672}"
                    HeightRequest="{OnIdiom Phone=448, Tablet=498, Desktop=498}"
                    HorizontalOptions="Fill">
                <Border.Shadow>
                    <Shadow Brush="#006C51"
                            Opacity="0.2"
                            Radius="20"
                            Offset="0,6"/>
                </Border.Shadow>
                <StackLayout HorizontalOptions="Center" Spacing="0" VerticalOptions="Center">

                    <!--  Payment status image  -->
                    <Image Margin="0,10,0,0"
                           HeightRequest="250"
                           Source="paymentsuccess.png"
                           WidthRequest="250"/>

                    <!--  Payment status label  -->
                    <Label Margin="0,20,0,0"
                           FontSize="22"
                           LineHeight="{OnPlatform Android=1.25, Default=-1}"
                           Style="{DynamicResource TitleLabelStyle}"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                           Text="Payment success"/>

                    <!--  Payment description label  -->
                    <Label Margin="17,8"
                           FontFamily="Roboto-Regular"
                           LineHeight="{OnPlatform Android=1.25, Default=-1}"
                           Style="{DynamicResource TitleLabelStyle}"
                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                           FontSize="16"
                           Text="Thank you for your payment. Receipt will sent to your whatsapp"/>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="{OnIdiom Phone=12, Tablet=16, Desktop=16}">
                        <button:SfButton Margin="0,24"
                                         Text="Order Details"
                                         VerticalOptions="Start"
                                         HeightRequest="40"
                                         WidthRequest="{OnIdiom Phone=142, Desktop=181, Tablet=181}"
                                         Style="{DynamicResource FormsButtonStyle}"/>

                        <button:SfButton Margin="0,24"
                                         CornerRadius="24"
                                         FontSize="14"
                                         Stroke="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                         StrokeThickness="2"
                                         FontFamily="Roboto-Medium"
                                         Background="Transparent"
                                         Text="Continue Shopping" HeightRequest="40"
                                         TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                         WidthRequest="{OnIdiom Phone=142, Desktop=181, Tablet=181}">
                        </button:SfButton>
                    </HorizontalStackLayout>
                </StackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentView>