<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Chat.RecentChatPage"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:controls="clr-namespace:EssentialMAUIUIKit.Controls"
             xmlns:badge="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:models="clr-namespace:EssentialMAUIUIKit.Models.Chat;assembly=EssentialMAUIUIKit"
             x:DataType="local:RecentChatViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <converter:StringToBadgeIconConverter x:Key="BadgeConverter"/>
            <converter:StringToGlyphConverter x:Key="GlyphConverter"/>
            <converter:StringToMessageTypeConverter x:Key="TextConverter"/>
            <converter:StatusToColorConverter x:Key="StatusColorConverter"/>
            <Style TargetType="badge:SfChip">
                <Setter Property="Padding" Value="0,0"/>
                <Setter Property="HeightRequest" Value="30"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid RowDefinitions="Auto,Auto,Auto,*" >
            <Grid Grid.Row="0" ColumnDefinitions="*,50,50" x:Name="TitleBar" Padding="8" BackgroundColor="{AppThemeBinding Light=Transparent, Dark=#1C1B1D}" HorizontalOptions="Fill">
                <Grid ColumnDefinitions="Auto,Auto" x:Name="ProfileView" HorizontalOptions="Start" IsVisible="True" VerticalOptions="Fill">
                    <!--  Rounded Profile Image  -->
                    <Border BackgroundColor="{AppThemeBinding Light=#ebecef, Dark=#1C1B1D}" Margin="10,0,0,0" Stroke="{AppThemeBinding Light=#ebecef, Dark=#1C1B1D}" Style="{DynamicResource ProfileBorderStyle}">
                        <Image HeightRequest="35" WidthRequest="35" x:Name="ProfileImage" Source="{Binding ActiveChatImage}"></Image>
                    </Border>
                    <!--  Recent Chat page Title  -->
                    <Label Grid.Column="1"
                           Margin="12,0"
                           FontSize="20"
                           HorizontalOptions="Start"
                           Style="{DynamicResource TitleLabelStyle}"
                           Text="Chat"
                           VerticalOptions="Center"
                           VerticalTextAlignment="Center"/>
                </Grid>
                <!--Search Button-->
                <buttons:SfButton Grid.Column="1"
                                  x:Name="SearchButton" FontSize="16" FontFamily="MaterialAssets"
                                  BindingContext="{x:Reference ProfileView}" TextColor="{AppThemeBinding Light=#474648, Dark=#C9C6C8}"
                                  IsVisible="{OnPlatform  Android=True,  iOS=True,  WinUI=False,  MacCatalyst=False}"
                                  Style="{DynamicResource IconButtonStyle}" Margin="0,0,-25,0"
                                  Text="&#xe715;" />

                <!--  Menu Button  -->
                <buttons:SfButton Grid.Column="2"
                                  x:Name="MenuButton" FontSize="14" TextColor="{AppThemeBinding Light=#474648, Dark=#C9C6C8}"
                                  Style="{DynamicResource IconButtonStyle}"
                                  Text="{DynamicResource More}"/>
            </Grid>

            <BoxView Style="{DynamicResource HorizontalSeparatorStyle}" Grid.Row="1"/>
            <badge:SfChipGroup Grid.Row="2" Margin="16,12,16,8">
                <badge:SfChip Text="All" Stroke="#E5E1E3"
                              Background="#7633DA" CornerRadius="25" FontFamily="Roboto-Medium"
                              TextColor="White"/>
                <badge:SfChip Text="Unread 8" CornerRadius="25" Stroke="#E5E1E3" FontFamily="Roboto-Medium"/>
                <badge:SfChip Text="Favorites" CornerRadius="25" Stroke="#E5E1E3" FontFamily="Roboto-Medium"/>
                <badge:SfChip Text="Group" CornerRadius="25" Stroke="#E5E1E3" FontFamily="Roboto-Medium"/>
                <badge:SfChip Text="&#xe70d;" Stroke="#E5E1E3" WidthRequest="40" TextColor="#ABABAB" FontFamily="MaterialAssets" FontSize="20" CornerRadius="25" VerticalTextAlignment="Center"/>
            </badge:SfChipGroup>

                <!--  Searchable List view  -->
                <listView:SfListView Grid.Row="3"
                                 x:Name="ListView"
                                 AllowSwiping="True"
                                 AutoFitMode="Height"
                                 ItemsSource="{Binding ChatItems}"
                                 SelectionGesture="Tap"
                                 SelectionMode="Single" ScrollBarVisibility="Never"
                                 SwipeOffset="156"
                                 VerticalOptions="Fill" BackgroundColor="{AppThemeBinding Light=Transparent, Dark=#1C1B1D}"
                                 SelectionBackground="{AppThemeBinding Light={DynamicResource SelectionBackgroundLight}, Dark={DynamicResource SelectionBackgroundDark}}">

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatItem">
                        <syncEffectsView:SfEffectsView RippleBackground="{AppThemeBinding Light=#E5E1E3, Dark=#3A3741}" TouchDownEffects="Ripple">
                            <Grid RowDefinitions="Auto,1">
                                <Grid Grid.Row="0"
                                        x:Name="Grid"
                                        Padding="16,12"
                                        ColumnDefinitions="Auto, *, Auto"
                                        ColumnSpacing="16"
                                        RowDefinitions="*, *"
                                        RowSpacing="2">

                                    <!--  Recent Sender Profile image  -->
                                    <badge:SfBadgeView x:Name="BadgeView"
                                                       Grid.RowSpan="2">
                                        <badge:SfBadgeView.Content>
                                            <Border
                                                    BackgroundColor="{AppThemeBinding Light=#ebecef, Dark=#1C1B1D}"
                                                    Stroke="{AppThemeBinding Light=Transparent, Dark=#1C1B1D}"
                                                    Style="{DynamicResource ProfileBorderStyle}">
                                                <Image HeightRequest="40" WidthRequest="40">
                                                    <Image.Source>
                                                        <UriImageSource
                                                                CacheValidity="14"
                                                                CachingEnabled="true" 
                                                                Uri="{Binding ResolvedImagePath}"/>
                                                    </Image.Source>
                                                </Image>
                                            </Border>
                                        </badge:SfBadgeView.Content>

                                        <badge:SfBadgeView.BadgeSettings>
                                            <badge:BadgeSettings
                                                Background="{Binding AvailableStatus, Converter={StaticResource StatusColorConverter}}"
                                                BadgeAlignment="End"
                                                Icon="{Binding AvailableStatus, Converter={StaticResource BadgeConverter}}"
                                                Position="BottomRight"
                                                Type="None" Offset="-2,-2"
                                                Stroke="{DynamicResource Gray-Bg}"
                                                StrokeThickness="0"/>
                                        </badge:SfBadgeView.BadgeSettings>
                                    </badge:SfBadgeView>

                                    <!--  Recent Sender Profile Name  -->
                                    <Label
                                            Grid.Column="1"
                                            FontFamily="Roboto-Regular"
                                            FontSize="16"
                                            HorizontalOptions="Start" 
                                            LineBreakMode="NoWrap"
                                            LineHeight="{OnPlatform Default=1.5, iOS=-1}"
                                            Text="{Binding SenderName}"
                                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsUnread}"
                                                         Value="True">
                                                <Setter Property="FontFamily" Value="Roboto-Medium"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsUnread}"
                                                         Value="False">
                                                <Setter Property="FontFamily" Value="Roboto-Regular" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Grid ColumnDefinitions="Auto,*"
                                          Grid.Row="1" ColumnSpacing="4"
                                          Grid.Column="1">

                                        <!--  Recent Message Type  -->
                                        <Label
                                                x:Name="MessageIcon" 
                                                HorizontalOptions="Start" FontSize="14"
                                                HorizontalTextAlignment="Start"
                                                Style="{DynamicResource IconLabelStyle}"
                                                Text="{Binding MessageType, Converter={StaticResource GlyphConverter}, ConverterParameter={x:Reference MessageIcon}}">
                                            <Label.Resources>
                                                <ResourceDictionary>
                                                    <ResourceDictionary.MergedDictionaries>
                                                        <ResourceDictionary Source="../../Styles/FontIcons.xaml"/>
                                                    </ResourceDictionary.MergedDictionaries>
                                                </ResourceDictionary>
                                            </Label.Resources>
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label">
                                                    <Setter Property="FontFamily" Value="Roboto-Regular"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <!--  Recent Message  -->
                                        <Label Grid.Column="1" FontSize="14" 
                                               x:Name="MessageLabel"
                                               LineBreakMode="TailTruncation"
                                               FontFamily="Roboto-Regular"
                                               Style="{DynamicResource SimpleLabelStyle}"
                                               Text="{Binding MessageType, Converter={StaticResource TextConverter}, ConverterParameter={x:Reference MessageLabel}}"/>

                                    </Grid>
                                    <!--  Recent Message Time  -->
                                    <Label
                                            Grid.Column="2" Margin="0,5,0,0"
                                            FontFamily="Roboto-Regular"
                                            HorizontalOptions="Center" FontSize="11"
                                            LineBreakMode="NoWrap"
                                            Style="{DynamicResource SimpleLabelStyle}"
                                            Text="{Binding Time}" TextColor="{AppThemeBinding Light=#3C3B3D, Dark=#878386}"
                                            VerticalOptions="Start"
                                            VerticalTextAlignment="Start">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="True">
                                                <Setter Property="FontFamily" Value="Roboto-Medium"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="False">
                                                <Setter Property="FontAttributes" Value="None"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Grid>
                        </syncEffectsView:SfEffectsView>
                    </DataTemplate>
                    </listView:SfListView.ItemTemplate>

                <listView:SfListView.EndSwipeTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,8"
                            BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                            Stroke="{DynamicResource Transparent}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 30, 0, 0, 30">
                            <Grid>
                                <Grid
                                    Padding="15,0"
                                    ColumnDefinitions="Auto, Auto, Auto"
                                    ColumnSpacing="14"
                                    RowDefinitions="Auto"
                                    VerticalOptions="Center">
                                    <!--Voice call button-->
                                    <buttons:SfButton
                                                    BackgroundColor="{DynamicResource Gray-Bg}"
                                                    CornerRadius="16"
                                                    HeightRequest="32"
                                                    Style="{DynamicResource IconButtonStyle}"
                                                    WidthRequest="32">
                                        <buttons:SfButton.Content>
                                            <DataTemplate>
                                                <Label
                                                     BackgroundColor="Transparent"
                                                     Style="{DynamicResource IconLabelStyle}"
                                                     Text="{DynamicResource PhoneFill}"
                                                     TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                                     VerticalTextAlignment="Center"/>
                                            </DataTemplate>
                                        </buttons:SfButton.Content>
                                    </buttons:SfButton>

                                    <!--Video call button-->
                                    <buttons:SfButton
                                                    Grid.Column="1"
                                                    BackgroundColor="{DynamicResource Gray-Bg}"
                                                    CornerRadius="16"
                                                    HeightRequest="32"
                                                    Style="{DynamicResource IconButtonStyle}"
                                                    WidthRequest="32">
                                        <buttons:SfButton.Content>
                                            <DataTemplate>
                                                <Label
                                                     BackgroundColor="Transparent"
                                                     Style="{DynamicResource IconLabelStyle}"
                                                     Text="{DynamicResource Video}"
                                                     TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                                     VerticalTextAlignment="Center"/>
                                            </DataTemplate>
                                        </buttons:SfButton.Content>
                                    </buttons:SfButton>

                                    <!--Settings button-->
                                    <buttons:SfButton
                                                    Grid.Column="2"
                                                    BackgroundColor="{DynamicResource Gray-Bg}"
                                                    CornerRadius="16"
                                                    HeightRequest="32"
                                                    Style="{DynamicResource IconButtonStyle}"
                                                    WidthRequest="32">
                                        <buttons:SfButton.Content>
                                            <DataTemplate>
                                                <Label
                                                    BackgroundColor="Transparent"
                                                    Style="{DynamicResource IconLabelStyle}"
                                                    Text="{DynamicResource Menu}"
                                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                                    VerticalTextAlignment="Center"/>
                                            </DataTemplate>
                                        </buttons:SfButton.Content>
                                    </buttons:SfButton>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </listView:SfListView.EndSwipeTemplate>
            </listView:SfListView>
        </Grid>
    </ContentView.Content>
</ContentView>