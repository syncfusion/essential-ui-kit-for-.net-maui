<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Bookmark.ArticleBookmarkPage"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:model="clr-namespace:EssentialMAUIUIKit.Models"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters"
             x:DataType="local:ArticleBookmarkViewModel">
    <ContentView.BindingContext>
        <local:ArticleBookmarkViewModel/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <ResourceDictionary>
            <converter:BooleanToStringConverter x:Key="boolToStringConverter" />
            <converter:BooleanToColorConverter x:Key="boolToColorConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>

        <ScrollView Margin="10" VerticalScrollBarVisibility="Never"
                    WidthRequest="{OnPlatform WinUI=680, MacCatalyst=680}">
            <!--  Featured blog list  -->
            <StackLayout
                x:Name="StackLayout"
                Padding="0,16"
                BindableLayout.ItemsSource="{Binding LatestStories}"
                Spacing="16">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="model:Story">
                        <Border StrokeShape="RoundRectangle 10" Margin="10,0"
                                BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArticleItemTapped" />
                            </Border.GestureRecognizers>
                            <Border.Shadow>
                                <!--Combined Shadow Effect-->
                                <Shadow Brush="{AppThemeBinding Dark={DynamicResource SeparatorColorDark}, Light={DynamicResource SeparatorColorLight}}" Offset="0,1" Radius="3" />
                            </Border.Shadow>
                            <Grid
                                ColumnSpacing="16"
                                HeightRequest="110"
                                RowDefinitions="*, Auto, Auto"
                                RowSpacing="0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{OnIdiom Desktop=0.25*, Tablet=0.25*, Phone=0.5*}" />
                                    <ColumnDefinition Width="{OnIdiom Desktop=0.8*, Tablet=0.8*, Phone=0.6*}" />
                                    <ColumnDefinition Width="{OnIdiom Desktop=0.1*, Tablet=0.1*, Phone=0.1*}" />
                                </Grid.ColumnDefinitions>

                                <!--  Blog image  -->
                                <Image
                                    Grid.RowSpan="3"
                                    Aspect="AspectFill"
                                    BackgroundColor="{DynamicResource Gray-200}"
                                    HeightRequest="110"
                                    Source="{Binding ImagePath}"
                                    VerticalOptions="Center"/>

                                <!--  Blog title  -->
                                <Label
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    FontSize="14" FontFamily="Roboto-Medium"
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Style="{DynamicResource TitleLabelStyle}"
                                    Text="{Binding Name}"/>

                                <!--  Author name  -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    FontFamily="Roboto-Medium"
                                    FontSize="12"
                                    LineHeight="{OnPlatform Default=-1,
                                Android=1.5}"
                                    Text="{Binding Author}"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"/>

                                <!--  Published date and Average reading time  -->
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,2,0,8"
                                    FontSize="12"
                                    LineHeight="{OnPlatform Default=-1, Android=1.5}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Date}" TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                  FontFamily="Roboto-Regular"/>
                                            <Span Text=" | " TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                  FontFamily="Roboto-Regular"/>
                                            <Span Text="{Binding AverageReadingTime}" TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                  FontFamily="Roboto-Regular"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!--  Bookmark button driven by the bound command  -->
                                <buttons:SfButton Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="{OnIdiom Desktop='10,0,0,0', Tablet='10,0,0,0', Phone='0,0,10,0'}"
                                                Padding="0"
                                                CornerRadius="25"
                                                FontSize="16"
                                                HeightRequest="35"
                                                HorizontalOptions="End"
                                                Style="{DynamicResource IconButtonStyle}"
                                                Text="{Binding IsBookmarked, Converter={StaticResource boolToStringConverter}, ConverterParameter=0}"
                                                TextColor="{Binding IsBookmarked, Converter={StaticResource boolToColorConverter}, ConverterParameter=9}"
                                                VerticalOptions="Start"
                                                Clicked="ArticleBookmarkButton_Clicked"
                                                WidthRequest="35">
                                </buttons:SfButton>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>
        </ScrollView>
    </ContentView.Content>
</ContentView>