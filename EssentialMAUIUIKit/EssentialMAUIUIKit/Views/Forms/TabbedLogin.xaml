<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="EssentialMAUIUIKit.Views.Forms.TabbedLogin"
    xmlns:button="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:dataForm="clr-namespace:Syncfusion.Maui.DataForm;assembly=Syncfusion.Maui.DataForm"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.Toolkit.TabView;assembly=Syncfusion.Maui.Toolkit"
    xmlns:checkBox="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:local="clr-namespace:EssentialMAUIUIKit"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    x:DataType="local:TabbedLoginViewModel">

    <ContentView.BindingContext>
        <local:TabbedLoginViewModel />
    </ContentView.BindingContext>
    <ContentView.Resources>
        <Style TargetType="tabView:SfTabItem">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="TextColor"
                Value="{AppThemeBinding Light={DynamicResource PrimaryColorLight},
                                        Dark={DynamicResource PrimaryColorDark}}" />

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup>

                        <!-- Unselected Tab -->
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="FontFamily"
                                    Value="Roboto-Regular" />
                            </VisualState.Setters>
                        </VisualState>

                        <!-- Selected Tab -->
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="FontFamily"
                                    Value="Roboto-Medium" />
                            </VisualState.Setters>
                        </VisualState>

                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>

    <ContentView.Content>
        <Grid VerticalOptions="Fill" HorizontalOptions="Fill" BackgroundColor="#e9ecf0">

            <Grid.ColumnDefinitions>

                <!-- Left Illustration -->
                <ColumnDefinition Width="{OnPlatform Android=0,
                                             iOS=0,
                                             WinUI=*,
                                             MacCatalyst=*}" />

                <!-- Right Form -->
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->

            <Border Grid.Column="0" IsVisible="{OnPlatform Android=False,
                                           iOS=False,
                                           WinUI=True,
                                           MacCatalyst=True}">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">

                        <GradientStop Color="#630ED4" Offset="0.0" />

                        <GradientStop Color="#7C3AED" Offset="0.5" />

                        <GradientStop Color="#732EE4" Offset="1.0" />

                    </LinearGradientBrush>
                </Border.Background>

                <VerticalStackLayout Margin="50,0,0,0" MaximumWidthRequest="700" HorizontalOptions="Start">

                    <Border Margin="30,70,0,14" HorizontalOptions="Start" BackgroundColor="#955ee6" Padding="10,6"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16">

                        <Label Text="Version 2.0 now live" FontFamily="Roboto-Medium" FontSize="14"
                            TextColor="#FCF8FA" />

                    </Border>

                    <Label Text="Shape the future of digital growth." Margin="30,0,0,20" MaximumWidthRequest="400"
                        HorizontalOptions="Start" FontFamily="Roboto-Medium" FontSize="36" TextColor="#FCF8FA" />

                    <Label
                        Text="Experience the next generation of modern technology interfaces. Streamlined, powerful and designed for builders of the future."
                        Margin="30,0,0,0" MaximumWidthRequest="390" HorizontalOptions="Start"
                        FontFamily="Roboto-Regular" FontSize="14" TextColor="#FCF8FA" />

                    <Image Source="illustration.png" Margin="0,20,0,0" MaximumWidthRequest="448"
                        MaximumHeightRequest="351" Aspect="AspectFit" HorizontalOptions="Start" />

                </VerticalStackLayout>

            </Border>

            <Border Grid.Column="1" Padding="{OnIdiom Phone=0, Tablet='20,0,20,0', Desktop='20,0,20,0'}"
                BackgroundColor="White" StrokeThickness="0.7" StrokeShape="RoundRectangle 12" VerticalOptions="Center"
                HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#29000000"
                            Offset="0,4"
                            Radius="4"
                            Opacity="0.15" />
                </Border.Shadow>
                <Grid VerticalOptions="Center" WidthRequest="{OnIdiom Phone=380, Tablet=430, Desktop=440}"
                    HorizontalOptions="Center">
                    <tabView:SfTabView Grid.Row="0" HorizontalOptions="Center" VerticalOptions="Center">

                        <tabView:SfTabItem Header="Login"
                             >
                            <tabView:SfTabItem.Content>
                                <StackLayout VerticalOptions="Start">
                                    <Label Text="Hello, Welcome back" Margin="0,12,0,20" FontSize="16" LineHeight="1.5"
                                        CharacterSpacing="0.15"
                                        TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                        FontFamily="Roboto-Medium" HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center" />

                                    <StackLayout Spacing="0" Margin="0" Padding="0" VerticalOptions="Fill"
                                        HorizontalOptions="Fill">


                                        <dataForm:SfDataForm x:Name="logInForm" DataObject="{Binding LoginInfo}" 
                                            MinimumHeightRequest="132" LayoutType="TextInputLayout" Background="White">
                                            <dataForm:SfDataForm.TextInputLayoutSettings>
                                                <dataForm:TextInputLayoutSettings ShowHelperText="False"
                                                    IsHintAlwaysFloated="True" EnableFloating="False" InputViewPadding="18,0,0,8"
                                                    Stroke="{AppThemeBinding Light={DynamicResource ContentTextColorDark}, Dark={DynamicResource SecondaryTextColorLight}}"
                                                    OutlineCornerRadius="3">
                                                    <dataForm:TextInputLayoutSettings.HelperTextStyle>
                                                        <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" />
                                                    </dataForm:TextInputLayoutSettings.HelperTextStyle>
                                                </dataForm:TextInputLayoutSettings>
                                            </dataForm:SfDataForm.TextInputLayoutSettings>
                                            <dataForm:SfDataForm.LabelTextStyle>
                                                <dataForm:DataFormTextStyle
                                                    TextColor="{AppThemeBinding Light={DynamicResource PlaceholderTextColorLight}, Dark={DynamicResource PlaceholderTextColorDark}}"
                                                    FontFamily="Roboto-Regular" FontSize="16" />
                                            </dataForm:SfDataForm.LabelTextStyle>
                                            <dataForm:SfDataForm.EditorTextStyle>
                                                <dataForm:DataFormTextStyle
                                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                    FontFamily="Roboto-Regular" FontSize="16" />
                                            </dataForm:SfDataForm.EditorTextStyle>
                                        </dataForm:SfDataForm>
                                        <Grid
                                            Margin="{OnIdiom Desktop='0,12,0,0', Phone='0,12,0,0', Default='0,12,0,0' }"
                                            Padding="0">
                                            <checkBox:SfCheckBox Text="Remember me"
                                             UncheckedColor="{AppThemeBinding Light={DynamicResource ContentTextColorDark}, Dark={DynamicResource SecondaryTextColorLight}}"
                                             FontSize="14"
                                             FontFamily="Roboto-Regular"
                                             TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                             TickColor="{DynamicResource White}"
                                             CheckedColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                             HorizontalOptions="Start"
                                             Margin="10,0,20,0" />
                                            <button:SfButton Text="Forgot Password?"
                                             FontSize="14"
                                             Background="Transparent"
                                             TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                             HorizontalOptions="End"
                                             FontFamily="Roboto-Medium"
                                             WidthRequest="130"
                                             HeightRequest="25"
                                             Margin="0,0,14,0" />
                                        </Grid>

                                        <button:SfButton x:Name="tabbedLoginButton" Text="Login" Margin="20,15,20,24"
                                            Style="{DynamicResource FormsButtonStyle}" FontSize="14"
                                            HorizontalOptions="Fill" />
                                        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center">
                                            <BoxView BackgroundColor="{AppThemeBinding Light=#E5E1E3, Dark=#474648}"
                                                HeightRequest="1" WidthRequest="81" HorizontalOptions="Fill"
                                                VerticalOptions="Center" />
                                            <Label Text="Or login with" FontSize="14"
                                                TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                FontFamily="Roboto-Regular" LineHeight="1.42" CharacterSpacing="0.25"
                                                HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                                Margin="8" />
                                            <BoxView BackgroundColor="{AppThemeBinding Light=#E5E1E3, Dark=#474648}"
                                                HeightRequest="1" WidthRequest="81" VerticalOptions="Center"
                                                HorizontalOptions="Fill" />
                                        </HorizontalStackLayout>

                                    </StackLayout>
                                    <StackLayout Margin="0,15,0,0">

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.5*" />
                                                <ColumnDefinition Width="0.5*" />
                                            </Grid.ColumnDefinitions>

                                            <button:SfButton Grid.Column="0" Text="Google"
                                                Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                StrokeThickness="2"
                                                WidthRequest="{OnIdiom Phone=165, Tablet=190, Desktop=190}"
                                                TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                ImageSource="google.png" HorizontalOptions="End"
                                                HorizontalTextAlignment="Justify" ImageAlignment="Default"
                                                ImageSize="16" ShowIcon="True" FontFamily="Roboto-Regular"
                                                Background="Transparent" />
                                            <button:SfButton Grid.Column="1" Text="Facebook"
                                                Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                StrokeThickness="2"
                                                WidthRequest="{OnIdiom Phone=165, Tablet=190, Desktop=190}"
                                                TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                ImageSource="facebooktabbed.png" HorizontalOptions="Start"
                                                HorizontalTextAlignment="Justify" ImageAlignment="Default"
                                                ImageSize="16" ShowIcon="True" FontFamily="Roboto-Regular"
                                                Background="Transparent" />
                                        </Grid>
                                        <HorizontalStackLayout Margin="{OnIdiom Phone='0,24,0,32', Default='0,16,0,20'}"
                                            VerticalOptions="End" HorizontalOptions="Center">


                                            <Label Text="Don't have an account?"
                                                TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                FontFamily="Roboto-Regular" FontSize="14"  
                                                CharacterSpacing="0.25" HorizontalOptions="Center"
                                                VerticalOptions="Start" Margin="10,10,0,10" />
                                            <button:SfButton Text="Sign up" WidthRequest="70" FontSize="14"
                                                Background="Transparent" 
                                                Style="{DynamicResource TransparentButtonStyle}" VerticalOptions="Start"
                                                FontFamily="Roboto-Medium" Margin="{OnIdiom Default='0,2,0,10', Phone='0,-1,0,10'}"
                                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}" />
                                        </HorizontalStackLayout>

                                    </StackLayout>

                                </StackLayout>
                            </tabView:SfTabItem.Content>
                        </tabView:SfTabItem>
                        <tabView:SfTabItem Header="Sign Up" TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight},
                                        Dark={DynamicResource PrimaryColorDark}}"
                             >

                            <tabView:SfTabItem.Content>
                                <StackLayout>

                                    <Label Text="Create your new account" Margin="0,15,0,15" FontSize="16"
                                        LineHeight="1.5" CharacterSpacing="0.15"
                                        TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                        FontFamily="Roboto-Medium" HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center" />

                                    <dataForm:SfDataForm x:Name="signupForm" DataObject="{Binding SignUpInfo}"
                                        MinimumHeightRequest="264" LayoutType="TextInputLayout">
                                        <dataForm:SfDataForm.TextInputLayoutSettings>
                                            <dataForm:TextInputLayoutSettings IsHintAlwaysFloated="True" EnableFloating="False"
                                                InputViewPadding="18,0,0,8"
                                                Stroke="{AppThemeBinding Light={DynamicResource ContentTextColorDark}, Dark={DynamicResource SecondaryTextColorLight}}"
                                                OutlineCornerRadius="3">
                                            </dataForm:TextInputLayoutSettings>
                                        </dataForm:SfDataForm.TextInputLayoutSettings>
                                        <dataForm:SfDataForm.LabelTextStyle>
                                            <dataForm:DataFormTextStyle
                                                TextColor="{AppThemeBinding Light={DynamicResource PlaceholderTextColorLight}, Dark={DynamicResource PlaceholderTextColorDark}}"
                                                FontFamily="Roboto-Regular" FontSize="14" />
                                        </dataForm:SfDataForm.LabelTextStyle>
                                        <dataForm:SfDataForm.ValidMessageLabelTextStyle>
                                            <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" />
                                        </dataForm:SfDataForm.ValidMessageLabelTextStyle>
                                        <dataForm:SfDataForm.EditorTextStyle>
                                            <dataForm:DataFormTextStyle
                                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                FontFamily="Roboto-Regular" FontSize="14" />
                                        </dataForm:SfDataForm.EditorTextStyle>
                                    </dataForm:SfDataForm>
                                    <Grid Margin="-10,-15,0,0" HorizontalOptions="Fill">
                                        <checkBox:SfCheckBox Text="I agree to the Terms and Conditions " FontSize="14"
                                            FontFamily="Roboto-Regular"
                                            TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                            TickColor="{DynamicResource White}"
                                            UncheckedColor="{AppThemeBinding Light={DynamicResource ContentTextColorDark}, Dark={DynamicResource ContentTextColorDark}}"
                                            HorizontalOptions="Start" Margin="18,13,0,0" />

                                    </Grid>
                                    <button:SfButton x:Name="signupButton" Margin="25,20,25,5" Grid.Row="1"
                                        Text="Create Account" FontSize="14" Style="{DynamicResource FormsButtonStyle}"
                                        HorizontalOptions="Fill" />

                                </StackLayout>

                            </tabView:SfTabItem.Content>


                        </tabView:SfTabItem>


                    </tabView:SfTabView>

                </Grid>
            </Border>
        </Grid>

    </ContentView.Content>
    <ContentView.Behaviors>
        <local:TabbedLoginBehavior />
    </ContentView.Behaviors>

</ContentView>
