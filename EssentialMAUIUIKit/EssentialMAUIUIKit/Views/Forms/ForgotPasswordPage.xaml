<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Forms.ForgotPasswordPage"
             xmlns:dataForm="clr-namespace:Syncfusion.Maui.DataForm;assembly=Syncfusion.Maui.DataForm"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:button="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             x:DataType="local:ForgotPasswordViewModel">
    <ContentView.BindingContext>
        <local:ForgotPasswordViewModel />
    </ContentView.BindingContext>

    <ContentView.Content>
        <Grid x:Name="mainGrid" ColumnDefinitions="{OnPlatform WinUI='5*,5*', MacCatalyst='5*,5*', Android='*', iOS='*'}"
              BackgroundColor="#e9ecf0">
            <Border x:Name="bannerPage" IsVisible="{OnPlatform WinUI=True, MacCatalyst=True, iOS=False, Android=False}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,0">
                        <GradientStop Color="#630ED4"
                                      Offset="0.0" />
                        <GradientStop Color="#7C3AED"
                                      Offset="0.5" />
                        <GradientStop Color="#732EE4"
                                      Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <StackLayout BackgroundColor="Transparent"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             WidthRequest="500">

                    <Border StrokeShape="RoundRectangle 16"
                            Margin="32,70,0,20"
                            HorizontalOptions="Start"
                            BackgroundColor="#955ee6"
                            Padding="10,6,10,6"
                            StrokeThickness="0">
                        <Label Text="Version 2.0 now live"
                               TextColor="{DynamicResource SentMessageColorLight}"
                               FontFamily="Roboto-Medium"
                               FontSize="14" />
                    </Border>

                    <Grid WidthRequest="400"
                          RowDefinitions="Auto,Auto"
                          HorizontalOptions="Start">
                        <Label Text="Shape the future of digital growth."
                               TextColor="{DynamicResource SentMessageColorLight}"
                               HorizontalOptions="Start"
                               Margin="32,0,0,20"
                               FontFamily="Roboto-Medium"
                               FontSize="36" />
                        <Label Text="Experience the next generation of modern technology interfaces. Streamlined, powerful and designed for builders of the future."
                               TextColor="{DynamicResource SentMessageColorLight}"
                               Grid.Row="1"
                               Margin="32,0,0,15"
                               HorizontalOptions="Start"
                               FontFamily="Roboto-Regular"
                               FontSize="14" />
                    </Grid>
                    <Image Source="illustration.png"
                           HorizontalOptions="Start"
                           HeightRequest="351"
                           WidthRequest="448" />
                </StackLayout>
            </Border>

            <Border x:Name="formsPage"
                    Grid.Column="1"
                    Padding="{OnIdiom Phone=0, Tablet='20,0,20,0', Desktop='20,0,20,0'}"
                    BackgroundColor="White"
                    StrokeThickness="0.7"
                    StrokeShape="RoundRectangle 12"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#80000000"
                            Offset="0,6"
                            Radius="3"
                            Opacity="0.3" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      VerticalOptions="Center"
                      HorizontalOptions="Center"
                      WidthRequest="{OnIdiom Phone=380, Tablet=430, Desktop=440}">
                    <Label Grid.Row="0"
                           Text="Forgot Your Password?"
                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorLight}}"
                           FontSize="22"
                           Margin="0,20,0,0"
                           FontFamily="Roboto-Medium"
                           HorizontalOptions="Center" />
                    <Label Grid.Row="1"
                           Text="Please enter your mail id to reset the password"
                           FontFamily="Roboto-Regular"
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                           Padding="0,15,0,20" />

                    <dataForm:SfDataForm Grid.Row="2"
                                         x:Name="dataForm"
                                         DataObject="{Binding ContactsInfo}"
                                         MinimumHeightRequest="70"
                                         BackgroundColor="White"
                                         LayoutType="TextInputLayout"
                                         ValidationMode="PropertyChanged">
                        <dataForm:SfDataForm.TextInputLayoutSettings>
                            <dataForm:TextInputLayoutSettings IsHintAlwaysFloated="True"
                                                              InputViewPadding="18,0,0,5"
                                                              OutlineCornerRadius="3">
                                <dataForm:TextInputLayoutSettings.HelperTextStyle>
                                    <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" />
                                </dataForm:TextInputLayoutSettings.HelperTextStyle>
                            </dataForm:TextInputLayoutSettings>
                        </dataForm:SfDataForm.TextInputLayoutSettings>
                        <dataForm:SfDataForm.LabelTextStyle>
                            <dataForm:DataFormTextStyle TextColor="{AppThemeBinding Light={DynamicResource PlaceholderTextColorLight}, Dark={DynamicResource PlaceholderTextColorDark}}"
                                                        FontFamily="Roboto-Regular"
                                                        FontSize="14" />
                        </dataForm:SfDataForm.LabelTextStyle>
                        <dataForm:SfDataForm.ErrorLabelTextStyle>
                            <dataForm:DataFormTextStyle TextColor="#D32F2F"
                                                        FontFamily="Roboto-Regular" />
                        </dataForm:SfDataForm.ErrorLabelTextStyle>
                        <dataForm:SfDataForm.ValidMessageLabelTextStyle>
                            <dataForm:DataFormTextStyle FontFamily="Roboto-Regular" />
                        </dataForm:SfDataForm.ValidMessageLabelTextStyle>
                        <dataForm:SfDataForm.EditorTextStyle>
                            <dataForm:DataFormTextStyle TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorLight}}"
                                                        FontFamily="Roboto-Regular"
                                                        FontSize="14" />
                        </dataForm:SfDataForm.EditorTextStyle>
                    </dataForm:SfDataForm>

                    <button:SfButton x:Name="sendButton"
                                     Grid.Row="3"
                                     Text="Send OTP"
                                     FontFamily="Roboto-Medium"
                                     FontSize="14"
                                     Margin="20,20,20,30"
                                     Style="{DynamicResource FormsButtonStyle}"
                                     HorizontalOptions="Fill" />
                </Grid>
            </Border>
        </Grid>
    </ContentView.Content>

    <ContentView.Behaviors>
        <local:ForgotPasswordBehavior />
    </ContentView.Behaviors>
</ContentView>