<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:button="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:checkBox="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:dataForm="clr-namespace:Syncfusion.Maui.DataForm;assembly=Syncfusion.Maui.DataForm"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:local="clr-namespace:EssentialMAUIUIKit"
    xmlns:rotator="clr-namespace:Syncfusion.Maui.Rotator;assembly=Syncfusion.Maui.Rotator"
    xmlns:picker="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    x:Class="EssentialMAUIUIKit.Views.Forms.CardPaymentPage"
    x:DataType="local:CardPaymentViewModel">

    <ContentView.BindingContext>
        <local:CardPaymentViewModel />
    </ContentView.BindingContext>

    <ContentView.Content>

        <Grid>

            <Grid.ColumnDefinitions>

                <!-- Left Illustration -->
                <ColumnDefinition Width="{OnPlatform Android=0,
                                             iOS=0,
                                             WinUI=*,
                                             MacCatalyst=*}" />

                <!-- Right Form -->
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    IsVisible="{OnPlatform Android=False,
                                           iOS=False,
                                           WinUI=True,
                                           MacCatalyst=True}">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                         EndPoint="1,0">

                        <GradientStop Color="#630ED4"
                      Offset="0.0" />

                        <GradientStop Color="#7C3AED"
                      Offset="0.5" />

                        <GradientStop Color="#732EE4"
                      Offset="1.0" />

                    </LinearGradientBrush>
                </Border.Background>

                <VerticalStackLayout Margin="50,0,0,0" MaximumWidthRequest="700"
                     HorizontalOptions="Start">

                    <Border Margin="30,70,0,14"
            HorizontalOptions="Start"
            BackgroundColor="#955ee6"
            Padding="10,6"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 16">

                        <Label Text="Version 2.0 now live"
               FontFamily="Roboto-Medium"
               FontSize="14"
               TextColor="#FCF8FA" />

                    </Border>

                    <Label Text="Shape the future of digital growth."
           Margin="30,0,0,20"
           MaximumWidthRequest="400"
           HorizontalOptions="Start"
           FontFamily="Roboto-Medium"
           FontSize="36"
           TextColor="#FCF8FA" />

                    <Label Text="Experience the next generation of modern technology interfaces. Streamlined, powerful and designed for builders of the future."
           Margin="30,0,0,0"
           MaximumWidthRequest="390"
           HorizontalOptions="Start"
           FontFamily="Roboto-Regular"
           FontSize="14"
           TextColor="#FCF8FA" />

                    <Image Source="illustration.png"
           Margin="0,20,0,0"
           MaximumWidthRequest="448"
           MaximumHeightRequest="351"
           Aspect="AspectFit"
           HorizontalOptions="Start" />

                </VerticalStackLayout>

            </Border>


            <ScrollView Grid.Column="1"
    VerticalScrollBarVisibility="Never"
    HorizontalOptions="Center"
    VerticalOptions="{OnPlatform Default=Center, Android=Start, iOS=Start}">


                <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Margin="0">


                    <Grid
                MaximumWidthRequest="{OnPlatform WinUI=386, MacCatalyst=400}"
                            HorizontalOptions="Fill"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                        <!-- Form -->

                        <Grid Margin="{OnPlatform WinUI='0,30,0,0', MacCatalyst='0,30,0,0', Android='20,30,20,0', iOS='20,30,20,20'}"
                           
                    Grid.Row="1"
                    RowSpacing="0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Card Number -->

                            <VerticalStackLayout
                        Grid.Row="0"
                                Margin="0,0,0,16"
                        Spacing="0">

                                <Label
                            Text="Card number" FontFamily="Roboto-Regular" LineHeight="1.42"
                                            CharacterSpacing="0.25" FontSize="14"
                                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                            VerticalTextAlignment="Start" />

                                <inputLayout:SfTextInputLayout
                            ContainerType="Outlined"
                            EnableFloating="False"
                            OutlineCornerRadius="4" FocusedStrokeThickness="1" UnfocusedStrokeThickness="1" InputViewPadding="{OnPlatform WinUI='16,6,16,6', MacCatalyst='16,6,16,6', Android='14', iOS='14'}"
                                    Stroke="{AppThemeBinding Light={DynamicResource ContentTextColorDark}, Dark={DynamicResource SecondaryTextColorLight}}"
                            Hint="Enter card number"
                            ReserveSpaceForAssistiveLabels="{Binding ContactsInfo.ReserveCardNumberSpace}"
                            HasError="{Binding ContactsInfo.HasCardNumberError}"
                            ErrorText="{Binding ContactsInfo.CardNumberError}">

                                    <inputLayout:SfTextInputLayout.HintLabelStyle>
                                        <inputLayout:LabelStyle FontSize="16" FontFamily="Roboto-Regular"
                                                TextColor="{AppThemeBinding Light={DynamicResource PlaceholderTextColorLight}, Dark={DynamicResource PlaceholderTextColorDark}}" />
                                    </inputLayout:SfTextInputLayout.HintLabelStyle>
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#D32F2F" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>

                                    <editors:SfMaskedEntry Mask="0000 0000 0000"
                                        Value="{Binding ContactsInfo.CardNumber}"
                                        Margin="0"
                                        Padding="0"
                                                           
                                        HidePromptOnLeave="True"
                                        VerticalOptions="Fill"
                                        HorizontalOptions="Fill"
                                        MaskType="Simple"                            
                                         />


                                </inputLayout:SfTextInputLayout>

                            </VerticalStackLayout>

                            <!-- Expiry Date + CVV -->

                            <Grid
                        Grid.Row="1"
                                Margin="0,0,0,16"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="16">

                                <!-- Expiry Date -->

                                <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="0">

                                    <Label
                                Text="Exp date" FontFamily="Roboto-Regular" LineHeight="1.42"
                                            CharacterSpacing="0.25" FontSize="14"
                                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                            VerticalTextAlignment="Start" />

                                    <inputLayout:SfTextInputLayout
                                Hint="MM/YYYY"
                                ContainerType="Outlined"
                                OutlineCornerRadius="4" FocusedStrokeThickness="1" UnfocusedStrokeThickness="1" InputViewPadding="{OnPlatform WinUI='16,6,16,6', MacCatalyst='16,6,16,6', Android='14', iOS='14'}"
                                EnableFloating="False"
                                ReserveSpaceForAssistiveLabels="{Binding ContactsInfo.ReserveExpiryDateSpace}"
                                        Stroke="{AppThemeBinding Light={DynamicResource ContentTextColorDark}, Dark={DynamicResource SecondaryTextColorLight}}"
                                HasError="{Binding ContactsInfo.HasExpiryDateError}"
                                ErrorText="{Binding ContactsInfo.ExpiryDateError}">
                                        <inputLayout:SfTextInputLayout.HintLabelStyle>
                                            <inputLayout:LabelStyle FontSize="16" FontFamily="Roboto-Regular"
                                                TextColor="{AppThemeBinding Light={DynamicResource PlaceholderTextColorLight}, Dark={DynamicResource PlaceholderTextColorDark}}" />
                                        </inputLayout:SfTextInputLayout.HintLabelStyle>
                                        <editors:SfMaskedEntry Mask="00/0000"
                                            Value="{Binding ContactsInfo.ExpiryDate}"
                                            MaskType="Simple"
                                            Margin="0"
                                            Padding="0"
                                            HidePromptOnLeave="True"
                                            VerticalOptions="Fill"
                                            HorizontalOptions="Fill"
                                             />
                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <inputLayout:LabelStyle TextColor="#D32F2F" />
                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>

                                    </inputLayout:SfTextInputLayout>

                                </VerticalStackLayout>

                                <!-- CVV -->

                                <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="0">

                                    <Label
                                Text="CVV" FontFamily="Roboto-Regular" LineHeight="1.42"
                                            CharacterSpacing="0.25" FontSize="14"
                                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                            VerticalTextAlignment="Start"  />


                                    <inputLayout:SfTextInputLayout 
                                        
                                ContainerType="Outlined"
                                EnableFloating="False"
                                Hint="Enter CVV"
                                OutlineCornerRadius="4" FocusedStrokeThickness="1" UnfocusedStrokeThickness="1" InputViewPadding="{OnPlatform WinUI='16,6,16,6', MacCatalyst='16,6,16,6', Android='14', iOS='14'}"
                                ReserveSpaceForAssistiveLabels="{Binding ContactsInfo.ReserveCVVSpace}"
                                HasError="{Binding ContactsInfo.HasCVVError}"
                                ErrorText="{Binding ContactsInfo.CVVError}"
                                Stroke="{AppThemeBinding Light={DynamicResource ContentTextColorDark}, Dark={DynamicResource SecondaryTextColorLight}}"
                                HorizontalOptions="Fill" VerticalOptions="Fill">
                                        <inputLayout:SfTextInputLayout.HintLabelStyle>
                                            <inputLayout:LabelStyle FontSize="16" FontFamily="Roboto-Regular"
                                                TextColor="{AppThemeBinding Light={DynamicResource PlaceholderTextColorLight}, Dark={DynamicResource PlaceholderTextColorDark}}" />
                                        </inputLayout:SfTextInputLayout.HintLabelStyle>
                                        <editors:SfMaskedEntry Mask="000"
                                            Value="{Binding ContactsInfo.CVV}"
                                           MaskType="Simple"
                                            Margin="0"
                                            Padding="0"
                                            HidePromptOnLeave="True"
                                            VerticalOptions="Fill"
                                            HorizontalOptions="Fill" />
                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <inputLayout:LabelStyle TextColor="#D32F2F" />
                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>

                                    </inputLayout:SfTextInputLayout>


                                </VerticalStackLayout>

                            </Grid>

                            <!-- Card Holder -->

                            <VerticalStackLayout
                        Grid.Row="2"
                        Spacing="0">

                                <Label
                            Text="Name on card" FontFamily="Roboto-Regular" LineHeight="1.42"
                                            CharacterSpacing="0.25" FontSize="14"
                                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                            VerticalTextAlignment="Start" />

                                <inputLayout:SfTextInputLayout
                            ContainerType="Outlined"
                            EnableFloating="False"
                            Hint="Enter name"
                            OutlineCornerRadius="4" FocusedStrokeThickness="1" UnfocusedStrokeThickness="1" InputViewPadding="16, 0, 16, 0"
                            ReserveSpaceForAssistiveLabels="{Binding ContactsInfo.ReserveCardHolderNameSpace}"
                                    Stroke="{AppThemeBinding Light={DynamicResource ContentTextColorDark}, Dark={DynamicResource SecondaryTextColorLight}}"
                            HasError="{Binding ContactsInfo.HasCardHolderNameError}"
                            ErrorText="{Binding ContactsInfo.CardHolderNameError}">

                                    <inputLayout:SfTextInputLayout.HintLabelStyle>
                                        <inputLayout:LabelStyle FontSize="16" FontFamily="Roboto-Regular"
        TextColor="{AppThemeBinding Light={DynamicResource PlaceholderTextColorLight}, Dark={DynamicResource PlaceholderTextColorDark}}" />
                                    </inputLayout:SfTextInputLayout.HintLabelStyle>


                                    <Entry
                                FontFamily="Roboto-Regular"
                                FontSize="16"
                                Text="{Binding ContactsInfo.CardHolderName}" />
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#D32F2F" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>

                                </inputLayout:SfTextInputLayout>

                            </VerticalStackLayout>

                        </Grid>

                        <!-- Save Card -->

                        <checkBox:SfCheckBox
                    Grid.Row="2"
                    Margin="{OnPlatform WinUI='0,10,20,0', MacCatalyst='0,10,20,0', Android='10,4,20,0',iOS='10,4,20,0'}"
                    CheckedColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight},
                                                Dark={DynamicResource PrimaryColorDark}}"
                    FontFamily="Roboto-Regular"
                    FontSize="14"
                    HorizontalOptions="Start"
                    Text="Save card"
                    TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight},
                                                 Dark={DynamicResource SecondaryTextColorDark}}"
                    TickColor="{DynamicResource White}" />

                        <!-- Payment Button -->

                        <button:SfButton
                    x:Name="addButton"
                    Grid.Row="3"
                    Margin="10,20,10,20"
                    Command="{Binding MakePaymentCommand}"
                    HorizontalOptions="Fill"
                    Style="{DynamicResource FormsButtonStyle}"
                    Text="Make Payment"
                    VerticalOptions="Center" />

                        <!-- Saved Cards Header -->

                        <Label
                    Grid.Row="4"
                    Margin="20,10,20,10"
                    FontFamily="Roboto-Medium"
                    FontSize="14"
                    HorizontalOptions="Start"
                    Text="Saved cards"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight},
                                                 Dark={DynamicResource PrimaryTextColorDark}}" />

                        <!-- Rotator -->
                        <rotator:SfRotator
                                    x:Name="sfRotator"
                                    Grid.Row="5"
                                    Margin="10,0"
                                    BackgroundColor="Transparent"
                                    DotsStroke="Transparent"
                                    DotPlacement="OutSide"
                                    HeightRequest="{OnPlatform Default=230, MacCatalyst=250}"
                                    ItemsSource="{Binding CardDetails}"
                                    NavigationStripMode="Dots"
                                    NavigationStripPosition="Bottom"
                                    SelectedDotColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight},
                                                                       Dark={DynamicResource PrimaryColorDark}}"
                                    UnselectedDotColor="{DynamicResource Gray-200}"
                                    VerticalOptions="Start">

                            <rotator:SfRotator.SelectedIndex>
                                <Binding
                            x:DataType="rotator:SfRotator"
                            Mode="TwoWay"
                            Path="SelectedIndex" />
                            </rotator:SfRotator.SelectedIndex>

                            <rotator:SfRotator.ItemTemplate>

                                <DataTemplate x:DataType="local:CardPaymentInfo">

                                    <Border
                                Margin="10"
                                Padding="0"
                                HeightRequest="190"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="340">

                                        <Border.Background>
                                            <LinearGradientBrush>
                                                <GradientStop
                                            Offset="0.0"
                                            Color="{DynamicResource PrimaryGradient}" />
                                                <GradientStop
                                            Offset="1.0"
                                            Color="{DynamicResource SecondaryGradient}" />
                                            </LinearGradientBrush>
                                        </Border.Background>

                                        <Grid Margin="20">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height=".5*" />
                                                <RowDefinition Height=".5*" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0"
                                          ColumnDefinitions="*,Auto">

                                                <!-- Left Content -->
                                                <VerticalStackLayout Grid.Column="0">

                                                    <Label
                                                FontFamily="Roboto-Medium"
                                                FontSize="14"
                                                HorizontalOptions="Start"
                                                Text="CREDIT CARD"
                                                TextColor="{DynamicResource White}" />

                                                    <Label
                                                Padding="0,40,0,0"
                                                FontFamily="Roboto-Regular"
                                                FontSize="12"
                                                HorizontalOptions="Start"
                                                Text="{Binding CardNumber}"
                                                TextColor="{DynamicResource White}" />

                                                </VerticalStackLayout>

                                                <!-- Mastercard Logo -->
                                                <Image
                                            Grid.Column="1"
                                            Source="mastercardlogo.png"
                                            WidthRequest="50"
                                            HeightRequest="32"
                                            Margin="0,-6,-10,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start" />

                                            </Grid>

                                            <Grid Grid.Row="1">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width=".4*" />
                                                    <ColumnDefinition Width=".4*" />
                                                    <ColumnDefinition Width=".2*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height=".7*" />
                                                    <RowDefinition Height=".3*" />
                                                </Grid.RowDefinitions>

                                                <!-- Card Holder -->

                                                <Label
                                            Grid.Column="0"
                                            FontFamily="Roboto-Regular"
                                            FontSize="12"
                                            HorizontalOptions="Start"
                                            Text="Card holder"
                                            TextColor="{DynamicResource White}"
                                            VerticalOptions="End" />

                                                <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            FontFamily="Roboto-Medium"
                                            FontSize="14"
                                            HorizontalOptions="Start"
                                            Text="{Binding CardHolderName}"
                                            TextColor="{DynamicResource White}"
                                            VerticalOptions="Center" />

                                                <!-- Expiration -->

                                                <Label
                                            Grid.Column="1"
                                            FontFamily="Roboto-Regular"
                                            FontSize="12"
                                            HorizontalOptions="Start"
                                            Text="Expires"
                                            TextColor="{DynamicResource White}"
                                            VerticalOptions="End" />

                                                <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            FontFamily="Roboto-Medium"
                                            FontSize="14"
                                            HorizontalOptions="Start"
                                            Text="{Binding ExpiryDate, StringFormat='{}{0:MM/yy}'}"
                                            TextColor="{DynamicResource White}"
                                            VerticalOptions="Center" />

                                                <!-- CVV -->

                                                <Label
                                            Grid.Column="2"
                                            FontFamily="Roboto-Regular"
                                            FontSize="12"
                                            HorizontalOptions="Start"
                                            Text="CVV"
                                            TextColor="{DynamicResource White}"
                                            VerticalOptions="End" />

                                                <Label
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            FontFamily="Roboto-Medium"
                                            FontSize="14"
                                            HorizontalOptions="Start"
                                            Text="{Binding CVV}"
                                            TextColor="{DynamicResource White}"
                                            VerticalOptions="Center" />

                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </rotator:SfRotator.ItemTemplate>
                        </rotator:SfRotator>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>



    </ContentView.Content>

    <ContentView.Behaviors>
        <local:CardPaymentBehavior />
    </ContentView.Behaviors>

</ContentView>