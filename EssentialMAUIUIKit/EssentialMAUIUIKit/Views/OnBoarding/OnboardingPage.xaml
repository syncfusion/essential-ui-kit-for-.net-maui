<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Rotator;assembly=Syncfusion.Maui.Rotator"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             x:Class="EssentialMAUIUIKit.Views.OnBoarding.OnboardingPage"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             x:DataType="local:OnboardingViewModel">

    <ContentView.BindingContext>
        <local:OnboardingViewModel/>
    </ContentView.BindingContext>

    <ContentView.Content>
        <ScrollView VerticalScrollBarVisibility="Never">
            <Grid VerticalOptions="Center" MinimumHeightRequest="550"
                BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{OnPlatform MacCatalyst=600, iOS=500,Default=*}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                    HeightRequest="50">
                    <buttons:SfButton x:Name="skipButton" Text="Skip" Margin="{OnPlatform Android='0,0,0,0', iOS='0,-30,20,0', WinUI='0,10,20,0', MacCatalyst='0,-30,20,0'}" TextColor="{AppThemeBinding Light=#3C3B3D, Dark=#FFFFFF}" Style="{DynamicResource TransparentButtonStyle}" HorizontalOptions="End" VerticalTextAlignment="Center" />
                </Grid>
                <syncfusion:SfRotator  x:Name="rotator"
                                       BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                       EnableLooping="False"
                                       Grid.Row="1" DotPlacement="OutSide" HeightRequest="{OnPlatform WinUI=600,Android=550}"
                                       ItemsSource="{Binding OnboardingItems}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Start"
                                       SelectedIndex="{Binding SelectedIndex}"
                                       SelectedDotColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}">

                    <syncfusion:SfRotator.Margin>
                        <OnPlatform x:TypeArguments="Thickness">
                            <On Platform="Android"
                                Value="10,30,10,10"/>
                            <On Platform="iOS"
                                Value="10,30,10,10"/>
                            <On Platform="Windows"
                                Value="10,40,10,10"/>
                            <On Platform="MacCatalyst"
                                Value="10,30,10,10"/>
                        </OnPlatform>
                    </syncfusion:SfRotator.Margin>

                    <!-- Rotator Item Template -->
                    <syncfusion:SfRotator.ItemTemplate>
                        <DataTemplate x:DataType="local:OnBoardingModel">
                            <Grid VerticalOptions="Center"
                                Padding="0"
                                RowDefinitions=".6*, .4*">
                                <Image  x:Name="RotatorImage"
                                        HeightRequest="200"
                                        Grid.Row="0" Margin="0,0,30,30"
                                        Source="{Binding Image}"
                                        Loaded="ContentLoaded"/>
                                <VerticalStackLayout Grid.Row="1" VerticalOptions="End" Spacing="8" Padding="0,20,0,40">
                                    <Label x:Name="RotatorTitle" Padding="0,0,0,0" Text="{Binding Title}" Style="{DynamicResource TitleLabelStyle}"  FontSize="24" HorizontalOptions="Center" Loaded="ContentLoaded"/>
                                    <Label x:Name="RotatorDescription" Padding="0,0,0,-2" Text="{Binding Description}" WidthRequest="{OnIdiom Phone=300, Tablet=500, Desktop=500}" Style="{DynamicResource DescriptionLabelStyle}"  FontSize="16" FontFamily="Roboto-Regular" HorizontalOptions="Center" Loaded="ContentLoaded"/>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </syncfusion:SfRotator.ItemTemplate>
                </syncfusion:SfRotator>

                <buttons:SfButton
                                x:Name="nextButton"
                                Grid.Row="2"
                                Text="Next"
                                Margin="20,30,20,20"
                                WidthRequest="{OnPlatform WinUI=400, Android=328, MacCatalyst=400}"
                                HorizontalOptions="{OnPlatform Default=Center, Android=Fill, iOS=Fill}"
                                VerticalTextAlignment="Center"
                                Style="{DynamicResource FormsButtonStyle}" />
            </Grid>
        </ScrollView>
    </ContentView.Content>

    <ContentView.Behaviors>
        <local:OnBoardingBehavior/>
    </ContentView.Behaviors>

</ContentView>
