<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:controls="clr-namespace:EssentialMAUIUIKit.AppLayout.Controls"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:maps="clr-namespace:Syncfusion.Maui.Maps;assembly=Syncfusion.Maui.Maps"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:popup="clr-namespace:Syncfusion.Maui.Toolkit.Popup;assembly=Syncfusion.Maui.Toolkit"
             xmlns:model="clr-namespace:EssentialMAUIUIKit.Models"
             xmlns:rotator="clr-namespace:Syncfusion.Maui.Rotator;assembly=Syncfusion.Maui.Rotator"
             x:Class="EssentialMAUIUIKit.Views.Detail.EventDetailPage"
             x:DataType="local:EventDetailViewModel">

    <ContentView.BindingContext>
        <local:EventDetailViewModel />
    </ContentView.BindingContext>

    <ContentView.Resources>
        <Style TargetType="listView:ListViewItem">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </ContentView.Resources>

    <ContentView.Content>
    <ScrollView VerticalScrollBarVisibility="Never">
    <StackLayout>
        <Grid
            HeightRequest="60"
            Padding="10,0"
            Grid.ColumnSpan="2"
            IsVisible="{OnIdiom Default=true, Phone=false}"
            BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
            RowSpacing="6"
            RowDefinitions="56,1">

            <!-- Header Content -->

            <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto,Auto"
                VerticalOptions="End">

                <!-- Left Logo -->

                    <Label Grid.Column="0"
                        FontFamily="UIKitIcons"
                        Text="&#xe727;"
                        FontSize="32"
                        VerticalOptions="Center"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}" />

                    <HorizontalStackLayout Grid.Column="1">

                    <!-- Center Menu -->

                    <HorizontalStackLayout
                                         Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">

                                <buttons:SfButton Background="Transparent"
                  CornerRadius="4"
                  Padding="8,0"
                  Clicked="HomeTapped"
                  TextColor="{DynamicResource Gray-700}">
                                    <buttons:SfButton.Content>
                                        <DataTemplate>
                                            <HorizontalStackLayout Padding="0,5,0,6"
                                                                   Spacing="6"
                         VerticalOptions="Center">
                                                <Label Text="Home"
                       FontSize="14"
                       FontFamily="Roboto-Medium"
                       CharacterSpacing="0.1"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                                <Label FontFamily="FontIcons"
                       Text="&#xe70B;"
                       FontSize="18"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}" />
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </buttons:SfButton.Content>
                                </buttons:SfButton>

                                <buttons:SfButton Background="Transparent"
                  CornerRadius="4"
                  Padding="8,0"
                  Margin="24,0,0,0"
                  Clicked="ResearchTapped"
                  TextColor="{DynamicResource Gray-700}">
                                    <buttons:SfButton.Content>
                                        <DataTemplate>
                                            <HorizontalStackLayout Padding="0,5,0,6"
                                                                   Spacing="6"
                         VerticalOptions="Center">
                                                <Label Text="Research"
                       FontSize="14"
                       FontFamily="Roboto-Medium"
                       CharacterSpacing="0.1"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                                <Label FontFamily="FontIcons"
                       Text="&#xe70B;"
                       FontSize="18"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}" />
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </buttons:SfButton.Content>
                                </buttons:SfButton>


                                <buttons:SfButton Background="Transparent"
                  CornerRadius="4"
                  Padding="8,0"
                  Margin="24,0,0,0"
                  Clicked="DraftTapped"
                  TextColor="{DynamicResource Gray-700}">
                                    <buttons:SfButton.Content>
                                        <DataTemplate>
                                            <HorizontalStackLayout Padding="0,5,0,6"
                                                                   Spacing="6"
                         VerticalOptions="Center">
                                                <Label Text="Drafts"
                       FontSize="14"
                       FontFamily="Roboto-Medium"
                       CharacterSpacing="0.1"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                                <Label FontFamily="FontIcons"
                       Text="&#xe70B;"
                       FontSize="18"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}" />
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </buttons:SfButton.Content>
                                </buttons:SfButton>


                                <Grid WidthRequest="248"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                VerticalOptions="Start"
                                Margin="24,0,0,0"
                                RowDefinitions="*,1">

                                <!-- Search content -->
                                <Grid ColumnDefinitions="32,*"
                                  VerticalOptions="Center">

                                    <Label Grid.Column="0"
                                     Text="&#xe705;"
                                     FontFamily="FontIcons"
                                     FontSize="18"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight},
                                                                 Dark={DynamicResource ContentTextColorDark}}" />

                                    <controls:SfEntry 
                                    Grid.Column="1"
                                    x:Name="searchView"
                                    Placeholder="Search"
                                    Background="Transparent"
                                    FontFamily="Roboto-Regular"
                                    FontSize="18"
                                    HeightRequest="40"
                                    Margin="8,0,0,8"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center"
                                    ClearButtonVisibility="Never"
                                    PlaceholderColor="{AppThemeBinding Light={DynamicResource PlaceholderTextColorLight},
                                                                        Dark={DynamicResource PlaceholderTextColorDark}}" />
                                </Grid>


                                <!-- Underline -->
                                <BoxView Grid.Row="1"
                                       HeightRequest="1"
                                       Margin="0,0,0,0"
                                       Color="{AppThemeBinding Light='#C9C6C8',
                                                               Dark='#5F5E60'}" />
                            </Grid>

                        </HorizontalStackLayout>

                        <!-- Right Section -->

                        <HorizontalStackLayout Margin="24,0"
                                                VerticalOptions="Center">

                            <buttons:SfButton Background="Transparent"
                                            CornerRadius="4"
                                            WidthRequest="30"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            HeightRequest="40"
                                            Padding="4,0"
                                            TextColor="{DynamicResource Gray-700}">
                                <buttons:SfButton.Content>
                                    <DataTemplate>
                                        <StackLayout Padding="0,5,0,6"
                                                    VerticalOptions="Center">
                                            <Label FontFamily="UIKitIcons"
                                                    HorizontalTextAlignment="Center"
                                                    Text="&#xe700;"
                                                    FontSize="18"
                                                    VerticalOptions="Center"
                                                    VerticalTextAlignment="Center"
                                                    TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}" />
                                        </StackLayout>
                                    </DataTemplate>
                                </buttons:SfButton.Content>
                            </buttons:SfButton>

                            <buttons:SfButton Background="Transparent"
                                            CornerRadius="4"
                                            WidthRequest="30"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            HeightRequest="40"
                                            Padding="4,0"
                                            TextColor="{DynamicResource Gray-700}">
                                <buttons:SfButton.Content>
                                    <DataTemplate>
                                        <StackLayout Padding="0,5,0,6"
                                                     VerticalOptions="Center">
                                            <Label FontFamily="UIKitIcons"
                                                    HorizontalTextAlignment="Center"
                                                    Text="&#xe733;"
                                                    FontSize="14"
                                                    VerticalOptions="Center"
                                                    VerticalTextAlignment="Center"
                                                    TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}" />
                                        </StackLayout>
                                    </DataTemplate>
                                </buttons:SfButton.Content>
                            </buttons:SfButton>

                            <buttons:SfButton Background="Transparent"
                                                CornerRadius="4"
                                                WidthRequest="30"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center"
                                                HeightRequest="40"
                                                Padding="4,0"
                                                TextColor="{DynamicResource Gray-700}">
                                <buttons:SfButton.Content>
                                    <DataTemplate>
                                        <StackLayout Padding="0,5,0,6"
                                                    VerticalOptions="Center">
                                            <Label FontFamily="FontIcons"
                                                    Text="&#xe704;"
                                                    HorizontalTextAlignment="Center"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    VerticalOptions="Center"
                                                    VerticalTextAlignment="Center"
                                                    TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}" />
                                        </StackLayout>
                                    </DataTemplate>
                                </buttons:SfButton.Content>
                            </buttons:SfButton>

                            <Border StrokeShape="RoundRectangle 20"
                                        Margin="16,0,0,0"
                                        Padding="0"
                                        Stroke="Transparent">

                                <Image
                                        HeightRequest="40"
                                        WidthRequest="40"
                                        Aspect="AspectFill"
                                        Source="profileavatar.png" />

                            </Border>

                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
            </Grid>

            <!-- Bottom Divider -->

            <BoxView Grid.Row="1"
                       HeightRequest="1"
                       Style="{DynamicResource HorizontalSeparatorStyle}" />

        </Grid>

            <Grid RowDefinitions="*,Auto" BackgroundColor="{AppThemeBinding Light='#F9F5F8', Dark={DynamicResource PrimaryTextColorLight}}">

            <Grid Grid.Row="0" BackgroundColor="Transparent">
            <Grid
                Margin="{OnIdiom Default='24,0,0,0', Tablet='24,0,24,0', Phone='0'}"
                HorizontalOptions="Fill"
                ColumnSpacing="8"
                ColumnDefinitions="{OnIdiom Default='1*', Desktop='1.5*,1*'}"
                RowDefinitions="{OnIdiom Default='Auto,Auto,Auto,Auto,Auto,Auto', Desktop='Auto,Auto,Auto,Auto'}">

                <Grid Grid.Row="1" 
                      IsVisible="{OnIdiom Default=true, Phone=false}"
                      Margin="{OnIdiom Default='0,24,0,0', Phone=0}"
                      VerticalOptions="Start"
                      HeightRequest="{OnIdiom Default=480, Phone=290}">

                    <Border
                            StrokeThickness="0"
                            StrokeShape="{OnIdiom Default='RoundRectangle 12', Phone=0}">
                        <!-- Background Image -->
                        <Image VerticalOptions="Start"
                               Aspect="AspectFill">
                            <Image.Source>
                                <UriImageSource
                                    CacheValidity="14"
                                    CachingEnabled="True"
                                    Uri="{Binding HeaderImages[0]}" />
                            </Image.Source>
                        </Image>
                    </Border>

                    <!-- Bottom Left Content -->
                    <VerticalStackLayout VerticalOptions="End"
                                         HorizontalOptions="Start"
                                         Spacing="12"
                                         Padding="24">

                        <HorizontalStackLayout Spacing="8">

                            <Border BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                    Padding="12,6"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">

                                <Label Text="{Binding EventCategory}"
                                       FontSize="12"
                                       FontFamily="Roboto-Medium"
                                       TextColor="White"/>
                            </Border>

                            <Border BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource PrimaryTextColorLight}}"
                                    Padding="12,6"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">

                                <Label Text="{Binding EventDuration}"
                                       FontSize="12"
                                       FontFamily="Roboto-Medium"
                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"/>
                            </Border>

                        </HorizontalStackLayout>

                        <Label Text="{Binding EventTitle}"
                               FontSize="40"
                               FontFamily="Roboto-SemiBold"
                               TextColor="White"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />

                    </VerticalStackLayout>

                </Grid>

                <Grid Grid.Row="1"
                        IsVisible="{OnIdiom Phone=true, Default=false}"
                        HeightRequest="320">

                    <!-- Hero Image -->
                    <Image Aspect="AspectFill"
                            HeightRequest="250"
                            VerticalOptions="Start">
                        <Image.Source>
                            <UriImageSource
                                CacheValidity="14"
                                CachingEnabled="True"
                                Uri="{Binding HeaderImages[0]}" />
                        </Image.Source>
                    </Image>

                    <!-- Top Actions -->
                    <Grid Padding="16,20,16,0"
                            ColumnDefinitions="Auto,*,Auto,Auto"
                            VerticalOptions="Start">

                                    <buttons:SfButton Background="Transparent"
                                                      Grid.Column="0"
                                                        CornerRadius="26"
                                                        Padding="8,0"
                                                        TextColor="{DynamicResource Gray-700}">
                                        <buttons:SfButton.Content>
                                            <DataTemplate>
                                                <Border 
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="9"
                                                    BackgroundColor="#4D000000"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 20">

                                                    <Label Text="&#xe709;"
                                                        FontFamily="FontIcons"
                                                        FontAttributes="Bold"
                                                        FontSize="20"
                                                        TextColor="White"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"/>
                                                </Border>

                                            </DataTemplate>
                                        </buttons:SfButton.Content>
                                    </buttons:SfButton>
                        
                        
                                    <buttons:SfButton Background="Transparent"
                                                      Grid.Column="2"
                                                    CornerRadius="26"
                                                    Padding="8,0"
                                                    TextColor="{DynamicResource Gray-700}">
                                        <buttons:SfButton.Content>
                                            <DataTemplate>
                                                <Border 
                                                        WidthRequest="40"
                                                        HeightRequest="40"
                                                        BackgroundColor="#4D000000"
                                                        StrokeThickness="0"
                                                        Padding="9"
                                                        StrokeShape="RoundRectangle 20">

                                                    <Label Text="&#xe704;"
                                                        FontFamily="FontIcons"
                                                        FontAttributes="Bold"
                                                        FontSize="20"
                                                        TextColor="White"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </buttons:SfButton.Content>
                                    </buttons:SfButton>

                                    <buttons:SfButton Background="Transparent"
                                                      Grid.Column="3"
                                                      CornerRadius="26"
                                                      WidthRequest="40"
                                                      Padding="8,0"
                                                      Command="{Binding ToggleFavoriteCommand}"
                                                      TextColor="{DynamicResource Gray-700}">
                                        <buttons:SfButton.Content>
                                            <DataTemplate x:DataType="local:EventDetailViewModel">
                                                <Border
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    BackgroundColor="#4D000000"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 20">

                                                    <Label Text="{Binding FavoriteIcon}"
                                                        TextColor="White"
                                                        FontFamily="UIKitIcons"
                                                        FontSize="22"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </buttons:SfButton.Content>
                                    </buttons:SfButton>

                                </Grid>

                            <!-- Overlapping Card -->
                            <Border
                                Margin="16,0,16,28"
                                VerticalOptions="End"
                                BackgroundColor="{AppThemeBinding Light=white, Dark={DynamicResource BackgroundColorDark}}"
                                StrokeThickness="0"
                                Padding="16"
                                StrokeShape="RoundRectangle 12">

                                <VerticalStackLayout Spacing="8">

                                    <Label Text="{Binding EventTitle}"
                                           FontFamily="Roboto-Medium"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2"/>

                                    <HorizontalStackLayout Spacing="8">

                                        <Label Text="{Binding EventCategory}"
                                               FontSize="14"
                                               CharacterSpacing="0.1"
                                               FontFamily="Roboto-Medium"
                                               TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"/>

                                        <Label Text="•"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"/>

                                        <Label Text="{Binding EventDuration}"
                                               FontSize="14"
                                               CharacterSpacing="0.1"
                                               FontFamily="Roboto-Medium"
                                               TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"/>

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                            </Border>

                        </Grid>

                        <Grid Grid.Row="{OnIdiom Default=2, Phone=3}" Padding="{OnIdiom Default='0,56,0,0', Phone=0}">
                            <VerticalStackLayout Spacing="16">
                                <Border BackgroundColor="{AppThemeBinding Light=white, Dark={DynamicResource BackgroundColorDark}}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="24" Margin="{OnIdiom Default=0, Phone=16}">
                                    <Border.Stroke>
                                        <OnIdiom x:TypeArguments="Brush">
                                            <OnIdiom.Phone>
                                                <SolidColorBrush Color="{AppThemeBinding
                                                                Light='#EBDCFF',
                                                                Dark='#41394E'}" />
                                            </OnIdiom.Phone>

                                            <OnIdiom.Default>
                                                <SolidColorBrush
                                                    Color="{AppThemeBinding
                                                                Light={DynamicResource SeparatorColorLight},
                                                                Dark={DynamicResource SeparatorColorDark}}" />
                                            </OnIdiom.Default>
                                        </OnIdiom>
                                    </Border.Stroke>
                                    <VerticalStackLayout Spacing="12">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label IsVisible="{OnIdiom Default=true, Phone=false}" Text="&#xe710;" VerticalOptions="{OnIdiom Default=Center, Desktop=Start}" Rotation="180" FontFamily="UIKitIcons" FontSize="20" TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}" />
                                            <Label Text="About Show" FontFamily="Roboto-Medium" FontSize="{OnIdiom Default=22, Phone=16}" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />
                                        </HorizontalStackLayout>
                                        <Label Text="Get ready for a night of uncontrollable laughter with Nesan David, one of the most exciting voices in stand-up today. 'Happy Ending' explores the hilarious ironies of everyday life, family dynamics, and the pursuit of finding peace in a chaotic world. Nesan brings his unique blend of storytelling and observational wit to the stage, ensuring every audience member leaves with a smile. This special tour has been receiving rave reviews across the country for its sharp writing and relatable charm." FontFamily="Roboto-Regular" FontSize="{OnIdiom Default=16, Phone=14}" LineHeight="1.25" CharacterSpacing="0.5" LineBreakMode="{OnIdiom Default=WordWrap, Phone=TailTruncation}" MaxLines="{OnIdiom Default=5, Phone=3}" TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}" />
                                            <buttons:SfButton Background="Transparent"
                                                              CornerRadius="4"
                                                              Padding="8,0"
                                                              HorizontalOptions="Start"
                                                              TextColor="{DynamicResource Gray-700}">
                                                <buttons:SfButton.Content>
                                                    <DataTemplate>
                                                        <Label IsVisible="{OnIdiom Default=false, Phone=true}" Text="Show more"  FontFamily="Roboto-Medium" FontSize="14" TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}" />
                                                    </DataTemplate>
                                                </buttons:SfButton.Content>
                                            </buttons:SfButton>
                                        </VerticalStackLayout>
                                </Border>

                                <Border BackgroundColor="{AppThemeBinding Light=white, Dark={DynamicResource BackgroundColorDark}}" Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="24" 
                                        HeightRequest="{OnIdiom Desktop=248,Tablet=270,Phone=248}" IsVisible="{OnIdiom Default=true, Phone=false}">
                                    <VerticalStackLayout Spacing="14">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Label Text="&#xe72d;" FontAttributes="Bold" FontFamily="UIKitIcons" FontSize="20" TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}" VerticalTextAlignment="Center" />
                                            <Label Grid.Column="1" Text="Crew" FontFamily="Roboto-Medium" FontSize="22" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />
                                        </Grid>

                                        <listView:SfListView
                                            AutoFitMode="Height"
                                            ItemSpacing="16"
                                            HorizontalOptions="Fill"
                                            ItemsSource="{Binding Connections}"
                                            Orientation="Horizontal"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent">

                                            <listView:SfListView.ItemTemplate>

                                                <DataTemplate x:DataType="model:UserProfile">

                                                    <VerticalStackLayout
                                                WidthRequest="130"
                                                HorizontalOptions="Center"
                                                Spacing="8">

                                                        <Border Margin="0,0,0,16"
                                                HorizontalOptions="Center"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 45"
                                                WidthRequest="{OnIdiom Default=76, Phone=64}"
                                                HeightRequest="{OnIdiom Default=76, Phone=64}">

                                                            <Image
                                                Aspect="AspectFill"
                                                HeightRequest="{OnIdiom Default=76, Phone=64}"
                                                WidthRequest="{OnIdiom Default=76, Phone=64}">

                                                                <Image.Source>
                                                                    <UriImageSource
                                                        CacheValidity="12"
                                                        CachingEnabled="True"
                                                        Uri="{Binding ImagePath}" />
                                                                </Image.Source>

                                                            </Image>

                                                        </Border>

                                                        <Label
                                                    HorizontalTextAlignment="Center"
                                                    FontSize="16"
                                                    FontFamily="Roboto-Medium"
                                                    CharacterSpacing="0.15"
                                                    Text="{Binding Name}"
                                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                                        <Label
                                                    HorizontalTextAlignment="Center"
                                                    FontSize="12"
                                                    FontFamily="Roboto-Regular"
                                                    CharacterSpacing="0.25"
                                                    Text="{Binding Role}"
                                                    TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}" />

                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                                    </VerticalStackLayout>
                                </Border>

                                <!--Crew section for Phone UI -->
                                <VerticalStackLayout
                                    Padding="16,0,16,16"
                                    Spacing="14"
                                    IsVisible="{OnIdiom Default=false, Phone=true}">

                                    <!-- Header -->
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="8">

                                        <Label
                                            Grid.Column="1"
                                            Text="Crew"
                                            FontFamily="Roboto-Medium"
                                            FontSize="22"
                                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight},
                                                                                Dark={DynamicResource PrimaryTextColorDark}}" />
                                    </Grid>

                                    <!-- Crew List -->
                                    <listView:SfListView
                                        ItemsSource="{Binding Connections}"
                                        Orientation="Horizontal"
                                        AutoFitMode="DynamicHeight"
                                        HeightRequest="140"
                                        ItemSize="180"
                                        ItemSpacing="0,0,16,0"
                                        ScrollBarVisibility="Never"
                                        SelectionBackground="Transparent">

                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate x:DataType="model:UserProfile">

                                                <VerticalStackLayout
                                                    HorizontalOptions="Center"
                                                    Spacing="4">

                                                    <!-- Circular Profile Image -->
                                                    <Border
                                                        Margin="12"
                                                        WidthRequest="64"
                                                        HeightRequest="64"
                                                        HorizontalOptions="Center"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 38">

                                                        <Image
                                                            Aspect="AspectFill">

                                                            <Image.Source>
                                                                <UriImageSource
                                                                    Uri="{Binding ImagePath}"
                                                                    CacheValidity="12"
                                                                    CachingEnabled="True" />
                                                            </Image.Source>

                                                        </Image>

                                                    </Border>

                                                    <!-- Name -->
                                                    <Label
                                                        Text="{Binding Name}"
                                                        HorizontalTextAlignment="Center"
                                                        FontFamily="Roboto-Medium"
                                                        FontSize="12"
                                                        CharacterSpacing="0.5"
                                                        LineBreakMode="TailTruncation"
                                                        MaxLines="1"
                                                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight},
                                                                                            Dark={DynamicResource PrimaryTextColorDark}}" />

                                                    <!-- Role -->
                                                    <Label
                                                        Text="{Binding Role}"
                                                        HorizontalTextAlignment="Center"
                                                        FontFamily="Roboto-Regular"
                                                        FontSize="12"
                                                        CharacterSpacing="0.4"
                                                        LineBreakMode="TailTruncation"
                                                        MaxLines="1"
                                                        TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight},
                                                                                            Dark={DynamicResource ContentTextColorDark}}" />

                                                </VerticalStackLayout>

                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                <VerticalStackLayout Grid.Row="{OnIdiom Default=3, Tablet=4, Phone=5}" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,Auto" Margin="{OnIdiom Default='8,24,24,0', Phone='16,0,24,16'}">
