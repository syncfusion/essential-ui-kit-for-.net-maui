<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Detail.DataTablePage"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             x:DataType="local:DataTableViewModel">
    <ContentView.BindingContext>
        <local:DataTableViewModel></local:DataTableViewModel>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <Style TargetType="syncfusion:DataGridHeaderCell">
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontFamily"
                    Value="Roboto-Medium"/>
        </Style>

        <Style TargetType="syncfusion:DataGridUnboundRowCell">
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontFamily"
                    Value="Roboto-Regular"/>
        </Style>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid RowSpacing="0"
              RowDefinitions="Auto,*"
              Padding="{OnIdiom Default='0,10,0,10', Phone='0'}">

            <Grid BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                  HeightRequest="55"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*">

                <Label  Grid.Column="0"
                         FontFamily="FontIcons"
                         Margin="16"
                         Text="&#xe728;"
                         TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                         Rotation="180"
                         FontSize="18"
                         FontAttributes="Bold"
                         VerticalOptions="Center" />

                <Label Grid.Column="1"
                        Text="Data table"
                        FontSize="16"
                        FontFamily="Roboto-Medium"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                        VerticalOptions="Center"
                        HorizontalOptions="Start" />

                <BoxView  HeightRequest="1"
                          Grid.Row="1"
                          Grid.ColumnSpan="2"
                          Style="{DynamicResource HorizontalSeparatorStyle}"/>
            </Grid>

            <Border StrokeShape="{OnIdiom Desktop='RoundRectangle 8', Tablet='RoundRectangle 8'}"
                    Grid.Row="1"
                    Margin="{OnIdiom Default='24', Phone='8'}"
                    Padding="{OnIdiom Default='0', Phone='4'}"
                    WidthRequest="{OnIdiom Desktop='766', Tablet='720', Phone='-1'}"
                    HorizontalOptions="Fill"
                    Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">
                <Grid>

                    <syncfusion:SfDataGrid
                                    ItemsSource="{Binding DataTableLists}"
                                    AutoGenerateColumnsMode="None"
                                    ColumnWidthMode="Fill"
                                    HeaderRowHeight="{OnIdiom Default='36', Phone='46', Tablet='46'}"
                                    RowHeight="48"
                                    SelectionMode="None"
                                    VerticalScrollBarVisibility="Never"
                                    HorizontalOptions="Center"
                                    GridLinesVisibility="Horizontal"
                                    HeaderGridLinesVisibility="Horizontal"
                                    VerticalOptions="Fill">

                        <syncfusion:SfDataGrid.DefaultStyle>
                            <syncfusion:DataGridStyle  HeaderGridLineColor="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                       GridLineColor="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"/>
                        </syncfusion:SfDataGrid.DefaultStyle>

                        <syncfusion:SfDataGrid.Columns>

                            <!-- Pos -->
                            <syncfusion:DataGridTextColumn
                                                    MappingName="SerialNumber"
                                                    CellTextAlignment="{OnIdiom Default='Center', Phone='Start'}"
                                                    HeaderTextAlignment="{OnIdiom Default='Center', Phone='Start'}"
                                                    HeaderText="Pos" 
                                                    MaximumWidth="{OnIdiom Phone=50}"/>

                            <!-- Club -->
                            <syncfusion:DataGridTemplateColumn
                                                    MappingName="ClubName"
                                                    HeaderTextAlignment="{OnIdiom Default='Center', Phone='Start'}"
                                                    CellTextAlignment="{OnIdiom Default='Center', Phone='Start'}"
                                                    MinimumWidth="{OnIdiom Default=90, Phone=75}"
                                                    HeaderText="Teams">

                                <syncfusion:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Grid.Column="1"
                                              ColumnSpacing="8"
                                              Margin="{OnIdiom Default='24,0,0,0', Phone='0'}"
                                              WidthRequest="70"
                                              HorizontalOptions="Center"
                                              x:DataType="local:DataTableList">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!--  Club images  -->
                                            <Image  Grid.Column="0"
                                                    Aspect="AspectFit"
                                                    HeightRequest="32"
                                                    WidthRequest="32"
                                                    HorizontalOptions="Start"
                                                    VerticalOptions="Center">
                                                <Image.Source>
                                                    <UriImageSource
                                                        CacheValidity="14"
                                                        CachingEnabled="true"
                                                        Uri="{Binding ImageIcon}"/>
                                                </Image.Source>
                                            </Image>

                                            <Label
                                                Grid.Column="1"
                                                Margin="0"
                                                FontFamily="Roboto-Regular"
                                                FontSize="14"
                                                Text="{Binding ClubName}"
                                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                VerticalOptions="Center"/>
                                        </Grid>

                                    </DataTemplate>
                                </syncfusion:DataGridTemplateColumn.CellTemplate>
                            </syncfusion:DataGridTemplateColumn>

                            <!-- Pl -->
                            <syncfusion:DataGridTextColumn
                                                MappingName="Played"
                                                HeaderText="Pl"
                                                MaximumWidth="{OnIdiom Phone=50}"
                                                CellTextAlignment="Center"
                                                HeaderTextAlignment="Center" />

                            <!-- Gd -->
                            <syncfusion:DataGridTextColumn
                                                MappingName="GoldPoints"
                                                HeaderText="Gd"
                                                CellTextAlignment="Center"
                                                HeaderTextAlignment="Center" />

                            <!-- Pts -->
                            <syncfusion:DataGridTextColumn
                                                MappingName="Points"
                                                HeaderText="Pts"
                                                MaximumWidth="{OnIdiom Phone=50}"
                                                CellTextAlignment="Center"
                                                HeaderTextAlignment="Center" />

                            <!-- Form -->
                            <syncfusion:DataGridTemplateColumn HeaderText=" "
                                                               CellTextAlignment="{OnIdiom Default='Center',Phone='End'}"
                                                               HeaderTextAlignment="Center">

                                <syncfusion:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="local:DataTableList">
                                        <StackLayout Grid.Column="5"
                                                     Margin="{OnIdiom Default='0,0,0,0', Phone='4,0,0,0'}"
                                                     BindableLayout.ItemsSource="{Binding MatchResults}"
                                                     HorizontalOptions="Center"
                                                     Orientation="Horizontal"
                                                     Spacing="4"
                                                     VerticalOptions="Center"
                                                     WidthRequest="80">

                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border BackgroundColor="{Binding .}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 6"
                                                            HeightRequest="12"
                                                            WidthRequest="12" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>
                                    </DataTemplate>
                                </syncfusion:DataGridTemplateColumn.CellTemplate>
                            </syncfusion:DataGridTemplateColumn>
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </Border>
        </Grid>
    </ContentView.Content>
</ContentView>