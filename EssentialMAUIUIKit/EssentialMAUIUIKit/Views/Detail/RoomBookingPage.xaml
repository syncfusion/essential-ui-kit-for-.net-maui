<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Detail.RoomBookingPage"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:rotator="clr-namespace:Syncfusion.Maui.Rotator;assembly=Syncfusion.Maui.Rotator"
             xmlns:rating="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Toolkit.Calendar;assembly=Syncfusion.Maui.Toolkit"
             xmlns:chip="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:maps="clr-namespace:Syncfusion.Maui.Maps;assembly=Syncfusion.Maui.Maps"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             x:DataType="local:RoomBookingPageViewModel">
    <ContentView.BindingContext>
        <local:RoomBookingPageViewModel/>
    </ContentView.BindingContext>

    <ContentView.Resources>
        <ResourceDictionary>
            <converter:BooleanToStringConverter x:Key="boolToStringConverter" />
            <converter:BooleanToColorConverter x:Key="boolToColorConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    
    <ContentView.Content>
        <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
                <Grid RowSpacing="16" RowDefinitions="{OnIdiom Default='Auto,Auto,Auto', Phone='Auto,Auto,Auto,Auto'}">

                <Grid BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                      HeightRequest="56"
                      ColumnDefinitions="{OnIdiom Default='Auto,*', Desktop='*'}">

                    <Label  FontFamily="UIKitIcons"
                            IsVisible="{OnIdiom Desktop='true', Default='false'}"
                            Margin="16,12"
                            Text="&#xe727;"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                            FontSize="30"
                            HorizontalOptions="Start"
                            VerticalOptions="Center" />

                        <Label  Grid.Column="0"
                                 FontFamily="FontIcons"
                                 IsVisible="{OnIdiom Desktop='false', Default='true'}"
                                 Margin="16"
                                 Text="&#xe728;"
                                 TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                 Rotation="180"
                                 FontSize="18"
                                 FontAttributes="Bold"
                                 VerticalOptions="Center" />

                        <Label Grid.Column="1"
                                Text="Modern Resort"
                               IsVisible="{OnIdiom Desktop='false', Default='true'}"
                                FontSize="16"
                                FontFamily="Roboto-Medium"
                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                VerticalOptions="Center"
                                HorizontalOptions="Start" />
                    </Grid>

                    <Grid Margin="16,0"
                          IsVisible="{OnIdiom Default='false', Phone='true'}"
                          Grid.Row="1"
                          WidthRequest="{OnIdiom Default=800, Phone=-1}"
                          ColumnDefinitions="*,Auto"
                          RowDefinitions="*,Auto">

                        <!--  Product Name  -->
                            <Label
                                FontSize="22"
                                HorizontalOptions="Start"
                                Style="{DynamicResource TitleLabelStyle}"
                                Text="{Binding RoomDetail.Name}"
                                VerticalOptions="Start"
                                VerticalTextAlignment="Start"/>
                            
                            <!--  Product rating  -->
                        <HorizontalStackLayout 
                                                Grid.Column="1"
                                                HorizontalOptions="End"
                                                HeightRequest="24"
                                                VerticalOptions="Center">
                            <Label Text="&#xE71E;"
                                    TextColor="#FFBE52"
                                    FontFamily="UIKitIcons"
                                    WidthRequest="20"
                                    FontSize="20"
                                    HeightRequest="20"/>
                            <Label Text="&#xE71E;"
                                    TextColor="#FFBE52"
                                    FontFamily="UIKitIcons"
                                    WidthRequest="20"
                                   FontSize="20"
                                    HeightRequest="20"/>
                            <Label Text="&#xE71E;"
                                    TextColor="#FFBE52"
                                    FontFamily="UIKitIcons"
                                    WidthRequest="20"
                                   FontSize="20"
                                    HeightRequest="20"/>
                            <Label Text="&#xE71E;"
                                    TextColor="#FFBE52"
                                    FontFamily="UIKitIcons"
                                    WidthRequest="20"
                                   FontSize="20"
                                    HeightRequest="20"/>
                            <Label Text="&#xE71D;"
                                    TextColor="#787678"
                                    FontFamily="UIKitIcons"
                                   FontSize="20"
                                    WidthRequest="20"
                                    HeightRequest="20"/>
                        </HorizontalStackLayout>

                        <!--Address Label-->
                        <Label Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding RoomDetail.Address}"
                               FontFamily="Roboto-Regular"
                               FontSize="16"
                               CharacterSpacing="0.5"
                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"/>
                    </Grid>

                    <Grid Grid.Row="{OnIdiom Default=1, Phone=2}">

                    <!--<Rotator for featured blog stories>-->
                    <rotator:SfRotator
                                    x:Name="Rotator"
                                    BackgroundColor="Gray"
                                    SelectedDotColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                    HeightRequest="{OnIdiom Default=350, Phone=204}"
                                    UnselectedDotColor="{AppThemeBinding Light={DynamicResource UnSelectedDotLight}, Dark={DynamicResource UnSelectedDotDark}}"
                                    HorizontalOptions="Start"
                                    ItemsSource="{Binding PreviewImages}"
                                    VerticalOptions="Start">
                        
                        <rotator:SfRotator.ItemTemplate>
                            <DataTemplate x:DataType="local:RoomDetail">
                                <Grid>

                                    <!--Image of the resort-->
                                    <Image
                                        Aspect="AspectFill"
                                        BackgroundColor="{DynamicResource Gray-200}"
                                        HeightRequest="{OnIdiom Default=350, Phone=204}">
                                        <Image.Source>
                                            <UriImageSource
                                                CacheValidity="14"
                                                CachingEnabled="true"
                                                Uri="{Binding ImagePath}"/>
                                        </Image.Source>
                                    </Image>

                                    <!--OverLay Effect-->
                                    <Border BackgroundColor="{DynamicResource Gray-Black}"
                                            Opacity="0.25"/>

                                </Grid>
                            </DataTemplate>
                        </rotator:SfRotator.ItemTemplate>
                    </rotator:SfRotator>

                    <StackLayout VerticalOptions="Start"
                                 HorizontalOptions="End"
                                 Orientation="{OnIdiom Default='Vertical', Phone='Horizontal'}"
                                 Margin="24"
                                 Spacing="12">

                        <!--  Favourite Icon  -->
                        <buttons:SfButton Clicked="SfButton_Clicked"
                                          Stroke="White"
                                          StrokeThickness="2"
                                          WidthRequest="40"
                                          HeightRequest="40"
                                          HorizontalOptions="End"
                                          Padding="0"
                                          Background="Transparent"
                                          VerticalOptions="Start">
                            <buttons:SfButton.Content>
                                <DataTemplate x:DataType="local:RoomBookingPageViewModel">
                                    <Label FontFamily="FontIcons"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           Text="{Binding IsFavourite, Converter={StaticResource boolToStringConverter}, ConverterParameter=1}"
                                           TextColor="{Binding IsFavourite, Converter={StaticResource boolToColorConverter}, ConverterParameter=2}" />
                                </DataTemplate>
                            </buttons:SfButton.Content>
                        </buttons:SfButton>

                        <!--  Share Icon  -->
                        <buttons:SfButton
                                        Stroke="White"
                                        StrokeThickness="2"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        HorizontalOptions="End"
                                        Padding="0"
                                        Background="Transparent"
                                        VerticalOptions="Start">
                            <buttons:SfButton.Content>
                                <DataTemplate>
                                    <Label FontFamily="FontIcons"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="White"
                                           Text="{DynamicResource Share}" />
                                </DataTemplate>
                            </buttons:SfButton.Content>
                        </buttons:SfButton>
                    </StackLayout>

                </Grid>

                <Grid Grid.Row="{OnIdiom Default=2, Phone=3}"
                      BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                      ColumnSpacing="0"
                      RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                      RowSpacing="0">

                    <Grid Margin="0,16"
                          Grid.Row="0"
                          IsVisible="{OnIdiom Default='true', Phone='false'}"
                          WidthRequest="{OnIdiom Default=800, Phone=-1}"
                          ColumnDefinitions="*,*"
                          RowDefinitions="*,*">
                        <StackLayout Orientation="Horizontal">
                            
                            <!--  Product Name  -->
                            <Label
                                FontSize="22"
                                HorizontalOptions="Start"
                                Style="{DynamicResource TitleLabelStyle}"
                                Text="{Binding RoomDetail.Name}"
                                VerticalOptions="Start"
                                VerticalTextAlignment="Start"/>
                            <!--  Product rating  -->
                            <rating:SfRating BackgroundColor="Transparent"
                                             Margin="12,0,0,0"
                                             ItemSpacing="4"
                                             ItemSize="13"
                                             VerticalOptions="Center"
                                             Style="{DynamicResource RatingStyle}"
                                             Value="{Binding RoomDetail.OverallRating}">
                                <rating:SfRating.RatingSettings>
                                    <rating:RatingSettings  RatedFill="#FFBE52"
                                                            RatedStroke="#FFBE52"
                                                            UnratedStroke="#787678"
                                                            UnratedStrokeThickness="0.5"/>
                                </rating:SfRating.RatingSettings>
                            </rating:SfRating>
                        </StackLayout>

                        <!--Address Label-->
                        <Label Grid.Row="1"
                               Text="{Binding RoomDetail.Address}"
                               FontFamily="Roboto-Regular"
                               FontSize="16"
                               CharacterSpacing="0.5"
                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"/>

                        <!--Book Now button-->
                        <buttons:SfButton Grid.RowSpan="2"
                                          Grid.Column="1"
                                          HorizontalOptions="End"
                                          VerticalOptions="Center"
                                          Text="Book Now"
                                          Style="{DynamicResource FormsButtonStyle }"/>
                    </Grid>

                    <BoxView  HeightRequest="8"
                              Grid.Row="1"
                              IsVisible="{OnIdiom Phone='false', Default='true'}" 
                              BackgroundColor="{AppThemeBinding Light={DynamicResource SentMessageColorLight}, Dark={DynamicResource SentMessageColorDark}}"/>

                    <Grid Grid.Row="2"
                          WidthRequest="{OnIdiom Default=800, Phone=-1}"
                          Margin="{OnIdiom Default='0,24,0,0', Phone='0'}">
                        
                        <Grid IsVisible="{OnIdiom Default='true', Tablet='true', Phone=false}"
                              RowDefinitions="Auto, Auto"
                              ColumnDefinitions="Auto, Auto, Auto">

                            <Label FontSize="16"
                                   Margin="0,0,0,12"
                                   HorizontalOptions="Start"
                                   TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                   FontFamily="Roboto-Regular"
                                   Text="Your search: 1 adult, 1 bedroom"
                                   VerticalOptions="Start"
                                   VerticalTextAlignment="Start">
                            </Label>

                            <StackLayout Orientation="Vertical"
                                         HeightRequest="80"
                                         WidthRequest="{OnIdiom Default='248', Phone='344'}"
                                         Grid.Row="1"
                                         Grid.Column="0">

                                <Label
                                    FontSize="14"
                                    Margin="0,4"
                                    HorizontalOptions="Start"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                    FontFamily="Roboto-Regular"
                                    Text="Check-in"
                                    VerticalOptions="Start"
                                    VerticalTextAlignment="Start"/>

                                <!--  combo Box for calender  -->
                                <Border Style="{DynamicResource DataFormBorderlessEntryBorderStyle}"
                                        HeightRequest="56"
                                        BackgroundColor="{OnPlatform Default={AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}},MacCatalyst=Transparent}">

                                    <rating:SfComboBox Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                                       x:Name="sfComboBox"
                                                       Margin="8,3,3,-3"
                                                       ItemsSource="{Binding Calender}"
                                                       DropdownFooterViewHeight="0"
                                                       DropdownHeaderViewHeight="300"
                                                       DropDownBackground="Transparent"
                                                       DropDownItemHeight="0"
                                                       DropdownWidth="300"
                                                       FontFamily="Roboto-Regular"
                                                       IsDropDownOpen="{OnIdiom Default={Binding IsDropDownOpen, Mode=TwoWay}, Phone=False}"
                                                       MaximumHeightRequest="300"
                                                       ShowDropdownFooterView="False"
                                                       IsClearButtonVisible="False"
                                                       ShowDropdownHeaderView="True"
                                                       ShowBorder="False"
                                                       Text="{Binding RoomDetail.SelectedRanges}"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                       FontSize="14"
                                                       HeightRequest="40"
                                                       VerticalOptions="Center">

                                        <rating:SfComboBox.DropdownHeaderView>

                                            <Grid Padding="2"
                                                  HeightRequest="300">
                                                <syncfusion:SfCalendar FooterView="{syncfusion:CalendarFooterView ShowActionButtons=True}"
                                                                       Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                                                       EnablePastDates="False"
                                                                       ActionButtonClicked="SfCalendar_ActionButtonClicked"
                                                                       SelectionMode="Range"/>
                                            </Grid>
                                        </rating:SfComboBox.DropdownHeaderView>

                                        <rating:SfComboBox.DropDownButtonSettings>
                                            <rating:DropDownButtonSettings>
                                                <rating:DropDownButtonSettings.View>
                                                    <Label
                                                        FontFamily="FontIcons"
                                                        FontSize="16"
                                                        Margin="0,0,0,5"
                                                        HorizontalTextAlignment="Start"
                                                        VerticalOptions="Center"
                                                        Style="{DynamicResource TitleLabelStyle}"
                                                        Text="{DynamicResource Calendar}"
                                                        TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                        VerticalTextAlignment="Center"
                                                        WidthRequest="20"/>
                                                </rating:DropDownButtonSettings.View>
                                            </rating:DropDownButtonSettings>
                                        </rating:SfComboBox.DropDownButtonSettings>

                                    </rating:SfComboBox>

                                </Border>
                            </StackLayout>

                            <StackLayout Margin="24,0,0,0"
                                         Grid.Column="1"
                                         HeightRequest="80"
                                         WidthRequest="{OnIdiom Default='248', Phone='344'}"
                                         Grid.Row="1"
                                         Orientation="Vertical">
                                <Label
                                    FontSize="14"
                                    Margin="0,4"
                                    HorizontalOptions="Start"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                    FontFamily="Roboto-Regular"
                                    Text="Guests"
                                    VerticalOptions="Start"
                                    VerticalTextAlignment="Start"/>
                                <!--  combo Box for guests  -->
                                <Border Style="{DynamicResource DataFormBorderlessEntryBorderStyle}"
                                        HeightRequest="56"
                                        BackgroundColor="{OnPlatform Default={AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}},MacCatalyst=Transparent}">

                                    <rating:SfComboBox Background="Transparent"
                                                       DropDownBackground="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                                       Margin="8,3,3,-3"
                                                       HeightRequest="40"
                                                       ItemsSource="{Binding GuestsCollection}"
                                                       DisplayMemberPath="DisplayText"
                                                       FontFamily="Roboto-Regular"
                                                       ShowBorder="False"
                                                       ItemPadding="3"
                                                       IsClearButtonVisible="False"
                                                       SelectedIndex="0"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                       FontSize="14"
                                                       VerticalOptions="Center">
                                    </rating:SfComboBox>

                                </Border>
                            </StackLayout>

                            <StackLayout Margin="24,0,0,0"
                                         HeightRequest="80"
                                         WidthRequest="{OnIdiom Default='248', Phone='344'}"
                                         Grid.Column="2"
                                         Grid.Row="1"
                                         Orientation="Vertical">
                                <Label
                                    FontSize="14"
                                    Margin="0,4"
                                    HorizontalOptions="Start"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                    FontFamily="Roboto-Regular"
                                    Text="Bedrooms"
                                    VerticalOptions="Start"
                                    VerticalTextAlignment="Start"/>
                                <!--  combo Box for bed  -->
                                <Border Style="{DynamicResource DataFormBorderlessEntryBorderStyle}"
                                        HeightRequest="56"
                                        BackgroundColor="{OnPlatform Default={AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}},MacCatalyst=Transparent}">

                                    <rating:SfComboBox Background="Transparent"
                                                       DropDownBackground="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                                       x:Name="bedComboBox"
                                                       Margin="8,3,3,-3"
                                                       HeightRequest="40"
                                                       ItemsSource="{Binding BedsCollection}"
                                                       DisplayMemberPath="DisplayText"
                                                       FontFamily="Roboto-Regular"
                                                       ShowBorder="False"
                                                       ItemPadding="3"
                                                       IsClearButtonVisible="False"
                                                       SelectedIndex="0"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                       FontSize="14"
                                                       VerticalOptions="Center">
                                    </rating:SfComboBox>
                                </Border>
                            </StackLayout>
                        </Grid>

                        <Grid IsVisible="{OnIdiom Default=false, Phone=true, Tablet=false}"
                              Padding="{OnIdiom Default=0, Phone=16}"
                              RowSpacing="16"
                              RowDefinitions="Auto,Auto,Auto">
                            <StackLayout Margin="10,5,10,0"
                                         Orientation="Vertical">
                                <Label
                                    FontSize="14"
                                    HorizontalOptions="Start"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                    FontFamily="Roboto-Regular"
                                    Text="Check-in and Check-out"
                                    VerticalOptions="Start"
                                    VerticalTextAlignment="Start"/>
                                <!--  combo Box for calender  -->
                                <Border Style="{DynamicResource DataFormBorderlessEntryBorderStyle}"
                                        HeightRequest="56"
                                        BackgroundColor="{OnPlatform Default={AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}},iOS=Transparent}">

                                    <rating:SfComboBox x:Name="sfComboBoxMobile" Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                                       Margin="8,3,3,-3"
                                                       ItemsSource="{Binding Calender}"
                                                       DropdownFooterViewHeight="0"
                                                       DropdownHeaderViewHeight="300"
                                                       DropDownBackground="Transparent"
                                                       DropDownItemHeight="0"
                                                       DropdownWidth="300"
                                                       FontFamily="Roboto-Regular"
                                                       IsDropDownOpen="{OnIdiom Phone={Binding IsDropDownOpen, Mode=TwoWay}, Default=False}"
                                                       MaximumHeightRequest="300"
                                                       ShowDropdownFooterView="False"
                                                       IsClearButtonVisible="False"
                                                       ShowDropdownHeaderView="True"
                                                       ShowBorder="False"
                                                       Text="{Binding RoomDetail.SelectedRanges}"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                       FontSize="14"
                                                       HeightRequest="40"
                                                       VerticalOptions="Center">

                                        <rating:SfComboBox.DropdownHeaderView>

                                            <Grid Padding="2"
                                                  HeightRequest="300">
                                                <syncfusion:SfCalendar FooterView="{syncfusion:CalendarFooterView ShowActionButtons=True}"
                                                                       Background="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                                                       EnablePastDates="False"
                                                                       ActionButtonClicked="SfCalendar_ActionButtonClicked"
                                                                       SelectionMode="Range"/>
                                            </Grid>
                                        </rating:SfComboBox.DropdownHeaderView>

                                        <rating:SfComboBox.DropDownButtonSettings>
                                            <rating:DropDownButtonSettings>
                                                <rating:DropDownButtonSettings.View>
                                                    <Label
                                                        Padding="0,0,4,0"
                                                        FontFamily="FontIcons"
                                                        FontSize="16"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{DynamicResource TitleLabelStyle}"
                                                        Text="{DynamicResource Calendar}"
                                                        TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                        VerticalTextAlignment="Center"
                                                        WidthRequest="20"/>
                                                </rating:DropDownButtonSettings.View>
                                            </rating:DropDownButtonSettings>
                                        </rating:SfComboBox.DropDownButtonSettings>

                                    </rating:SfComboBox>

                                </Border>
                            </StackLayout>

                            <StackLayout Margin="10,5,10,0"
                                         Grid.Row="1"
                                         Orientation="Vertical">
                                <Label
                                    FontSize="14"
                                    HorizontalOptions="Start"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                    FontFamily="Roboto-Regular"
                                    Text="Guests"
                                    VerticalOptions="Start"
                                    VerticalTextAlignment="Start"/>
                                <!--  combo Box for guests  -->
                                <Border Style="{DynamicResource DataFormBorderlessEntryBorderStyle}"
                                        HeightRequest="56"
                                        BackgroundColor="{OnPlatform Default={AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}},iOS=Transparent}">

                                    <rating:SfComboBox Background="Transparent"
                                                       DropDownBackground="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                                       Margin="8,3,3,-3"
                                                       HeightRequest="40"
                                                       ItemsSource="{Binding GuestsCollection}"
                                                       DisplayMemberPath="DisplayText"
                                                       IsClearButtonVisible="False"
                                                       FontFamily="Roboto-Regular"
                                                       ShowBorder="False"
                                                       ItemPadding="3"
                                                       SelectedIndex="0"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                       FontSize="14"
                                                       VerticalOptions="Center">
                                    </rating:SfComboBox>

                                </Border>
                            </StackLayout>

                            <StackLayout Margin="10,5,10,0"
                                         Grid.Row="2"
                                         Orientation="Vertical">
                                <Label
                                    FontSize="14"
                                    HorizontalOptions="Start"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                    FontFamily="Roboto-Regular"
                                    Text="Bedrooms"
                                    VerticalOptions="Start"
                                    VerticalTextAlignment="Start"/>
                                <!--  combo Box for bed  -->
                                <Border Style="{DynamicResource DataFormBorderlessEntryBorderStyle}"
                                        HeightRequest="56"
                                        BackgroundColor="{OnPlatform Default={AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}},iOS=Transparent}">

                                    <rating:SfComboBox Background="Transparent"
                                                       Margin="8,3,3,-3"
                                                       HeightRequest="40"
                                                       ItemsSource="{Binding BedsCollection}"
                                                       DropDownBackground="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                                       DisplayMemberPath="DisplayText"
                                                       FontFamily="Roboto-Regular"
                                                       ShowBorder="False"
                                                       ItemPadding="3"
                                                       IsClearButtonVisible="False"
                                                       SelectedIndex="0"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                       FontSize="14"
                                                       VerticalOptions="Center">
                                    </rating:SfComboBox>
                                </Border>
                            </StackLayout>
                        </Grid>
                    </Grid>

                    <BoxView  HeightRequest="8"
                              Grid.Row="3"
                              Margin="0,16"
                              IsVisible="{OnIdiom Phone='false', Default='true'}" 
                              BackgroundColor="{AppThemeBinding Light={DynamicResource SentMessageColorLight}, Dark={DynamicResource SentMessageColorDark}}"/>


                    <StackLayout Grid.Row="4"
                                 Padding="{OnIdiom Default=0, Phone=16}"
                                 WidthRequest="{OnIdiom Default=800, Phone=-1}">
                        
                        <!--  Title for amenities  -->
                        <Label
                             Margin="{OnIdiom Default='0,8,0,0', Phone='0,8'}"
                             FontSize="22"
                             HorizontalOptions="Start"
                             Style="{DynamicResource TitleLabelStyle}"
                             Text="Amenities"/>

                        <!--  icon label  -->
                        <FlexLayout
                            Margin="0,8,0,24"
                            Wrap="Wrap"
                            Direction="Row"
                            BindableLayout.ItemsSource="{Binding Facilities}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:RoomDetail">
                                    <Border
                                            Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight},
                                                                        Dark={DynamicResource SeparatorColorDark}}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 32"
                                            Padding="12,4"
                                            Margin="0,0,8,8">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label
                                                Text="{Binding Icon}"
                                                FontFamily="UIKitIcons"
                                                FontSize="18"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center"
                                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight},
                                                                Dark={DynamicResource PrimaryTextColorDark}}" />

                                            <Label
                                                Text="{Binding Facility}"
                                                FontSize="14"
                                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight},
                                                                Dark={DynamicResource PrimaryTextColorDark}}" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </FlexLayout>
                    </StackLayout>

                    <BoxView  HeightRequest="8"
                              Grid.Row="5"
                              IsVisible="{OnIdiom Phone='false', Default='true'}" 
                              BackgroundColor="{AppThemeBinding Light={DynamicResource SentMessageColorLight}, Dark={DynamicResource SentMessageColorDark}}"/>

                    <StackLayout Grid.Row="6"
                                Padding="{OnIdiom Default=0, Phone='16,0'}"
                                WidthRequest="{OnIdiom Default=800, Phone=-1}">
                        <!--  Resort information title  -->
                        <Label
                            Margin="0,20,0,10"
                            FontSize="22"
                            HorizontalOptions="Start"
                            Style="{DynamicResource TitleLabelStyle}"
                            Text="About Hotel"/>

                        <!--  resort description  -->
                        <Label
                            Margin="0"
                            FontSize="16"
                            WidthRequest="{OnIdiom Default=800, Phone=-1}"
                            HorizontalOptions="Start"
                            HorizontalTextAlignment="Start"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                            FontFamily="Roboto-Regular"
                            CharacterSpacing="0.5"
                            Text="{Binding RoomDetail.ResortDescription}"/>
                    </StackLayout>

                    <BoxView  HeightRequest="8"
                              Margin="0,16,0,0"
                              Grid.Row="7"
                              IsVisible="{OnIdiom Phone='false', Default='true'}" 
                              BackgroundColor="{AppThemeBinding Light={DynamicResource SentMessageColorLight}, Dark={DynamicResource SentMessageColorDark}}"/>


                    <StackLayout Grid.Row="8"
                                     Padding="{OnIdiom Default=0, Phone=16}"
                                     WidthRequest="{OnIdiom Default=800, Phone=-1}">
                        
                        <!--  Title for location  -->
                        <Label Margin="0,24"
                               FontSize="22"
                               HorizontalOptions="Start"
                               Style="{DynamicResource TitleLabelStyle}"
                               Text="Location"/>

                        <!--  Map for locating the location  -->
                        <maps:SfMaps Grid.Row="10"
                                 HeightRequest="300"
                                 x:Name="Map"
                                 BackgroundColor="{DynamicResource Gray-Bg}"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill">

                        <maps:SfMaps.Layer>
                            <maps:MapTileLayer UrlTemplate="https://tile.openstreetmap.org/{z}/{x}/{y}.png">
                                <maps:MapTileLayer.Center>
                                    <maps:MapLatLng Latitude="40.133808"
                                                    Longitude="-75.516279"/>
                                </maps:MapTileLayer.Center>

                                <maps:MapTileLayer.ZoomPanBehavior>
                                    <maps:MapZoomPanBehavior ZoomLevel="16"
                                                             EnableZooming="False"/>
                                </maps:MapTileLayer.ZoomPanBehavior>

                                <maps:MapTileLayer.Markers>
                                    <maps:MapMarkerCollection>
                                        <maps:MapMarker Latitude="40.133808"
                                                        Longitude="-75.516279"/>
                                    </maps:MapMarkerCollection>
                                </maps:MapTileLayer.Markers>

                                <!--Template for customizing the address popup-->
                                <maps:MapTileLayer.MarkerTemplate>
                                    <DataTemplate>
                                        <StackLayout>

                                            <!--Set pin image-->
                                            <Image
                                                Margin="10,5,0,0"
                                                HeightRequest="25"
                                                HorizontalOptions="Start"
                                                Source="pin.png"
                                                WidthRequest="25"/>
                                        </StackLayout>
                                    </DataTemplate>
                                </maps:MapTileLayer.MarkerTemplate>
                            </maps:MapTileLayer>
                        </maps:SfMaps.Layer>
                    </maps:SfMaps>

                    </StackLayout>

                    <BoxView  HeightRequest="8"
                              Grid.Row="9"
                              Margin="0,16,0,0"
                              IsVisible="{OnIdiom Phone='false', Default='true'}" 
                              BackgroundColor="{AppThemeBinding Light={DynamicResource SentMessageColorLight}, Dark={DynamicResource SentMessageColorDark}}"/>

                    <!--  Rating and Reviews  -->
                    <StackLayout Grid.Row="10"
                                     WidthRequest="{OnIdiom Default=800, Phone=-1}">
                        <StackLayout Spacing="0">
                            <!--  Rating and Reviews Header  -->
                            <StackLayout Margin="0"
                                         Orientation="Horizontal">

                                <Label
                                    Margin="{OnIdiom Default='0,20,8,8', Phone='16,20,8,8'}"
                                    HorizontalOptions="Start"
                                    Style="{DynamicResource TitleLabelStyle}"
                                    Text="Ratings and Review"
                                    FontSize="22"
                                    VerticalOptions="Center"/>

                            </StackLayout>

                        </StackLayout>

                        <listView:SfListView
                            x:Name="listView"
                            ItemSize="{OnIdiom Default='220', Phone='200'}"
                            HeightRequest="{OnIdiom Phone=450, Default=-1}"
                            IsScrollingEnabled="False"
                            SelectionBackground="Transparent"
                            ItemSpacing="0,8"
                            Padding="{OnIdiom Default=0, Phone=12}"
                            ItemsSource="{Binding RoomDetail.Reviews}">

                            <listView:SfListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RoomBookingReview">
                                    <StackLayout>

                                        <Border StrokeShape="{OnIdiom Default='RoundRectangle 4', Phone='0'}"
                                                Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                StrokeThickness="{OnIdiom Default=1, Phone=0}"
                                                Margin="0"
                                                BackgroundColor="{OnPlatform Default={AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}},MacCatalyst=Transparent}">

                                            <Grid ColumnDefinitions="Auto,*, Auto"
                                                  RowDefinitions="Auto, *, Auto, Auto, 1"
                                                  ColumnSpacing="0">
                                                <!--  Profile Image  -->
                                                <Border
                                                    BackgroundColor="{DynamicResource Gray-Bg}"
                                                    StrokeThickness="{OnIdiom Default=2,Desktop=0}"
                                                    StrokeShape="RoundRectangle 24,24,24,24"
                                                    Margin="{OnIdiom Default='24,24,0,24', Phone='0,0,12,0'}"
                                                    HeightRequest="40"
                                                    Style="{DynamicResource ProfileBorderStyle}"
                                                    WidthRequest="40">
                                                    <Image BackgroundColor="{DynamicResource Gray-200}">
                                                        <Image.Source>
                                                            <UriImageSource
                                                                CacheValidity="14"
                                                                CachingEnabled="true"
                                                                Uri="{Binding CustomerImage}"/>
                                                        </Image.Source>
                                                    </Image>
                                                </Border>

                                                <StackLayout
                                                        Margin="{OnIdiom Default='12,24,0,0', Phone='0'}"
                                                        Padding="0"
                                                        Grid.Column="1"
                                                        Spacing="2"
                                                        VerticalOptions="Start">

                                                    <!--  Customer Name  -->
                                                    <Label
                                                        FontSize="16"
                                                        CharacterSpacing="0.5"
                                                        FontFamily="Roboto-Regular"
                                                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                        HorizontalOptions="Start"
                                                        Text="{Binding CustomerName}"/>

                                                    <!--  Commented Date  -->
                                                    <Label
                                                        FontFamily="Roboto-Regular"
                                                        FontSize="12"
                                                        CharacterSpacing="0.4"
                                                        TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                        Text="{Binding ReviewedDate, StringFormat='Posted on {0:dd MMM yyyy}'}"/>
                                                </StackLayout>

                                                <StackLayout Margin="{OnIdiom Default='24,0', Phone='0'}"
                                                            Grid.Column="2"      
                                                            HorizontalOptions="End"
                                                            VerticalOptions="Center">
                                                    <!--  Product rating  -->
                                                        <HorizontalStackLayout VerticalOptions="Center">
                                                                <Label Text="&#xE71E;"
                                                                        TextColor="#FFBE52"
                                                                        FontFamily="UIKitIcons"
                                                                        WidthRequest="20"
                                                                        FontSize="20"
                                                                        HeightRequest="20"/>
                                                                <Label Text="&#xE71E;"
                                                                    TextColor="#FFBE52"
                                                                    FontFamily="UIKitIcons"
                                                                    WidthRequest="20"
                                                                   FontSize="20"
                                                                    HeightRequest="20"/>
                                                                <Label Text="&#xE71E;"
                                                                    TextColor="#FFBE52"
                                                                    FontFamily="UIKitIcons"
                                                                    WidthRequest="20"
                                                                   FontSize="20"
                                                                    HeightRequest="20"/>
                                                                <Label Text="&#xE71E;"
                                                                    TextColor="#FFBE52"
                                                                    FontFamily="UIKitIcons"
                                                                    WidthRequest="20"
                                                                   FontSize="20"
                                                                    HeightRequest="20"/>
                                                                <Label Text="&#xE71D;"
                                                                    TextColor="#787678"
                                                                    FontFamily="UIKitIcons"
                                                                   FontSize="20"
                                                                    WidthRequest="20"
                                                                    HeightRequest="20"/>
                                                        </HorizontalStackLayout>
                                                    </StackLayout>
                                                
                                                <!--  Product Review  -->
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="{OnIdiom Default='24,0,0,16', Phone='4,16,0,16'}"
                                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{DynamicResource DescriptionLabelStyle}"
                                                    FontFamily="Roboto-Regular"
                                                    Text="{Binding Comment}"/>

                                                <listView:SfListView
                                                        Grid.Row="{OnIdiom Default='2', Phone='3'}"
                                                        Grid.ColumnSpan="3"
                                                        SelectionBackground="Transparent"
                                                        IsScrollingEnabled="False"
                                                        ItemSize="60"
                                                        Margin="{OnIdiom Default='20,0,0,12', Phone='0'}"
                                                        Orientation="Horizontal"
                                                        ItemSpacing="4"
                                                        HeightRequest="80"
                                                        ItemsSource="{Binding CustomerReviewImages}">

                                                    <listView:SfListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" HeightRequest="60" WidthRequest="60">
                                                                <Image
                                                                    Source="mask.png"
                                                                    WidthRequest="60"
                                                                    HeightRequest="60"
                                                                    Aspect="AspectFit"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </listView:SfListView.ItemTemplate>

                                                </listView:SfListView>

                                                    <BoxView  HeightRequest="1"
                                                              Grid.Row="4"
                                                              Margin="0,16" 
                                                              BackgroundColor="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"/>
                                                </Grid>
                                        </Border>
                                    </StackLayout>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>
                    </StackLayout>

                </Grid>
            </Grid>
        </ScrollView>

        <!-- Sticky Footer (Phone only) -->
        <Border
            Grid.Row="1"
            IsVisible="{OnIdiom Phone='true', Default='false'}"
            Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight},
                                            Dark={DynamicResource SeparatorColorDark}}"
            BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight},
                                            Dark={DynamicResource BackgroundColorDark}}">

            <Grid
                Padding="20,12"
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,Auto">

                <Label
                    Grid.Column="0"
                    Grid.Row="0"
                    FontFamily="Roboto-Medium"
                    FontSize="16"
                    VerticalOptions="Center"
                    Text="{Binding FooterPrice}"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight},
                                            Dark={DynamicResource PrimaryTextColorDark}}" />
                <Label
                    Grid.Column="0"
                    Grid.Row="1"
                    FontFamily="Roboto-Regular"
                    CharacterSpacing="0.4"
                    FontSize="12"
                    VerticalOptions="Center"
                    Text="{Binding FooterSummary}"
                    TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight},
                            Dark={DynamicResource SecondaryTextColorDark}}" />

                <buttons:SfButton
                    Grid.Column="1"
                    Grid.RowSpan="2"
                    WidthRequest="140"
                    HeightRequest="52"
                    CornerRadius="26"
                    FontSize="16"
                    Text="Book Now"
                    TextColor="White"
                    Background="{AppThemeBinding Light={DynamicResource PrimaryColorLight},
                                            Dark={DynamicResource PrimaryColorDark}}" />

            </Grid>
        </Border>
        </Grid>
    </ContentView.Content>
</ContentView>