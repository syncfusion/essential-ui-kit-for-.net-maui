<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Catalog.ArticleCardPage"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:model="clr-namespace:EssentialMAUIUIKit.Models"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters"
             x:DataType="local:ArticleCardViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <converter:BooleanToStringConverter x:Key="boolToStringConverter" />
            <converter:BooleanToColorConverter x:Key="boolToColorConverter" />
        </ResourceDictionary>
        <Style TargetType="listView:ListViewItem">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                        Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                        Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>
    <ContentView.BindingContext>
        <local:ArticleCardViewModel />
    </ContentView.BindingContext>
    <ContentView.Content>
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="0">
            <Grid ColumnDefinitions="Auto,*"
                  Padding="0,5,0,5">
                <buttons:SfButton Background="Transparent"
                                  CornerRadius="4"
                                  Margin="{OnIdiom Desktop='0,0,0,0',Phone='0,7,0,9', Tablet='0,15,0,17'}"
                                  HeightRequest="32"
                                  WidthRequest="110"
                                  TextColor="{DynamicResource Gray-700}">
                    <buttons:SfButton.Content>
                        <DataTemplate>
                            <StackLayout Padding="8,5,8,6"
                                         Orientation="Horizontal"
                                         Spacing="8"
                                         VerticalOptions="Center">
                                <Label FontFamily="FontIcons"
                                       Rotation="180"
                                       FontSize="20"
                                       Style="{DynamicResource DescriptionLabelStyle}"
                                       IsVisible="{OnIdiom Phone=True, Tablet=True, Desktop=False}"
                                       Text="{DynamicResource ArrowRight}"
                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center" />
                                <Label FontFamily="Roboto-Medium"
                                       FontSize="16"
                                       Text="Articles"
                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center" />
                            </StackLayout>
                        </DataTemplate>
                    </buttons:SfButton.Content>
                </buttons:SfButton>
                <HorizontalStackLayout Grid.Column="1"
                                       Margin="5"
                                       Spacing="8"
                                       HorizontalOptions="End">
                    <buttons:SfButton Background="Transparent"
                                      CornerRadius="4"
                                      TextColor="{DynamicResource Gray-700}">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Padding="8,5,8,6"
                                             VerticalOptions="Center">
                                    <Label FontFamily="FontIcons"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           Text="{DynamicResource Search}"
                                           TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                           VerticalOptions="Center"
                                           VerticalTextAlignment="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>
                </HorizontalStackLayout>
            </Grid>

            <BoxView Grid.Row="1"
                     Style="{DynamicResource HorizontalSeparatorStyle}" />

            <Grid Grid.Row="2"
                  HorizontalOptions="Center"
                  MaximumWidthRequest="{OnPlatform WinUI=1100, MacCatalyst=1100}">
                <listView:SfListView  ItemSpacing="5"
                                      x:Name="ArticlesCard"
                                      AllowSwiping="True"
                                      AutoFitMode="Height"
                                      ScrollBarVisibility="Never"
                                      ItemsSource="{Binding Articles}"
                                      SelectionBackground="Transparent"
                                      SelectionGesture="Tap"
                                      SelectionMode="Single"
                                      VerticalOptions="Fill">
                    <listView:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="model:Story">
                            <Border HeightRequest="240"
                                    WidthRequest="{OnIdiom Phone=383,
    Tablet=343,
    Desktop=344}"
                                    Margin="0,16,0,16"
                                    Padding="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}">
                                <Border.Content>
                                    <syncEffectsView:SfEffectsView RippleBackground="{DynamicResource Gray-300}"
                                                                   TouchDownEffects="Ripple">

                                        <Border Stroke="Transparent"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4">
                                            <Grid WidthRequest="{OnIdiom Phone=383, Tablet=343, Desktop=344}"
                                                  ColumnSpacing="0"
                                                  ColumnDefinitions="6.5*, 3.5*"
                                                  RowDefinitions="*,Auto,Auto"
                                                  RowSpacing="0">

                                                <Border Grid.ColumnSpan="2"
                                                        Grid.Row="0"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 10">
                                                    <Image Aspect="AspectFill">
                                                        <Image.Source>
                                                            <UriImageSource CacheValidity="14"
                                                                            CachingEnabled="true"
                                                                            Uri="{Binding ImagePath}" />
                                                        </Image.Source>
                                                    </Image>

                                                </Border>

                                                <!--  Description of the Article  -->
                                                <StackLayout Grid.Row="1"
                                                             Grid.Column="0"
                                                             Margin="5,10,5,0"
                                                             Spacing="2"
                                                             HorizontalOptions="Start"
                                                             VerticalOptions="Start">

                                                    <!--  Article Title  -->
                                                    <Label Margin="0"
                                                           FontFamily="Roboto-Medium"
                                                           HorizontalOptions="Start"
                                                           LineBreakMode="TailTruncation"
                                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                           Text="{Binding Name}"
                                                           VerticalOptions="End" />

                                                    <!--  Author name  -->
                                                    <Label FontFamily="Roboto-Medium"
                                                           FontSize="12"
                                                           LineHeight="{OnPlatform Default=-1,
                                                            Android=1.5}"
                                                           Text="{Binding Author}"
                                                           TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                           VerticalOptions="End" />

                                                    <!--  Published date and average reading time  -->
                                                    <Label Grid.Row="2"
                                                           FontFamily="Roboto-Regular"
                                                           Margin="0,0,0,8"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                           LineHeight="{OnPlatform Default=-1,
                                                            Android=1.5}"
                                                           VerticalOptions="End">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding Date}"
                                                                      TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                                      FontFamily="Roboto-Regular" />
                                                                <Span Text=" | "
                                                                      TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                                      FontFamily="Roboto-Regular" />
                                                                <Span Text="{Binding AverageReadingTime}"
                                                                      TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                                                      FontFamily="Roboto-Regular" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>

                                                <StackLayout Grid.Row="1"
                                                             Grid.Column="1">
                                                    <StackLayout Margin="0,8,5,8"
                                                                 HorizontalOptions="End"
                                                                 VerticalOptions="Start"
                                                                 Orientation="Horizontal"
                                                                 Spacing="0">

                                                        <!--  Share Icon  -->
                                                        <buttons:SfButton x:Name="shareButton"
                                                                          Padding="0"
                                                                          FontAttributes="Bold"
                                                                          HeightRequest="30"
                                                                          FontSize="18"
                                                                          HorizontalTextAlignment="Center"
                                                                          Style="{DynamicResource IconButtonStyle}"
                                                                          Text="{DynamicResource Share}"
                                                                          WidthRequest="30" />

                                                        <!--  Favourite Icon  -->
                                                        <buttons:SfButton HeightRequest="30"
                                                                          FontAttributes="Bold"
                                                                          FontSize="18"
                                                                          Style="{DynamicResource IconButtonStyle}"
                                                                          Text="{Binding IsFavourite, Converter={StaticResource boolToStringConverter}, ConverterParameter=1}"
                                                                          TextColor="{Binding IsFavourite, Converter={StaticResource boolToColorConverter}, ConverterParameter=4}"
                                                                          Clicked="FavouriteButton_Clicked_1"
                                                                          WidthRequest="30" />

                                                        <!--  Bookmark Button  -->
                                                        <buttons:SfButton HeightRequest="30"
                                                                          FontSize="18"
                                                                          FontAttributes="Bold"
                                                                          Style="{DynamicResource IconButtonStyle}"
                                                                          Text="{Binding IsBookmarked, Converter={StaticResource boolToStringConverter}, ConverterParameter=0}"
                                                                          TextColor="{AppThemeBinding Light=#474648, Dark=#C9C6C8}"
                                                                          Clicked="BookmarkButton_Clicked"
                                                                          WidthRequest="30" />


                                                    </StackLayout>

                                                </StackLayout>

                                                <BoxView Grid.Row="2"
                                                         Margin="0,5,0,0"
                                                         Grid.ColumnSpan="2"
                                                         Style="{DynamicResource HorizontalSeparatorStyle}" />
                                            </Grid>

                                        </Border>
                                    </syncEffectsView:SfEffectsView>
                                </Border.Content>
                            </Border>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>

                    <!--  Layout to customize no. of columns in SfListView  -->
                    <listView:SfListView.ItemsLayout>
                        <listView:GridLayout SpanCount="{OnIdiom Phone=1, Tablet=2, Desktop=3}" />
                    </listView:SfListView.ItemsLayout>

                </listView:SfListView>
            </Grid>
        </Grid>
    </ContentView.Content>
</ContentView>