<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Catalog.CategoryTilePage"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:chip="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             x:DataType="local:CategoryTileViewModel">
    <ContentView.BindingContext>
        <local:CategoryTileViewModel x:Name="viewModel" />
    </ContentView.BindingContext>
    <ContentView.Resources>
        <Style TargetType="listView:ListViewItem">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                        Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                        Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="SideNavButtonStyle"
               TargetType="buttons:SfButton">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="CornerRadius"
                    Value="4" />
            <Setter Property="TextColor"
                    Value="{DynamicResource Gray-700}" />
        </Style>
        <Style x:Key="SideNavIconContainerStyle"
               TargetType="StackLayout">
            <Setter Property="Padding"
                    Value="8,5,8,6" />
            <Setter Property="VerticalOptions"
                    Value="Center" />
        </Style>
        <Style x:Key="SideNavIconLabelStyle"
               TargetType="Label">
            <Setter Property="FontSize"
                    Value="22" />
            <Setter Property="FontAttributes"
                    Value="Bold" />
            <Setter Property="VerticalOptions"
                    Value="Center" />
            <Setter Property="VerticalTextAlignment"
                    Value="Center" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}" />
        </Style>
        <Style x:Key="BottomNavButtonStyle"
               TargetType="buttons:SfButton"
               BasedOn="{StaticResource SideNavButtonStyle}" />
        <Style x:Key="BottomNavItemContainerStyle"
               TargetType="StackLayout">
            <Setter Property="Padding"
                    Value="8,5,8,6" />
            <Setter Property="VerticalOptions"
                    Value="Center" />
        </Style>
        <Style x:Key="BottomNavIconLabelStyle"
               TargetType="Label"
               BasedOn="{StaticResource SideNavIconLabelStyle}">
            <Setter Property="HorizontalOptions"
                    Value="Center" />
        </Style>
        <Style x:Key="BottomNavTextLabelStyle"
               TargetType="Label">
            <Setter Property="FontFamily"
                    Value="Roboto-Medium" />
            <Setter Property="VerticalOptions"
                    Value="Center" />
            <Setter Property="VerticalTextAlignment"
                    Value="Center" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}" />
        </Style>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="Auto,*">
                <buttons:SfButton Background="Transparent"
                                  CornerRadius="4"
                                  Margin="{OnIdiom Desktop='0,8,0,12',Phone='0,10,0,12', Tablet='0,15,0,17'}"
                                  HeightRequest="32"
                                  WidthRequest="120"
                                  TextColor="{DynamicResource Gray-700}">
                    <buttons:SfButton.Content>
                        <DataTemplate>
                            <StackLayout Padding="8,0,8,0"
                                         Orientation="Horizontal"
                                         Spacing="8"
                                         VerticalOptions="Center">
                                <Label FontFamily="FontIcons"
                                       Rotation="180"
                                       IsVisible="{OnIdiom Phone=True, Tablet=True, Desktop=False}"
                                       FontSize="20"
                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                       Text="{DynamicResource ArrowRight}"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center" />
                                <Label FontFamily="Roboto-Medium"
                                       Text="Categories"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center" />
                            </StackLayout>
                        </DataTemplate>
                    </buttons:SfButton.Content>
                </buttons:SfButton>
                <HorizontalStackLayout Grid.Column="1"
                                       Margin="5"
                                       Spacing="8"
                                       HorizontalOptions="End">
                    <buttons:SfButton Background="Transparent"
                                      CornerRadius="4"
                                      TextColor="{DynamicResource Gray-700}">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Padding="8,5,8,6"
                                             VerticalOptions="Center">
                                    <Label FontFamily="FontIcons"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                           Text="{DynamicResource Search}"
                                           VerticalOptions="Center"
                                           VerticalTextAlignment="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>

                    <buttons:SfButton Background="Transparent"
                                      CornerRadius="4"
                                      TextColor="{DynamicResource Gray-700}">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Padding="8,5,8,6"
                                             VerticalOptions="Center">
                                    <Label FontFamily="FontIcons"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           Text="{DynamicResource Cart}"
                                           VerticalOptions="Center"
                                           VerticalTextAlignment="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>
                </HorizontalStackLayout>
            </Grid>

            <BoxView HeightRequest="1"
                     Grid.Row="1"
                     IsVisible="{OnIdiom Phone=True, Tablet=True, Desktop=True}"
                     Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" />

            <Grid Grid.Row="2"
                  RowDefinitions="*,Auto"
                  ColumnDefinitions="Auto,Auto,*">

                <VerticalStackLayout Spacing="{OnIdiom Tablet=28, Desktop=24}"
                                     Padding="0,8,0,0"
                                     Margin="{OnIdiom Tablet='10,22,10,0', Desktop='0,20,20,0'}"
                                     IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}">
                    <buttons:SfButton Style="{StaticResource SideNavButtonStyle}">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Style="{StaticResource SideNavIconContainerStyle}"
                                             Padding="{OnIdiom Phone='8,5,8,6', Desktop='8,5,8,6', Tablet='5,5,8,6'}">
                                    <Label FontFamily="UIKitIcons"
                                           FontSize="26"
                                           TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                           Text="&#xe701;"
                                           VerticalOptions="Center"
                                           VerticalTextAlignment="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>
                    <buttons:SfButton Style="{StaticResource SideNavButtonStyle}">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Style="{StaticResource SideNavIconContainerStyle}">
                                    <Label Style="{StaticResource SideNavIconLabelStyle}"
                                           FontFamily="FontIcons"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                           Text="{DynamicResource Category}"
                                           HorizontalTextAlignment="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>

                    <buttons:SfButton Style="{StaticResource SideNavButtonStyle}">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Style="{StaticResource SideNavIconContainerStyle}">
                                    <Label Style="{StaticResource SideNavIconLabelStyle}"
                                           FontFamily="FontIcons"
                                           Text="{DynamicResource Cart}"
                                           HorizontalTextAlignment="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>

                    <buttons:SfButton Style="{StaticResource SideNavButtonStyle}">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Style="{StaticResource SideNavIconContainerStyle}">
                                    <Label Style="{StaticResource SideNavIconLabelStyle}"
                                           FontFamily="FontIcons" BackgroundColor="Red"
                                           Text="{DynamicResource Settings}"
                                           HorizontalTextAlignment="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>

                    <buttons:SfButton Style="{StaticResource SideNavButtonStyle}">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Style="{StaticResource SideNavIconContainerStyle}">
                                    <Label Style="{StaticResource SideNavIconLabelStyle}"
                                           FontFamily="FontIcons"
                                           Text="{DynamicResource Account}"
                                           HorizontalTextAlignment="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>
                </VerticalStackLayout>
                <BoxView WidthRequest="1"
                         Grid.Column="1"
                         IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}"
                         Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" />

                <ScrollView Grid.Column="2"
                            Grid.Row="0">
                    <Border Padding="{OnIdiom Phone=0, Tablet=20, Desktop='0,0,30,0'}"
                            Margin="0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout MaximumWidthRequest="{OnPlatform WinUI=930, MacCatalyst=900}"
                                             HorizontalOptions="Center">

                            <Label Text="Catalog"
                                   IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}"
                                   Margin="10,15,10,15"
                                   FontSize="16"
                                   FontFamily="Roboto-Medium"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                            <BoxView HeightRequest="1"
                                     Margin="10,0,0,5"
                                     IsVisible="{OnIdiom Phone=True, Tablet=True, Desktop=True}"
                                     Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" />

                            <chip:SfChipGroup Margin="{OnIdiom Phone='20,10,0,10',Desktop='10,10,0,10',Tablet='10,10,0,10'}">
                                <chip:SfChipGroup.Items>
                                    <chip:SfChip Text="All Categories"
                                                 CornerRadius="32"
                                                 HeightRequest="32"
                                                 FontFamily="Roboto-Medium"
                                                 FontSize="14"
                                                 TextColor="#FFFFFF"
                                                 Background="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}" />
                                    <chip:SfChip Text="Popular"
                                                 CornerRadius="32"
                                                 Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                 TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                 HeightRequest="32"
                                                 FontSize="14"
                                                 FontFamily="Roboto-Medium" />
                                    <chip:SfChip Text="New Arrivals"
                                                 CornerRadius="32"
                                                 HeightRequest="32"
                                                 Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                 TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                 FontSize="14"
                                                 FontFamily="Roboto-Medium" />
                                    <chip:SfChip Text="Featured"
                                                 CornerRadius="32"
                                                 IsVisible="{OnIdiom Phone=True,Desktop=True,Tablet=True}"
                                                 HeightRequest="32"
                                                 Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                 TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                 FontSize="14"
                                                 FontFamily="Roboto-Medium" />
                                    <chip:SfChip Text="Essentials"
                                                 IsVisible="{OnIdiom Phone=False,Desktop=True,Tablet=True}"
                                                 CornerRadius="32"
                                                 HeightRequest="32"
                                                 Stroke="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}"
                                                 TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                 FontSize="14"
                                                 FontFamily="Roboto-Medium" />
                                </chip:SfChipGroup.Items>
                            </chip:SfChipGroup>

                            <!--  ListView for Category  -->
                            <listView:SfListView Padding="0"
                                                 IsScrollingEnabled="False"
                                                 AutoFitMode="Height"
                                                 BackgroundColor="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                                 ItemSpacing="{OnPlatform WinUI='0,0,0,10', Default='0,0,0,20'}"
                                                 ItemsSource="{Binding Categories}"
                                                 Style="{DynamicResource TransparentSelectionListView}">

                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:CategoryItem">
                                        <VerticalStackLayout Spacing="{OnIdiom Phone=0, Tablet=0, Desktop=6}"
                                                             Margin="{OnIdiom Phone=0, Tablet=0, Desktop='0,10,0,0'}"
                                                             WidthRequest="{OnIdiom Phone=164, Tablet=210, Desktop=164}"
                                                             HorizontalOptions="Center">
                                            <syncEffectsView:SfEffectsView TouchDownEffects="Ripple"
                                                                           RippleBackground="{DynamicResource Gray-300}">
                                                <Border Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 12"
                                                        HeightRequest="{OnIdiom Phone=150, Tablet=200, Desktop=150}"
                                                        WidthRequest="{OnIdiom Phone=164, Tablet=210, Desktop=164}">

                                                    <Image Aspect="AspectFill"
                                                           BackgroundColor="Transparent">
                                                        <Image.Source>
                                                            <UriImageSource Uri="{Binding Icon}"
                                                                            CachingEnabled="true"
                                                                            CacheValidity="14" />
                                                        </Image.Source>
                                                    </Image>
                                                </Border>
                                            </syncEffectsView:SfEffectsView>

                                            <!--  Category Name  -->
                                            <Label Text="{Binding Name}"
                                                   FontSize="14"
                                                   Margin="{OnIdiom Phone='0,5,0,0',Desktop=0, Tablet=0}"
                                                   HorizontalOptions="Center"
                                                   FontFamily="Roboto-Medium"
                                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>

                                <!--  Layout to customize no. of columns in SfListView  -->
                                <listView:SfListView.ItemsLayout>
                                    <listView:GridLayout x:Name="gridLayout"
                                                         SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                                </listView:SfListView.ItemsLayout>
                            </listView:SfListView>
                        </VerticalStackLayout>
                    </Border>
                </ScrollView>
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Padding="0,5,10,5"
                                       Grid.Row="1"
                                       Grid.Column="2"
                                       IsVisible="{OnIdiom Phone=True, Tablet=False, Desktop=False}">
                    <buttons:SfButton Style="{StaticResource BottomNavButtonStyle}" WidthRequest="76">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Style="{StaticResource BottomNavItemContainerStyle}">
                                    <Label Style="{StaticResource BottomNavIconLabelStyle}"
                                           FontFamily="UIKitIcons"
                                           FontSize="26"
                                           TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                           Text="&#xe701;"
                                           HorizontalOptions="Center" />
                                    <Label Style="{StaticResource BottomNavTextLabelStyle}"
                                           Text="Home"
                                           Margin="10,0,0,5" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>
                    <buttons:SfButton Style="{StaticResource BottomNavButtonStyle}" WidthRequest="86">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Style="{StaticResource BottomNavItemContainerStyle}">
                                    <Label Style="{StaticResource BottomNavIconLabelStyle}"
                                           FontFamily="FontIcons"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                           Text="{DynamicResource Category}"
                                           HorizontalOptions="Center" />
                                    <Label Style="{StaticResource BottomNavTextLabelStyle}"
                                           Text="Categories"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                           HorizontalOptions="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>

                    <buttons:SfButton Style="{StaticResource BottomNavButtonStyle}" WidthRequest="76">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Style="{StaticResource BottomNavItemContainerStyle}">
                                    <Label Style="{StaticResource BottomNavIconLabelStyle}"
                                           FontFamily="FontIcons"
                                           Text="{DynamicResource Cart}"
                                           HorizontalOptions="Center" />
                                    <Label Style="{StaticResource BottomNavTextLabelStyle}"
                                           Text="Cart"
                                           HorizontalOptions="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>

                    <buttons:SfButton Style="{StaticResource BottomNavButtonStyle}" WidthRequest="76">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Style="{StaticResource BottomNavItemContainerStyle}">
                                    <Label Style="{StaticResource BottomNavIconLabelStyle}"
                                           FontFamily="FontIcons"
                                           Text="{DynamicResource Settings}"
                                           TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}"
                                           HorizontalOptions="Center" />
                                    <Label Style="{StaticResource BottomNavTextLabelStyle}"
                                           Text="Settings"
                                           HorizontalOptions="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>

                    <buttons:SfButton Style="{StaticResource BottomNavButtonStyle}" WidthRequest="76">
                        <buttons:SfButton.Content>
                            <DataTemplate>
                                <StackLayout Style="{StaticResource BottomNavItemContainerStyle}">
                                    <Label Style="{StaticResource BottomNavIconLabelStyle}"
                                           FontFamily="FontIcons"
                                           Text="{DynamicResource Account}"
                                           HorizontalOptions="Center" />
                                    <Label Style="{StaticResource BottomNavTextLabelStyle}"
                                           Text="Account"
                                           HorizontalOptions="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfButton.Content>
                    </buttons:SfButton>
                </HorizontalStackLayout>

                <!-- Floating chat button (overlay) -->
                <buttons:SfButton CornerRadius="28"
                                  Grid.Column="2"
                                  Margin="{OnIdiom Phone='0,0,15,20', Tablet='0,0,30,20', Desktop='0,0,96,40'}"
                                  WidthRequest="48"
                                  HeightRequest="48"
                                  Background="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                  TextColor="White"
                                  HorizontalOptions="End"
                                  VerticalOptions="End">
                    <buttons:SfButton.Content>
                        <DataTemplate>
                            <Label FontFamily="UIKitIcons"
                                   FontSize="22"
                                   TextColor="#FFFFFF"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Text="&#xe71b;" />
                        </DataTemplate>
                    </buttons:SfButton.Content>
                </buttons:SfButton>
            </Grid>
        </Grid>
    </ContentView.Content>
</ContentView>