<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Catalog.TravelPlannerPage"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:rotator="clr-namespace:Syncfusion.Maui.Rotator;assembly=Syncfusion.Maui.Rotator"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:model="clr-namespace:EssentialMAUIUIKit.Models.Catalog"
             x:DataType="local:TravelPlannerViewModel">
    <ContentView.BindingContext>
        <local:TravelPlannerViewModel />
    </ContentView.BindingContext>
    <ContentView.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="boolToColorConverter" />
            <converter:BooleanToStringConverter x:Key="boolToStringConverter" />
        </ResourceDictionary>
        <Style TargetType="listView:ListViewItem">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                        Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                        Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>

    <ContentView.Content>
        <Grid>
            <ScrollView>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      MaximumWidthRequest="{OnIdiom Phone=400, Desktop=950, Tablet=950}" 
                      HorizontalOptions="Center">

                    <!--  Rotator for travel places  -->
                    <rotator:SfRotator Grid.Row="0"
                                       x:Name="sfRotator"
                                       BackgroundColor="Transparent"
                                       DotPlacement="OutSide"
                                       Margin="{OnPlatform Default='10,10,10,0', MacCatalyst='100,0,100,0'}"
                                       HeightRequest="{OnIdiom Phone=315, Desktop=330, Tablet=335}"
                                       DotsStroke="Transparent"
                                       HorizontalOptions="Center"
                                       ItemsSource="{Binding TravelPlacesList}"
                                       NavigationStripMode="Dots"
                                       NavigationStripPosition="Bottom"
                                       SelectedDotColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                       UnselectedDotColor="{DynamicResource Gray-200}">
                        <rotator:SfRotator.ItemTemplate>
                            <DataTemplate x:DataType="model:Travel">
                                <Border WidthRequest="{OnIdiom Phone=393, Desktop=650, Tablet=450}"
                                        Stroke="{AppThemeBinding Light={DynamicResource Gray200}, Dark=Transparent}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10">
                                    <Grid x:Name="grid"
                                          RowDefinitions="Auto, Auto, Auto"
                                          RowSpacing="0">

                                        <!--  Image of the place  -->
                                        <Image Aspect="AspectFill"
                                               BackgroundColor="{DynamicResource Gray-White}"
                                               HeightRequest="{OnIdiom Phone=200, Desktop=216, Tablet=210}">
                                            <Image.Source>
                                                <UriImageSource CacheValidity="14"
                                                                CachingEnabled="true"
                                                                Uri="{Binding ImagePath}" />
                                            </Image.Source>
                                        </Image>

                                        <!--  Travel place  -->
                                        <Label Grid.Row="1"
                                               Margin="16,8,16,4"
                                               HorizontalOptions="Start"
                                               Style="{DynamicResource TitleLabelStyle}"
                                               Text="{Binding Place}" />

                                        <!--  Details of travel place  -->
                                        <Label WidthRequest="{OnIdiom Phone=300, Desktop=600, Tablet=600}"
                                               Grid.Row="2"
                                               Margin="16,0,16,16"
                                               MaxLines="2"
                                               HorizontalOptions="Start"
                                               LineBreakMode="TailTruncation"
                                               FontSize="12"
                                               HorizontalTextAlignment="Start"
                                               Text="{Binding Details}" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </rotator:SfRotator.ItemTemplate>
                    </rotator:SfRotator>

                    <Grid Grid.Row="1"
                          Margin="{OnIdiom Phone='10,20,10,0', Desktop='20,20,10,0', Tablet='20,20,10,0'}">
                        <Label FontSize="22"
                               HorizontalOptions="Start"
                               FontFamily="Roboto-Medium"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                               Text="Top Destinations"
                               VerticalOptions="Center" />
                    </Grid>

                    <listView:SfListView Grid.Row="2"
                                         Margin="0"
                                         Padding="0"
                                         AutoFitMode="Height"
                                         Orientation="Horizontal"
                                         IsScrollingEnabled="{OnPlatform WinUI=False, Default=True}"
                                         HeightRequest="260"
                                         ItemSpacing="{OnPlatform MacCatalyst=3, Default=0}"
                                         HorizontalOptions="Center"
                                         IsStickyHeader="True"
                                         ItemsSource="{Binding TopDestinationsList}"
                                         SelectionBackground="Transparent">

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="model:Travel">

                                <Border Padding="10"
                                        Margin="{OnIdiom Phone='8,0,8,0', Desktop='10,0,10,0', Tablet='5,0,15,0'}"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0.3"
                                        HeightRequest="248"
                                        WidthRequest="213">

                                    <!-- Shadow -->
                                    <Border.Shadow>
                                        <Shadow Brush="#80000000"
                                                Offset="0,3"
                                                Radius="3"
                                                Opacity="0.4" />
                                    </Border.Shadow>

                                    <syncEffectsView:SfEffectsView RippleBackground="{DynamicResource Gray-300}"
                                                                   TouchDownEffects="Ripple">

                                        <Grid HorizontalOptions="Start"
                                              RowDefinitions="Auto,Auto,Auto,Auto">

                                            <!-- Image Container -->
                                            <Grid>
                                                <Image Margin="0,0,0,5"
                                                       Aspect="AspectFill"
                                                       HeightRequest="124"
                                                       HorizontalOptions="Fill"
                                                       Source="{Binding ImagePath}"
                                                       VerticalOptions="Start" />
                                            </Grid>

                                            <Grid Grid.Row="1"
                                                  Margin="0,8,0,2">
                                                <!-- Title -->
                                                <Label Text="{Binding Place}"
                                                       FontSize="14"
                                                       FontFamily="Roboto-Medium"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />
                                                <Border BackgroundColor="#7C3AED"
                                                        Padding="6,1,6,1"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="Start"
                                                        StrokeShape="RoundRectangle 12">

                                                    <Label Text="★ 3.0"
                                                           FontFamily="Roboto-Medium"
                                                           TextColor="#FFFFFF"
                                                           FontSize="11" />
                                                </Border>
                                            </Grid>

                                            <!-- Description -->
                                            <Label Grid.Row="2"
                                                   Margin="0,5,0,0"
                                                   Text="{Binding Details}"
                                                   FontSize="12"
                                                   FontFamily="Roboto-Regular"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"
                                                   TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}" />

                                            <!-- Bottom row -->
                                            <Grid Grid.Row="3"
                                                  ColumnDefinitions="*,Auto"
                                                  Margin="0,12,0,0">

                                                <Label Text="{Binding Price}"
                                                       FontSize="16"
                                                       FontFamily="Roboto-Medium"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                                       VerticalOptions="Center" />

                                                <Label Grid.Column="1"
                                                       FontFamily="FontIcons"
                                                       Text="{DynamicResource ArrowRight}"
                                                       Style="{DynamicResource IconLabelStyle}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}" />
                                            </Grid>
                                        </Grid>
                                    </syncEffectsView:SfEffectsView>
                                </Border>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                    </listView:SfListView>
                    
                    <Grid Grid.Row="3"
                          Margin="10,10,8,10"
                          RowDefinitions="Auto,*"
                          ColumnSpacing="0"
                          RowSpacing="0">
                        <buttons:SfButton Background="Transparent"
                                          CornerRadius="4"
                                          Margin="{OnIdiom Desktop='0,8,0,12',Phone='0,10,0,12', Tablet='0,15,0,17'}"
                                          HeightRequest="32"
                                          WidthRequest="90"
                                          TextColor="{DynamicResource Gray-700}">
                            <buttons:SfButton.Content>
                                <DataTemplate>
                                    <StackLayout Padding="8,0,8,0"
                                                 Orientation="Horizontal"
                                                 Spacing="8"
                                                 VerticalOptions="Center">
                                        <Label FontFamily="Roboto-Medium"
                                               FontSize="14"
                                               Text="View All"
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                               VerticalOptions="Center"
                                               VerticalTextAlignment="Center" />
                                        <Label FontFamily="FontIcons"
                                               Rotation="90"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               Text="{DynamicResource Next}"
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                               VerticalOptions="Center"
                                               VerticalTextAlignment="Center" />
                                    </StackLayout>
                                </DataTemplate>
                            </buttons:SfButton.Content>
                        </buttons:SfButton>
                        <Label FontSize="22"
                               Grid.Row="1"
                               Margin="{OnPlatform Android='0,20,0,0', iOS='4,20,0,0', Default='18,20,0,0'}"
                               HorizontalOptions="Start"
                               FontFamily="Roboto-Medium"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                               Text="Best Places"
                               VerticalOptions="Center" />
                    </Grid>

                    <listView:SfListView Grid.Row="4"
                                         Padding="0"
                                         AutoFitMode="Height"
                                         ItemSpacing="{OnPlatform MacCatalyst=2, Default=0}"
                                         Orientation="Horizontal"
                                         HorizontalOptions="Center"
                                         HeightRequest="270"
                                         IsStickyHeader="True"
                                         ItemsSource="{Binding BestPlacesList}"
                                         SelectionBackground="Transparent">
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="model:Travel">
                                <Border Margin="{OnIdiom Phone='8,0,8,24', Desktop='8,0,8,0', Tablet='2,0,14,0'}"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        Stroke="{AppThemeBinding Light={DynamicResource BackgroundColorLight}, Dark={DynamicResource BackgroundColorDark}}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        HeightRequest="250"
                                        WidthRequest="212">
                                    <syncEffectsView:SfEffectsView RippleBackground="{DynamicResource Gray-300}"
                                                                   TouchDownEffects="Ripple">
                                        <Border HorizontalOptions="Start"
                                                Stroke="Transparent"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4">
                                            <Grid ColumnSpacing="0"
                                                  RowSpacing="0">

                                                <!--  Place image  -->
                                                <Image Aspect="AspectFill"
                                                       Source="{Binding ImagePath}"
                                                       VerticalOptions="Fill" />

                                                <!--  OverLay Effect  -->
                                                <Border BackgroundColor="{DynamicResource Gray-Black}"
                                                        Opacity="0.15" />

                                                <!--  Place name  -->
                                                <Label Margin="15,0,0,12"
                                                       HorizontalOptions="Start"
                                                       FontSize="14"
                                                       FontFamily="Roboto-Medium"
                                                       Text="{Binding Place}"
                                                       TextColor="{DynamicResource Gray-White}"
                                                       VerticalOptions="End" />

                                                <!--  Favourite Icon  -->
                                                <buttons:SfButton Margin="0,2,10,0"
                                                                  HeightRequest="30"
                                                                  HorizontalOptions="End"
                                                                  Style="{DynamicResource IconButtonStyle}"
                                                                  Text="{Binding IsFavourite, Converter={StaticResource boolToStringConverter}, ConverterParameter=1}"
                                                                  TextColor="{Binding IsFavourite, Converter={StaticResource boolToColorConverter}, ConverterParameter=2}"
                                                                  Clicked="FavouriteButton_Clicked"
                                                                  VerticalOptions="Start"
                                                                  WidthRequest="30" />

                                            </Grid>
                                        </Border>
                                    </syncEffectsView:SfEffectsView>
                                </Border>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                    </listView:SfListView>
                </Grid>
            </ScrollView>
            <!-- Floating chat button (overlay) -->
            <buttons:SfButton CornerRadius="28"
                              Grid.Row="4"
                              Grid.Column="2"
                              Margin="0,0,30,30"
                              WidthRequest="48"
                              HeightRequest="48"
                              Background="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                              TextColor="White"
                              HorizontalOptions="End"
                              VerticalOptions="End">
                <buttons:SfButton.Content>
                    <DataTemplate>
                        <Label FontFamily="UIKitIcons"
                               FontSize="22"
                               TextColor="#FFFFFF"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Text="&#xe71b;" />
                    </DataTemplate>
                </buttons:SfButton.Content>
            </buttons:SfButton>
        </Grid>
    </ContentView.Content>
</ContentView>