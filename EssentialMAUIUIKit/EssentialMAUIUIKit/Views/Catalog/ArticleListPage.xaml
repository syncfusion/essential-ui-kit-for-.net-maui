<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Catalog.ArticleListPage"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Rotator;assembly=Syncfusion.Maui.Rotator"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:model="clr-namespace:EssentialMAUIUIKit.Models"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             x:DataType="local:ArticleListViewModel">
    <ContentView.BindingContext>
        <local:ArticleListViewModel />
    </ContentView.BindingContext>
    <ContentView.Content>
        <Grid RowDefinitions="Auto,*">
            <StackLayout Grid.Row="0">
                <buttons:SfButton Background="Transparent"
                                  CornerRadius="4"
                                  HorizontalOptions="Start"
                                  Margin="{OnIdiom Desktop='0,10,0,10',Phone='0,7,0,9',Tablet='0,15,0,17'}"
                                  HeightRequest="32"
                                  WidthRequest="100"
                                  TextColor="{DynamicResource Gray-700}">
                    <buttons:SfButton.Content>
                        <DataTemplate>
                            <StackLayout Padding="8,5,8,6"
                                         Orientation="Horizontal"
                                         Spacing="12"
                                         VerticalOptions="Center">
                                <Label FontFamily="FontIcons"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       Text="{DynamicResource BurgerMenu}"
                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center" />
                                <Label FontFamily="Roboto-Medium"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                       Text="Blog"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center" />
                            </StackLayout>
                        </DataTemplate>
                    </buttons:SfButton.Content>
                </buttons:SfButton>

                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" />
            </StackLayout>
            <ScrollView Grid.Row="1">
                <Grid RowDefinitions="Auto,Auto,Auto"
                      Padding="0,20,0,0"
                      HorizontalOptions="Center"
                      MaximumWidthRequest="{OnIdiom Phone=400, Tablet=765, Desktop=765}">

                    <!--<Rotator for featured blog stories>-->
                    <syncfusion:SfRotator Grid.Row="0"
                                          x:Name="Rotator"
                                          BackgroundColor="Transparent"
                                          Margin="{OnPlatform Android='10,0,10,0',iOS='10,0,10,0' ,MacCatalyst='50,0,50,0'}"
                                          DotPlacement="OutSide"
                                          DotsStroke="Transparent"
                                          HeightRequest="{OnPlatform Default=340, Android=276, iOS=270}"
                                          HorizontalOptions="Start"
                                          ItemsSource="{Binding FeaturedStories}"
                                          NavigationDirection="Horizontal"
                                          NavigationStripMode="Dots"
                                          SelectedDotColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                          UnselectedDotColor="{AppThemeBinding Light=#F3F0F2, Dark=#3C3B3D}"
                                          VerticalOptions="Start">
                        <syncfusion:SfRotator.ItemTemplate>
                            <DataTemplate x:DataType="model:Story">
                                <Border Stroke="{DynamicResource Gray-300}"
                                        StrokeThickness="1"
                                        HeightRequest="{OnPlatform Default=300, Android=256, iOS=270}"
                                        WidthRequest="{OnIdiom Phone=380, Tablet=765, Desktop=650}"
                                        StrokeShape="RoundRectangle 10">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <Image Aspect="AspectFill"
                                               BackgroundColor="{DynamicResource Gray-200}"
                                               HeightRequest="{OnPlatform Default=199, Android=146, iOS=146}">
                                            <Image.Source>
                                                <UriImageSource CacheValidity="14"
                                                                CachingEnabled="true"
                                                                Uri="{Binding ImagePath}" />
                                            </Image.Source>
                                        </Image>

                                        <StackLayout Grid.Row="1"
                                                     Spacing="0"
                                                     BackgroundColor="{AppThemeBinding Light=White, Dark=Transparent}">
                                            <!--  Blog tile  -->
                                            <Label FontFamily="Roboto-Medium"
                                                   HorizontalOptions="Start"
                                                   LineBreakMode="TailTruncation"
                                                   FontSize="14"
                                                   Margin="{OnPlatform Default='14,14,8,0',MacCatalyst='14,20,8,0'}"
                                                   LineHeight="{OnPlatform Default=-1,
                                Android=1.25}"
                                                   MaxLines="1"
                                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                   Style="{DynamicResource TitleLabelStyle}"
                                                   Text="{Binding Name}" />

                                            <!--  Author name  -->
                                            <Label Grid.Row="1"
                                                   Grid.Column="1"
                                                   FontFamily="Roboto-Regular"
                                                   FontSize="12"
                                                   Margin="{OnPlatform Default='14,4,5,0',MacCatalyst='14,10,5,0'}"
                                                   TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}">

                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Author}" />
                                                        <Span Text=" · " />
                                                        <Span Text="{Binding Date}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <StackLayout Orientation="Horizontal"
                                                         Spacing="6"
                                                         Margin="{OnPlatform Default='14,12,0,0',MacCatalyst='14,15,0,0'}">

                                                <Path Data="M1 8C1 4.14 4.14 1 8 1C11.86 1 15 4.14 15 8C15 11.86 11.86 15 8 15C4.14 15 1 11.86 1 8ZM0 8C0 12.411 3.589 16 8 16C12.411 16 16 12.411 16 8C16 3.589 12.411 0 8 0C3.589 0 0 3.589 0 8ZM7.5 9H11C11.276 9 11.5 8.776 11.5 8.5C11.5 8.224 11.276 8 11 8H8V4C8 3.724 7.776 3.5 7.5 3.5C7.224 3.5 7 3.724 7 4V8.5C7 8.776 7.224 9 7.5 9Z"
                                                      Stroke="Gray"
                                                      StrokeThickness="0.2"
                                                      VerticalOptions="End"
                                                      Fill="Gray"
                                                      WidthRequest="20"
                                                      HeightRequest="20"
                                                      Aspect="Uniform" />

                                                <Label Text="{Binding AverageReadingTime}"
                                                       FontSize="12"
                                                       Margin="0,0,0,2"
                                                       VerticalOptions="End"
                                                       FontFamily="Roboto-Regular"
                                                       TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}">
                                                </Label>
                                            </StackLayout>

                                        </StackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </syncfusion:SfRotator.ItemTemplate>
                    </syncfusion:SfRotator>

                    <!--  Header label  -->
                    <Label Grid.Row="1"
                           Margin="{OnIdiom Phone=20, Tablet='16,20,0,10', Desktop='2,10,0,20'}"
                           FontFamily="Roboto-Medium"
                           FontSize="16"
                           HorizontalOptions="Start"
                           LineHeight="{OnPlatform Default=-1,
                                        Android=1.25}"
                           Text="Latest Articles"
                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}" />

                    <!--  Featured blog list  -->
                    <StackLayout Grid.Row="2"
                                 Margin="{OnIdiom Phone='0', Tablet='16,0,16,20', Desktop='16,0,16,20'}"
                                 WidthRequest="{OnIdiom Phone=380, Tablet=765, Desktop=765}"
                                 BindableLayout.ItemsSource="{Binding LatestStories}"
                                 Spacing="14">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="model:Story">

                                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                                        StrokeThickness="0.3"
                                        Padding="0"
                                        StrokeShape="RoundRectangle 14">

                                    <Border.Shadow>
                                        <Shadow Brush="#80000000"
                                                Offset="0,2"
                                                Radius="3"
                                                Opacity="0.4" />
                                    </Border.Shadow>

                                    <syncEffectsView:SfEffectsView TouchDownEffects="Ripple"
                                                                   RippleBackground="#E0E0E0">
                                        <Grid Padding="12"
                                              ColumnSpacing="12"
                                              RowSpacing="2"
                                              RowDefinitions="Auto,Auto,Auto"
                                              ColumnDefinitions="Auto,*,Auto"
                                              HeightRequest="140"
                                              WidthRequest="{OnIdiom Phone=380, Tablet=765, Desktop=765}">

                                            <Grid.Resources>
                                                <ResourceDictionary>
                                                    <converter:BooleanToStringConverter x:Key="boolToStringConverter" />
                                                    <converter:BooleanToColorConverter x:Key="boolToColorConverter" />
                                                </ResourceDictionary>
                                            </Grid.Resources>

                                            <Border Grid.RowSpan="3"
                                                    Margin="0,4,0,0"
                                                    HeightRequest="110"
                                                    WidthRequest="110"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10">

                                                <Image Source="{Binding ImagePath}"
                                                       Aspect="AspectFill" />
                                            </Border>

                                            <StackLayout Grid.Column="1"
                                                         Spacing="4"
                                                         Margin="0,6,0,0">

                                                <Label FontSize="14"
                                                       FontFamily="Roboto-Medium"
                                                       Text="{Binding Name}"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2" />

                                                <Label Grid.Row="1"
                                                       Grid.Column="1"
                                                       FontFamily="Roboto-Medium"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}">

                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Author}" />
                                                            <Span Text=" · " />
                                                            <Span Text="{Binding Date}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </StackLayout>

                                            <StackLayout Grid.Row="2"
                                                         Grid.Column="1"
                                                         Orientation="Horizontal"
                                                         Spacing="6"
                                                         Margin="0,6,0,0">

                                                <Path Data="M1 8C1 4.14 4.14 1 8 1C11.86 1 15 4.14 15 8C15 11.86 11.86 15 8 15C4.14 15 1 11.86 1 8ZM0 8C0 12.411 3.589 16 8 16C12.411 16 16 12.411 16 8C16 3.589 12.411 0 8 0C3.589 0 0 3.589 0 8ZM7.5 9H11C11.276 9 11.5 8.776 11.5 8.5C11.5 8.224 11.276 8 11 8H8V4C8 3.724 7.776 3.5 7.5 3.5C7.224 3.5 7 3.724 7 4V8.5C7 8.776 7.224 9 7.5 9Z"
                                                      Stroke="Gray"
                                                      StrokeThickness="0.2"
                                                      VerticalOptions="End"
                                                      Fill="Gray"
                                                      WidthRequest="20"
                                                      HeightRequest="20"
                                                      Aspect="Uniform" />


                                                <Label Text="{Binding AverageReadingTime}"
                                                       FontSize="12"
                                                       Margin="0,0,0,2"
                                                       VerticalOptions="End"
                                                       FontFamily="Roboto-Regular"
                                                       TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}">
                                                </Label>
                                            </StackLayout>

                                            <buttons:SfButton Grid.Row="0"
                                                              Grid.Column="2"
                                                              Padding="0"
                                                              CornerRadius="4"
                                                              FontSize="16"
                                                              HeightRequest="35"
                                                              HorizontalOptions="End"
                                                              Style="{DynamicResource IconButtonStyle}"
                                                              Text="{Binding IsBookmarked, Converter={StaticResource boolToStringConverter}, ConverterParameter=0}"
                                                              TextColor="{AppThemeBinding Light=#474648, Dark=#C9C6C8}"
                                                              VerticalOptions="Start"
                                                              Clicked="BookmarkButton_Clicked"
                                                              WidthRequest="35">
                                            </buttons:SfButton>
                                        </Grid>
                                    </syncEffectsView:SfEffectsView>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </Grid>
            </ScrollView>
        </Grid>
    </ContentView.Content>
</ContentView>