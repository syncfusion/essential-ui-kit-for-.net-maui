<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EssentialMAUIUIKit.Views.Catalog.ArticleTilePage"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:rotator="clr-namespace:Syncfusion.Maui.Rotator;assembly=Syncfusion.Maui.Rotator"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:local="clr-namespace:EssentialMAUIUIKit"
             xmlns:model="clr-namespace:EssentialMAUIUIKit.Models"
             xmlns:converter="clr-namespace:EssentialMAUIUIKit.Converters"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             x:DataType="local:ArticleListViewModel">
    <ContentView.BindingContext>
        <local:ArticleListViewModel />
    </ContentView.BindingContext>
    <ContentView.Resources>
        <Style TargetType="listView:ListViewItem">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                        Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Background"
                                        Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>

    <ContentView.Content>
        <Grid RowDefinitions="Auto,Auto,*"
              ColumnSpacing="0"
              RowSpacing="0">
            <Grid ColumnDefinitions="Auto,*">
                <buttons:SfButton Background="Transparent"
                                  CornerRadius="4"
                                  Margin="{OnIdiom Desktop='0,10,0,10',Phone='0,7,0,9', Tablet='0,15,0,17'}"
                                  HeightRequest="32"
                                  WidthRequest="100"
                                  TextColor="{DynamicResource Gray-700}">
                    <buttons:SfButton.Content>
                        <DataTemplate>
                            <StackLayout Padding="8,5,8,6"
                                         Orientation="Horizontal"
                                         Spacing="12"
                                         VerticalOptions="Center">
                                <Label FontFamily="FontIcons"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       IsVisible="{OnIdiom Phone=True, Tablet=True, Desktop=True}"
                                       Text="{DynamicResource BurgerMenu}"
                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center" />
                                <Label FontFamily="Roboto-Medium"
                                       FontSize="16"
                                       Text="Blog"
                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center" />
                            </StackLayout>
                        </DataTemplate>
                    </buttons:SfButton.Content>
                </buttons:SfButton>
            </Grid>
            <BoxView HeightRequest="1"
                     Grid.Row="1"
                     Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" />

            <Grid Grid.Row="2"
                  RowDefinitions="*,Auto"
                  ColumnDefinitions="Auto,Auto,*">

                <BoxView WidthRequest="1"
                         Grid.Row="0"
                         Grid.Column="1"
                         IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}"
                         Color="{AppThemeBinding Light={DynamicResource SeparatorColorLight}, Dark={DynamicResource SeparatorColorDark}}" />

                <ScrollView Grid.Column="2"
                            Grid.Row="0">
                    <StackLayout>
                        <rotator:SfRotator x:DataType="local:ArticleListViewModel"
                                           x:Name="Rotator"
                                           DotPlacement="Default"
                                           Margin="0,0,0,10"
                                           DotsStroke="Transparent"
                                           EnableLooping="False"
                                           HeightRequest="{OnPlatform Default=324, Android=210, iOS=210}"
                                           HorizontalOptions="Center"
                                           SelectedIndex="2"
                                           ItemsSource="{Binding FeaturedStories}"
                                           NavigationStripMode="Dots"
                                           SelectedDotColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}"
                                           UnselectedDotColor="{DynamicResource Gray-White}"
                                           VerticalOptions="Start">
                            <rotator:SfRotator.ItemTemplate>
                                <DataTemplate x:DataType="model:Story">
                                    <Grid x:Name="Grid">
                                        <Image Aspect="AspectFill"
                                               BackgroundColor="{DynamicResource Gray-200}"
                                               HeightRequest="{OnPlatform Default=324, Android=210, iOS=210}"
                                               Source="{Binding ImagePath}" />

                                        <Label Margin="16"
                                               FontFamily="Roboto-Medium"
                                               FontSize="{OnPlatform WinUI=32, Android=20, iOS=20}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation"
                                               LineHeight="{OnPlatform Default=-1,
    Android=1.25}"
                                               Text="{Binding Name}"
                                               TextColor="#FFFFFF" />

                                    </Grid>
                                </DataTemplate>
                            </rotator:SfRotator.ItemTemplate>
                        </rotator:SfRotator>

                        <!--  List out the items for latest stories  -->
                        <listView:SfListView x:Name="SfListView"
                                             Grid.Row="1"
                                             IsScrollingEnabled="False"
                                             Margin="0,20,0,0"
                                             AutoFitMode="Height"
                                             MaximumWidthRequest="{OnIdiom Desktop=900, Phone=393, Tablet=900}"
                                             HorizontalOptions="Center"
                                             ItemSpacing="10"
                                             ItemsSource="{Binding LatestStories}"
                                             SelectionBackground="Transparent"
                                             VerticalOptions="Fill">

                            <listView:SfListView.ItemTemplate>
                                <DataTemplate x:DataType="model:Story">
                                    <VerticalStackLayout HeightRequest="{OnIdiom Phone=335, Tablet=325, Desktop=325}">
                                        <Border StrokeThickness="0"
                                                HeightRequest="319"
                                                WidthRequest="{OnIdiom Phone=370, Tablet=418, Desktop=418}"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{AppThemeBinding Light=White, Dark=Transparent}"
                                                Margin="{OnIdiom Phone='0,10,0,0', Tablet='0', Desktop='0'}">

                                            <Border.Shadow>
                                                <Shadow Brush="#80000000"
                                                        Offset="0,3"
                                                        Radius="3"
                                                        Opacity="0.4" />
                                            </Border.Shadow>

                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                                                <!-- IMAGE -->
                                                <Image Grid.Row="0"
                                                       Aspect="AspectFill"
                                                       HeightRequest="153">
                                                    <Image.Source>
                                                        <UriImageSource Uri="{Binding ImagePath}" />
                                                    </Image.Source>
                                                </Image>

                                                <!-- TITLE -->
                                                <Label Grid.Row="1"
                                                       Margin="16,12,16,0"
                                                       FontSize="16"
                                                       FontFamily="Roboto-Medium"
                                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColorLight}, Dark={DynamicResource PrimaryTextColorDark}}"
                                                       HorizontalTextAlignment="Start"
                                                       Text="{Binding Name}" />

                                                <!-- DESCRIPTION -->
                                                <Label Grid.Row="2"
                                                       Margin="16,6,16,0"
                                                       FontSize="14"
                                                       FontFamily="Roboto-Regular"
                                                       TextColor="{AppThemeBinding Light={DynamicResource ContentTextColorLight}, Dark={DynamicResource ContentTextColorDark}}"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation"
                                                       HorizontalTextAlignment="Start"
                                                       Text="{Binding Description}" />

                                                <!-- BOTTOM ROW -->
                                                <Grid Grid.Row="3"
                                                      Margin="16,24,16,0"
                                                      ColumnDefinitions="Auto,*,Auto"
                                                      VerticalOptions="Center">

                                                    <!-- AVATAR -->
                                                    <Border HeightRequest="40"
                                                            WidthRequest="40"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 21"
                                                            BackgroundColor="{AppThemeBinding Light={DynamicResource ReceivedMessageColorLight}, Dark={DynamicResource ReceivedMessageColorDark}}"
                                                            VerticalOptions="Center">

                                                        <Label Text="JD"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"
                                                               FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light=#3C3B3D, Dark=#FFFFFF}" />
                                                    </Border>

                                                    <!-- TEXT BLOCK -->
                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Margin="10,0,0,0"
                                                                         Spacing="2"
                                                                         VerticalOptions="Center">

                                                        <Label Text="{Binding Author}"
                                                               FontSize="12"
                                                               FontFamily="Roboto-Medium"
                                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}" />

                                                        <Label FontSize="12"
                                                               FontFamily="Roboto-Regular"
                                                               TextColor="{AppThemeBinding Light={DynamicResource SecondaryTextColorLight}, Dark={DynamicResource SecondaryTextColorDark}}">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding Date}" />
                                                                    <Span Text=" | " />
                                                                    <Span Text="{Binding AverageReadingTime}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                    </VerticalStackLayout>

                                                    <!-- ARROW -->
                                                    <Border HeightRequest="38"
                                                            WidthRequest="38"
                                                            Grid.Column="2"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 20"
                                                            BackgroundColor="{AppThemeBinding Light=#EBDCFF, Dark=#41394E}"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="End">

                                                        <syncEffectsView:SfEffectsView RippleBackground="Black"
                                                                                       TouchDownEffects="Highlight">
                                                            <Label Text="{DynamicResource ArrowRight}"
                                                                   Style="{DynamicResource IconLabelStyle}"
                                                                   FontSize="18"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"
                                                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryColorLight}, Dark={DynamicResource PrimaryColorDark}}" />
                                                        </syncEffectsView:SfEffectsView>
                                                    </Border>

                                                </Grid>

                                            </Grid>

                                        </Border>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>

                            <!-- ✅ Grid Layout -->
                            <listView:SfListView.ItemsLayout>
                                <listView:GridLayout SpanCount="{OnIdiom Phone=1, Tablet=2, Desktop=2}" />
                            </listView:SfListView.ItemsLayout>

                        </listView:SfListView>
                    </StackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </ContentView.Content>
</ContentView>